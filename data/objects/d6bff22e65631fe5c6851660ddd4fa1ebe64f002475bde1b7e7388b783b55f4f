:{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"jgiv","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_43c3152010964cc3980a61ae0087b18c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Easy Sheet Pan Oven Fried Chicken"}},{"type":"PARAGRAPH","id":"c926e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"698jp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is always a meal everyone looks forward to at our house! It makes the house smell so good!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cq2n8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The chicken sizzling in the oven smells so delicious I think we're all ready to go into a food coma before we eat. And for the cook this is a breeze. Talk about a great Sunday dinner! Or any other day of the week.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"etls2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a3c93","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e845p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I wash up and wrap the potatoes in foil and put them in the oven first at 375 degrees. Then I clean up the corn and get it ready for the microwave. Yes, The microwave. It will take only 3-4 minutes per ear and I don't even have to shuck it! The husks slip right off. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"13qp6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4hpb1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Trim just the tip of the corn silk off of the cob and then any loose outer leaves and rinse the corn well. Now hold the tip of the corn under the running water of the faucet and fill up the corn husk with a few tablespoons of water. You'll want to start cooking the corn just before the chicken is ready so let it hang out in the microwave until then.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2tf6c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5oc48","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I microwave 2-3 ears at a time in my tiny microwave for 3-4 minutes per ear depending on how large or old it is. If it's larger and older go with 4 minutes per ear.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fe8nf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"58gcl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Put the corn into the microwave directly onto the carousel and cook the corn on high power.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ciop","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fmn38","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When it's done, use a mitt or potholder, my husband uses an Ove' Glove to take the ears out of the microwave. They will be very hot. Now and one by one, cut the large stalk end off with a sharp knife and squeeze the small tip of the cob until the ear of corn plops right out of the husk perfectly clean.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"45bjh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5eldj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fhden","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"22eh4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This has literally never failed to give us tasty, flavorful, perfectly cooked corn on the cob and it's so fast with almost no cleanup!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"73qmg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"idei","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Getting the chicken ready for the oven is fast and easy too. Below is a tutorial you can click on and follow along. It's takes about 5 minutes to do.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"nc82","nodes":[{"type":"TEXT",