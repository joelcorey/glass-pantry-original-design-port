idn't.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eombs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"40vh4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"ebbt0","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_1af68191db4c4e3492f7742d26bb2b22~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"A day's harvest"},{"image":{"media":{"src":{"url":"577c92_0b40bac255344e49bc46becf09d48a78~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"A days harvest"},{"image":{"media":{"src":{"url":"577c92_cf7271e2c081402fbe77991dc55852f7~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Spaghetti Squash"},{"image":{"media":{"src":{"url":"577c92_a9cc9b065c904e52a56ef207e5d3541e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Volunteer cabbage"},{"image":{"media":{"src":{"url":"577c92_d85adacc830d4dffa7eb2e3b48da84d3~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Scarlett Runner Beans"},{"image":{"media":{"src":{"url":"577c92_e972d502658746bebfb198a0c8054787~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"The potatoes"},{"image":{"media":{"src":{"url":"577c92_1542afb2834e45b49ee72b052b73d5a2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Brandywine Heirloom Tomato"},{"image":{"media":{"src":{"url":"577c92_42657696b52f4484bf76e6e6c492b45e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Brandywine Heirloom Tomato"},{"image":{"media":{"src":{"url":"577c92_2521bce0efed4a16857dcb9c74e054e8~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Brandywine Heirloom Tomato"},{"image":{"media":{"src":{"url":"577c92_59dcf0553f41400db48c62a143a43c65~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"The Zucchini Patch"},{"image":{"media":{"src":{"url":"577c92_783fe0a6ce974a2daa5f18aad883a833~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Patio Tomatoes"},{"image":{"media":{"src":{"url":"577c92_d2ae5cde853c481088372c8a76db13d4~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Poblano peppers"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":16},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"ajbam","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"30gvs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I've never grown spaghetti squash before and it grew beautifully under my rose bushes! These squash grew so big! Much bigger than the ones in the store. I cooked one and I'm also impressed with the flavor. I always find the ones from the store to taste watery and bland but these are so full of flavor and sweeter. If you're not a big fan of spaghetti squash you might want to try these home grown. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"53stj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fggcv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I do a lot of container gardening so I can tell you that although many people say zucchini and yellow summer squash are good candidates, I haven't had any luck. Once I put them in the ground they just took off! Make sure you have space for the large plants.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fo4gp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1dgol","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I do have spectacular results with peppers and chilies in containers. They don't need very much space either to produce a lot of fruit. The thing about peppers is you need to pick them. If you pick them they will produce more and more fruit for you.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"el9es","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"727sv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We had a fairly short season because it snowed and never warmed up until well into May so I did start with some large store bought plants this year. I hope things warm up a little sooner next spring.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2bpgk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"csrm6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I planted my garlic a few weeks ago for next summer's harvest.  Be sure to check out my post about  H","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"ow to Grow Garlic. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/07/10/How-to-Grow-and-Harvest-Garlic","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I've grown hard neck garlic 3 years now and it never fails. We love the garlic scape bonus that comes with growing hardneck garlic too! Mmmmm ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Garlic Scape Pesto","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/07/10/How-to-Grow-and-Harvest-Garlic","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ka5g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2bpoc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5i0p5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cp2q4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"498nf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hover or click on these images for more information","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"GALLERY","id":"dk8pg","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_f424573c175e4a92921f50e0a559a348~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"The patio"},{"image":{"media":{"src":{"url":"577c92_da2af8edfdb84914b9bb8332dbc8c7f1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Stone Crop"},{"image":{"media":{"src":{"url":"577c92_5622cd967473420690233ca142dab097~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Succulents and an ornamental chili"},{"image":{"media":{"src":{"url":"577c92_9008003c0eb14d42b1d902f1e3dd815c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Succulent planting"},{"image":{"media":{"src":{"url":"577c92_e14825b6915f4a498813e1ac808e8b95~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Wall Planter"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"524q3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fio8h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ap8v4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I just love succulents and I'm learning how easy it is to propagate them. Many are quite hardy in our winter temperatures so I'm going to propagate and spread them around even more next year. Kalanchoe and Stone crop reproduce readily from cutting placed in a glass of water. As soon as they have some roots I put them in pots and they grow very easily. Kalanchoe is not winter hardy and I have to bring that into the house to place with bright light.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"61n5g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e8j1o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"f72vq","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_782c43bd3c9e4d5b85542d57e81be0ac~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Maiden Hair Fern"}},{"type":"PARAGRAPH","id":"fdej2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7nrgk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This Maidenhair fern is one of my favorite plants. It's about 30\" across in this picture. It has gone brown and died back as it does every fall but since it doesn't live outside here in the winter this is okay. I recently brought it in and cut off all that was of the beautiful foliage you see here and it thinks it's spring again already and it's putting up all kinds of new little shoots, Yay! I've been moving this plant inside and out again for 3 years and it's getting bigger all the time. I may have to get it a bigger pot next spring.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"v863","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"870tt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"96v02","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cn0dv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aavb5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"eeu7r","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_b77428eeaf6d4232828cdabf9273d9f5~mv2.jpg"},"width":1125,"height":1500}},"title":"My favorite planter"},{"image":{"media":{"src":{"url":"577c92_f636cd6e096b4a19ac47168e74cdab51~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_53ddfa1ffea0441cbbd8e7dcf0f756a5~mv2_d_2729_1905_s_2.jpg"},"width":2729,"height":1905}}}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"eactf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"61q7m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bdlbe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is my favorite planter this year. I started it with 4 small starts in May so it's about 3 months old in these pictures. Purple petunias, pink calibrachoa, white alyssum, and sweet potato 