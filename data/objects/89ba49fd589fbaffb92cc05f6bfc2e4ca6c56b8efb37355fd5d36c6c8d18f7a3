6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Meatloaf has always been a family favorite at our house. It's always my goal to make a meatloaf large enough (or two) that my husband can get a meatloaf sandwich made out of it the next day! Really, the family likes my meatloaf so much that it's not so easy to create leftovers. You might want to try this if you have any venison hanging out in your freezer. If you don't, then make this with ground beef and enjoy it all the same.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"72mll","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c9gcf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I use half ground beef because of the fat content. Venison is so lean that when I use it alone it's just too dry for meatloaf. It works wonderfully for lean summer sausage though, but that will be another blog.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9h0b6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3d7c4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"101l3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b4l4d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is a simple recipe although the list of ingredients looks a bit long. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dmrv6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"485ql","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"First combine the spices then measure out the milk and bread crumbs. Place the ground venison and ground beef together in an electric mixer or mix by hand until somewhat combined. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"55i3f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the spices and 1 egg then mix until almost combined.  Add the Worcestershire sauce, bread crumbs and milk then mix until just combined. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"76dc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cnnj5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Do not over mix the ground meat or it will become to compact and your meatloaf will be tough. It should hold together well but still have a soft texture.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d7lk0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9g89c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"36qjc","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTEN