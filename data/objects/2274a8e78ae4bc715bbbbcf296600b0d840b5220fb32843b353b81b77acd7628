{"postPage":{"id":"15141deb-3cf9-4db5-86bb-b76863d577d7","post":{"id":"15141deb-3cf9-4db5-86bb-b76863d577d7","title":"Smoked Tuna Masago Sushi Roll","excerpt":"Place down some plastic wrap on your sushi mat, then thinly and evenly spread the sushi rice to cover just the bottom half of the mat. This ","firstPublishedDate":"2017-04-02T01:17:32.398Z","lastPublishedDate":"2017-04-02T01:17:32.398Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/04/01/smoked-tuna-masago-sushi-roll"},"slug":"2017/04/01/smoked-tuna-masago-sushi-roll","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","715d4ad1-bef8-425f-aa2b-a2ef47bf20ca","ecbcfcfe-4a80-42f2-bfc4-b104a8dcf8fd","86cb13c9-ebe8-4da9-92bc-d9f63db5b610","6ba8db7a-6fe2-4b5a-83bf-acd0b1cbda4c"],"memberId":"4bafc351-4af6-4e6a-bf15-1ac9c1d80e80","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":608},"minutesToRead":3,"tagIds":["cefc0491-77e7-4b63-aacd-518818e37860"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":608,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Smoked Tuna Masago Sushi Roll","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Smoked Tuna Masago Sushi Roll | Smoked Tuna | Masago Recipe"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"du307","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Smoked Tuna Masago Sushi Roll","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bgreo","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b7e8ce78f29547d09cd20df4d86af2a5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"167c9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6cbvp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My brother makes some really incredible canned smoked tuna and I was lucky enough to get some from him recently. This is one of the things I decided to make with it. I love sushi and I really like to use masago in it. This sushi roll highlights both and it tastes as amazing as it looks and it's really simple to make too!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2enda","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"22adf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"So yum!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5cgbo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6a8la","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5p9nu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I started with the sushi rice.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3sppa","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_58b92f4540584080a6eeecf179963f50~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"5em9o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a4i85","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sushi rice is super simple. Get some Calrose or other short grained white rice and cook it up in a pot or rice maker. I use a pot because I already have too many specially designed gadgets in my kitchen and the pot just works. 2 cups of water to 1 1/3 cups Calrose rice. I have a hot water tap so I use that for the water, then add the rice and turn it on high. Let it get to a rolling boil for 30 seconds or so then pop on the lid and pull it off the heat while you turn the burner down to low and let it cool off a bit. After your burner is cooled off, return the pot to the burner to simmer for at least 20-30 minutes then check your rice. If you take a taste and it's still a bit tough in the middle add 2-3 tablespoons of water and set back to simmer for another 10 minutes. Take it off the heat now and fluff it, put the lid back on and let it sit while you do whatever. I like to do this early so the rice has some time to age for a little while, maybe an hour or so. After it has cooled a bit (lid on) put the rice in a big bowl and add 3-6 tablespoons of rice vinegar to taste and stir it with a wooden spoon until well mixed and fluffed. Keep it covered until you are ready to prepare the rolls.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"25ltk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"firme","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c5b4t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f7a0h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When you are ready to finish up your sushi rolls, it's time to set up your rolling station. This is mine today. My brothers incredible smoked tuna (about 8 oz) mixed with 8 oz neufchatel or cream cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bfvtl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Some green onion, a sushi mat, chop stick, iced tea spoon, plastic wrap, masago and nori. Here's the assembly sequence.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"63e1o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fnv8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"13o4h","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_2e9798c9bf8a464abc9328700148fad3~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20170401_121051"},{"image":{"media":{"src":{"url":"577c92_291c4f9632cd4c889eb2dc825f088772~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20170401_121404"},{"image":{"media":{"src":{"url":"577c92_0dcbd7fda02048ceb85b5dc03d5a5fe9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20170401_121159"},{"image":{"media":{"src":{"url":"577c92_490314591233464cb80abc0beff154d3~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20170401_121533(0)"},{"image":{"media":{"src":{"url":"577c92_6659836e7b164c36923ed3f980c1896b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20170401_121533"},{"image":{"media":{"src":{"url":"577c92_d2989bced1ba481db05be998b3cbce41~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20170401_121745"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"ebtnd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7mjbq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52kbj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place down some plastic wrap on your sushi mat, then thinly and evenly spread the sushi rice to cover just the bottom half of the mat. This is a thin, light layer, it's really easy to over do the rice in a sushi roll. Next add one 1/2 sheet of nori to cover the rice. Then using your spoon and chop stick add a nice even row of the smoked tuna mixture and top that with a little of the masago and some strips of green onion. Then you roll it up! Do this slowly and apply even pressure all the way across the row to get it nice and snug.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ah0ci","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7snun","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2r8cl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_0b5f3f1fb7634e66b816fe521417dce5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"61d43","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"618rn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Adding the last coating of masago, which is the roe of the capelin fish. Capelin is a type of smelt found in Arctic waters. Capelin is a sustainable fish found in large quantities, so eating masago sushi is an ocean-friendly option.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5cst6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ipjo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"uc4u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Lay down some plastic wrap on a sushi plate or on a cutting board and then lay down a 2 inch wide 1/4 inch deep layer of masago onto it with a small spoon. After unrolling your smoked tuna roll from the mat and it's plastic wrap, set it on top of the masago and press gently, turn the roll and press again until you have covered the roll. Now roll it up gently in the plastic wrap and roll it gently until it's uniformly covered with the masago. You can now put it in the refrigerator for later or unwrap it immediately and plate it. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7igj2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8h99t","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_63500f9d679149e1b3ed6982b72bc338~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"4c709","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6b3th","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I chose to plate mine immediately because I was hungry and it looked soooooo good!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dr6r9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"cis5e","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_0cd6bdfe21e44086a0cf0ceb85b457c4~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"4kij4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Then I added some garnishes. Some green onion, pickled ginger, wasabi and a squeeze of Kewpie sriracha mayo with a little bit of masago in it.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e75hg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dbmru","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c556504ffff84dbe85fee5d6a1f7a8c9~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032},"altText":""}},{"type":"PARAGRAPH","id":"bo2jl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fhmv5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"37itc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I hope you'll try this. Thanks for the tuna little brother!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7l78f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eh6al","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"feqke","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"audap","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-11T00:29:06.100Z","updatedTimestamp":"2024-06-11T00:29:06.100Z","id":"186ee6a5-c182-46d8-afbc-d8b8084fa381"}},"contentId":"61728aec98f45e00165412a9","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_b7e8ce78f29547d09cd20df4d86af2a5~mv2_d_4032_3024_s_4_2.jpg","url":"https://static.wixstatic.com/media/577c92_b7e8ce78f29547d09cd20df4d86af2a5~mv2_d_4032_3024_s_4_2.jpg","height":3024,"width