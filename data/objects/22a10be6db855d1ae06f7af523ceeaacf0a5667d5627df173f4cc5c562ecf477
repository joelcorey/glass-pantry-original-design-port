isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jx81liwu":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">With a rolling pin, roll&nbsp;out a sheet of puff pastry and cut it into a circle to fit a&nbsp;pie plate then fill&nbsp;it with cooled cherry pie filling. Bake according to the directions on your puff pastry box.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">I really didn&#39;t want to waste the scraps I had cut from the puff pastry sheet so I made some little pin&nbsp;wheels with them&nbsp;and baked them separately, placing them on the top after baking the puff pastry pie.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jxc3h1n7":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Method for a Rainier or Bing Cherry&nbsp;Pie</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Mix together the ingredients for the pie filling listed above.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Roll out a piece of refrigerated&nbsp;pie crust and fit it in the pie plate. Don&#39;t forget to trim the edges. Save them wrapped in plastic wrap for a little later.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Roll out the second sheet of pie crust and lay it across the pie folding the edges under the bottom crust to seal. Score the pie decoratively to let steam escape as it bakes. Crimp the sealed edges using your fingers.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Prepare a baking sheet with foil or parchment paper to place on the rack beneath the pie to catch drips if the pie leaks.&nbsp;</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Bake the pie in a pre-heated oven at 400 degrees for 20 minutes then cover the edges of the pie with foil to prevent over browning. Add any decorative pieces you make from the scraps of dough you saved and continue to bake for another 25 minutes.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Cool at least 45 minutes or completely before serving.</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jx81lijm":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-jx81liy1":{"id":"comp-jx81liy1","appDefinitionId":"13016589-a9eb-424a-8a69-46cb05ce0b2c","widgetId":"130165ba-4eeb-4a87-3121-a3cf2a86d2ca","isAppInClientSpecMap":true,"isViewerMode":true,"isResponsive":false,"translations":{"preloaderOverlay":{"loading":"Loading"},"errorMessageOverlay":{"reloadText":"Refresh this page","oopsText":"App Didn't Load","installErrorText":"We Were Unable to Install This App","generalErrorPrefix":"Try again later, disable any ad blockers, or reload the page. Contact the author of","generalErrorSuffix":"for help.","uninstalledErrorText":"We Were Unable to Install This App"},"unavailableMessageOverlay":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us.","reloadText":"Refresh this page"}},"applicationId":"2979"},"comp-jx81lizd":{"images":[{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_24a35ec53c4a4d41a0da9c7b7cd6d2d3~mv2_d_3000_1965_s_2.jpg","alt":"","width":3000,"height":1965,"id":"dataItem-jx81lizo","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_f1ab68320b444a4ca3cc0b7dd2284bf5~mv2_d_3000_4500_s_4_2.jpg","alt":"","width":3000,"