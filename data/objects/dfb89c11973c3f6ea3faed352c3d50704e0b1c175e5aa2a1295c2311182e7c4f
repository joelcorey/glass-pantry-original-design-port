"text":"Portabello Mushrooms","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"dcakb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"with Mushroom Marinara","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4koh1","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e1589c34a2774eb0ae6692de163e92c3~mv2.jpg"},"width":1500,"height":1125},"altText":"Sausage Stuffed Portabello Mushrooms"}},{"type":"PARAGRAPH","id":"eh3ok","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ad82l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is a tasty dish my husband taught me! Well, he was making something similar for himself before we got married. His version was the basics, large portabello mushrooms stuffed with mild Italian sausage then topped with mozzarella cheese. All baked together in yummy harmony. Really I just stepped it up with the addition of some mushroom marinara. Try this either way depending on how much time you have or how much energy you would like to put into dinner. Trust me it will be delicious!  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"et16k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"60eia","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"77o5r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4ibd","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_104ebf293f1a45b5bbade776c87250b5~mv2.jpg"},"width":1333,"height":1000},"altText":"Portabello Mushrooms"}},{"type":"PARAGRAPH","id":"ei1je","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you opt for making the marinara sauce. Start by removing the large stem from the mushrooms and chop them up to add to the sauce.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"97b5t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5b3kr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I missed the picture where I stuffed the portabello's so I pulled them out of the oven so you could see how they were coming along. Just make a ball of mild Italian sausage, place it into the mushroom cap and flatten it out like a hamburger. Place the stuffed mushrooms in a shallow baking dish with enough water to cover the bottom of the dish 1/4 inch deep then into the oven at 350 degrees for 30-40 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7jtl5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"93t77","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8e42982f6e0a4d899f557f40990c18b4~mv2.jpg"},"width":1125,"height":1500},"altText":""}},{"type":"PARAGRAPH","id":"6jmba","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4p4jm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" While the mushrooms are baking it's time to make the sauce.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"11vgi","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_30420241ef5a482d9ed5359027e01c75~mv2.jpg"},"width":1500,"height":1125},"altText":"Mushroom Marinara Ingredients"}},{"type":"PARAGRAPH","id":"dok0t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"These are the marinara ingredients I've gathered. 1/4 chopped onion, one bay leaf, 2 cloves minced garlic, 1 small can of tomato paste, 1 14 oz can Italian style diced tomatoes, basil, oregano, salt and pepper. If you don't have or want to use the Italian style diced tomatoes just boost the quantity of the basil and oregano by one teaspoon each and add a clove of garlic.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a316n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7hcv3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aeacc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"81hr1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Begin the sauce with the onions. Add them to a sauce pan with a tablespoon of olive oil and saute' them until they are translucent. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"erdp","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_47d5dba90aad4cb6b2e7d1989d865358~mv2.jpg"},"width":1500,"height":1125},"altText":"Sauteing Onions"}},{"type":"PARAGRAPH","id":"dt4le","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ub2k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5c8rt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"el0jq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now add the garlic for just a minute or two then stir in the rest of the ingredients. I added the chopped mushrooms last so they wouldn't cook down too much and still retain some of their texture. I stir these in and bring the pot to a low boil then reduce the heat to low and let it simmer.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9rnau","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"7ci4p","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_262e545c2b354e6cbc6348cc7a2b5331~mv2.jpg"},"width":1500,"height":1125},"altText":"Adding Portabello stems to the Marinara Sauce"}},{"type":"PARAGRAPH","id":"einim","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ake0b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ev4e2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"About twenty minutes later I have a lovely chunky mushroom marinara sauce.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9j3j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_fcc497471c9f4e17aa935990ababe31a~mv2.jpg"},"width":1500,"height":1125},"altText":"Mushroom Marinara Sauce"}},{"type":"PARAGRAPH","id":"b97f7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"er8or","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"94mod","nodes":[],"imageData":{"containerData":{"width":{"size":"SMALL"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_0da415339f3941889236f8a3b42c6630~mv2.jpg"},"width":1085,"height":1447},"altText":"Maitake Mushroom Oil"}},{"type":"PARAGRAPH","id":"flhff","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I have this wonderful Maitake mushroom oil I got as a Christmas gift from my brother that smells divine! I don't always have this on hand but it was a perfect add for this sauce. If you have some mushroom or truffle oil add a little to the marinara before topping the stuffed portabella's.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"am661","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"eakll","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d94df232e6954f8d86bd3a78547716c8~mv2.jpg"},"width":1500,"height":1125},"altText":"Sausage Stuffed Portabello Mushrooms"}},{"type":"PARAGRAPH","id":"6h6j5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I was using my cranberry colored Pyrex on my black glass cook top and it was difficult to get a picture of these gorgeous stuffed mushrooms so I pulled them out so you could see them better.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bsodn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ev3b3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bvf39","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5enqm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"With my meat thermometer, I checked to be sure they were cooked to 160 degrees before adding a dollop of marinara sauce and nice handful of grated mozzarella cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1hh7d","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5a1abb568e5745f6abefad0df3fb5509~mv2.jpg"},"width":1500,"height":1125},"altText":"Topping the stuffed portabello mushrooms"}},{"type":"PARAGRAPH","id":"479qq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c3047","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I turned on my broiler and put them back into the oven for another 5 minutes to brown the tops.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9p8ck","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f785fd1056314e6e8f10fe43214923c7~mv2.jpg"},"width":1125,"height":1500},"altText":"Sausage Stuffed Portabello Mushrooms"}},{"type":"PARAGRAPH","id":"82ebl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cg74r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Dinner is served! I made some pasta to serve with the extra marinara and some steamed broccoli that also pairs well with this sauce.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"b7629","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e1589c34a2774eb0ae6692de163e92c3~mv2.jpg"},"width":1500,"height":1125},"altText":"Sausage Stuffed Portabello Mushrooms"}},{"type":"PARAGRAPH","id":"e5c5t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2vh20","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Such a simple dish but it packs a ton of flavor! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},