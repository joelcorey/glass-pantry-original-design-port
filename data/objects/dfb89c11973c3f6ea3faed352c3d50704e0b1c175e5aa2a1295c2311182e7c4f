corations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"898cb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mushroom or truffle oil (optional)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7tb52","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"308fb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"*If you don't use the Italian style diced tomatoes boost the quantity of the basil and oregano by one teaspoon each and add one more clove of garlic.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c5vdj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3u4o1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"716uf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a4ab5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"atnac","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dh1ip","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Start the mushrooms","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7368e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the large stem from the mushrooms and chop them up to add to the sauce. Make 4 balls of mild Italian sausage, place one into each mushroom cap and flatten it out like a hamburger. Place the stuffed mushrooms in a shallow baking dish with enough water to cover the bottom of the dish 1/4 inch deep then into the oven preheated to 350 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"o8np","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5n5ta","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Make the Marinara","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"rgf6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the onions to a sauce pan with a tablespoon of olive oil and saute' them until they are translucent. Now add the garlic for just a minute or two then stir in the rest of the ingredients. I add the chopped mushrooms last so they wouldn't cook down too much and still retain some of their texture. Bring the pot to a low boil then reduce the heat to low and let it simmer for twenty minutes or so. Add the truffle or mushroom oil now if using.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1vg6i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"217k4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Top and finish the mushrooms","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f10i1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"With a meat thermometer, check to be sure the sausage in the mushrooms is cooked to 160 degrees before adding a dollop of marinara sauce and nice handful of grated mozzarella cheese. Preheat the broiler on the oven then put the topped mushrooms back into the oven to brown the tops. Watch closely. They should be nicely browned in 4-5 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fc8p6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4fefc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-12T10:56:07.429Z","updatedTimestamp":"2024-05-12T10:56:07.429Z","id":"2b729a8a-f91f-4b9e-9b12-bf4f3014184c"}},"contentId":"61728aec1d9d1c0017ddc707","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_e1589c34a2774eb0ae6692de163e92c3~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_e1589c34a2774eb0ae6692de163e92c3~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f676986b1c54b001781c70d","internalCategoryIds":["5f67697cf4b037001706012d","5f67697cf4b0370017060139","5f67697cf4b0370017060135","5f67697cf4b0370017060132"],"internalRelatedPostIds":[],"isLiked":false,"isSubscribed":false,"owner":{"activityStatus":"UNKNOWN","contactId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","id":"2d3dcba5-39de-4c33-b11a-89d9248a0e51