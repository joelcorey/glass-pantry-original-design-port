"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jl825nac":{"crop":{"x":5,"y":0,"width":4021,"height":3024},"alt":"20200417_193248.jpg","width":4032,"height":3024,"uri":"577c92_5a94c394471a4ca9a4a459c27040d5b9~mv2.jpg","name":"20200417_193248.jpg","containerId":"comp-jl825nac","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/577c92_5a94c394471a4ca9a4a459c27040d5b9~mv2.jpg/v1/crop/x_5,y_0,w_4021,h_3024/fill/w_504,h_379,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200417_193248.jpg","srcset":"https://static.wixstatic.com/media/577c92_5a94c394471a4ca9a4a459c27040d5b9~mv2.jpg/v1/crop/x_5,y_0,w_4021,h_3024/fill/w_504,h_379,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200417_193248.jpg 1x, https://static.wixstatic.com/media/577c92_5a94c394471a4ca9a4a459c27040d5b9~mv2.jpg/v1/crop/x_5,y_0,w_4021,h_3024/fill/w_1008,h_758,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200417_193248.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":504,"height":379,"objectFit":"cover"}}},"containerWidth":504,"containerHeight":379,"isInFirstFold":false,"onClickBehavior":"disabled","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-jl825nac","mainPageId":"qgy49","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-jl825nbi":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">To get a great sear on any protein,&nbsp;you need to get the pan super hot. Cast iron is great for this job. I don&#39;t use any oil in the pan for this recipe any more. The shrimp has just enough oil from the marinade that it cooks perfectly without any extra.</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Make sure not to crowd those beautiful morsels. They need to have lots of space between them so the moisture on the outside of the shrimp evaporates quickly creating the sear and sealing the shrimp juices inside.</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">The shrimp will probably stick&nbsp;immediately when added to a properly heated pan. This is good! No stir-frying in this dish. Let the shrimp sear undisturbed for about 2 minutes then check to see if it&#39;s loosening from the pan. it will naturally release when it&#39;s ready.</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">When the shrimp releases from the pan it&#39;s time to turn it over and sear the other side. Again, let it sear undisturbed for about 2 minutes. When it releases from the pan easily, remove it&nbsp;to keep warm in a bowl close by&nbsp;until all the shrimp are done.</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"color:#1c1c1c;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:400;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Another way to know if the shrimp is done is to sear them until they are&nbsp;opaque and shaped like the letter &quot;C&quot;. Try not to cook them until they are the shape of the letter &quot;O&quot; because&nbsp;O stands&nbsp;for overdone.</span></span></span></span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jl825ndl":{"crop":{"x":0,"y":0,"width":4032,"height":3024},"alt":"20180815_182440.jpg","width":4032,"height":3024,"uri":"577c92_2538ee09b2cf44f381d5e82db628374b~mv2_d_4032_3024_s_4_2.jpg","name":"20180815_182440.jpg","containerId":"comp-jl825ndl","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/577c92_2538ee09b2cf44f381d5e82db628374b~mv2_d_4032_3024_s_4_2.jpg/v1/fill/w_504,h_375,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180815_182440.jpg","srcset":"https://static.wixstatic.com/media/577c92_2538ee09b2cf44f381d5e82db628374b~mv2_d_4032_3024_s_4_2.jpg/v1/fill/w_504,h_375,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180815_182440.jpg 1x, https://static.wixstatic.com/media/577c92_2538ee09