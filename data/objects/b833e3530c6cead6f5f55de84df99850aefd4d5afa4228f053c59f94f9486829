ata":{"text":"Double Cut Pork Chops with Korean BBQ Glaze","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"cmg9n","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_63720da2334d48ad90bf6e936623051a~mv2.jpg"},"width":1500,"height":1002},"altText":"Double Cut Pork Chop with Korean BBQ glaze"}},{"type":"PARAGRAPH","id":"7i0dp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f0ac4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A thick cut of pork is easier to cook through without drying it out too much so if dry pork chops have been a problem for you in the past this could be the answer for you. These chops are moist and flavorful with a spicy Korean BBQ sauce and what's nice for me is that they are cooked indoors. It's getting pretty cold here in North Central Oregon and outdoor BBQ's will have to wait for a few months. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8dlns","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cgplk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ed75r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"c478l","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_0efcef55fef64b4d9445a6af825caa50~mv2.jpg"},"width":1500,"height":1003},"altText":"Double Cut Pork Chop with Korean BBQ glaze"}},{"type":"PARAGRAPH","id":"br9i1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sear these beauties in an oven safe pan on the stove top then finish them off in the oven for great caramelization and flavor!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eg8p6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8j5ot","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ab9an","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"11ade","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband had never had a double cut pork chop before and was very curious as to what the attraction was. I'm pleased to report that the mystery has since been revealed!The results are juicy and tender.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"15m83","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a14453d5d4b343e9843c4cac83e7bfe1~mv2.jpg"},"width":1500,"height":999},"altText":"Double Cut Pork Chop with Korean BBQ glaze"}},{"type":"PARAGRAPH","id":"79jus","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5hrha","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1vqbh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1uu7m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2l2c4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I found  French pork racks on special at our Fred Meyer recently at a great price and thought this was a good day to make some double cut pork chops! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"75mb6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d4lfo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This was a beautiful cut of meat as it was but I was really interested in taking the mystery out of the double cut pork chop so I cut it in half. One of the great things about doing this is that I increased the surface area of the meat for seasoning and caramelizing. That equals more flavor. Yum!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f34af","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"1q9ov","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_c433d5fa59e04f1687fe4acdc463b15a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"This is the cut I purchased"},{"image":{"media":{"src":{"url":"577c92_a2bf42e9edee47f3bbcc220c88cd98d7~mv2_d_3265_2185_s_2.jpg"},"width":3265,"height":2185}}},{"image":{"media":{"src":{"url":"577c92_52f08ef1f37043c98bfd606dde3f9ff6~mv2_d_3665_2442_s_4_2.jpg"},"width":3665,"height":2442}},"title":"Cut this in half"},{"image":{"media":{"src":{"url":"577c92_017fb184aa3f4539b8574eaa52775f17~mv2_d_3722_2486_s_4_2.jpg"},"width":3722,"height":2486}},"title":"Double Cut Pork Chops"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"46blv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"edhtb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"63aa6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now that I had my double cut pork chops, I rubbed them with a few tablespoons of BBQ rub and let them come to room temperature over the next 30 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a3ttm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bnr8r","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b89ded429dc947128469268de3a9e8f8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Double cut pork chops seasoned with BBQ rub"}},{"type":"PARAGRAPH","id":"ri5e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7q0er","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5sav0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I started preheating the oven to 400 degrees and a cast iron skillet over medium high heat until it was very hot. I added a teaspoon of oil to the skillet after it was preheated and then immediately started to sear the chops for 6 minutes on each side. Then I started turning them around on their edges to get them seared too. It took about one minute per side.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"abtnh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6d9n1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"1v0rn","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_38ded9c9a200415a98ad542399d33eb8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Sear over high heat"},{"image":{"media":{"src":{"url":"577c92_984281487a104bf6b261a0d596068a01~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Turn at about 6 minutes"},{"image":{"media":{"src":{"url":"577c92_6eccf089591d4032866f267deedfcab2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"After 6 more minutes"},{"image":{"media":{"src":{"url":"577c92_8866ea21b7c94c608e3ee3b772478bf2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Now sear the sides."},{"image":{"media":{"src":{"url":"577c92_71e28b0165ee4e4d8ffc509551484f47~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_d25b8d1eb8354e64989c76ab30ccb993~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Ready for the oven!"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"ad18q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After both sides and all the edges were seared, I liberally coated the top of the chops with the Korean BBQ sauce then placed the whole pan in the preheated oven with the rack placed in the middle.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dsdnc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9datd","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_6e1100fa809242dfac03b5eb8037bafc~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Double Cut Pork Chop with Korean BBQ glaze"}},{"type":"PARAGRAPH","id":"4ofqm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6hvr2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Over the next 15 minutes I turned and basted the pork chops with the Korean BBQ sauce twice.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5itsn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment"