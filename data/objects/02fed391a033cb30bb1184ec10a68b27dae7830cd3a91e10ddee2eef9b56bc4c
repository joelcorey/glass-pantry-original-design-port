 <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertising":"marketing"}},"comp-kwmluvdr":{"type":"Anchor","id":"dataItem-kwmluvds","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"7ku-6500"},"name":"Chanterelle Chowder","compId":"comp-kwmluvdr","urlFragment":"chanterellechowder"},"comp-kwmluvdv":{},"comp-kwmluvdz":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:50px;\"><span style=\"font-size:50px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\">Chanterelle Chowder</span></span></span></h1>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kwmluve1":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ingredients</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kwmluve21":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">24-32 oz. chopped chanterelle mushrooms, fresh, frozen or pre-cooked</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 large cloves garlic, minced</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 large sweet onion, diced</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">4 ribs of celery, diced and divided</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">4 slices cooked bacon, chopped and divided</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/4 cup butter</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/4 cup all purpose flour</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">8 oz. clam juice or other liquid of choice</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 1/2 to 2 cups fat free half and half or other cream</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 1/2 teaspoons salt</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 1/2 teaspoons pepper</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 teaspoons herb salt blend. Here&#39;s a recipe for&nbsp;<span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.theglasspantry.com/my-secret-spice-blend\" target=\"_self\" class=\"wixui-rich-text__text\">My Spice Blend</a></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">5-6 peeled and chopped russet potatoes</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">extra butter, and dry sherry for garnish</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kwmluve4":{"pinUrl":"https://www.pinterest.com/pin/637329784777472299/","isConsentPolicyActive":false,"isMobile":false,"translations":{"componentName":"Share from Pinterest","large_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url> ","large_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","medium_element_one_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> cookie settings.<url>","medium_element_two_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> and <%=cookietype%> cookie settings.<url>","small_element_one_cookie":"<url>Update your cookie settings<url>","small_element_two_cookie":"<url>Update your cookie settings<url>","small_tooltip_one_cookie":"To view <%=componentname%>, update your <%=cookietype%> settings.","small_tooltip_two_cookie":"To view <%=componentname%>, update your <%=cookietype%> and <%=cookietype%> settings.","small_element_aria_label":"More info","tiny_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_aria_label":"Unblock <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertising":"marketing"}},"comp-kwmluve5":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Method</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kwmluve61":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Bring a large pot or Dutch oven to a medium temperature and add the fresh or frozen chopped chanterelle mushrooms. Allow them to sweat and cook until the liquid has nearly evaporated. If you use precooked chanterelles you can skip this step.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Add the garlic, sweet onion and half of the celery. Stir and cover, stirring occasionally and recovering until the veggies are translucent.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Now stir in half of the chopped bacon and add the butter. Allow the butter to melt then sprinkle on the 1/4 cup of flour. Mix until the flour is incorporated.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Next stir in the 8 oz. clam juice or other liquid and stir until smooth. Then add the fat free half and half or other cream and stir until well blended.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Add the rest of the chopped celery.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Stir in the salt, pepper and herb salt blend then bring the whole pot up to a full simmer while stirring. The Chowder should begin to thicken up after all the ingredients have warmed sufficiently.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Now add in the chopped potatoes and cook at a high simmer until the potatoes are fork tender. About 30 minutes or so. The smaller the pieces, the faster they cook.&nbsp;</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">When the potatoes are tender, test the chowder for salt and pepper adjusting as needed to suit your taste.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Garnish with a pat of butter, a dash of dry sherry and the bacon bits.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kwmluve8":{"id":"comp-kwmluve8","appDefinitionId":"13016589-a9eb-424a-8a69-46cb05ce0b2c","widgetId":"130165ba-4eeb-4a87-3121-a3cf2a86d2ca","isAppInClientSpecMap":true,"isViewerMode":true,"isResponsive":false,"translations":{"preloaderOverlay":{"loading":"Loading"},"errorMessageOverlay":{"reloadText":"Refresh this page","oopsText":"App Didn't Load","installErrorText":"We Were Unable to Install This App","generalErrorPrefix":"Try again later, disable any ad blockers, or reload the page. Contact the author of","generalErrorSuffix":"for help.","uninstalledErrorText":"We Were Unable to Install This App"},"unavailableMessageOverlay":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us.","reloadText":"Refresh this page"}},"applicationId":"2979"},"comp-kwmluveb":{"images":[{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_24a35ec53c4a4d41a0da9c7b7cd6d2d3~mv2_d_3000_1965_s_2.jpg","alt":"","width":3000,"height":1965,"id":"dataItem-kwmluveh1","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_f1ab68320b444a4ca3cc0b7dd2284bf5~mv2_d_3000_4500_s_4_2.jpg","alt":"","width":3000,"height":4500,"id":"dataItem-kwmluveh2","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-anchor":{},"uri"