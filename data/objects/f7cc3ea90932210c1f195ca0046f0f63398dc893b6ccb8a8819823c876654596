-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Lyophyllum decastes)</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">, Honey Mushrooms (Armillaria),</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">&nbsp;a variety of milk caps ( L</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">actari</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">us), Oyster mushrooms or Shrimp Russula (</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Russula xerampelina)</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"> mushrooms would be very tasty in this dish.<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\n&nbsp;</span><span style=\"color:rgb(236, 77, 77); font-family:avenir-lt-w01_35-light1475496,sans-serif; letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Important Note *</span></span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"> If using wild mushrooms for this recipe, b</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">e sure you have properly identified the mushrooms and thoroughly cleaned and cooked them before adding them to this casserole.</span><br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\n<span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">I like to use wild mushrooms that I have already prepared, </span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">saut&eacute;ed</span><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">&nbsp;and frozen, thaw just enough to loosen them and mix them in.</span></h5>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jp00yhu9":{"pinUrl":"https://www.pinterest.com/pin/637329784745994200/","isConsentPolicyActive":false,"isMobile":false,"translations":{"componentName":"Share from Pinterest","large_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url> ","large_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","medium_element_one_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> cookie settings.<url>","medium_element_two_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> and <%=cookietype%> cookie settings.<url>","small_element_one_cookie":"<url>Update your cookie settings<url>","small_element_two_cookie":"<url>Update your cookie settings<url>","small_tooltip_one_cookie":"To view <%=componentname%>, update your <%=cookietype%> settings.","small_tooltip_two_cookie":"To view <%=componentname%>, update your <%=cookietype%> and <%=cookietype%> settings.","small_element_aria_label":"More info","tiny_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_aria_label":"Unblock <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertising":"marketing"}},"comp-lo1v07zo1":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07zo1","hasBgFullscreenScrollEffect":false,"