agraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"5si69","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Maryhill Winery Concert & Picnic","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aiao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ebg9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Smoked beef wraps, red wine and Carlos Santana at Maryhill Winery in WA, State. What a way to spend a Sunday! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"257tk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5egs2","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f466c8177f8d41af9740e22cdc02296b~mv2.jpg"},"width":1500,"height":1125},"altText":"Santana at Maryhill Winery 2017"}},{"type":"PARAGRAPH","id":"ccdrj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8cpkm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Carlos Santana at Maryhill Winery June 25, 2017","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"caj0n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c9j9v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e749v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8k4bb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fg31t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband, myself and a great group of friends volunteer at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Maryhill Winery","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.maryhillwinery.com/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" to take tickets during their Summer Concert Series. We have been doing this for several years and are so lucky to have this gig! Maryhill is very generous with their volunteers giving us some great perks that make this job very enjoyable. Maryhill throws a big potluck dinner for all of us just before the start of each season where we get any new training, go over staff rules and pick up our season badges and staff t-shirts. It's quite the event as it seems most of our volunteer staff has a thing about good food and wine! Maryhill provides the wine for this event of course. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8sb4v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d5dra","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9qi2t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"29oqq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"At every concert at least a few people in our group bring food items to share before the gates open and then later when everyone really gets hungry. We have had some wonderful fresh fruits and tasty watermelon salsa, even chilled cucumber soup which is really good on a hot summer's day! In the past I've made caprese kabobs, Albacore tuna sliders on homemade buns, home made blue cheese with crackers and honey, and many other fun picnic things. Last night I brought ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Smoked Beef Wraps","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/06/26/Smoked-Beef-Wraps","target":"SELF"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":".","decorations":[{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/06/26/Smoked-Beef-Wraps","target":"SELF"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f3t3s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"2bn77","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_55eebf1e6d2e4d5f847e4c4f50d2e51b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Smoked Beef Wrap"},{"image":{"media":{"src":{"url":"577c92_c3c64878f62245e3a41566e0d399576f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Smoked Beef Wrap"},{"image":{"media":{"src":{"url":"577c92_b1ac213b97ce4389a0c363bbbca754c4~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Smoked Beef Wrap"},{"image":{"media":{"src":{"url":"577c92_67d0856cd13c41e09b99ca1d275ff5a0~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Smoked Beef Wrap"},{"image":{"media":{"src":{"url":"577c92_0028a2be6b3a4a559aced5126e3f067f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Smoked Beef Wrap"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"bdt3q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Smoked Beef Wraps with seasoned cream cheese and spinach","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ct74s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6n9ok","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ahido","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9hshu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Our favorite perk for volunteering at Maryhill Winery is the staff parking. If you attend concerts at all you know that getting out of any venue can be trying but some more so than others. This beautiful winery is pretty rural and getting in and out takes some time. Staff parking helps a lot with that part! Of course we also get to see every concert for free from the general admission area of the lawn. Who doesn't love a great picnic in the grass at a concert? Not too mention some great quality wine and amazing views of the Columbia River Gorge.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fs0pd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7sf5k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It's really an adventure every time we work a concert because the crowd and the weather are always different. Each musician or group has a different following and our weather ranges from 104 degrees with little to no breeze to 65 degrees, 25 mph winds with rain and hail showers. The show has always gone on rain or shine! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2v1rh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5pm76","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This week we had the 104 degrees and little to no wind kind of day so we opened the gates 30 minutes early to help get people out of the sun. Maryhill had provided plenty of ice and water and even sunscreen for staff and everything went really well.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dimr5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"48u03","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the gates open we have a few people who take down some low lawn chairs and blankets to stake our place on the lawn for later, while the rest of us begin scanning tickets as guests begin to enter into the venue. Then we all work together at a furious pace for the first few hours getting everyone through the gates. It can be crazy work as everyone's in a hurry to find their place on the lawn or get to the wine gardens. We help to support venue security by watching for problems and pointing them out to the right people. As always, every guest is special with their own personal story and needs, so sometimes we need to help them out, finding assistance for them at will call, security or occasionally medical assistance. It's a challenging fun fast paced couple of hours with great rewards but it's definitely not for everyone.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9tbbk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f54co","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Usually two by two we are released as the flow of people entering the winery decreases. We make our way to the wine garden and then to our place on the lawn to enjoy the people, the sunset and the music if the concert has already begun. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1p43a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5muon","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It's a wonderful evening with great music, food, wine and friends!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3lvq4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2quck","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The adventure of visiting Maryhill Winery is highly recommended.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5oile","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"blhpl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9htim","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1bap4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-06T16:41:39.599Z","updatedTimestamp":"2024-06-06T16:41:39.599Z","id":"fe2b1991-e075-4cff-a6cb-90bc8c90e869"}},"contentId":"61712258a2398f001688590c","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_f466c8177f8d41af9740e22cdc02296b~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_f466c8177f8d41af9740e22cdc02296b~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f67698057272c0018407e7f","internalCategoryIds":["5f67697cf4b037001706011f","5f67697cf4b037001706012d","