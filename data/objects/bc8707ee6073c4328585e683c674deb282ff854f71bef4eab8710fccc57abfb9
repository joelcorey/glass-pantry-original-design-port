{"postPage":{"id":"0861af7b-1801-43b8-ba83-50c5363e9796","post":{"id":"0861af7b-1801-43b8-ba83-50c5363e9796","title":"Shrimp Stuffed Chicken                          with Lobster Sauce","excerpt":"Shrimp Stuffed Chicken with Lobster Sauce This is a dish you could use for your next candle lit dinner. Delicately flavored with gooey...","firstPublishedDate":"2017-12-31T22:37:10.514Z","lastPublishedDate":"2017-12-31T22:37:10.514Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/12/29/shrimp-stuffed-chicken-with-lobster-sauce"},"slug":"2017/12/29/shrimp-stuffed-chicken-with-lobster-sauce","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","2005ffa7-ea76-4f2a-93e8-f5e21b58d721","f3d78c3c-f7fd-498a-8718-f4c2bee77fea","49888eb1-b430-428d-8226-5b1939919eb2","86cb13c9-ebe8-4da9-92bc-d9f63db5b610","a704b556-158c-45cd-8aa0-7ecf3fb52188"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":212},"minutesToRead":5,"tagIds":["98ba37f2-e9fa-46f2-9905-04cf72569d66","8e0f5a23-2d9b-470a-b32c-c4de612c8361","64a63fad-a48d-4e0c-bb0c-c5f2a132be8f","ff4ebb9e-e9ad-4140-aacc-110872b92bfb","36447a20-2243-4b3b-8b02-cd7765d4d3e1","cfae499a-90f4-43b1-ac7d-7d5f8bef38df","8424e3b5-f404-48e2-a46b-c587c2e97c6e"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":212,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Shrimp Stuffed Chicken                          with Lobster Sauce","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Shrimp Stuffed Chicken | Lobster Sauce | Lobster Shells"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"69f1a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Shrimp Stuffed Chicken with Lobster Sauce","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"av2c4","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_05ab2878c92643648202d3312622cda5~mv2.jpg"},"width":1500,"height":1125},"altText":"Shrimp Stuffed Chicken Breast with Lobster Sauce"}},{"type":"PARAGRAPH","id":"35jl6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4ngjj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This is a dish you could use for your next candle lit dinner. Delicately flavored with gooey mozzarella cheese oozing from the shrimp filled center. Surely impressive enough for your significant other and yet surprisingly simple. The secret ingredient is lobster shells from that last lobster dinner you had. You know the ones you didn't throw away but kept in the freezer for just such an occasion as this. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cgnm5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dk7dl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you haven't had lobster recently maybe you've made some shrimp. You could substitute shrimp shells to make this sauce. Of course it won't be lobster sauce anymore but hey, it will still be excellent with shrimp sauce!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8trug","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9kla7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"d8ecl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_59d87eb4ea9640519387531e9103fbe0~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Shrimp Stuffed Chicken Breast with Lobster Sauce"}},{"type":"PARAGRAPH","id":"c161s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I love the warm pink, creamy colors, delicate flavors and of course the cheese. I told you there was cheese didn't I?  Rich creamy cheese and garlic.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"qj3g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2cpn5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6m130","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"h40","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_651fd0daebcd492c856806c612abc5df~mv2.jpg"},"width":1231,"height":923},"altText":"Shrimp Stuffed Chicken Breast with Lobster Sauce"}},{"type":"PARAGRAPH","id":"7j1sk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"al9k7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82n5c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you saved the shells from your last lobster or shrimp dinner you should pull them out of the freezer now and make this sauce. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"96ao5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"ekrcv","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_93d5bf6b94894b77b6e5af8ad275ccee~mv2.jpg"},"width":1500,"height":1125}},"title":"Boiling the lobster tail shells"},{"image":{"media":{"src":{"url":"577c92_fffb4c7fbf7f42a9810d79a4e4b10bea~mv2.jpg"},"width":1500,"height":1125}},"title":"Boiling the lobster tail shells"},{"image":{"media":{"src":{"url":"577c92_6af4aae75f164fd58593f275e05ad805~mv2.jpg"},"width":1500,"height":1125}},"title":"Boiling the lobster tail shells"},{"image":{"media":{"src":{"url":"577c92_028a876d2e9443e983174964b73273e6~mv2.jpg"},"width":1500,"height":1125}},"title":"Cook for 3 minutes more."},{"image":{"media":{"src":{"url":"577c92_34b8ff67755142899b585b1bf5b500c6~mv2.jpg"},"width":1500,"height":1125}},"title":"1 1/2 cups lobster stock"},{"image":{"media":{"src":{"url":"577c92_6d9c322903be45acb972e252e3b5f8dc~mv2.jpg"},"width":1377,"height":1033}},"title":"peeled jumbo shrimp"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"a1c4n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I put the frozen empty shells into 2 cups of water and boiled them for 10 minutes. Then I added 10 raw jumbo pink shrimp in their shells to the boil for 3 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"53and","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5fprg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I removed the shells and shrimp and reserved the stock to make my lobster sauce. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8u9bh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"515kj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tip:","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Peel the shrimp and save the shells for your next seafood sauce.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5hq2m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3q5u4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8tcu3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7br52","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next I prepped the chicken breasts. They were absolutely huge so I cut them in half lengthwise and pounded them gently to tenderize them. This also makes them thinner and larger to more easily wrap around the shrimp and cheese filling.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e27er","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"61d6v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a16367ac91684182aa54c21960582b14~mv2.jpg"},"width":1260,"height":840},"altText":"Cover the breasts with plastic wrap"}},{"type":"PARAGRAPH","id":"aq93p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I placed them on a large cutting board and covered them with plastic wrap before pounding them gently with my mallet. The plastic wrap helps to keep the meat juices from splattering all around the kitchen.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6plrn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"d8rmp","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1a608a0e97f342cdb5a0dec5284781f8~mv2.jpg"},"width":1443,"height":962},"altText":"Gently Pound to flatten and tenderize the breasts"}},{"type":"PARAGRAPH","id":"40o5d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Chicken after pounding gently with a tenderizing mallet.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"27fub","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"9hd0m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"devgm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2bcib","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b05961549495431f86f1df16467b3482~mv2.jpg"},"width":1375,"height":1031},"altText":"Assemble ingredients, Lemon, Scallion, Uncut Shrimp"}},{"type":"PARAGRAPH","id":"880h4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I had some leftover quartered lemons and chopped scallion on hand that I new would go great with my sauce so I brought those out and then I organized my spices.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cfves","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"21qdh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"78c3q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I used salt, nutmeg, white pepper, tarragon, cayenne pepper and garlic powder fairly lightly so they would enhance but not overpower the delicate seafood flavors.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fd1l6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3302j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1848eb7c5f9e404ca694daabeffd1b13~mv2.jpg"},"width":1500,"height":1125},"altText":"Spices"}},{"type":"PARAGRAPH","id":"22v2j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7uq1u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a4jtn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now it was time to stuff the chicken and get it into the oven to bake. I set aside the shrimp I used to top the chicken and cut the rest of the shrimp in half lengthwise to stuff the chicken.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"r6nl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"cgra0","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b2b200151d3f400c8612798a39c1bfda~mv2.jpg"},"width":1268,"height":951},"altText":"Cut shrimp for stuffing"}},{"type":"PARAGRAPH","id":"clgt6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"49lgh","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_2c3f04a6299e45b894d4329305e1e703~mv2.jpg"},"width":1318,"height":989},"altText":"Stuffing the chicken breast"}},{"type":"PARAGRAPH","id":"810d6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8p3si","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I sprinkled the chicken with some of the shredded mozzarella and scallion then topped those with 3-4 slices of shrimp. I rolled up the chicken and sprinkled just a little mozzarella on top.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c1mot","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"62use","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"jrb6","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_204dc35b5ba549c9a61b9acb7f1f5632~mv2.jpg"},"width":1334,"height":889},"altText":"Stuffed breasts, rolled and topped with shredded mozzarella"}},{"type":"PARAGRAPH","id":"4ekph","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After they had all been rolled up, placed in the baking dish seam side down and topped with cheese, I put them into the oven to bake at 350 degrees for 20-25 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9sgg1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7oqq7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"efgb9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6el6d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"How to make lobster sauce:","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"35uee","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aas23","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"While the chicken is baking, I add 1/4 cup of butter to a small sauce pan and turn the heat on medium low. After the butter melts, I add 1/4 of all purpose flour and blend them with a whisk until it's bubbling and smooth. About 1 minute.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5r4o6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8pg5q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next I add the lobster stock. It should measure about 1 1/2 cups. You can add water to bring it to this measurement if you need too. Continue to stir until the flour is blended into the stock. About 1 minute.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"99gj7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c32rh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now I turn up the heat to medium- high and stir constantly until the mixture comes to a low boil and thickens. When the sauce begins to thicken, I turn the heat down to low and begin slowly adding some milk until the sauce has thinned to the consistency I like and it has become more opaque and white. This usually takes 3-4 minutes on my stove top.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ptas","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8eshf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"cgt4p","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_4c6f32859ad44a558f2aa1219400fcb1~mv2.jpg"},"width":1281,"height":961}},"title":"Making the Rue"},{"image":{"media":{"src":{"url":"577c92_34b8ff67755142899b585b1bf5b500c6~mv2.jpg"},"width":1500,"height":1125}},"title":"20171222_165907_edited"},{"image":{"media":{"src":{"url":"577c92_7b669fda29b74cb9a81790853270a14c~mv2.jpg"},"width":1033,"height":775}},"title":"Adding the milk and spices"},{"image":{"media":{"src":{"url":"577c92_41b3a75ffb2948669fef21b8523e6730~mv2.jpg"},"width":1500,"height":1125}},"title":"Keep warm until the chicken is ready"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"8lsln","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now that I have a white sauce, I add my seasonings and lemon juice, then keep it warm over low heat stirring occasionally until the rest of the meal is ready to plate. This will give the seasonings a little time to bloom and marry with the lobster stock. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"45o76","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2osmv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now that wasn't so hard. Lobster sauce. It just sounds intimidating doesn't it?","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8n6g2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"96m8o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ba4s7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1omac","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f0ba724470f84b68966d62c31ec57cf2~mv2.jpg"},"width":1403,"height":935},"altText":"Shrimp Stuffed Chicken Breasts"}},{"type":"PARAGRAPH","id":"codc4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" As the chicken finishes cooking it will firm up, the juices will run clear and the cheese will begin to melt and ooze out a little. The cheese on the top will also brown and bubble some giving it more color and flavor.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5nob5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"