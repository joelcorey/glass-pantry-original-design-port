{"postPage":{"id":"d751f5d3-40c9-47a7-8ea8-0688ea0fef91","post":{"id":"d751f5d3-40c9-47a7-8ea8-0688ea0fef91","title":"Cherry Harvesting at Home","excerpt":"Cherry Harvesting at Home It's Cherry Harvest time in Southern Oregon and I feel so lucky to have two beautiful trees in the front yard...","firstPublishedDate":"2019-06-18T19:24:45.263Z","lastPublishedDate":"2019-06-18T19:24:45.263Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2019/06/18/cherry-harvesting-at-home"},"slug":"2019/06/18/cherry-harvesting-at-home","featured":true,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","77a7e5bb-3035-4aec-b5d9-f3ac91f5cdd7","340a691e-f0fb-48cb-81ca-aa54a6c4e6bc","27278c23-7e90-46de-93b3-ad018839fa44"],"memberId":"4bafc351-4af6-4e6a-bf15-1ac9c1d80e80","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":102},"minutesToRead":3,"tagIds":[],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":102,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Cherry Harvesting at Home","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Cherry Harvesting | Home Grown Cherries | Bing Cherry Harvest | Rainier Cherry Harvest | Growing Cherries in Southern Oregon | Cherries in the Rogue Valley"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"PARAGRAPH","id":"fto9k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"6ho5n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cherry Harvesting at Home","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fmdsu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dv4tg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a30ab04352154929b8104ff80e56c036~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Cherry Harvest 2019"}},{"type":"PARAGRAPH","id":"9ao5k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e68u5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It's Cherry Harvest time in Southern Oregon and I feel so lucky to have two beautiful trees in the front yard of our new home this year! We have both a Bing (the dark red ones) and a Rainier Cherry tree. I recently learned that it is essential to have two varieties of cherries growing near each other for proper pollenization. We also have two apple trees and this applies to them too. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"84odt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8melj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7d0l2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"810q6","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_6adf7b60ed7347a388463a31d5b3f25b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Harvesting Rainer Cherries"}},{"type":"PARAGRAPH","id":"3bqo7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7nm9l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2b2e2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is my Superman hovering around the tops of the trees picking gallons of glorious cherries for us. He picked for hours until I asked him to stop because I had run out of places to store them until some were processed. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eagk3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d12c2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"What a guy I have! It was about 98 degrees that day. A lovely morning for picking but after lunch it got pretty warm up on that ladder I assure you.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5b6li","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4a27h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Speaking of ladder's, we looked into buying an orchard ladder this year but we already have several ladders and we realized that one of the ladders we had was quite suitable for the job. Orchard ladders are not only expensive but large and require some storage space so we were very pleased that we didn't really need to buy one. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"467bf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ce9dp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We were also extremely lucky that the birds didn't eat too many before we got the chance to get ours harvested. Many people in our area buy cherry nets to wrap the trees in to keep the birds off. They are effective but also not free. We found we would need to buy 2 of the largest nets and that would have been about $75. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3nm8d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cj4nm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"They say the nets are reusable but I imagine not as effective in consecutive years and they would eventually need to be replaced. We harvested plenty this year so I think we'll see how next year goes before investing in netting. I'm sure that in a lot of other peoples yards they would really be necessary.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9iptm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9tl4k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"32bp2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9aap","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_776d3697cb8a4499b7ee48f77987b666~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Ripe Bing Cherries on the tree"}},{"type":"PARAGRAPH","id":"3q5o1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Aren't they just gorgeous! Cherries are my all time favorite fruit I'm sure.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3bkrg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b3m78","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4v2v0","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_74dbc273ea954510a7bcbddfd296ef04~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Cherry trees ready for harvest."}},{"type":"PARAGRAPH","id":"878t1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When we lived in the Rogue Valley years ago, My mom would buy quite a lot then, after rinsing them, she stored them uncovered in the refrigerator in a HUGE yellow Tupperware bowl.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8duqo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fqb2p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I would get that bowl every afternoon and sit on the couch and gorge myself on cherries.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6pra6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ah1v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"She also canned quite a few cherries. Have you ever had home canned cherries? They are amazing and nothing like the canned cherry pie filling in a tin. They are light and sweet, tangy and deliciously refreshing!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"84h5e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dh3um","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_2777485118d24524b247b7059e6765cd~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Pitting Bing Cherries"}},{"type":"PARAGRAPH","id":"70hm6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a07ip","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This was my set up for removing the pits or stones from the cherries for processing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c4ju3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2qefb","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_aed324e1553d4f09a9249a0aba751173~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Removing pits from Bing Cherries"}},{"type":"PARAGRAPH","id":"a7ik9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2917u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I set this up in front of the TV and it helped some with the tedious task. Carpal tunnel could flare up if you have a problem with it and too many cherries to pit. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9mvb4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4f337","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4nutr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ahqs1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"36s74","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_efa0e555d45d4eee883d50629ee2684b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Fresh Rainier and Bing Cherries on large bowls."}},{"type":"PARAGRAPH","id":"9s2qh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This was only about half of what we picked. The rest were already in my extra refrigerator. Two trees produce an abundance of these sweet treats!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2b9f4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"26ad","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"f64p5","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_259ad034e481479cafd103e9c90a4297~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032},"altText":"Fresh Rainier and Bing Cherries"}},{"type":"PARAGRAPH","id":"etg26","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a8ilt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Both of these varieties are sweet cherries and the Bing variety is most common and loved cherry in Oregon. The Rainier is a special variety that Is also considered to be a premium sweet cherry. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ekdqk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2r06m","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_2eb64a0b1ef244249f3e3d38654f18d2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Rainier and Bing Cherries"}},{"type":"PARAGRAPH","id":"boo27","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rainier Cherries are not the same as the Queen Anne variety although they look very similar. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"5ktuu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"42cjt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"77ti0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rainier Cherries are a yellow to blush colored cherry that is considered to be larger and sweeter than the bright red Bing cherry. Rainiers are, however, on the more tart end of the scale for yellow cherries. Queen Anne cherries being on the much sweeter end of the yellow cherry sweetness scale.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"btsbd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a9j8o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"51i7u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After pitting the cherries I stewed up a large pot of the Rainier cherries and made a delicious puff pastry pie!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"clo22","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"a9p4i","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ce28339288b44b4dafa9d3e358b90d1e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"70s42","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"494r9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I just couldn't throw out those little scraps of puff pastry after making the round pie crust, so I made some free form decorations with them for the top of the pie and pressed them on after baking them separately. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8vu3l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"erpmg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Stay tuned for more on what I'm doing with all of these cherries. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"422r0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cojoc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next up, ways to preserve the little gems for future use.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fb0mg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"vvdg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"inde