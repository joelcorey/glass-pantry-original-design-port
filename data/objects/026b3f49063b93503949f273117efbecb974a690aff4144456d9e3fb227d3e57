{"postPage":{"id":"1b7c5a8f-b872-4298-b473-125c572763a8","post":{"id":"1b7c5a8f-b872-4298-b473-125c572763a8","title":"Fresh Cheese Curds                             \na.k.a. Squeaky Cheese!","excerpt":"Fresh Cheese Curds  a.k.a. Squeaky Cheese! Home made cheese curds are delicious! This is a very simple recipe that both beginners and...","firstPublishedDate":"2017-12-21T16:54:49.629Z","lastPublishedDate":"2017-12-21T16:54:49.629Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/12/16/fresh-cheese-curds"},"slug":"2017/12/16/fresh-cheese-curds","featured":true,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","2005ffa7-ea76-4f2a-93e8-f5e21b58d721","ecbcfcfe-4a80-42f2-bfc4-b104a8dcf8fd"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":292},"minutesToRead":5,"tagIds":["d3f43933-a8c1-40d5-b8b1-0e658f3fcf29","25bbcf78-ff1d-45da-b93e-cbe994906723","518c5af2-4d48-4f66-bc53-75c3e1fc9576","e08d611e-6f3f-4053-aa17-41eb86adde52","12e568d1-c1e4-4f8b-a8d0-02f313e2b143"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":292,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Fresh Cheese Curds","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Fresh Cheese Curds | Cheddar Cheese Curds | How to make cheese curds"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"46i53","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fresh Cheese Curds                   ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"a.k.a. Squeaky Cheese!","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"b335c","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8361f86086794b4bb4b443c8b5dd7062~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Home made fresh Cheese Curds"}},{"type":"PARAGRAPH","id":"bpt8s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"lcg2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Home made cheese curds are delicious! This is a very simple recipe that both beginners and advanced cheese makers can love. Wouldn't you love to add this to your next holiday appetizer tray? I really liked incorporating the cheddaring process into this recipe. It gives the final cheese curds a lot more flavor and texture. Cheddaring is a multi-step process that reduces whey content, adjusts acidity, adds characteristic flavor, and results in a denser more crumbly texture.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"70kd7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aljg1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Since this is going to be a bit lengthy, I'll get right to how to do it. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ikss","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fta52","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3skak","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Slowly bring 2 gallons of whole milk (not ultra-pasteurized) to 96 degrees over the next 45 minutes. If you would like more color to the curds add 1/4-1/2 tsp of annato cheese coloring.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"i93j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bf1fl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4576c7de7443436ea43e4652ce179eaf~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"b5rfg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fhe1p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"99gu1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Dilute 1/2 teaspoon Calcium Chloride in 1/4 cup distilled water and add this to the milk stirring in an up and down motion. The milk should be still for most of the process so don't stir it in a swirling motion. It takes much more time for the whirlpool to stop than when you use up and down strokes as you stir the milk.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9cjjp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"nbbi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sprinkle 1/4 teaspoon of bulk C201 Thermophilic Culture (or one packet direct set) across the top of the milk and allow it to re-hydrate there for 2 minutes then stir it into the milk thoroughly in an up and down motion for about 30 seconds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"du07i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4g54d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Let the milk rest to ripen for the next 30 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ck644","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bo5om","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the ripening period, dilute 1/2 teaspoon of rennet in 1/4 cup distilled water and add this to the ripened milk stirring with up and down motions for 30 seconds. Then allow the milk to sit undisturbed for 30 minutes, holding at 96 degrees or as close as possible.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aqf52","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"75ukc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2t8ts","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_967e23b9d8df4b5f92a76a673e288bb5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"5v661","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bpipp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"15oh5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6jprl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cut a slice into the milk about an inch deep and then scoop under the cut with the knife to test the curd. If it splits nicely and the liquid that rises in the cut is clear, it's time to cut the curd. If not, wait 10 minutes and check it again until the whey is no longer cloudy. Keep the temperature at 96 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"560fc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5pgj8","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d1f47d26902647018d9156081771cc33~mv2_d_2659_1779_s_2.jpg"},"width":2659,"height":1779},"altText":""}},{"type":"PARAGRAPH","id":"8gklp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bojsg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next cut the curd into 3/4 inch pieces by cutting in a checkerboard fashion as shown below. Wait 3 minutes and then begin to stir. As you stir the curds will shrink.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aljbf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"82m6f","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c8aa48bc26194d309eab25136d2270b9~mv2_d_2307_1546_s_2.jpg"},"width":2307,"height":1546},"altText":""}},{"type":"PARAGRAPH","id":"86i3l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"apoor","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Somehow I was distracted by 5 other things and forgot to get a few pictures of stirring and cooking the curd. I suppose you will have to use your imagination here for a few steps.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fkg2v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4c5ct","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next begin heating the curds slowly. Continue to stir to keep them from settling into a mass and melting together over the next 30 minutes until the curds reach 116 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6i966","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"as8hi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Continue to cook and stir the curds for 30 minutes more at 116 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"128kv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1oegr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"58h3o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4dthc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next, line a colander with cheese cloth and place a large pot under it to catch the whey. I place this in the sink and then pour the curds and whey into the colander, separating the curds and whey.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2h6rq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4v9vg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c8n17","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Squeeze the curds together in the cheese cloth by twisting the cloth closed to drain more whey from the curd and to bring it together into one solid mass.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"78r3v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"12qli","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place this curd mass into the colander and then the colander over the warm whey in the pot and set the pot back over a low heat to gently steam the mass of cheese in the colander. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"31hi5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8364h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9m6bc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1hduj","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_60a4fadb76b447d8a6b76e88c69c5f9c~mv2_d_3422_2290_s_2.jpg"},"width":3422,"height":2290},"altText":""}},{"type":"IMAGE","id":"bdgrg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_68ccb98e66934100ab941f77ac03ff9b~mv2_d_3179_2123_s_2.jpg"},"width":3179,"height":2123},"altText":""}},{"type":"PARAGRAPH","id":"7s91t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"n5n6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6361t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Over the next 30 minutes, turn the curd mass over in the colander every 10 minutes. This is the beginning of the cheddaring process. I think this gives the cheese curds much more flavor and the distinct crumbly layered texture of cheddar cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6kd6o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"en357","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"957r5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3b3al","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4e0eb","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_04d4feef805a4582b17d8548a6b0c1de~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"5q4ij","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"en3ch","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the curd mass from the colander to a cutting board and cut the cheese into large slices. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8vqe7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"70jgp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"engpo","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c41a06f136034062b1aba03f78e4b7b8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"dokiq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"av7qi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Put the slices back into the colander and continue to steam gently, cheddaring the cheese curds for the next 30 minutes, turning the slices of curd every ten minutes or so.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ud62","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9dk24","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_99d897c3263d4cf9ba3017d76b85978b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"1jeq7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b916i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"t