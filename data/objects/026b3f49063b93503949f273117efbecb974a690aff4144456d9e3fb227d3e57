textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cuv1q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bb486","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6j8mk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Slowly bring 2 gallons of milk to 96 degrees over 45 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"rsov","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you would like more color to the curds add 1/4-1/2 tsp of annato cheese coloring.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dv507","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9lh2o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Dilute 1/2 teaspoon Calcium Chloride in 1/4 cup distilled water and add this to the milk stirring in an up and down motion.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bo9lr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d3cs7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Sprinkle 1/4 teaspoon of bulk C201 Thermophilic Culture (or one packet direct set) across the top of the milk and allow it to re-hydrate there for 2 minutes then stir it into the milk thoroughly in an up and down motion for about 30 seconds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"946dj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ergsl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4.Let the milk rest to ripen for the next 45 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fd92f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6k0ho","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"5. Dilute 1/2 teaspoon of rennet in 1/4 cup distilled water and add this to the ripened milk stirring with up and down motions for 30 seconds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5jj99","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"549fk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6. Allow the milk to sit undisturbed for 30 minutes, holding at 96 degrees or as close as possible.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1mmf0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"40c4u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"7. Cut a slice into the milk about an inch deep and then scoop under the cut with the knife to test the curd. If it splits nicely and the liquid that rises in the cut is clear, it's time to cut the curd. If not, wait 10 minutes and check it again until the whey is no longer cloudy. Keep the temperature at 96 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fk1dj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7bbkl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8. Next cut the curd into 3/4 inch pieces by cutting in a checkerboard fashion as shown above. Wait 3 minutes and then begin to stir. As you stir the curds will shrink.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6a0lj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1p34e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"9. Next begin heating the milk slowly over the next 30 minutes to 116 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dcc51","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7oecl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10.Continue to cook and stir the curds for 30 minutes more at 116 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dhlb6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"75qn7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"11. Line a colander with cheese cloth and place a large pot under it to catch the whey. I place this in the sink and then pour the curds and whey into the colander. separating the curds and whey.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7qmsr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"34ktg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"12. Squeeze the curds together in the cheese cloth by twisting the cloth closed to drain more whey from the curd and to bring it together into one solid mass.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fhof9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4b1tj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Place this curd mass into the colander and then the colander over the warm whey in the pot and set the pot back over a low heat to gently steam the mass of cheese in the colander. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"54tcc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fv2bc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"14. Over the next 30 minutes, turn the curd mass over in the colander every 10 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"blg1e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text