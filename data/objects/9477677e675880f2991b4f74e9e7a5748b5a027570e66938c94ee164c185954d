headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"cgi5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Orange-Ginger Jam Buttercream","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1gahj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2admi","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_94d6a968d33b482c87fb3a6ba73b1766~mv2_d_2266_3021_s_2.jpg"},"width":2266,"height":3021},"altText":""}},{"type":"PARAGRAPH","id":"3d1h4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dfrk1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sumo Citrus is a new hybrid orange that's very large, very sweet and very easy to peel. It is the new orange darling in the produce isle. Have you seen them in the stores yet? We bought some recently and I was inspired to try a new flavor for a birthday cake for my mother. It was really tasty! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"456n7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9hog2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"As I was planning the icing, I found that I had one of those special little jam jars that my daughter had given me. The flavor was Orange Ginger. I thought, \"Wow! This is something I can really work with!\" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ajb5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9phej","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I decided on a buttercream icing and added in the jam for flavor. My husband and I were both so surprised at how much orange flavor came through in this truly buttery cake! It was quite decadent and a small piece was all we really needed to be satisfied.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8eu96","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4mlv7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9e4df","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5c06e9b928d64bb7993d4cb31cbdb14e~mv2_d_2266_3021_s_2.jpg"},"width":2266,"height":3021},"altText":"Sumo Citrus Cake with Orange Ginger Buttercream Icing"}},{"type":"PARAGRAPH","id":"4sc1i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" None of us really need to eat cake so I thought I'd compromise and make just a single layer cake. I also left the sides \"naked\" and opted for a smaller star shaped piping tip hoping it would keep the top layer of buttercream from becoming too deep. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a05gq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"nlap","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e4p9p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is a naked Sumo Citrus after I had zested it for the cake batter.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b32t6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"f44v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_21592027dfbc450b9cea79199ee2c20c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"bvkhc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8qe9r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f03u0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"17m6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7c7gl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I also used the juice of half the Sumo in the batter. Look at how thin the pith is on this orange. That's what makes it so easy to peel and very nice to work with in general. It's super juicy!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"csu1v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_426fb67b0d114c19a142d7697d4c08d5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"eivre","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8458i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5nhmu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"While I mixed the cake batter, I let a stick of butter come to room temperature to make the Orange Ginger Buttercream Icing. You can see flecks of zest in the batter.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9jmvo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"57mdq","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e1332f77c52444178a75f72ce011ebe7~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"9dfop","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e4an2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"arhq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"45boo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the cake was in the oven, I whipped the butter then added in the rest of the ingredients including my cute little jar of Orange Ginger Jam. Click on the images below for more details.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6hghn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"5r5im","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_fd2e83d9700447369bddfc425a7f69e8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"First I whipped the butter."},{"image":{"media":{"src":{"url":"577c92_e6c72d2997914215b5528b7069f0124d~mv2.jpg"},"width":1500,"height":1125}},"title":"After adding the sugar."},{"image":{"media":{"src":{"url":"577c92_f1cd41c44e564c5cbab4cf6879b7fc13~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"This is called a crumb coat."},{"image":{"media":{"src":{"url":"577c92_89510e22d4fe4b93bc03059eed736063~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Next I prepared a piping bag"},{"image":{"media":{"src":{"url":"577c92_84226ca14fb640079731d69e941797a9~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Easy loading bag"},{"image":{"media":{"src":{"url":"577c92_3ed3b5281f5b489f9d9e07ef44ccccc6~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Fill the bag with buttercream."},{"image":{"media":{"src":{"url":"577c92_55158fa28bc14440b80b81c1e945f1f2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Chill the piping bag."},{"image":{"media":{"src":{"url":"577c92_9d66714272ed46a7b8193cb5dd5a2139~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"After Piping I added pearls"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"127ip","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I start piping the icing onto the cake by making a small star in the center of the cake and then proceed counter clockwise (perhaps because I'm right handed) making rosettes around the star in concentric circles until I reach the outer edge. Then I go back and fill in any gaps with small star shapes. Try changing the color of your icing for the little star flowers and it will really give this cake decoration more pop!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5d5ng","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f8h6n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To make the rosette, touch the tip of the piping star to the cake, squeeze gently but firmly as you draw a small circle with it going around twice. Release your pressure on the icing and lift to complete the rosette.  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"angi8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2bobi","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_02c356f5c3f74fe3a84dd558c8304f96~mv2_d_2266_3022_s_2.jpg"},"width":2266,"height":3022},"altText":"Sumo Citrus Cake with Orange Ginger Buttercream Icing"}},{"type":"PARAGRAPH","id":"dod2g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eje4h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The blue pearls accentuate the center of a small star flowers. The smaller white pearls and sugar crystals accentuate the rosettes randomly like drops of dew. At least that's what I imagined I was going for. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ch8so","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fd9bl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eu4gb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1c71g","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5c06e9b928d64bb7993d4cb31cbdb14e~mv2_d_2266_3021_s_2.jpg"},"width":2266,"height":3021},"altText":"Sumo Citrus Cake with Orange Ginger Buttercream Icing"}},{"type":"PARAGRAPH","id":"caes","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"44eif","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tip:","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I froze the cake for an hour before applying the crumb coat. That's a fancy name for a thin layer of icing that protects the decorative outer layer of icing from getting mussed up by little floating bits of cake crumbs.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"76sj6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"41hck","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_02c356f5c3f74fe3a84dd558c8304f96~mv2_d_2266_3022_s_2.jpg"},"width":2266,"height":3022},"altText":"Sumo Citrus Cake with Orange Ginger Buttercream Icing"}},{"type":"PARAGRAPH","id":"37k16","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b1lr9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5pkbf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7vsk9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eelvj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tip:","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I also chilled the buttercream after I whipped it together so it would be firmer to pipe the rosettes. If the buttercream starts getting too soft from the warmth of your hand as you pipe the decorative layer on top, stop and chill the filled piping bag in the refrigerator for 15 minutes before continuing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7t59n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"581if","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_622ec959e6fa49c68deb02e5bd67edce~mv2_d_3485_1960_s_2.jpg"},"width":3485,"height":1960},"altText":"Sumo Citrus Cake with Orange Ginger Buttercream Icing"}},{"type":"PARAGRAPH","id":"4q5r0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"71tlm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I stored the cake in the refrigerator covered with plastic wrap to keep it moist and this is how we discovered that this cake really needed to be brought to room temperature fully before eating it to get the best experience.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4eq7q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"er0sh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The crumb or texture seemed to be tight and more dry until fully warmed. Then the buttery goodness became soft and melting and oh so rich!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6g3pr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0