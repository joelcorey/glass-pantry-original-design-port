[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bmno4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aq3kr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ihsk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2vlq3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Preheat oven to 350°F. Line a cake pan with parchment paper and set aside.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"710j8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4nn5o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In a large mixing bowl, mix together the flour, baking powder, and salt. Set aside.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"40ra4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fgn31","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In the bowl of a stand mixer fitted with the paddle attachment, or in a large mixing bowl using a hand-held mixer, beat the butter and granulated sugar together until light and fluffy. Mix in each egg one at a time, then the vanilla extract, making sure to mix well after each ingredient. Add in the sumo citrus juice and zest, mix until well combined, then mix in the milk and sour cream until fully combined.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"70tp9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"do85u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the dry ingredients to the wet ingredients and mix until just combined, making sure not to over mix the batter. Use a rubber spatula or spoon to turn the batter, scrape the bottom of the mixing bowl to make sure everything is well combined.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6481t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cacgu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Pour the batter into the cake pan and bake at 350°F for 30 - 40 minutes or until a toothpick inserted into the center of the cake comes out clean and the top springs back when lightly touched.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4vanp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d5g78","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove from the oven, then carefully remove the cake from the pan and transfer to a wire rack to cool.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"gjvp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"coj4o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To make the buttercream icing","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6nk8v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8lk16","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In the bowl of a stand mixer fitted with the paddle attachment, or in a large mixing bowl using a hand-held mixer, beat the butter until smooth. Mix in the powdered sugar, heavy cream, and vanilla extract until well combined. Add in the Orange Ginger preserves (or jam), food coloring and salt and continue mixing until fully and combined.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ardid","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6l51f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Frost the cooled cake as desired. Freeze the cake for at least one hour for best results.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"joa7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cfd4j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-2