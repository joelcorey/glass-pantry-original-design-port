:{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f8n79","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 1/2 cups All Purpose Flour ( I use ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"King Arthur All Purpose Flour","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.kingarthurflour.com/shop/items/king-arthur-unbleached-all-purpose-flour-5-lb","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" for this)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"as74e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3/4 cup Semolina Flour ( I use ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bob's Red Mill Semolina Pasta Flour","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.bobsredmill.com/semolina-pasta-flour.html","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":")","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"es1sj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons room temperature butter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"737ni","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 teaspoons active dry yeast","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e21qg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp fine sea salt","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fl4b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup sourdough starter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7u5t7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup water or whey ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bf0bi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4kakb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fidvs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method   ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4t4dv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7saa9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" (40 minutes active     2 1/2 to 3 hours total)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b09kd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bg2le","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Add dry ingredients and butter to a stand mixer ( I don't sift) and mix on low speed with the hook attachment to somewhat combine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9e5v9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7qahg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Add  sourdough starter all at once and mix again on low speed to somewhat combine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cc7b2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fu32o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Begin to drizzle in the liquid very slowly with the machine running on low speed until you have used about 1 cup.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e02dd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9drrj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4. Allow the machine to continue to work the dough until it begins to pull away from the sides of the mixer adding more liquid tablespoon by tablespoon if it seems too dry. If you go too fast and the dough gets too wet add more bread flour a few tablespoons at a time. The dough should become just slightly sticky and be very soft in about 5 minutes. Let the machine knead a few minutes after it comes together about 6 minutes total. The dough should be very soft and not too sticky.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7lt5k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"qovp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"5. Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3trck","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"mfua","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6. Gather the dough into a ball and place it in a large bowl that has a teaspoon of oil in it and roll it around so it's lightly covered with the oil. I use grape seed oil but any good oil will do.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aq0l3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e8kja","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"7. Cover the bowl loosely with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"19cmu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c6sj6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8. When your bread has risen until you can still see your fingerprint when you poke it gently and it doesn't immediately spring back then it's time to form your loaf!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"68io5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2f02d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"9. Turn it out onto a floured board and degas the dough by folding it over on itself 3-4 times, then gather it back into a ball and put it into a floured proofing basket. I cover this with a cotton kitchen towel and set it back in my warm rising space on top of my stove with the range hood lights on for a little extra warmth.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eec19","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ckg1m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10. Put a cast iron dutch oven in your oven and begin heating it to 450 degrees for at least 30 minutes. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"h6e8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1bdep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"11. After 30 to 40 minutes the dough should have nearly doubled in size so prep for scoring by putting a piece of pop-up parchment paper on the breadboard and sprinkle it with cornmeal, polenta grits or semolina flour.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"70p5u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"csf25","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"12. Very carefully remove the preheated dutch oven to your stove top leaving the lid on.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4qh9p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8c40g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Gently roll/flip the formed loaf out of the proofing basket onto the parchment paper sprinkled with cornmeal and then quickly score the loaf with a razor blade making almost 1/2 inch deep slashes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"32nv7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"jpo3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"14. Remove the lid from the dutch oven with an oven mitt and gently transfer your loaf by lifting the parchment paper and setting the whole thing in the pot paper and all. Replace the lid using an oven mitt and put the whole dutch oven back into your oven. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d27d9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cf8rk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"15. Turn down the temperature on the oven to 425 degrees at this point and set a timer for 45 minutes. If you would like a darker crust you may want to keep it on a higher temperature but it should be done within 40-45 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ao3r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ckn39","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bread is done when it sounds hollow when tapped on the bottom. Let cool at least an hour before slicing. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"28tnk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a9qu4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"See the gallery above for more tips on baking this bread.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cghre","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"da0gp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-15T04:41:08.007Z","updatedTimestamp":"2024-05-15T04:41:08.007Z","id":"0c1a9059-6c70-43cd-94ef-6124eae7f834"}},"contentId":"61728aecc4284300161412e5","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_099e4329f47d497cb4e465ec15800b3a~mv2_d_4032_3024_s_4_2.jpg","url":"https://static.wixstati