ignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"a7esv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Crispy Salt & Pepper Chicken","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"23l7i","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_24c0178260b0403083245bd3f7b8d4f1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Crispy Salt & Pepper Chicken"}},{"type":"PARAGRAPH","id":"23p7l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d7o07","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is easily the simplest chicken recipe I have ever made and the all time favorite chicken eaten at our house on a regular basis. Deep golden brown, super crispy and oh so flavorful! My husband likes this recipe made with chicken thighs and I have to agree. We think this is possibly the best fried chicken ever. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ag4r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fsvjg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" An interesting thing about this fried chicken is that it's not breaded. Talk about easy!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b0p28","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3fgbm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The fat in the skin of the chicken renders out into the frying oil and you're left with the most crackling crispy skin and crazy moist, perfectly cooked chicken. The juicy meat literally pulls right off of the bones.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b4vqa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"21duj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Because it's not breaded, it needs to be fried in a deep fat fryer or in a large dutch oven with enough oil to completely submerge the chicken that is kept at a constant 350 degrees. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"69o13","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e59fd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cgkqi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tips:","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"22eq6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bt4hm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you make the seasoning mix ahead of time and use a deep fryer instead of setting up and then later cleaning a dutch oven for frying this chicken is literally ready in minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3bo4j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9sjun","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I think this is great at room temperature or even chilled so try this as picnic chicken.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"373qr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6e83g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"75fhg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"avjkh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"322et","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4scco","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"So how do you make this glorious fried chicken?","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7rea1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"61fkk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  Start with chicken thighs that are clean and dry. Be sure you have completely dried the chicken or the water in it will cause the very hot oil to pop and splatter. That's no fun at all and could cause serious burns so please, be sure your chicken is dry. One way to do this is to lay the chicken pieces out on a sheet pan and leave it in the refrigerator for a few hours and allow all the moisture to evaporate. It will also help the chicken crisp up better in the fryer.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7orh4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"78eug","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4a7e5810f75d4f2a9de7587fa4460967~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"797si","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"896v5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" While the chicken is frying or earlier, mix up the salt and pepper mixture for seasoning the chicken as soon as it comes out of the fryer. I use this so often I almost always have some made up in a jar.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82pib","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"38l6q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I buy whole Szechuan peppercorns and give them a wiz in my spice grinder, pulsing about 10 times so it's medium fine in texture. These peppercorns are not true peppercorns. They are an Asian spice that is peppery but also has this amazing quality that's a bit like menthol and will tingle and numb your tongue when you eat a lot of it. I know that sounds really weird but it's so good!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cj6s2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ci7d9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I mix the ground Szechuan peppercorns with ground black pepper in equal parts then add fine sea salt to measure 1/4 of the total of the 2 peppers. So let's say 2 tablespoons each peppers (4 tablespoons) to 1 tablespoon of salt ( 5 tablespoons total). I use roughly 3-4 tablespoons to season 10 chicken thighs.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ev3hp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e5vkn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ad7q9","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e7176cb8a3b0485e8046ff9fae0e7f11~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"aubsh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"976g8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"adfaj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I use tongs to slip the chicken thighs carefully into the fryer at 350 degrees and deep fry for 12 minutes. Do this in batches and don't crowd the fryer. After frying 12 minutes, I drain them for 5 seconds over the fryer and turn them out onto a sheet pan lined with a sheet of parchment or paper towels.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b95lv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9mcm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I sprinkle them with 1/4 to 1/2 teaspoon of seasoning immediately and then turn them over with the tongs and sprinkle the top side with another 1/4 to 1/2 teaspoon of seasoning. Finally I sprinkle the tops (skin side up) with a light sprinkling of Kosher salt.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fk5ua","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9teic","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"30do9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"d2g20","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c5dbcbb9d1ad492392ef90addfe4bb79~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"IMAGE","id":"a8ndk","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1ba5170a02e444b782df5b6711d77a7b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"9kasj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"47lu8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"19nmh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I fry them in batches until all of the thighs have been deep fried and seasoned. I place the chicken on the baking sheet in the oven at 250 degrees between batches.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5kk06","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"327km","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1i6rm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6qa18","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8f700a0989b449f79df4eebb9cb6b46b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"d8dll","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" When all of the chicken has been fried and seasoned they are done! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8s5m6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9qb6n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Enjoy immediately.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4jvkq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7sg9f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b57k9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4jb3p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c2spu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"bp1b6","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"21nne","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Crispy Salt & Pepper Chicken","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7fucb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5mpm2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"frbd3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8jtee","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8-10 chicken thighs, clean and dry","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"685oi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3-4 tablespoons salt & pepper spice mix","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e94ck","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4i0qt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"salt and pepper spice mix:","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2k9c7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eav0p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons each ground Szechuan peppercorns and ground black pepper","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","i