{"postPage":{"id":"99775b53-caf0-46d7-811d-d46e8545d24c","post":{"id":"99775b53-caf0-46d7-811d-d46e8545d24c","title":"House Made Potato Chips","excerpt":"Just like at your favorite restaurant. Here's how to do it!","firstPublishedDate":"2017-05-19T20:42:00.000Z","lastPublishedDate":"2017-05-19T20:42:00.000Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/05/15/house-made-potato-chips"},"slug":"2017/05/15/house-made-potato-chips","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","77a7e5bb-3035-4aec-b5d9-f3ac91f5cdd7","89a46745-be80-4751-ac52-b0e612985284","ecbcfcfe-4a80-42f2-bfc4-b104a8dcf8fd","1ea5b168-6a99-4764-98d7-376076cf2eca","d0df4a33-1268-4032-beca-ad5121c62cfa"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":103},"minutesToRead":3,"tagIds":["032e23f9-7756-4c74-b205-9ded4b0b3015","b0ee0525-46b5-40d5-a312-5418bfcef2f7"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":103,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"House Made Potato Chips","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"house made potato chips | homemade potato chips"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"PARAGRAPH","id":"epos9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"dcge7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"House Made Potato Chips","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7jbhb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Just like at your favorite restaurant. Here's how to do it!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"80vnr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"85vlr","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_fd1cf068a08b4c6dba86f6f12cf4622c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"House Made Potato Chips"}},{"type":"PARAGRAPH","id":"c1ktt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3hliu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"58d22","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is a great reason to buy a mandoline slicer. Mine is made by OXO and it's made of stainless steel. You can use a less expensive one made from plastic and this will still work. It's not very easy to evenly slice potatoes this thin by hand so I highly recommend using a mandoline slicer for this. The thinly sliced potatoes will cook up beautifully browned when they are the same size and not so well if they aren't.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bdmc0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1d14n","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4c8423aca71a47ccbdd6e7b2b01ec750~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"5m0ts","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Look at how gorgeous these slices of large red potato are! A mandoline makes all the difference. By the way, use whatever potato you like best. Or use any other root vegetable you like because this method works for them all. Make sure you fry each variety separately though if you try more than one type of vegetable at a time. They will have different rates of cooking and won't become crisp at the same time.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6avd8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I slice up all of the potatoes just before they go into the fryer so they don't become oxidized and turn brown before cooking. This means wash up your potatoes but don't peel them. Finish up the other elements of your meal before slicing and fry the potatoes immediately before you are ready to serve. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7l2m2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fr9h0","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_18b10ab18a3644d5a876d180e7a97686~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Potato Chips in the Fryer"}},{"type":"PARAGRAPH","id":"3eq6u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6gi4q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Use a slotted spoon or metal tongs to toss the chips over occasionally for about 1-2 minutes with the fryer set at 350 degrees. You could also do this in a large dutch oven or deep heavy skillet you have filled with oil to a depth that the chips will float and turn easily. Don't over crowd the potatoes as they need to evaporate their moisture so they will become crisp. Always be very careful when adding the potato slices to the oil. I try to slip them in rather than toss them while separating them into individual slices if they are sticking together. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"435un","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bncq7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b8o44","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1p5lo","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1747fc0037ee442396670f3225fc14d8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"ehrim","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ar27k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you are frying in a dutch oven or a skillet you will need a slotted spoon to scoop out the chips as they finish frying. When they have browned and become crisp I flip them out of their basket and onto a lined baking sheet and sprinkle immediately with fine salt. Maybe you might try a favorite popcorn seasoning if you feel adventurous. On this batch I used some finely ground smoked Himalayan salt I made last fall. Yum!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2d81a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dqcpe","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_873ae4912be34c389356fe5904d59345~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"eckl6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7uifc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"That's all there is too it. The trick to beautiful house made potato chips is really in the slicing. Nice evenly sliced potatoes will make it possible to fry the chips quickly at the same rate so you don't find yourself fishing for chips that are burning while others haven't finished frying.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6q8gl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9cjgb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It's also important that the potato slices are as dry as they can be before dropping them into the hot oil. This will reduce splattering and make them more crisp. You can blot them with a paper towel if you happen to have a particularly juicy bunch of potatoes. I find it helps to dry the potatoes thoroughly after they have been washed with skins on before slicing them to avoid extra moisture.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cdj4m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ercd9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I hope these tips have inspired you to try making your own house made potato chips! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"drh4n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"daa7j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Enjoy!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8pdef","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5al2o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9s1ra","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-10T19:13:23.494Z","updatedTimestamp":"2024-06-10T19:13:23.494Z","id":"7dd1e1eb-eeda-487f-a6b9-ba57a0e46a20"}},"contentId":"61728aec98f45e00165412ac","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_fd1cf068a08b4c6dba86f6f12cf4622c~mv2_d_4032_3024_s_4_2.jpg","url":"https://static.wixstatic.com/media/577c92_fd