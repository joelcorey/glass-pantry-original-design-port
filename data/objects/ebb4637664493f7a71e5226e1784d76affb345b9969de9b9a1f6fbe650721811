slations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jk5wkg12":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:65px;\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\">Sourdough </span></span><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\">Pull-Apart&nbsp;Rolls</span></span></h1>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jk5wkg22":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ingredients</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jk5wkg32":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 cups All Purpose Flour</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 cup bread flour</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 teaspoon active dry yeast</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 1/2 teaspoons&nbsp;salt</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 tablespoon softened butter</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">&nbsp;- plus more for brushing</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 cup sourdough starter, fed the night before</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 cup warm milk, water or whey at about 105 degrees</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/2 cup flour for forming the rolls</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jk5wkg6k":{"pinUrl":"https://www.pinterest.com/pin/637329784744163136/","isConsentPolicyActive":false,"isMobile":false,"translations":{"componentName":"Share from Pinterest","large_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url> ","large_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","medium_element_one_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> cookie settings.<url>","medium_element_two_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> and <%=cookietype%> cookie settings.<url>","small_element_one_cookie":"<url>Update your cookie settings<url>","small_element_two_cookie":"<url>Update your cookie settings<url>","small_tooltip_one_cookie":"To view <%=componentname%>, update your <%=cookietype%> settings.","small_tooltip_two_cookie":"To view <%=componentname%>, update your <%=cookietype%> and <%=cookietype%> settings.","small_element_aria_label":"More info","tiny_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_aria_label":"Unblock <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertising":"marketing"}},"comp-jk5wkg48":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Method</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jk5wkg5h":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Add all of the dry ingredients and the butter to a stand mixer and mix on low speed just to combine, then add the sourdough starter and begin mixing on low speed.&nbsp;</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">With the mixer running on low speed slowly add the warm milk, water or whey, up to one cup until the dough begins to pull away from the sides of the bowl as shown above. If the dough has not fully combined, add warm liquid one tablespoon at a time until it does. Be sure to give it time to mix in before each addition. If the dough becomes too wet add a little more all purpose flour until it comes together. </span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Once your dough has come together, continue to mix for 6-8 more minutes on low. The dough should be fairly sticky.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Scrape the dough onto a well floured board and knead with floured hands 4-5 times and form the dough into a ball.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Place the ball into a bowl with 2 teaspoons of olive oil and swirl it around until all sides are lightly coated with the oil.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Cover with plastic wrap and leave the dough to rise in a warm place until doubled. (60-90 minutes)</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">After the dough has risen, move the dough back onto the floured board,&nbsp;knead 4-5 times then cut it into 15 even pieces. I use a scale for this but I&#39;m sure my grandma just eyeballed it and hers turned out just fine.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Form each of the 15 pieces into a ball and place them side by side evenly spaced in a 15&quot; x 9&quot; pan as shown above. They should be&nbsp;almost touching.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Cover them loosely&nbsp;with&nbsp;plastic wrap sprayed with oil and allow the dough to rise once more in a warm place until doubled (45-75 minutes)</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Start preheating an oven to 375 degrees.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">When the dough has risen, gently brush the tops of the rolls with melted butter and place them in the oven.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Bake 30 - 40 minutes until the tops are golden. Brush again with melted butter and serve.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jtad34g8":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-jk5wkg7k":{"id":"comp-jk5wkg7k","appDefinitionId":"13016589-a9eb-424a-8a69-46cb05ce0b2c","widgetId":"130165ba-4eeb-4a87-3121-a3cf2a86d2ca","isAppInClientSpecMap":true,"isViewerMode":true,"isResponsive":false,"translations":{"preload