":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6psv6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bhfv0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9r8mj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7va38","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We were seated quickly at a table on the mezzanine overlooking the bar and the entry where a great jazz trio was playing. Click on the video below to listen in on the atmosphere. I wish I had taken a business card from them to remind me of their names. It's sad I can't mention them here. They were very good!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"31t13","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"VIDEO","id":"6eod4","nodes":[],"videoData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"video":{"src":{"url":"https://www.youtube.com/watch?v=OGg4eSmfZcI"}},"thumbnail":{"src":{"url":"https://img.youtube.com/vi/OGg4eSmfZcI/mqdefault.jpg"},"width":626,"height":352}}},{"type":"PARAGRAPH","id":"3o3jg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3c33c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Dinner was excellent and they have an extensive wine list. From appetizers to salads, entree's and desert w