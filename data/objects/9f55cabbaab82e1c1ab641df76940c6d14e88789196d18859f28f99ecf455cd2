":{"url":"577c92_f43781ecd455443bb191bbb193156c76~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":15},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"e60vv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fg7df","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a0tu6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We decided to hold a \"Celebration of Life\" for our friend last weekend. The family was not having one and we needed it. Several people in our community seemed to need it too. So last weekend we had a potluck at our community center to celebrate our friend. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4pbff","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1hn89","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I made a loaf of this great ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sourdough French Bread ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#213f95"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/03/04/Sourdough-French-Bread","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"and I made a Twice Smoked Ham:","decorations":[{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/03/04/Sourdough-French-Bread","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9fv99","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7f4s7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Twice Smoked Ham","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/03/04/Sourdough-French-Bread","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eklfs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aorha","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We bought a butchered pig last year and the first ham we ate seemed a little light on flavor to our taste so I smoked it in my electric smoker this time.","decorations":[{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/03/04/Sourdough-French-Bread","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3tj8h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7uqr3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I thawed out our last 4-5 lb. Ham and put it cut side down in a disposable aluminum pan and set the smoker on 275 for 4 hours. I used just one pan of alder wood chips and filled the water pan in the bottom of the smoker with 3 cups of water and 2 cups of apple cider vinegar.","decorations":[{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/03/04/Sourdough-French-Bread","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f1fo9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"71et","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I went to the store to do some grocery shopping at this point and my helpful Honey kept an eye on the Ham. He took it out of the smoker when it reached 150 degrees and covered it with plastic wrap until I came home. It was beautiful.","decorations":[{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/03/04/Sourdough-French-Bread","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cdsq4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bpkhk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My thoughtful husband had saved the juices that were in the pan with the Ham in the smoker too. We put the juices (in their own container) and the Ham (wrapped in plastic) into the refrigerator for the night.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4pda4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"51be9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In the morning before our potluck, I skimmed the fat off of the juices that had congealed into a beautiful aspic and we spread the aspic into a large roasting pan. My husband sliced the ham and set it on top of the aspic and we heated it, covered, for about 1 1/2 hours at 200 degrees. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"946vv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"sret","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It was wonderful! I was surprised how much subtle flavor was infused into the Ham from the apple cider vinegar. Has anyone else ever tried this method?","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f2lse","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"5mhmd","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"44u3f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6he7u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"43h0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Having the potluck felt good. An event to make the living feel better after the hardship and loss of a loved one seems to be a very important thing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c33l1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2h97","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Life in Balance!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"csbt2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dk94i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I feel like we are moving forward again.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f6kat","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fjhtv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"By next weekend we will be heading out on our next big adventure and we will take our memories of our friend with us. Balancing the good and the bad, the happy and the sad. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a6pel","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e00o9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Our next big adventure takes us along the top of the Cascade range from Canada to Oregon on the outback routes of the ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"WABDR","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"rever.co/2016/06/03/wabdr2/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":". We are driving up to Canada in our vintage \"Dune Buggy\" based on the earlier \"Meyers Manx\".  Then we return to Stevenson, WA along the Columbia River driving the Washington Backcountry Discovery Route. Check back on my ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Adventure Page","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"https://www.theglasspantry.com/adventure","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" or subscribe to my website so you don't miss this post. It's going to be an amazing trip!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e41ab","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bo3sh","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_779ae07651e0458e84f7fdfcef8ff40a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Dune Buggy"}},{"type":"PARAGRAPH","id":"1jf36","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3dfj3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I hope you are currently living a life in balance!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7q0s2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"75q5i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metada