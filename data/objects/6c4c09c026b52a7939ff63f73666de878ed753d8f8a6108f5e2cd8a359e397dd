and image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-jmqeayu1":{},"comp-jmqeayva":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:30px;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:caudex,serif;\" class=\"wixui-rich-text__text\">Hawaiian Beef Stir-fry&nbsp;</span></span></h1>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jmqeaywj":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ingredients</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jmqeayxp":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">For the Stir-fry</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 large round steak sliced thinly across the grain</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">3 large cloves of garlic, minced</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 inch ginger, minced</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 sweet onion, sliced</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 can pineapple chunks or 1/2 a fresh pineapple</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 cup snap peas</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">4 oz baby corn</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 small Roma tomatoes</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 tablespoons + 1 teaspoon peanut or canola oil</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 chopped scallions and black sesame seeds for garnish</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">For the Marinade</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 tablespoon cornstarch</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 tablespoons tamari or soy sauce</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 teaspoons sesame oil</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/3&nbsp;of the minced garlic</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/3 of&nbsp;the minced ginger</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">For the Stir-Fry Sauce</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">2-3 tablespoons pineapple juice</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">2 tablespoons ketchup</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">2-3 tablespoons tamari or soy sauce</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">2 tablespoons garlic chili sauce</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">2 tablespoons white sugar</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">1 tablespoon sesame oil</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">2 tablespoons mirin</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">2 tablespoons rice vinegar</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">1 tablespoon cornstarch</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">1/3 of the minced garlic</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">1/3 of the minced ginger</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">1/2 cup cold water</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jmqeaz07":{"pinUrl":"https://www.pinterest.com/pin/637329784743620019/","isConsentPolicyActive":false,"isMobile":false,"translations":{"componentName":"Share from Pinterest","large_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url> ","large_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","medium_element_one_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> cookie settings.<url>","medium_element_two_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> and <%=cookietype%> cookie settings.<url>","small_element_one_cookie":"<url>Update your cookie settings<url>","small_element_two_cookie":"<url>Update your cookie settings<url>","small_tooltip_one_cookie":"To view <%=componentname%>, update your <%=cookietype%> settings.","small_tooltip_two_cookie":"To view <%=componentname%>, update your <%=cookietype%> and <%=cookietype%> settings.","small_element_aria_label":"More info","tiny_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_aria_label":"Unblock <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertisi