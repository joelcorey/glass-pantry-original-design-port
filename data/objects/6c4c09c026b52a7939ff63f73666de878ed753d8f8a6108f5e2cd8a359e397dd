sQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lo1v07kx":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07kx","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jmqeaylk":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07ky":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07ky","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jmqeayix":{"crop":{"x":504,"y":0,"width":3024,"height":2268},"alt":"Hawaiian Beef Stir-fry","width":4032,"height":2268,"uri":"577c92_47d66f1975c444e08101461d26d3247d~mv2_d_4032_2268_s_2.jpg","name":"20180720_180712.jpg","containerId":"comp-jmqeayix","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/577c92_47d66f1975c444e08101461d26d3247d~mv2_d_4032_2268_s_2.jpg/v1/crop/x_504,y_0,w_3024,h_2268/fill/w_504,h_378,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180720_180712.jpg","srcset":"https://static.wixstatic.com/media/577c92_47d66f1975c444e08101461d26d3247d~mv2_d_4032_2268_s_2.jpg/v1/crop/x_504,y_0,w_3024,h_2268/fill/w_504,h_378,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180720_180712.jpg 1x, https://static.wixstatic.com/media/577c92_47d66f1975c444e08101461d26d3247d~mv2_d_4032_2268_s_2.jpg/v1/crop/x_504,y_0,w_3024,h_2268/fill/w_1008,h_756,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180720_180712.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":504,"height":378,"objectFit":"cover"}}},"containerWidth":504,"containerHeight":378,"isInFirstFold":false,"onClickBehavior":"disabled","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-jmqeayix","mainPageId":"qgy49","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-jmqeayke":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Once the ingredients are prepped this stir-fry takes only 15 minutes and dinner is served!</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Start by letting the beef slices marinate while prepping the stir-fry sauce. Then start heating up the pan while prepping the veggies. As soon as the pan is hot you can start frying the beef in two batches. It only takes about 3 minutes per batch. Don&#39;t crowd the pan because you don&#39;t want the beef to steam or worse yet boil. Leaving space between the slices will allow the liquids to evaporate more rapidly.</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Remove the beef to a plate or bowl while you stir-fry the veggies.&nbsp;</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Add the beef and stir-fry sauce to the veggies when they are ready and bring the whole thing to a boil for just a minute to thicken the sauce and it&#39;s done!</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Click through the images below for a better look.</span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jmqeayqd":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07kz":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07kz","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jmqeaynu":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}}