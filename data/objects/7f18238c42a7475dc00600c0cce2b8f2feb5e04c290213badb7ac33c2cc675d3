,{"type":"PARAGRAPH","id":"28vl3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4 Tablespoons coconut oil (melted)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1064h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9omir","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b1ot0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3j5gg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add all ingredients to a large bowl except the honey and coconut oil.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a9fcu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Stir very well to incorporate all ingredients evenly.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5jiun","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"avnq3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add honey and oil and stir well again for about 5 minutes or until you have all of the granola coated with the honey and the oil. It may not seem like enough but give it time and it will distribute perfectly.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d0msu",