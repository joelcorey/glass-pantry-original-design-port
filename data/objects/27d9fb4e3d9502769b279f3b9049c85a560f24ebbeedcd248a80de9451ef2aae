:"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5jp181338","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bring the White vinegar water to a boil and add the boiled snails. Continue to boil for another 5 minutes in the vinegar to remove any slime. The water will probably foam up depending on how slimy you're snails are. Mine are not very slimy here.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"o50my1340","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"hvosk1342","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rinse the snails again in cool fresh water then pluck them from their shells very carefully with tweezers. You can rinse the shells well and bake them in the oven to dry them if you like but wild snail shells are usually very thin and fragile.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"laapc1344","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"jshvp1346","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the crimini mushrooms in a shallow baking dish then fill each mushroom with one snail or a spoonful of the cream cheese filling until you have filled all of the mushrooms.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"usqcd1348","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ursp71350","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next, cover the snail stuffed mushrooms with the compound butter.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"umeum1352","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"fdijp1354","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Pre-heat an oven to 400 degrees and bake the mushrooms for about 15 minutes. When the mushrooms are just getting tender, turn on the broiler and broil the stuffed mushrooms for another few minutes until the tops are golden brown.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"u7jkc1356","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"qie6v1358","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Serve immediately with crusty bread.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-03-08T18:55:13.749Z","updatedTimestamp":"2023-03-08T18:55:13.749Z","id":"577be5ea-f0b1-492f-9d6b-3fe3a2aea6eb"},"documentStyle":{}},"instructions":"Bring the salted water to a full boil and add the fresh snails. Boil for 3 minutes then rinse in cool fresh water.\n\nBring the White vinegar water to a boil and add the boiled snails. Continue to boil for another 5 minutes in the vinegar to remove any slime. The water will probably foam up depending on how slimy you're snails are. Mine are not very slimy here.\n\nRinse the snails again in cool fresh water then pluck them from their shells very carefully with tweezers. You can rinse the shells well and bake them in the oven to dry them if you like but wild snail shells are usually very thin and fragile.\n\nPlace the cremini mushrooms in a shallow baking dish then fill each mushroom with one snail or a spoonful of the cream cheese filling until you have filled all of the mushrooms.\n\nNext, cover the snail stuffed mushrooms with the compound butter.\n\nPre-heat an oven to 400 degrees and bake the mushrooms for about 15 minutes. When the mushrooms are just getting tender, turn on the broiler and broil the stuffed mushrooms for another few minutes until the tops are golden brown.\n\nServe immediately with crusty bread.","title":"Escargot Stuffed Mushrooms","link-recipes-1-1-all":"/wild-mushrooms/"}}],"pagingMetadata":{"count":1,"offset":0,"tooManyToCount":false,"cursors":{"next":""},"hasNext":true}}