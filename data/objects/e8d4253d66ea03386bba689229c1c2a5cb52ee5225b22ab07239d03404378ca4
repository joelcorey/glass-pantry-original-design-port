{"postPage":{"id":"d2ca0ba1-d429-46d9-8aa8-94d6a62e851e","post":{"id":"d2ca0ba1-d429-46d9-8aa8-94d6a62e851e","title":"Washington Backcountry Discovery Route Part Two","excerpt":"Washington Backcountry Discovery Route: Part Two This was such an amazing journey! Eleven of us traveled the Washington Backcountry...","firstPublishedDate":"2017-10-17T14:43:32.574Z","lastPublishedDate":"2017-10-17T14:43:32.574Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/09/28/washington-backcountry-discovery-route-part-two"},"slug":"2017/09/28/washington-backcountry-discovery-route-part-two","featured":false,"pinned":false,"categoryIds":["340a691e-f0fb-48cb-81ca-aa54a6c4e6bc","7a4e13b1-0b29-43ff-bafe-a30058858dd5","f0e3fce4-d677-461b-af98-d7f059887e9a","2d749d80-9208-4fa4-8b99-06013c133b34","6817d7b7-5a3c-46cb-84df-6c98e5d3e96f","7b640cc9-cc3a-4e7a-854c-b3ddf807d97e"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":228},"minutesToRead":7,"tagIds":["c4339c99-eaca-4de1-8fa3-83edbd9c9342","7e3d4cd1-2b55-4aa0-b271-39eec26a18e5","c95b8e2f-9f36-4d20-8498-2a8b51cab146","7e2473f6-d585-4e87-956e-283c9b873d0f","dffd8e36-8111-4f7f-8879-9ba857b46bbb","18eef253-915c-4138-96a6-5a7e2ebee19a","66e08a4e-f170-48df-b69d-b17ccbfb99e5","f43cf711-c337-49fd-945d-fcd7cd8a18bc"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":228,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Washington Backcountry Discovery Route | WABDR 2 | Backcountry Travel","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Washington Backcountry Discovery Route | #WABDR | #RideBDR | Backcountry Travel"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"PARAGRAPH","id":"2dtc3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"d2lsk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Washington Backcountry Discovery Route: Part Two","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"36cc3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ev79i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5eh6h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This was such an amazing journey! Eleven of us traveled the ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Washington Backcountry Discovery Route ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"ridebdr.com/WABDR","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"from Canada to Stevenson, WA during the first week of August. Don't try this unless you are driving an all terrain vehicle. Also, we all did this discovery route backwards so we ended our journey near home instead of more than 500 miles away. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"64n1t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"7a52v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a97d565b30454c5ea26ced808bbf4dc4~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Mike and Melisa Smith on the WABDR 2017"}},{"type":"PARAGRAPH","id":"a660r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6u59v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Our journey began on July 29, 2017. We left our home in Oregon and traveled in our little blue Dune Buggy to Oroville, WA near the Canadian border. It was a fast drive up the freeway through some beautiful country. This is part two of a journey through small towns, rural America and true back country across the beautiful Cascade Mountains of Washington State. Don't worry if you missed part one. You can always read it later.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"49ppu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ctsm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is day 3 of our journey and what is technically Part 5 of the ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Washington Backcountry Discovery Route. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"ridebdr.com/WABDR","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We left Conconully, WA at 8:30am and drove to the not really there town of Ruby. We did find the marker and headed up the first grade of the day. It was a nice one!","decorations":[{"type":"LINK","linkData":{"link":{"url":"ridebdr.com/WABDR","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1dae","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5cl3a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"tego","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"brji","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6e9pa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The back roads will take us into the mountains today through some truly beautiful terrain with amazing vistas that begin to rapidly disappear as the smoke from distant fires blows into and around the state during this week. It's one of the worst fire years I've ever known.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"198s6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"angjj","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_89cb14291feb4dd3b5067e05e84b77b8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"The Historic Town of Ruby"},{"image":{"media":{"src":{"url":"577c92_6df9a71764ec4fcb9ead4f906f63bf2c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Nice climb!"},{"image":{"media":{"src":{"url":"577c92_1b369842daa9405ca0ae37e91a8d1260~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"And what a view!"},{"image":{"media":{"src":{"url":"577c92_16491a75033d40f1a60d0a3274e46928~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_ca1867288e1344d7b79c12f486a61344~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_3292717f4627482290d87e72de16806f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_f4299131524e4c259b73bfcf08b776d5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"The Burnt Cabin"},{"image":{"media":{"src":{"url":"577c92_3393e1c8ede741ff964d3816a2cb2a4c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"acgis","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We had discovered a pace that everyone was pretty comfortable with as a group. Mike and I took the lead for most of the day since I could co-pilot and everyone else was driving it made it easier for me to follow the GPS tracks. We would go to the next fork in the road and wait for the person behind and then continue to the next fork in the road leaving the person who came behind us to point the next person forward and so on, leap frogging through the forest. We were moving surprisingly fast!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4ic38","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b4a0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"There is no cell service for most of the route, only when you enter town at the end of each day and of course in the morning before you take off if you take each part as mapped. You can download GPS tracks that will allow you to track your progress on a map using your phone or other GPS as this does not require cell service. Your device will require power, however, so be prepared with back-up batteries or power from your vehicle. This kind of GPS really gives your device a workout. It will eat up power.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6r57t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5p38m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b3175","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8bvq8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Somewhere behind us one of our riders took a fall and the bike landed on his foot very hard. When we all gathered along the road for lunch it was decided that two of our party would take a short cut off the mountain and into Chelan where we would all spend the night. Unfortunately, Devon wouldn't be able to ride much farther so Rich volunteered to make sure they both made it safely to Chelan, WA.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2501m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"augeh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"One of our team had a map of the forestry roads we were on that was excellent so Rich and I used that to determine a quick route down to the highway. I highly recommend that you do not rely completely on the WABDR route tracks in case of an emergency. The tracks are not going to show you the fastest or easiest way out. That's not the purpose of the discovery route and road signs are few to none. Have a backup plan and some emergency supplies if you have space to carry some. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"32odl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dq9kl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"5c9oq","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_b617698135a94d2fac8164bed8f7071c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Lunch by the road"},{"image":{"media":{"src":{"url":"577c92_925850c611084eca9295733cfb177252~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"On the road again!"},{"image":{"media":{"src":{"url":"577c92_0440475193254388897349e2e958630a~mv2_d_2592_1944_s_2.jpg"},"width":2592,"height":1944}},"title":"Kickin' up some dust"},{"image":{"media":{"src":{"url":"577c92_e518d24725ee46c1add236c729017a6b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Down into a valley."},{"image":{"media":{"src":{"url":"577c92_57486a77df454c10be39dc8e418ef5ad~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"And back up to nearly 6000'"},{"image":{"media":{"src":{"url":"577c92_f016b2d692fe41b6a2748d68e29d986a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Amazing views"},{"image":{"media":{"src":{"url":"577c92_94ebaa529517450ca87c15cc561bf164~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Pass at the top of the snow park"},{"image":{"media":{"src":{"url":"577c92_fbd9496679a5491482c7b75d10d5f131~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"At the Pass"},{"image":{"media":{"src":{"url":"577c92_8b555f99add04ab280518d31ca53fcaa~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Looking down at Lake Chelan"},{"image":{"media":{"src":{"url":"577c92_9fa57c6d9f784b83978d1840ed0ce91d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Nearly there"},{"image":{"media":{"src":{"url":"577c92_2b2b97f5c93b48668585b6432a13448f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Lake Chelan"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"e2mvj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"ba7j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"ct2k6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"it4h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"cep2o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mountain Top Fun!","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"ugl7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"92s2e","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f75f659a26d94c41a494c2bee4d8a50d~mv2_d_2560_1920_s_2.jpeg"},"width":2560,"height":1920},"altText":"Fearless Leader"}},{"type":"PARAGRAPH","id":"dphrg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"VIDEO","id":"87h23","nodes":[],"videoData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"video":{"src":{"url":"https://www.youtube.com/watch?v=kxURnwbD3nA"}},"thumbnail":{"src":{"url":"https://img.youtube.com/vi/kxURnwbD3nA/mqdefault.jpg"},"width":626,"height":352}}},{"type":"PARAGRAPH","id":"d6hln","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"What you do when you find an abandoned cement mixer on a mountain.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"10lu6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fs1is","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"721lt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4s1ib","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1lcta","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"db136","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Eventually we did all meet up at our hotel in Chelan, WA. It had this little front yard and some picnic tables so Devon and Rich were able to hang out and wait for everyone there and we had a nice shady place to relax and catch our breath after a long hot dusty day on the back roads.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"92drs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6c68a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Later we decided to go get some pizza. Most of us were staying in hotels a couple of blocks off downtown so it was easy to walk around and really enjoy the evening. A few of our group camped out of town on the way to our next departure point. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"esm2e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2rhvl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Our fearless leader, the guy who got us all to join up on this trip together, ask his son to bring a pick-up and haul Devon's motorcycle back to his son's house in Ellensburg, WA, where we would stop in a few days. It was great! He actually had time to do it and  Devon was able to hitch a ride with Paul in the Jeep we were traveling with. He would be able to continue on with us!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cuprb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8mknn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ee9ns","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ukbo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d325e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In the morning we all got some breakfast on our own and then regrouped for the ride out to the campground where we picked up the rest of our guys and headed back into the mountains.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8jd0g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"81g2v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"dnfk5","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_6265838d4458458281c24e4b73650f5a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},