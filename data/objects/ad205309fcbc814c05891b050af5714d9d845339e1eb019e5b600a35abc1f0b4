ons":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"677q9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"sesame seeds to sprinkle","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7mv6m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"93b3l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"51eup","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dcsh0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2510v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"flcqa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add all of the dry ingredients to a stand mixer including the butter at room temperature and then add the lightly beaten egg and the sourdough starter all at once before starting the mixer fitted with a dough hook on low. Slowly add the water or whey until the dough comes together and then continue to mix for another 6 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c01v6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"he2c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the dough from the mixer and roll it into a ball. Put it in a bowl that has been sprayed with spray oil and turn it around to coat it completely finally covering it with plastic wrap to proof for about 90 minutes in a warm place. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2es9v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6t42c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After about 90 minutes the dough should rise to nearly double it's original size. Take the dough out of the bowl and onto a floured surface. Knead it a few times by folding it back onto itself then turning it halfway around and folding it back on itself again. Repeat this 2 or 3 times, then cut the dough into 8 equal pieces. I have a postage mailing scale that works very well as a kitchen scale so I weigh mine to check them. Without a scale, it's probably easiest to cut them evenly if the dough is shaped into a rectangle and then cut into 8 equal squares.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1g2vq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2u53m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Form the buns by squeezing them gently through an opening between your thumb and index finger with one hand while pinching the bottom together with your other hand working to get a smooth and tight surface. Do this about 3 times for each one. See illustrations above.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6b8ta","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dticv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the newly formed buns evenly spaced on a parchment paper lined 1/2 baking sheet and cover with plastic wrap. Set in a warm place to proof once more for about an hour.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"hps3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9n34s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Start preheating the oven to 375 degrees so that it will be ready when the buns are. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dmimu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"caoed","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the buns are ready and the oven is hot, brush the tops with a little bit of cream or butter and sprinkle with sesame seeds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bug9d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8bt7r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bake at 375 degrees for 30-40 minutes turning the baking sheet halfway through.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1oli","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bhk42","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Brush them with cream once again when they are done baking. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e6ns2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"53efm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-24T01:15:38.548Z","updatedTimestamp":"2024-05-24T01:15:38.548Z","id":"ab763ebd-0ab2-4f0f-b503-a09f85945523"}},"contentId":"61728aecc4284300161412e9","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_498ede5082bd409ba436b736c2f4db38~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_498ede5082bd409ba436b736c2f4db38~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f6769804f34aa001761fd35","internalCategoryIds":["5f67697cf4b0370017060123","5f67697cf4b0370017060134","5f67697cf4b0370017060124","5f67697cf4b037001706013a","5f67697cf4b037001706013e","5f67697cf4b037001706012d"],"internalRelatedPostIds":[],"isLiked":false,"isSubscribed":false,"owner":{"activityStatus":"UNKNOWN","contactId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","id":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","name":"By Melisa Smith","privacyStatus":"PUBLIC","siteMemberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","status":"UNKNOWN","isBlocked":false,"isOwner":false},"preview":