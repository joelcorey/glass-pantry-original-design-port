HEADING","id":"ai8nq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hatch Green Chili Sauce","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bfpth","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_95b3b30fe7c7456e9ea027dfe4f150cb~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Hatch Green Chili Sauce"}},{"type":"PARAGRAPH","id":"a069l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ersl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Make your own chili Sauce! This is a classic New Mexican chili sauce made with green Hatch chilies.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dv316","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7678j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Have you ever been to New Mexico? We vacationed there in March of 2016. It was so much fun, we went hiking and took this amazing gondola ride near Albuquerque called the ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sandia Peak Tramway. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.sandiapeak.com/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We rented a car, stayed in Albuquerque, drove all over seeing the sights and ate at great restaurants. That's when we discovered Hatch chilies.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ecaf4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f156i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"At every restaurant we were asked \"red or green\" because everyone has chili sauce with their meal. Even meals you might not expect to come with chili sauce. Each restaurant makes their own it seems and they all make them with the famous local Hatch chilies. We fell in love!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e0ohf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bbbbu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"So when I found some at my local grocery store I was elated! I had to try this myself.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fh104","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3vmg6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5gtpf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e85pc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is how it starts. First, I roast and peeled my fresh green chili peppers. You can find the details on how to do this in my post ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"How to Roast and Peel Peppers.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/10/10/How-to-Roast-and-Peel-Peppers","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9mmna","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ffqcl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_312c17e871ed4fd5a7916c073cdfe6e8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Roasted Hatch Green Chilies"}},{"type":"PARAGRAPH","id":"9a2e7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Roast and peeled Hatch Chili Peppers","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"av5gm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b5d5t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"et2k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8qg38","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_7b6987f8154a4647819d3cee9a5cf2c9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"cl2m2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7r1e2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I broiled them on a sheet pan lined with foil and then steamed them in a large plastic bag for 15 minutes. After they steamed I peeled off the outer charred skins and removed the stems and seeds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"anau8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cdfup","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cg3os","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"These chilies can be pretty hot so be sure you remove the seeds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f350h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"20j10","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_cc07044c286b47c0ad7f390c5777d513~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"IMAGE","id":"7kem","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5bfa5984efcd4a818bae933018d72226~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"dha14","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After the chilies were prepared, I made what is essentially a light chicken gravy with flour, butter, chicken stock, salt, pepper, garlic and onion powder. Then I added my chilies. After they stewed for 15 minutes or so I let the mixture cool for a little while and then gave it all a nice whiz in the blender on the puree setting. The sauce was pretty thick so I added water to thin it out and then seasoned it with salt and pepper.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3rij9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"377on","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"7jh92","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"dls0r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"316d3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"And Voila! There it was like magic! Beautiful rich spicy green chili sauce.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"98fbm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ci7fi","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_7acd4451165045df802a4c9e397d4dd1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Hatch Green Chili Sauce"}},{"type":"PARAGRAPH","id":"d34jr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"34ke2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This green chili sauce is wonderful on so many things. Omelets, Eggs Benedict, Enchilada's, Chili Rellenos,  Chimichanga's, Burritos, I could go on and on. Try it on my ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Green Chili Chicken Enchiladas!","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/10/20/Green-Chili-Chicken-Enchiladas","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ufee","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ckrd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Of course you can use this method with many other chilies as well so don't worry if you can't get any Hatch chili's. Try this with Anaheim, Poblano or any other chili that floats your boat.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c9mpm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8f1ok","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"es77p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"cllar","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"8j5jh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"How to Make ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"ei051","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hatch Green Chili Sauce","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4d1o0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"erite","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"63vt3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"uphr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c7unn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6-8 large chili's roasted and peeled","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bhrkk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3-4 tablespoons butter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dsnnf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 tablespoons flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8fpr9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 cups chicken stock","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"781qa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 teaspoons garlic powder or 3 cloves minced","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"66hhf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 teaspoons onion powder or 1/4 of an onion minced","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"76qke","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"water as needed - I probably added about 1 cup in the blender","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d05cl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"salt & pepper to taste","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dtvkk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5jolo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ejtb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1196c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1im8q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"be4v9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Heat a skillet and saute the garlic and onion if using fresh with a tablespoon of butter until they are translucent. Add 3 tablespoons of butter until melted and then add the flour stirring well with a whisk to combine and remove any lumps. Do not let it brown.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b4p8e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fhp71","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the mixture is bubbly, add the 1 1/2 cups chicken stock and stir it in well with a whisk. Add the garlic and onion powder now if you didn't saute them from fresh. Continue to stir and bring the mixture to a low boil. It will begin to thicken as it boils. Add the roast and peeled chili peppers to the gravy and turn the heat down as soon as it begins to thicken up.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"976cn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1vcs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Let the sauce simmer for 10-15 minutes then set it off of the heat and let it c