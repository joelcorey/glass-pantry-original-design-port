disabled":false}]},"richContent":{"nodes":[{"type":"PARAGRAPH","id":"bpo9a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7l3fg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"22c2f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Chicken Vegetable Pan Roast and Butter Braised Radishes with their Greens","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2trdf","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e22ef2bcac9d418db0b8c879079d894d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Chicken Vegetable Roast with Butter Braised Radishes and Greens"}},{"type":"PARAGRAPH","id":"b1k49","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This beautiful farm to table style dinner is full of color and flavor and it's so easy! Savory roast chicken breast with a Spanish style seasoning, Yukon gold potatoes, red bell and poblano peppers, served with a side of radishes and their deeply colored greens braised in butter and fresh dill.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d45ko","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"8ga1v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ld3b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"beufv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My inspiration for this dinner was the gorgeous fresh picked radishes from my","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Home Garden!","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/6/5/2017-Home-Gardens","target":"SELF"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7eft8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3ne4t","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b88bc28098734639a1cc6c0cde06a40f~mv2.jpg"},"width":1500,"height":1124},"altText":"Home Garden Radishes and Greens"}},{"type":"PARAGRAPH","id":"85u4n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Radishes love butter so why not a little butter?  This classic french pairing of radishes and butter would be the side dish star for my spring supper.","decorations":[{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"dqh4g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f22an","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8do31","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b1svp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ce707","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I was thinking about having chicken so I added to the menu a sheet pan roast of bone-in,  skin-on chicken breasts and some other veggies I found in my pantry. It's always a good idea to get to the freshest vegetables while they are at their best but sometimes my food plans get interrupted and a few things end up in my refrigerator a little longer than intended. I'm sure this would never happen to you!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3suar","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"blt0v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I find roasting is a great way to use vegetables that have been around a bit longer than some of the others. The flavors concentrate and the sugars caramelize enhancing the colors and flavors that may have faded some with time. If the skins have blemishes or wrinkles they disappear deliciously as they roast in the oven. Win! Win!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"973qj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2l21a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"On this meal occasion I found a forgotten red bell and poblano pepper hiding in my crisper drawer. They were not the freshest but still large and plump. This combination said to me \"Spanish style pan roast chicken dinner\" loud and clear. So I mixed up a small batch of seasoning; garlic powder, onion powder, salt, black pepper, dried oregano, cumin and cayenne red pepper, to season up my chicken.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"20r5j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4tcot","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I baked the chicken in a very large glass baking dish with big chunks of unpeeled yukon gold potato for about 60 minutes at 350 degrees before I added the bell pepper and poblano chili along with some red onion. The chicken was a little more than half finished cooking.  All of the vegetables were chopped into very large pieces.  The more tender vegetables don't take as long to cook and I wanted them to remain somewhat firm and juicy to go with the lean chicken. I cooked this in a low sided glass baking pan but I've done this many times using a sheet pan and it works just as well either way. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"atb1t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"40bpl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the chicken temperature was 160 degrees I removed the pan from the oven to the top of my stove and covered it with cooking foil to let it rest while I braised the radishes and greens. The chicken finished cooking perfectly and everything stayed very warm. Letting the chicken breast rest after baking like this helps to keep the juices inside the large bone-in chicken pieces so the breast does not dry out but gets done all the way through.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3v955","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2vmj0","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a4045823a58b41f1bdb5415e50d83056~mv2.jpg"},"width":1500,"height":1125},"altText":"Spanish seasoned chicken and vegetables"}},{"type":"PARAGRAPH","id":"ep7tc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Chicken and vegetable roast with Spanish style seasoning. This was taken as I added the peppers and red onion about half-way through the roasting time.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fe4up","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"e78bo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"bhhae","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"9aj4b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now it was time to prepare the beautiful radishes I had harvested from my garden earlier in the day!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cmf2t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"at7er","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_5495327d15084c2b83686a59d45e9503~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Home Garden Radishes"},{"image":{"media":{"src":{"url":"577c92_584b43ff52b942ec946319e48fbd53db~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Butter Braised Radishes with Fresh D"},{"image":{"media":{"src":{"url":"577c92_1fea573a0e304f91abcdce3f8aec505e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Butter Braised Radishes with Fresh D"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"2pf70","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82osa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After thoroughly rinsing the radishes and their greens I cut off the radish root portions leaving just a tiny bit of the greens attached and I cut each of them in half. I chopped the greens very coarsely.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ntv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1vtec","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next, I heated a large skillet to medium heat then added a tablespoon of avocado oil to the pan (because it sounded good) and a tablespoon of butter. You could use more butter or any other good quality oil you like to use. I added the radish halves to this and let them braise for a few minutes until they began to become translucent. This is when I added the dark leafy greens to the pan, 2 more pats of butter, 2 tablespoons of water and 2 tablespoons of freshly chopped dill. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5lbjh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7a87q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"1c7qi","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_6e69bb541ed7413999bd39d16d752889~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Butter Braised Radishes with Dill"},{"image":{"media":{"src":{"url":"577c92_fa50c7abc0514674adf5a8dd768214a1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Butter Braised Radishes with Dill"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"8g0s9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I tossed them in the pan with tongs for a few minutes then put the lid on and let the greens braise about 10 minutes until they were well wilted and the radishes were tender.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"79m2p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ab374","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"268ln","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a4522484b1cb4cfd8c4405fffccbe10a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Butter Braised Radishes with Fresh Dill"}},{"type":"PARAGRAPH","id":"apg5c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Butter Braised Radishes with Fresh Dill","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"190md","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8pbmo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d3ifc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7o1j8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I absolutely love radishes this way! I never even thought about eating cooked radishes when I was younger but since I discovered butter braised radishes I am now a huge fan. I also recommend roasting them on a sheet pan lightly coated in a quality oil with other vegetables like broccoli and garbanzo beans. Even the greens can be roasted. The greens taste something like roasted kale and become crispy if left to roast long enough.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"i