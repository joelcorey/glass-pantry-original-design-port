corations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"3dj70","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Green Chili ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"efmoq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Chicken Enchiladas","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d6rd1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2b34v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b0816e514196414cb77cdb1fa5652a2e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Green Chili Chicken Enchiladas"}},{"type":"PARAGRAPH","id":"33j3d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" We visited New Mexico last year and fell deeply in love with the food there. New Mexico has this amazing local chili pepper called a Hatch chili that they make red or green chile sauce with. Everyone seems to eat it with every meal and if you stay there long enough you'll find you sort of want it all the time too. These green chili chicken enchiladas are made with my own house made ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hatch green chili sauce","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/10/20/How-to-Make-Hatch-Green-Chili-Sauce","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":".","decorations":[{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/10/20/How-to-Make-Hatch-Green-Chili-Sauce","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d32np","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"anokj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I did neglect to take a photo of the chicken filling I made for these beautiful New Mexican enchiladas but it was quite simple. I chopped up and sauteed some chicken breasts and added a few tablespoons of taco seasoning that I make at home. It's not always exactly the same but it will always have chili powder, cumin, garlic powder, onion powder, paprika, salt and pepper, cayenne pepper and a little oregano. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eqh6m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d053b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You could get a bit fancier and add some fresh chopped garlic, minced onion, cilantro or green onion but I was feeling lazy the night I made this and left it out. It was still quite delicious!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e8ins","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"drrkh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7mktu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Here is what brings it all together, my ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"house made hatch green chili sauce","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/10/20/How-to-Make-Hatch-Green-Chili-Sauce","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":". Just add a few tablespoons of this sauce to the chicken filling and it will be magic.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"68kli","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_95b3b30fe7c7456e9ea027dfe4f150cb~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"link":{"url":"www.theglasspantry.com/single-post/2017/10/20/How-to-Make-Hatch-Green-Chili-Sauce","target":"BLANK"},"altText":"House Made Hatch Green Chili Sauce"}},{"type":"PARAGRAPH","id":"92vt0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" House made hatch green chili sauce.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"ITALIC","italicData":true},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/10/20/How-to-Make-Hatch-Green-Chili-Sauce","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"2qfu1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"1sa63","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I start making the enchiladas by softening a corn tortilla in a warm skillet with a little vegetable oil. The oil will keep the corn tortilla from cracking or falling apart when you roll it and as it bakes. I drain away as much oil as I can back into the pan and place the tortilla on a clean cutting board. I top the tortilla with 2 1/2 tablespoons of the chicken filling I've made and sprinkle with Mexican style shredded cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"469j0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"24mg8","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_8a9e09514e97496b98ee5283380c8d59~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Soften the tortilla."},{"image":{"media":{"src":{"url":"577c92_22f95e9c1abf4bf3afd3d2dd8f739508~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_b7ddc4e372f7465d94fe66d8dede66f5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Filled Tortilla"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"imre","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Very gently, I fold both sides over the filling and place it onto a baking pan seam side down. I repeat this process until I have filled as many enchiladas as I plan to make. After all of the enchiladas have been filled, I top them with my green Hatch chili sauce and sprinkle them with more cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5vf24","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decora