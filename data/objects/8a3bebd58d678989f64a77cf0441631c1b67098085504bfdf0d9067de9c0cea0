id":"56gn5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"47lo5","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_d26d520e32fc44cf8bb5c1bf9d2810d1~mv2.jpg"},"width":1500,"height":1125}},"title":"Beautiful Cheeseburgers"},{"image":{"media":{"src":{"url":"577c92_aac67ca91195418982072249a1d269d9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Perfectly Formed Patty"},{"image":{"media":{"src":{"url":"577c92_97f3c25e1a5f432eb1ee2be3e8bad8bb~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"4 Perfectly Formed Patties"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"dvkp9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b8h34","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Great burgers are my husbands favorite food I think. When we go to a restaurant that serves many dishes but is known for their burgers I know exactly what he's going to order. So I decided I needed to work on this meal for him at home.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"agehp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dbi73","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Until I learned this tip I was never very good at making  burgers because they would always shrink and fall apart.This is the best way to make perfectly formed burger patties that are uniform and never fall apart on the grill. I know I could go out and buy a burger forming gadget but what fun would that be? The method I'm using has an added bonus too. Crazy easy clean-up! I love the way these patties are all the same size and thickness for even cooking too.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d273v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c8a0v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fr4nf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"95asp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Here is my technique:","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4437j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"akcsd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"44p9e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"First, go find the lid to a large jar that's very close to the size of the burger buns you will be using and some plastic wrap. Lay a square piece of plastic wrap across the top of the upside down lid like in the picture below.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5nek9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cgpv4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next, mix up your ground meat. I'm not going to give you a recipe here because I encourage you to be creative and enjoy the freedom to make your own burger and not have to buy a preformed one from the freezer section of your local market. I will say that whatever you decide to put with your ground meat it should include one egg for every 16 oz of meat. It works as a binder that will keep your patty from disintegrating on the grill. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ukgo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"309gs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6sc2j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e0d8b5d9797c4daaafff4d6c512ecae9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Making a burger patty"}},{"type":"PARAGRAPH","id":"512ko","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1h4um","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fill up the lid with your burger mixture and mash it in lightly with a fork until it's nice and level and goes all the way out to the edges without leaving any big air spaces. Be careful not to over do it and pack it in too hard. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6kto","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fn5q5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now fold the edges of the plastic wrap back across the burger patty and gently press it smooth with your fingers taking care to keep the burger filling level with the edges of the lid.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bjvfr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6hhav","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b2893752dea7447fac8ab8d8880f9da9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"1ibh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8gdsk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now open the plastic wrap back up and lay a square of wax paper across the top of the newly formed patty and flip it out onto your hand like this. Now you can remove the plastic wrap from the perfect burger patty and place the plastic wrap back into the jar lid clean side down to use again.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"13be3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6sp0r","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_32c56a969fc34b79bb31b33ff5d57534~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"57hr0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ikoi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"And there you have it! The Perfectly Formed Burger Patty.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5m80k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3i3e0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2jaca","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ecipl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_aac67ca91195418982072249a1d269d9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Perfectly Formed Patty"}},{"type":"PARAGRAPH","id":"ak6ca","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  Now you can make more!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7h544","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"ind