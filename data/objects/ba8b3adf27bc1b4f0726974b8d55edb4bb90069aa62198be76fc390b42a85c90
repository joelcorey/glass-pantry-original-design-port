eam Cheese filling (if using):","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}},{"type":"BOLD","fontWeightValue":700.0}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4 oz cream cheese blended with 3 tablespoons grated Parmesan cheese, 1 clove minced garlic, a pinch of the minced shallot, a dash of cayenne pepper and salt & black pepper to taste.​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vlf0j1122","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"sh3gh1141","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Crusty Bread for Serving","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}},{"type":"BOLD","fontWeightValue":700.0}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-03-08T18:53:59.079Z","updatedTimestamp":"2023-03-08T18:53:59.079Z","id":"b66a5cfb-b0b9-458b-a1ac-34a44b946356"},"documentStyle":{}},"catagory":"Wild Mushrooms","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bring the salted water to a full boil and add the fresh snails. Boil for 3 minutes then rinse in cool fresh water.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"n9uf61336","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5jp181338","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bring the White vinegar water to a boil and add the boiled snails. Continue to boil for another 5 minutes in the vinegar to remove any slime. The water will probably foam up depending on how slimy you're snails are. Mine are not very slimy here.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"o50my1340","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"hvosk1342","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rinse the snails again in cool fresh water then pluck them from their shells very carefully with tweezers. You can rinse the shells well and bake them in the oven to dry them if you like but wild snail shells are usually very thin and fragile.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"laapc1344","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"jshvp1346","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the crimini mushrooms in a shallow baking dish then fill each mushroom with one snail or a spoonful of the cream cheese filling until you have filled all of the mushrooms.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"usqcd1348","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ursp71350","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next, cover the snail stuffed mushrooms with the compound butter.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"umeum1352","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"fdijp1354","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Pre-heat an oven to 400 degrees and bake the mushrooms for about 15 minutes. When the mushrooms are just getting tender, turn on the broiler and broil the stuffed mushrooms for another few minutes until the tops are golden brown.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"u7jkc1356","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"qie6v1358","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Serve immediately with crusty bread.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-03-08T18:55:13.749Z","updatedTimestamp":"2023-03-08T18:55:13.749Z","id":"577be5ea-f0b1-492f-9d6b-3fe3a2aea6eb"},"documentStyle":{}},"instructions":"Bring the salted water to a full boil and add the fresh snails. Boil for 3 minutes then rinse in cool fresh water.\n\nBring the White vinegar water to a boil and add the boiled snails. Continue to boil for another 5 minutes in the vinegar to remove any slime. The water will probably foam up depending on how slimy you're snails are. Mine are not very slimy here.\n\nRinse the snails again in cool fresh water then pluck them from their shells very carefully with tweezers. You can rinse the shells well and bake them in the oven to dry them if you like but wild snail shells are usually very thin and fragile.\n\nPlace the cremini mushrooms in a shallow baking dish then fill each mushroom with one snail or a spoonful of the cream cheese filling until you have filled all of the mushrooms.\n\nNext, cover the snail stuffed mushrooms with the compound butter.\n\nPre-heat an oven to 400 degrees and bake the mushrooms for about 15 minutes. When the mushrooms are just getting tender, turn on the broiler and broil the stuffed mushrooms for another few minutes until the tops are golden brown.\n\nServe immediately with crusty bread.","title":"Escargot Stuffed Mushrooms","link-recipes-1-1-all":"/wild-mushrooms/"},{"introduction":"Crispy golden brown on the bottom, moist and full of flavor on top! This makes an awesome holiday side dish for serving with anything. Traditional herbs, celery and onion are so good with the tangy sourdough bread cubes I save from the ends and pieces of homemade bread but you can use store bought sourdough if your not a bread baker. Mixing up different types of sourdough bread will give it a unique texture and flavor that's amazing!","servings":"6-8","photo":"image://v1/577c92_7a0f659a109342098dc32c3f31c4b536~mv2_d_4032_3024_s_4_2.jpg/4032_3024/20181123_181456.jpg","url":"https://www.theglasspantry.com/sausage-mushroom-sourdough-stuffing","link-recipes-1-1-title":"/mushrooms1/sausage-mushroom-sourdough-stuffing-","_id":"66964ca0-127b-4b37-bd19-860792f7ef3e","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2023-03-08T18:37:48.316Z"},"shortDescription":"Crispy golden brown on the bottom, moist and full of flavor on top! This makes an awesome holiday side dish for serving with anything. Traditional herbs, celery and onion are so good with the tangy sourdough bread cubes I save from the ends and pieces of homemade bread but you can use store bought sourdough if your not a bread baker. Mixing up different types of sourdough bread will give it a unique texture and flavor that's amazing!","cookingTime":"50 minutes","_updatedDate":{"$date":"2023-03-08T20:25:06.977Z"},"recipesCatagoryCatagory":"/Recipes/catagory/Wild-Mushrooms","preparationTime":"30 minutes","order":12.0,"ingredients":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8 cups diced sourdough bread cubes","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"tgunv129","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 pound bulk pork sausage. (I used Jimmy Dean Sage Breakfast sausage)","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ouh3l131","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 cups chopped fresh cremini mushrooms or 1 cup cooked and chopped wild mushrooms as described in the method below.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"66zyd133","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 3/4 - 2 cups chicken stock","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"exxg1135","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons melted butter","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"rxntm137","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons chopped parsley","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"861jt139","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 of a large sweet onion chopped (1/2 inch pieces)","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"a4au2141","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4 ribs of celery chopped into a small dice (1/4 to 1/2 inch)","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"84efd143","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon each: dried basil, dried thyme leaves, dried tarragon leaves and dried rosemary all crushed together with a mortar & pestle.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"8zc1i145","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 teaspoon salt","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5sgml147","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 teaspoon black pepper","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-03-08T19:12:04.355Z","updatedTimestamp":"2023-03-08T19:12:04.355Z","id":"a2b379cd-27fe-4906-b7d0-6cf535a16b8b"},"documentStyle":{}},"catagory":"Wild Mushrooms","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cut sourdough bread into small cubes while browning the sausage lightly.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"wun6l186","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"enbhf188","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add 1 tablespoon chopped parsley, the salt, pepper, and crushed herbs to the cubed bread.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"65nlp190","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"4ana3192","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the celery and onions to the sausage and sauté until wilted. Next add the mushrooms. Stir them in and sauté another 2 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3jsjc194","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"667m2196","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I have used store bought cremini in this recipe but Chanterelles, Fried Chicken mushrooms (Lyophyllum decastes), Honey Mushrooms (Armillaria), a variety of milk caps ( Lactarius), Oyster mushrooms or Shrimp Russula (Russula xerampelina) mushrooms would be very tasty in this dish.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"bsivj198","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"pimms200","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Important Note *","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}},{"type":"BOLD","fontWeightValue":700.0}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" If using wild mushrooms for this recipe, be sure you have properly identified the mushrooms and thoroughly cleaned and cooked them before adding them to this casserole. I like to use wild mushrooms that I have already prepared, sautéed and frozen, thaw just enough to loosen them and mix them in. You could alternatively add 1 1/2 cups cleaned and chopped fresh wild mushrooms and cook them thoroughly with the sausage.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"md5uj204","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"mg4yp206","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Melt the butter and add it, along with the chicken stock and the sausage mixture to the seasoned bread cubes and mix well.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"v5b6k208","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ooo4r210","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Spray oil a 13 x 9 glass baking dish and spread the stuffing into the baking dish and pack it gently with the back of a large spoon or spatula.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ojzru212","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3vbm9214","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add a little more water or stock if the stuffing seems too dry. That will depend on how dry your bread is and how moist you like your stuffing.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"text