{"postPage":{"id":"af5e34e2-fbd3-482a-96d0-19ee825ed2da","post":{"id":"af5e34e2-fbd3-482a-96d0-19ee825ed2da","title":"Autumn Maple Leaf Sugar Cookies","excerpt":"Autumn Maple Leaf Sugar Cookies Autumn maple leaf sugar cookies smell heavenly. Touched with some maple extract they smell just like...","firstPublishedDate":"2017-10-31T14:03:00.000Z","lastPublishedDate":"2017-10-31T14:03:00.000Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/10/28/autumn-maple-leaf-sugar-cookies"},"slug":"2017/10/28/autumn-maple-leaf-sugar-cookies","featured":false,"pinned":false,"categoryIds":["77a7e5bb-3035-4aec-b5d9-f3ac91f5cdd7","15abe877-7a05-4ea7-9f92-bfe7c73120b4","a1665d29-27d9-46c7-9891-3d068d63fb84","accdf66c-0e8c-4ccb-9d3c-46a7d67e90f5","89a46745-be80-4751-ac52-b0e612985284","aa2525e7-dac8-4c68-aac0-104363e2cb79"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":3230},"minutesToRead":4,"tagIds":["05891723-44d2-4872-8879-97f28e6b1780","3901b9e7-2957-4afa-9444-3af54fde8bd6","e87764ff-385d-4240-9479-263d1594ab73","b67032ab-f4b9-482f-8382-faefccbaa988","ea0b342e-502f-4796-b292-e57ee280b2c3","c7757086-a383-47d1-9076-3a6ab7a9bfb0","2c7fcff1-17b0-474b-928c-39378a7b7ad8","4b13a634-09cd-481a-b6d4-6619a886a48b"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":3230,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Autumn Maple Leaf Sugar Cookies","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Autumn Maple Leaf Sugar Cookies | Rolled Sugar Cookies | Maple Icing | How to flood and marble cookie icing"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"451as","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Autumn Maple Leaf","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"8e03p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sugar Cookies","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fvk66","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1o8mp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Autumn maple leaf sugar cookies smell heavenly. Touched with some maple extract they smell just like fresh maple bar donuts when you open the cookie box. I think these are wonderful holiday cookies for the Fall in fact I made some for Thanksgiving last year. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5kgb4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ctll","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e6427f1785aa498683c0b810e363036a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Maple Leaf Sugar Cookies"}},{"type":"PARAGRAPH","id":"7tk3e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9pc0r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This year I made these cookies for the Stanford at OSU football game because my husbands side of the family was gathering there for a mini family reunion to watch our nephew Kaden Smith play for Stanford. What a game that was!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9mmj4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7em4m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It was a tiny bit difficult for us all being Beavers fans for the most part and Kaden's dad is actually OSU alumni, but we were there to support K and he did not disappoint. Not only is he a great guy but a hell of a football player too! Love you Kaden!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"77bj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3lo6v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Although we only had a few minutes to spend with our nephew we did get to spend many wonderful hours visiting with cousins, brothers and sisters and all of the kids that we had not seen in quite some time. We had a tailgate party with other Stanford player families and made new friends too! It was a great time.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6hqn2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ng70","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ktoe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"b3irf","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_0555687cd6e94bf08aa0779de4105331~mv2.jpg"},"width":1289,"height":967},"altText":"Autumn Maple Leaf Sugar Cookies"}},{"type":"PARAGRAPH","id":"6jddt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Cookies at the after party","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"1ehfg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2f5hh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c6tbj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A few days before we left for Corvalis, Or. where the game was played, I started on the cookies. Cookies like these are not made in one day, so I made the dough the night before baking the cookies and let the flour bloom and everything get cozy overnight in the fridge. (day 1)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e7ij0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e89cq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I've researched many sugar cookie recipes and I've come to a compromise. The recipes that make the cleanest sharp edged intricately designed cookies do not make the tastiest cookies. The rich, chewy sugar cookie recipes taste great but do not make the prettiest cut outs because they are too puffy and the edges become too rounded. So the recipe I have used here is somewhere in the middle.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e302r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fa82t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"322fo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The next day, (day 2), I quartered the dough and then one at a time, I rolled the dough out and cut and baked the cookies. That process takes a couple of hours and is illustrated below. Click on the images for extra details.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a0hi4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"chec8","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_42fc30fd634d40899467212fb112d9e2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cold dough from the fridge."},{"image":{"media":{"src":{"url":"577c92_ea70130654364eddbb348a421ae24712~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cutting the dough into quarters."},{"image":{"media":{"src":{"url":"577c92_b25f9115633041999ba1aab191701a18~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Flour for the cookie cutter."},{"image":{"media":{"src":{"url":"577c92_df1a9386fe484a85b366c1e1c4b39669~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Rolling the dough."},{"image":{"media":{"src":{"url":"577c92_c28d062d70eb45519b3dd6ccca7b7a29~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Rolling the dough."},{"image":{"media":{"src":{"url":"577c92_252b98a9f3634a839d10c2f59f6aee04~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cutting the leaves."}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"9baqh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c3e1r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c7qur","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After cutting and rolling out the cookies I bake them at a slightly higher temperature for a shorter length of time than most recipes call for. I found that 375 degrees for 8-9 minutes gives me the just slightly golden color I like for these Maple Leaf cookies. Don't forget to turn the pan half way through baking to maintain an even color.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"deuib","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4se62","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_fd625d47e0be42ef8d40e7c1bd37f208~mv2.jpg"},"width":1500,"height":1125},"altText":"Maple Leaf Sugar Cookies"}},{"type":"PARAGRAPH","id":"7lptl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b066j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"afh90","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3tmu4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d22be","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5uned","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e51a9e6e72f24143a485742b1d639a47~mv2.jpg"},"width":1125,"height":1500},"altText":"Maple Leaf Sugar Cookies"}},{"type":"PARAGRAPH","id":"9adar","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After all of the cookies are baked and have had plenty of time to cool, I put them into a large airtight container for the night. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"amv6r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ef5a2","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_3063fa1bf7304898ad2ff5720293be51~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Maple Leaf Sugar Cookies"}},{"type":"PARAGRAPH","id":"an1n8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b3f5d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The next day, (day 3), is decorating day!Time to make the yummy maple glace icing. It smells so good. The smell of maple fills the kitchen for the day and I mix up my little paint pots with bright fall color. My husband went outside and found these beautiful leaves for me to use for inspiration. The color will soften as the cookies dry so I keep that in mind as I add the color to my icing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6odmk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6lugr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ke0a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ecspd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I found the icing recipe at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Stuff By Stace","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"stuffbystace.blogspot.com/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" and changed the vanilla extract to maple extract for this recipe.  I use Wilton food coloring to get the intense hues. I made these colors to flood the cookies with so I added enough milk to get a consistency that melts back into itself within a few seconds when drizzled without leaving marks. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fah01","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9qc7s","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_360582ce78744f07883247a6762aee9e~mv2.jpg"},"width":1500,"height":1125},"altText":"maple glace icing"}},{"type":"PARAGRAPH","id":"e6l5q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7rj68","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After making and coloring the maple glace icing for flooding, I fill one piping bag with a thicker version of the brown glace icing. It's just a little bit more stiff so that it will hold its shape when piped onto the edge of the cookie creating a barrier that will keep the flooding icing from running all over the place and making a nice clean edge. When piping the edge around the cookie, I like to make nice sharp points to enhance the shape of the design.  Click through the images below for more details about decorating these cookies.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"20hsq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"3ehdn","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_e2df3ae94ee94a04a52930fd731b5b9e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Piping Bag"},{"image":{"media":{"src":{"url":"577c92_b1e8546bd950462982e35096b2d96451~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Maple Glace Icing"},{"image":{"media":{"src":{"url":"577c92_e106bdd47d1844e2a2cc2fb370ec202b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Piped Maple Leaf Cookies"},{"image":{"media":{"src":{"url":"577c92_c11e127b75fa41558273ac63f40c27cd~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Flooding the Cookies"},{"image":{"media":{"src":{"url":"577c92_5fc488a2495a4a66a484dd55e633aa98~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Flood the Cookies"},{"image":{"media":{"src":{"url":"577c92_eb76ece506af4bbca73ea8f15a5b5668~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Marbling the Cookies"},{"image":{"media":{"src":{"url":"577c92_328bfeb39f5d4f8898904ebb61bc216e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Marbling the Cookies"},{"image":{"media":{"src":{"url":"577c92_7e137bdcbd284945a1d1587083b1782f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"aaf81","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Here's a short video from my ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"YouTube channel","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.youtube.com/channel/UCmkdY0w5ud72cksC9Hwep_g/videos?view_as=subscriber","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" illustrating how I flood and marble the icing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6b2jd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragrap