_s_4_2.jpg"},"width":4032,"height":3024}}}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"233n3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" As the cookies dry overnight, the colors melt together and soften bringing out subtle details in the marbling. It always amazes me how different they look after drying. The icing recipe I use is a maple glace really so unlike royal icing, they retain a satin like sheen even after the high gloss goes away. In the morning they are ready to box up or wrap in individual clear cookies bags for sharing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fufv1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"eo158","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_14a7f1a287b84042b8b9eeabd7999e55~mv2.jpg"},"width":901,"height":676},"altText":"Autumn Maple Leaf Sugar Cookies"}},{"type":"PARAGRAPH","id":"8hre9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I love this technique for decorating maple leaf cookies. Just like in nature, no two are ever exactly the same. It's a very organic. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f6777","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"airc5","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_2