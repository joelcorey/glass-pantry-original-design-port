{"postPage":{"id":"fa10f9d4-8da3-4284-b466-956c8a9a15ab","post":{"id":"fa10f9d4-8da3-4284-b466-956c8a9a15ab","title":"Hazelnut Molasses Sourdough Bread","excerpt":"Hazelnut Molasses Sourdough Bread This is a lightly sweet and hearty hazelnut studded seed bread that makes wonderful breakfast toast and...","firstPublishedDate":"2017-11-14T14:39:00.000Z","lastPublishedDate":"2017-11-14T14:39:00.000Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/11/05/hazelnut-molasses-sourdough-bread"},"slug":"2017/11/05/hazelnut-molasses-sourdough-bread","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","a3a5dcbf-0099-4cce-9147-27c56bc3988e","e444dbd4-a3f2-41ca-b0ae-85bd13111cd6","173f5020-85a4-4dfd-9e92-e3ed6303db2b"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":409},"minutesToRead":7,"tagIds":["96d3a9c9-5cd1-41e5-a62f-127b10a658af","a8607f29-92d6-4757-9ffe-bd2c473061f2","532e517b-ae87-4aeb-91f2-f9acf4152b35","4cca5cfe-d04a-4481-9082-1097e811a8ef","d88e537a-8ee5-4632-bef0-3d62e1379bb8","6598f707-1789-4257-b5a3-3e0b3875ef1d"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":409,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Hazelnut Molasses Sourdough Bread","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Sourdough Bread | Hazelnut Bread | Dutch Oven Bread"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"ac8pt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Hazelnut Molasses Sourdough Bread","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3lolg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b50f3aa69b8b4e98aaff38b92a7f92f5~mv2_d_4003_2676_s_4_2.jpg"},"width":4003,"height":2676},"altText":"Hazelnut Molasses Sourdough Bread"}},{"type":"PARAGRAPH","id":"2tc6v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ehe0s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This is a lightly sweet and hearty hazelnut studded seed bread that makes wonderful breakfast toast and a great addition to any meal. It has molasses and honey and just a light tang from the sourdough. ","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fitj5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ccdv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I made this recipe to take to Corvalis Oregon for a football game at Oregon State so I thought I'd be a bit cheeky and make it shaped and scored to look like a football. What do you think? Success?","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7qu91","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8dfg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"er76h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bhc6c","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a2199ab6afeb41619ac422a161209b38~mv2_d_3751_2509_s_4_2.jpg"},"width":3751,"height":2509},"altText":"Hazelnut Molasses Sourdough Bread"}},{"type":"PARAGRAPH","id":"9438p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"drlk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"4pceg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Look at those big chunks of hazelnut sticking out. Yum!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"21f31","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fvicj","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_01164f72a49b4556bc1d9b0a3638a0cc~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Hazelnut Molasses Sourdough Bread"}},{"type":"PARAGRAPH","id":"63lnb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3c1qr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tvko","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fjbu5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Putting the dough together is simple in a stand mixer. Add the butter and all of the dry ingredients except the hazelnuts to the mixing bowl and run the mixer with the dough hook attachment just to get them mixed. Then add the molasses, honey and sourdough all at once and begin to mix them together. As this starts to combine, start drizzling in the warm water until you have used about 1 cup. If the dough seems too dry, add water one tablespoon at a time until the dough comes together and then let the mixer continue to run for 7-8 minutes to knead the dough and get the gluten working.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aoim7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ulfe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other. Gather the dough into a ball and place it in a large bowl that has a tablespoon of oil in it and roll it around so it's lightly covered with the oil. ","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"385pk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"55e1r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Cover the bowl with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1sire","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1je0k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"8ktkm","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_bb1f7ec54fcd47249359fceb2c1f4cbc~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"In a mixer, combine ingredients"},{"image":{"media":{"src":{"url":"577c92_c2b80ec741124f9c8fcbac2c9174d3d3~mv2_d_4027_2690_s_4_2.jpg"},"width":4027,"height":2690}},"title":"Kneading the dough"},{"image":{"media":{"src":{"url":"577c92_b9b219f01d474bc8917b7a1c0f42f68d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Kneading the dough."},{"image":{"media":{"src":{"url":"577c92_b44175f6ffd64aa796113c33c48b6540~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"First Rise"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"2nd18","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4p95k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After an hour or so the bread should double in size and be ready to form into loaves for the second rise. Turn the dough out onto the floured board and with floured hands pat it out into a disc and top it with the chopped hazelnuts. Stretch and fold the dough over itself then turn the dough and stretch and fold again. Repeat until the nuts have been incorporated into the dough then roll the bread up newspaper fashion creating surface tension as you roll until you have created an oval football shape.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1mpjm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8g9gn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You could put this loaf into a large oval proofing basket at this point to rise again and bake as one loaf but in this case I was preparing to make two loves. One medium sized football shaped loaf for the Stanford at Oregon State football game we were attending in a few days and a small round loaf for that nights dinner.  ","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e75i5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e1nps","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I cut the loaf into two pieces as shown in the pictures below and continued to form them into a small football shaped oval and a smaller round loaf.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9tc2l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"32qi4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"eim9i","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_3fd0bba1a38447a88a4c74809a8177d3~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Dough after first rise."},{"image":{"media":{"src":{"url":"577c92_69efa78bfd58436aa8e3c812ea382077~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"adding the chopped hazelnuts"},{"image":{"media":{"src":{"url":"577c92_33a0f56c0f31408caa4dfbe4f179ee49~mv2_d_3517_2341_s_2.jpg"},"width":3517,"height":2341}},"title":"Folding in the hazelnuts"},{"image":{"media":{"src":{"url":"577c92_c9882843be8b4cf5b5e86aadacb7f20f~mv2_d_4027_2686_s_4_2.jpg"},"width":4027,"height":2686}},"title":"Forming a football shaped loaf"},{"image":{"media":{"src":{"url":"577c92_6a8c878e5278456e9c9caded58bf6fdb~mv2_d_4027_2685_s_4_2.jpg"},"width":4027,"height":2685}},"title":"Forming the two loaves"},{"image":{"media":{"src":{"url":"577c92_de1ffa613afc403db2c331ff60e403ec~mv2_d_4032_2691_s_4_2.jpg"},"width":4032,"height":2691}},"title":"Forming the two loaves"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"2gvj9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bvm4m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"60tpe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ej584","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_758fc76a10624784a37725ced2968943~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Sourdough Molasses Hazelnut bread proofing"}},{"type":"PARAGRAPH","id":"d7gge","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hazelnut Molasses Sourdough Bread Proofing","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"69r8k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4b92n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I floured the two bannetons I was using and added the newly formed loves seam side up then covered them with the banneton covers.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4h7t1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2kf3e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"These bread baskets are awesome. I do live a two hours away from any serious kitchen supply store so I do much of my shopping on Amazon. I have been very pleased with the items I use and those displayed on my website. I highly recommend using bannetons if you want to make quality bread at home easily. I have worked in fine dinning restaurants and I see so much value in purchasing restaurant or bakery quality kitchen products. They are time saving and really make things so much easier to prepare. If you love cooking and do a lot of it, quality items are worth the investment.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4idnk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9hua1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3vr0d","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_538fa969b890409eb3c28cdaf13655db~mv2_d_2221_1483_s_2.jpg"},"width":2221,"height":1483},"altText":"Sourdough Molasses Hazelnut Bread Proofing"}},{"type":"PARAGRAPH","id":"389if","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hazelnut Molasses Sourdough Bread Proofing","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"2mfka","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"50fu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After covering the bread for it's second proofing I start my oven heating with my dutch ovens inside. One for each loaf of bread. I used a large oval shaped dutch oven for the football loaf and a smaller round one for the little round loaf this time.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eaq6f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3cfqr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the dutch oven(s) inside of your kitchen oven and turn the temperature up to 450 degrees for this bread. After placing the bread in the oven later, turn it down to 425 degrees to bake for 30-40 minutes","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3l5ns","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52je7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6nbvm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6n41c","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1344a734066048df826215430b930841~mv2_d_4032_2690_s_4_2.jpg"},"width":4032,"height":2690},"altText":"Sourdough Molasses Hazelnut Bread after proofing"}},{"type":"PARAGRAPH","id":"bo7h9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"85rmk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hazelnut Molasses Sourdough Bread After Proofing","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"3ods9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"delcj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"7rlng","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"25i5j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7s13","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is the part I love! This is where I get to be creative and hopefully create something beautiful as well as tasty.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f54aj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9r8ie","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"First, take the dutch oven(s) out and set them on top of the range very carefully using big oven mitts. They are obviously VERY hot.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1svqa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"daqe5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place a piece of parchment paper on the cutting board and sprinkle it with polenta or semolina flour. Roll the loaf you are baking out of its banneton onto the parchment paper then score it using a very sharp straight edged blade or knife making several slashes quite deep and quickly into the bread. For this oval I thought I'd dress it up with what I thought looked like the laces of a football since we were headed for the game soon.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dphoh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1aiac","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For a more complete description and great pictures of the baking process using a dutch oven click on the dutch oven category at the top of this post for more bread recipes or check out my recipe for ","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rosemary Garlic Sourdough Bread. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/05/31/Rosemary-Garlic-Sourdough-Bread","target":"SELF"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9jdo6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6e9nv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fnris","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a2199ab6afeb41619ac422a161209b38~mv2_d_3751_2509_s_4_2.jpg"},"width":3751,"height":2509},"altText":"Hazelnut Molasses Sourdough Bread"}},{"type":"PARAGRAPH","id":"fkjle","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6jcfk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After scoring the bread, remove the lid of the dutch oven you will be baking in with an oven mitt and set it aside someplace secure. Now lift up the bread with parchment paper and placed it directly into the dutch oven, paper and all, replace the lid and put it into the oven. Now turn the temperature of the oven down from 450 degrees to 425 degrees.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e40um","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b1bja","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bjs7b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dr1v3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9qupn","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_01164f72a49b4556bc1d9b0a3638a0cc~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Hazelnut Molasses Sourdough Bread"}},{"type":"PARAGRAPH","id":"d7qob","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5h5l0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next I repeated the process with the small round loaf making a simple cross of the loaf and placing it it the smaller dutch oven then into the main oven. Using the dutch ovens inside your large oven helps to simulate a real bakery oven with it's steam injection and strong even heat and it will give you a beautiful crust!","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1871j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8biq1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"962b2","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_afbb393b658943dc904a0892c8a7324b~mv2_d_3703_2476_s_4_2.jpg"},"width":3703,"height":2476},"altText":"Sourdough Molasses Hazelnut Bread"}},{"type":"PARAGRAPH","id":"56gcs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" What do you think? Football bread? This made terrific hearty morning toast! The dinner loaf was fabulous with just butter after had cooled completely. There are so many crunchy good things in this loaf and the touch of molasses gave it a wonderful sweetness and added color. It's a great bread for the autumn and winter seasons I hope you will try.","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8s21e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5o63p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Happy Baking!","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"frfq4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[{"type":"COLOR","colorData":{"foreground":"#666666"}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bsg3m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"4280g","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"6ik35","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"j5kg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cjuep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hazelnut Molasses Sourdough Bread","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ds4bq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f5p13","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f1cjv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 cups all-purpose flour","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 whole wheat flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4s81g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 bread flour","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp active dry yeast ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp salt","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 Tbsp Molasses","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tablespoons Honey","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2pekl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons butter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4etog","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 tablespoons flax seeds","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ca7jl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 tablespoons Millet","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"12k1f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons roasted unsalted sunflower seeds ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"62apd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup coarsely chopped hazelnuts ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bonij","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3/4 cup sourdough starter","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 to 1 1/4 cup warm water ( about 110 degrees)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ab5n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"(start with 1 cup and add a tablespoon at a time until the dough comes together)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5c501","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bmho","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Olive Oil","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6unpc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cornmeal or Semolina Flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"pm7s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3hb42","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ffrap","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ogh2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6g6ks","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f0s9u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9afd0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Add the flours, butter, salt and yeast to a stand mixer ( I don't sift) and mix on low speed with the hook attachment to somewhat combine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52j28","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cgj9u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Add the molasses, honey and sourdough starter all at once and mix again on low speed to somewhat combine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"hvnt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7o04n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Begin to drizzle in the liquid very slowly with the machine running on low speed until you have used a little more than 1 cup.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b827v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bg53s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4. Allow the machine to continue to work the dough until it begins to pull away from the sides of the mixer adding more liquid tablespoon by tablespoon if it seems too dry. If you go too fast and the dough gets too wet add more bread flour a few tablespoons at a time. The dough should become just slightly sticky and be very soft in about 5 minutes. Let the machine knead a few minutes after it comes together maybe 7-8 minutes total. The dough should be just tacky now and still very soft.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9bos5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"71cfc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"5. Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dguta","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4es9h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6. Gather the dough into a ball and place it in a large bowl that has a tablespoon of oil in it and roll it around so it's lightly covered with the oil.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aq19c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bcdvs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"7. Cover the bowl with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4gvkk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dua2i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8. When your bread has risen until you can still see your fingerprint when you poke it gently and it doesn't immediately spring back then it's time to form your loaf!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4f4ml","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3b9r7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" 9. Roll it back out onto a floured board and degassed the dough by folding it over on itself 3-4 times, then started rolling it up like a newspaper fairly tightly. You want to get some decent surface tension going on the outside of the loaf you are forming.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"68dh8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6kb44","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10. I put it in a floured proofing basket called a banneton to do its second rise. Cover it with the cover that often comes with your banneton or very loosely with plastic wrap that you've sprayed with oil.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9jo6d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"47q0d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tip - You can make a proofing basket out of a bread basket or pan lined with towels but it's not nearly as convenient if you make bread regularly.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"39ugd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eerg5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"11. Put a cast iron dutch oven in your oven and begin heating it to 450 degrees for at least 30 minutes. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"81n3s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bp0jp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"12. After 30 minutes, very carefully remove the preheated dutch oven to your stove top leaving the lid on.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8gfu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"obar","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Roll your loaf out of the basket and onto a piece of super handy parchment paper sprinkled with polenta or semolina flour and score as shown above or in the pattern of your choice.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ggj4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cds65","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"14. Remove the lid from the dutch oven with an oven mitt and gently transfer your loaf by lifting the parchment paper and setting the whole thing in the pot paper and all. Replace the lid using an oven mitt and put the whole dutch oven back into your oven. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"18uuj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"difv2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"15. Turn down the temperature on the oven to 425 at this point and bake for 30 minutes. If you would like a darker crust you may want to keep it on a higher temperature but it should be done within 40 minutes. Bread is done when it sounds hollow when tapped on the bottom.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"40ikf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b082s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Please let this cool at least an hour before slicing. It will make all the difference in the texture of this bread. If placed in a plastic bag after completely cooled the crust will soften and become more chewy.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"54sh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"br5iq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"