type":"PARAGRAPH","id":"4bkqf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/3 cup soft butter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8rmp7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 Tbsp Honey","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a060m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 cloves minced garlic","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a6tlv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 Tbsp Worcestershire Sauce","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cond9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tsp dried thyme","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"62qk4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 tsp black pepper coarsely ground","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3dpef","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 tsp kosher salt","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ckfg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tbsp English style mustard optional","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ee889","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"pr9l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ",