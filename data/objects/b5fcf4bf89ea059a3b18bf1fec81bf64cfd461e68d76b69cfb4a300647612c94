ions":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b7s8l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This building is old folks! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bls1d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"76r65","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The site was originally a boarding school and orphanage for boys who had lost their parents to Yellow Fever, opening its doors in 1792. The fires that consumed much of New Orleans in 1774 also laid rest to the boarding school with five young boys inside. After the fire, a U.S. Federal Courthouse was almost immediately built and remained there until before the turn of the 20th Century, where General Andrew Jackson, who later became the seventh U.S. president, was held in contempt of court and charged with obstruction of justice. The courthouse was demolished and the current building was erected in 1890.","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3gads","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4rgfj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This information comes from The Hotel Website. You can ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"click here","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.andrewjacksonhotel.com/about/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" to see more about it's history.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"39bhe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bbi3i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A resident hotel kitty","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"fsk7l","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_777b1a5b0ce44668b0752f40cc529138~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"e7ois","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b6koj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a1vpl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is the back of the hotel, a beautiful well shaded courtyard where kitty lives. A beautiful place to hang out day or night. It makes a wonderful gathering place for groups if you happen to be part of one.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bgfnt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3u2sc","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4aec1414a01a45c28cd84ebd2443ab55~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"3sp1l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1jh05","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d6kch","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The scroll of history under the pillow is neat souvenir!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6hseh","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_87fb81c83f414ceda4acae5ab0879853~mv2.jpg"},"width":1125,"height":1500},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"g6ul","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fvr03","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Our room was clean and we never had a problem with water pressure or temperature and we were on the 2 floor.  Rooms are small but very well appointed. The bathrooms have been fairly recently updated and are quite nice. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"576ov","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"37lbl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We new what we were getting into as far as old building go and yes there are gaps in the doors and some missing paint outside. The walkways around the upper floor are very narrow and everything seems small. That's the way things were built back then and this is an historic building. Well cared for really, but well used as well.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9igro","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1qvvm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you are not into small historic buildings this might not be the hotel for you. If you are, then you will be charmed off your feet!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f518k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"100te","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_120c6ef5a7b646e9a0fac2af27c3727f~mv2.jpg"},"width":1125,"height":1500},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"741i5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Inside the cabinet under the television is a mini fridge and microwave.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c2a4p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"brfbr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1lcvb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ce2jo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5b73b","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_66bb7ee6ce3f4d6193690f8628cf4fcc~mv2.jpg"},"width":1500,"height":1125},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"aed3n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The small door at the far end to the right takes you back into the Hotel Lobby.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9j2cl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"71srs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"edq2u","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b91c44210a674510bd5c1d43598bea6e~mv2.jpg"},"width":1500,"height":1125},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"468j8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7vvad","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The staff is very attentive for the most part. Only a few items forgotten by housekeeping that were remedied immediately by the front desk. The Desk and Valet staff were wonderful about having our car ready both days we needed it. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5k3o7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1fbfa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The location couldn't be better for us, It's away from the noise of Bourbon street and very central for walking to shopping, Jackson Square and the French Market. Cafe Amelie is a fantastic restaurant right across the street. Be sure to make reservations there.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b1vuh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8gpml","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dr01s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cafe Amelie","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"8535j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f8b4fad1342b4e3791e247f2cb6d436d~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"ejpv9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}]