"PARAGRAPH","id":"3pvev","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We were hoping to hear or see some of the resident ghosts but unfortunately they were quiet when we visited.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9uhoh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"b01gq","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_7f7d5186d1794d799bb1e9c01eebb336~mv2.jpg"},"width":1125,"height":1500},"altText":"Andrew Jackson Hotel, New Orleans room 204"}},{"type":"PARAGRAPH","id":"5nlt4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Rooms 204 and 208 are said to be the most haunted rooms in the Hotel.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"crfqe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3584t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6a7n7","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_066eb209243a4a99b7a78df3732455cf~mv2.jpg"},"width":1125,"height":1500},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"2k1kk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" The boys are usually heard playing and laughing in this courtyard late at night.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6c3iq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8n205","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"20no5","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d144296c8496456eab4852c9f6c87111~mv2.jpg"},"width":1125,"height":1500},"altText":"Andrew Jackson Hotel, New Orleans"}},{"type":"PARAGRAPH","id":"2cna9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Directly across from our room was a room labeled as 208. I was surprised to turn around and see that the room next to ours had also once been labeled as 208. The numbers have been removed but through the old layers of paint the numbers are still plainly visible. No new numbers have been placed on the door. I wonder if they use that room any more. No one seemed to be there during our stay.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"79nrk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ducpl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6o9p7","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5b6d17dc8a9b4e8689f98311c8d1caee~mv2.jpg"},"width":1125,"height":1500},"altText":"Andrew Jackson Hotel, New Orleans room 208?"}},{"type":"PARAGRAPH","id":"fdc3s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Other ghost st