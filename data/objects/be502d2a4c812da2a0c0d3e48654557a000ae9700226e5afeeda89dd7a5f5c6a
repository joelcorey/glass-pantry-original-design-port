{"postPage":{"id":"bf26d034-69c0-4f10-b1a6-ff00dea8d851","post":{"id":"bf26d034-69c0-4f10-b1a6-ff00dea8d851","title":"Cranberry Sourdough Bread","excerpt":"Cranberry Sourdough Bread This savory sourdough bread is studded with tangy sweet dried cranberries that re-hydrate during the rising and...","firstPublishedDate":"2018-02-22T16:15:17.425Z","lastPublishedDate":"2018-02-22T16:15:17.425Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2018/02/20/cranberry-sourdough-bread"},"slug":"2018/02/20/cranberry-sourdough-bread","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","a3a5dcbf-0099-4cce-9147-27c56bc3988e","e444dbd4-a3f2-41ca-b0ae-85bd13111cd6","173f5020-85a4-4dfd-9e92-e3ed6303db2b"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":944},"minutesToRead":6,"tagIds":["96d3a9c9-5cd1-41e5-a62f-127b10a658af","a8607f29-92d6-4757-9ffe-bd2c473061f2"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":944,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Cranberry Sourdough Bread","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Cranberry Sourdough bread | Sourdough Bread | Rustic Sourdough Bread"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"9rqcb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cranberry ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"5b099","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sourdough Bread","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"a0bdd","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4e24fd238a284a35917f45046cb7928f~mv2.jpg"},"width":1500,"height":1125},"altText":"Cranberry Sourdough Bread"}},{"type":"PARAGRAPH","id":"ekorq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"15oam","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This savory sourdough bread is studded with tangy sweet dried cranberries that re-hydrate during the rising and baking process. It is amazing when warmed or toasted with a bit of butter. Cranberry sourdough bread is truly a versatile bread that I like to serve with dinner or breakfast. I'm sure it's going to make fantastic grilled cheese sandwiches one day at my house. It would also be perfect for making crostini to serve with baked brie.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fsf18","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dcqna","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4u4o8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1c7tg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Putting the dough together is simple in a stand mixer. Add all of the dry ingredients except the dried cranberries and seeds to the mixing bowl then run the mixer with the dough hook attachment just to get them mixed. Then add the sourdough all at once and begin to mix them together. As this starts to combine, start drizzling in the warm water until you have used about 1 cup. If the dough seems too dry, add water one tablespoon at a time until the dough comes together and then let the mixer continue to run for 7-8 minutes to knead the dough and get the gluten working. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9i2vm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9du0k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I've used images in this blog from two different loaves of the same recipe.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fp8n9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"88om5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"ejven","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_0fa14fdbbb87491c936ec7a81d84ed55~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Mix dry Ingredients briefly"},{"image":{"media":{"src":{"url":"577c92_5eef15b19b2342938fe77e08435e803f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Bubbly sourdough starter!"},{"image":{"media":{"src":{"url":"577c92_d822c7a2ab09448a900a30540d9ff38e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Start the mixer running on low"},{"image":{"media":{"src":{"url":"577c92_6edac06101c14c6790cf65cdd90f598d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_9eda26b345d441bdbd0e7e0806e3dc2c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_f8fcdcd040644920a028d2127a7afa4b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Nearly done"},{"image":{"media":{"src":{"url":"577c92_bd62a03533174762a19cc00e4509b5f1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_61c07c12687f4b37a1c423b734c5c50d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_54f5913c908a4bceb14abcf5133fc5bf~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Knead the dough briefly"},{"image":{"media":{"src":{"url":"577c92_a7ad0dc4fb2c469388ed75ad7a205a4c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Fold and turn"},{"image":{"media":{"src":{"url":"577c92_74a87c1a237c4923bb818ccc1356e2cb~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Fold and turn"},{"image":{"media":{"src":{"url":"577c92_a5a98994bc004d27846990d681ce0da1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"fold and turn"},{"image":{"media":{"src":{"url":"577c92_ad439bd61e8544cdae4dc160337a58e7~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Shape into a ball"},{"image":{"media":{"src":{"url":"577c92_e49b86f7ee56402daff07469b24e103c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cover with plastic wrap"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"6cdd3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tp0m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9jruu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8r7o0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other. Gather the dough into a ball and place it in a large bowl that has a tablespoon of oil in it and roll it around so it's lightly covered with the oil. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8k37f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6m0fk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Cover the bowl with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f1lvh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"btmcr","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e49b86f7ee56402daff07469b24e103c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Cover with plastic wrap"}},{"type":"PARAGRAPH","id":"3jo8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fjhn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f6evv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After an hour or so the bread should double in size and be ready to form into loaves for the second rise. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"algq2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1o2ha","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Turn the dough out onto the floured board and with floured hands pat it out into a disc and top it with the dried cranberries and seeds. Stretch and fold the dough over itself then turn the dough and stretch and fold again. Repeat until all of the cranberries have been incorporated into the dough then roll the bread into a ball creating surface tension as you roll until you have created a round shape. Place the dough onto a floured banneton or a bowl that you have lined with a towel and floured well.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1i57m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"86lf8","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_204b52a814d444d7853234e09ff05d15~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Flatten the dough into a disk"},{"image":{"media":{"src":{"url":"577c92_5d24aaf529984f4cab634ea88b2296e5~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Top the dough"},{"image":{"media":{"src":{"url":"577c92_ad95717c12744edcaa96f0a2adad625d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Start folding"},{"image":{"media":{"src":{"url":"577c92_604e783750bf4902ade8641a67ba61d0~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"fold again"},{"image":{"media":{"src":{"url":"577c92_0cbe9607f1cf4b3081d41a66af97eec7~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"fold again"},{"image":{"media":{"src":{"url":"577c92_294b5bad55d440aea6165a80a47339f1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Prepare the banneton"},{"image":{"media":{"src":{"url":"577c92_a9cc949ecd2d4e4290aa8599357a7173~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"now form a ball"},{"image":{"media":{"src":{"url":"577c92_cfd490ffffab47cea8fcd953aa9c9230~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"cover the dough"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"4rvcb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"elfoa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ehmd6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5vvek","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After covering the bread with a light dry towel or banneton cover, for it's second proofing I start my oven heating with a large round Dutch oven inside. This takes about 45 minutes to one hour.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"devpm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"agbqp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the Dutch oven inside of your kitchen oven and turn the temperature up to 450 degrees. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"11l5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2755r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next comes the part I love! This is where I get to be creative and hopefully create something beautiful as well as tasty.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3dhmj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6lmq6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"1cdma","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_4267c21aa9904a26a1c00b795ed2ca12~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cranberry Sourdough Bread"},{"image":{"media":{"src":{"url":"577c92_acb6154f84914b0e931efe084cdd0f59~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cranberry Sourdough Bread"},{"image":{"media":{"src":{"url":"577c92_f5dee3fe41864350bf4bba9099672053~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20171230_152102"},{"image":{"media":{"src":{"url":"577c92_dd57043651064cd290f3a258c67b9d10~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_3d2e665d4c314c85922956134ac1338e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_a87976761d064a16acd97b4734723fe2~mv2.jpg"},"width":1500,"height":1125}},"title":"Cranberry Sourdough Bread"},{"image":{"media":{"src":{"url":"577c92_5f17ca86674e43e7ab41a4faef22b53b~mv2.jpg"},"width":1500,"height":1125}},"title":"Cranberry Sourdough bread"},{"image":{"media":{"src":{"url":"577c92_94d2b199ae3342728c4f04441e0b70fd~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Cranberry Sourdough bread"},{"image":{"media":{"src":{"url":"577c92_fdf3da0123544627be1496acd2e93e2a~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Cranberry Sourdough bread"},{"image":{"media":{"src":{"url":"577c92_71e05bebbc774ce79c26974dab4b2dd3~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cranberry Sourdough bread"},{"image":{"media":{"src":{"url":"577c92_5c97aa01ef56487aa4740dde98a27e41~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cranberry Sourdough bread"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"7ff76","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bdcir","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7nj81","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the loaf has risen for the second time, take the Dutch oven out of the preheated oven and set it on top of the range very carefully using big oven mitts. It is obviously VERY hot.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6h22p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"373o2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place a piece of parchment paper on a bread board and sprinkle it with polenta or semolina flour. Gently roll the loaf you are baking out of its banneton onto the parchment paper then score it using a very sharp straight edged blade or knife making three slashes quite deep and quickly into the bread. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e5kq1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9urue","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For a more descriptions and great pictures of the baking process using a Dutch oven click on the Dutch oven category at the top of this post for more bread recipes or check out my recipe for ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rosemary Garlic Sourdough Bread. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/05/31/Rosemary-Garlic-Sourdough-Bread","target":"SELF"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b3vqv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2fs1u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After scoring the bread with three long deep slashes, remove the lid of the Dutch with an oven mitt and set it aside someplace secure. Now lift up the bread using the parchment paper and placed it directly into the Dutch oven, paper and all, replace the lid and put it into the oven. Now turn the temperature of the oven down from 450 degrees to 425 degrees and bake for 45 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ct8sq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4c0n5","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b1ea7e52f016463c90d90a6b8948b01a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Cranberry Sourdough Bread"}},{"type":"PARAGRAPH","id":"3sd1s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Happy Bread Baking!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e5n07","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f2n8i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"epmi1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"7guio","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"d2i4u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cranberry ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"a41fi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sourdough Bread","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2p3g2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1unjp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5aab8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8l6td","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 1/2 cups All Purpose Flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5hp91","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3/4 cup bread flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"akblq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon active dry yeast","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5o9ed","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp fine sea salt","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"duj5a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup sourdough starter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"65jap","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup very warm water or whey (100-110 degrees)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"60fsd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 cup dried cranberries","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a259t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup tablespoons pumpkin seeds","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"50plf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tablespoons flax seeds","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"etdsq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tablespoons millet seeds","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"32b65","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1jiqf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"63pqu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method   ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8on7t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"39p5r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" (40 minutes active     2 1/2 to 3 hours total)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"o2nh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2r2t6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Add dry ingredients to a stand mixer ( I don't sift) and mix on low speed with the hook attachment to somewhat combine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ioma","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6f80u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Add sourdough starter all at once and mix again on low speed to somewhat combine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4aj6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ck65","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Begin to drizzle in the liquid very slowly with the machine running on low speed until you have used about 1 cup.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ou9i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dnng","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4. Allow the machine to continue to work the dough until it begins to pull away from the sides of the mixer adding more liquid tablespoon by tablespoon if it seems too dry. If you go too fast and the dough gets too wet add more bread flour a few tablespoons at a time. The dough should become just slightly sticky and be very soft in about 5 minutes. Let the machine knead a few minutes after it comes together about 7-8 minutes total. The dough should be very soft and not too sticky.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c1nsu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"du4aa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"5.  Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e8pdh","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4p9jo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6. Gather the dough into a ball and place it in a large bowl that has a teaspoon of oil in it and roll it around so it's lightly covered with the oil. I use grape seed oil but any good oil will do.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3aki8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2t4cg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"7. Cover the bowl loosely with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"63kjo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"55h2g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8. When your bread has risen until you can still see your fingerprint when you poke it gently and it doesn't immediately spring back then it's time to form your loaf!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e9hgt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5c3md","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"9. Turn the dough out onto a floured board with a spatula and with floured hands pat it out into a disc then top it with the dried cranberries and seeds.  Stretch and fold the dough over itself then turn the dough and stretch and fold again. Repeat until all of the cranberries have been incorporated into the dough then roll the bread into a ball creating surface tension as you roll until you have created a round shape. Place the dough onto a floured banneton or a bowl that you have lined with a towel and floured well. I cover this with a cotton kitchen towel or banneton cover and set it back in my warm rising space on top of my stove with the range hood lights on for a little extra warmth.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"efu70","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"19tlh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10. Put a cast iron Dutch oven in your oven and begin heating it to 450 degrees for at least 30 minutes. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"39gsb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6fg48","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"11. After 40 to 60 minutes the dough should have nearly doubled in size so prep for scoring by putting a piece of pop-up parchment paper on a bread board and sprinkle it with cornmeal, polenta grits or semolina flour.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"94hj7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cncrm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"12. Very carefully remove the preheated Dutch oven to your stove top leaving the lid on.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e41dj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2gejg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Gently roll/flip the formed loaf out of the proofing basket onto the parchment paper sprinkled with cornmeal and then quickly score the loaf with a razor blade making three 1/2 inch deep slashes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"sqav","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"birj7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"14. Remove the lid from the Dutch oven with an oven mitt and gently transfer your loaf by lifting the parchment paper and setting the whole thing in the pot paper and all. Replace the lid using an oven mitt and put the whole Dutch oven back into your oven. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1btab","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8kdjc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"15. Turn down the temperature on the oven to 425 degrees at this point and set a timer for 45 minutes. If you would like a darker crust you may want to keep it on a higher temperature but it should be done within 40-45 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5sit9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cal3k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bread is done when it sounds hollow when tapped on the bottom. Let cool completely or at least an hour before slicing. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6nl23","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e3em6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"See the slideshow above for more tips on baking this bread.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3lrdh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"275pd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-03T14:41:54.705Z","updatedTimestamp":"2024-06-03T14:41:54.705Z","id":"e24e7eee-fb98-4333-ab85-f3ec92eeddf0"}},"contentId":"61535cd22bccae00166033c7","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_4e24fd238a284a35917f45046cb7928f~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_4e24fd238a284a35917f45046cb7928f~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f676986f497bd0017daaece","internalCategoryIds":["5f67697cf4b037001706012d","5f67697cf4b0370017060123","5f67697cf4b037001706013e","5f67697cf4b037001706012b"],"internalRelatedPostIds":[],"isLiked":false,"isSubscribed":false,"owner":{"activityStatus":"UNKNOWN","contactId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","id":"2d3dcba5-39de-4c33-b11a-89d9248a0e