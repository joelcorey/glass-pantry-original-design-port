bled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"2auna","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rosemary Garlic","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"299q1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sourdough Bread","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8vgb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"btgpl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5c302dce8f62413f842ee0bf0dcf2caa~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Rosemary Garlic Sourdough Bread"}},{"type":"PARAGRAPH","id":"9kf58","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Beautiful soft rosemary and garlic scented  harvest bread. This bread makes your house smell wonderful! It's light in texture and color with a chewy crust.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4gg8s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"csnf2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I bake this loaf in a dutch oven at 400 degrees for 50 minutes instead the usual 450 degrees for 45 minutes so that it comes out a little bit lighter in color and less crusty. This is a loaf that loves to be dipped in a great dipping oil.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52iob","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6377c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"20uf2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"29q7i","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_345c64762e454c6a867095ee5fbff4b2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"7ndch","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rosemary Garlic Sourdough Bread ready for the oven.","decorations":[{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"82p37","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"1ukhb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"33me7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"a099j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b654d645d98741e982b95f06e53e9266~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032},"altText":"Dry ingredients added to stand mixer"}},{"type":"PARAGRAPH","id":"bqlvg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5257j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"First step, all of the dry ingredients go into your stand mixer. Just mix them up for a few seconds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7cu95","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ftfq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is a very simple recipe. I use Fleischmann's active dry yeast added directly to the mixer without first rehydrating and it adds just enough boost to my sourdough that I don't need to wait for an overnight rise and I can bake my bread the same day I start it. If you prefer not to use the active dry yeast your rise times will be much longer but you will be rewarded in flavor! I sadly, am not that patient. Most days I want to bake my bread and eat it too.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bg4pl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4lciu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ee0iu","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_eb4c55911fda41e3b616fabc55885190~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032},"altText":"Sourdough Starter"}},{"type":"PARAGRAPH","id":"6727e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is my sourdough starter bubbling away. Mmmmm... it smells delicious! Freshly fed in the morning, it's had a few hours to get all worked up and ready to ferment my next sourdough adventure.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cumam","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1lmku","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7fver","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ctfp8","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_323f250b8bde44cba3f322dcfd9524c9~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032},"altText":"Mixing the dough"}},{"type":"PARAGRAPH","id":"4f535","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The next step is to add the sourdough starter to the dry ingredients. Then start your mixer on low speed and slowly begin pouring in the warm water until the dough forms a ball and pulls away from the sides of the mixer. Continue to mix from 5 to 7 minutes until the dough is soft and elastic. If it's too wet, add more flour a few tablespoons at a time until the dough is just sticky.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dhvfm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4g80n","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_3594627620c448969752a754d300ebce~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Fully mixed dough"}},{"type":"PARAGRAPH","id":"emgo5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Now the dough is ready to set up for its first rise.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cu2vh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"38jum","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8pbum","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ahnt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Click on the images to see more...","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"7rb4s","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_328452769691454b805c92c88464e717~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Kneading the Dough"},{"image":{"media":{"src":{"url":"577c92_7933496116924336a3f09a1285b78920~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"First Fold"},{"image":{"media":{"src":{"url":"577c92_c468ebd49a0044d98a2d8502ec36b755~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Second Fold"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"appi0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"First scrape the dough out onto a floured board to knead a couple of times and then form the dough into a ball. Place the ball upside down in the bowl with a teaspoon of olive oil in it and then flip it over coating the ball of dough that is now right side up. Cover with plastic wrap to rise for 60-90 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6uc6t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"1erth","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_f09a005765da489cbaaa83b2234ae65d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Getting ready for the first rise."},{"image":{"media":{"src":{"url":"577c92_315f9c44ba7541d9acc7615422810e8e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Getting ready for the first rise."},{"image":{"media":{"src":{"url":"577c92_f8868e69da7e41689c8f0ca46d6e3828~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Fully proofed first rise."}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"5acbs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the dough has nearly doubled in size scrape it back out onto your floured board and knead a few more times as illustrated above and again form it into a ball. Work the ball until you have a nicely tight and smooth surface.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4q4cs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"b6g89","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_323d587c7b014c739460101c1b1150c1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Return the dough to a floured board."},{"image":{"media":{"src":{"url":"577c92_5bfcc6bdbc25429ab71de620e2820613~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Forming the Loaf"},{"image":{"media":{"src":{"url":"577c92_ee3e39844e3d46d38444f438f7aa9782~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Floured Banneton"},{"image":{"media":{"src":{"url":"577c92_5f7a56d202c640bf9348edb076498361~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Setting up for the last rise."}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"4icj1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the ball into a banneton or a bowl or basket lined with a thin cotton towel with the smooth side down.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3v9a8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bu83u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now is the time to put your dutch oven with the lid on into your oven and begin preheating it to 450 degrees F.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4mrpr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"51e2t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e7e4u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"25dfe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After about 60 minutes your dough should be nearly double in size. Carefully flip the dough out of the proofing basket and onto a sheet of parchment paper that you have sprinkled generously with cornmeal or semolina flour. I used Bob's Red Mill Polenta Grind for this bread.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"btaut","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"cl436","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_b973e7fa53db4f9597cf926a78d94e72~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Fully proofed and ready to score"},{"image":{"media":{"src":{"url":"577c92_76901df1a23b4128948438269ead5f5c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Proofed Formed Dough"},{"image":{"media":{"src":{"url":"577c92_345c64762e454c6a867095ee5fbff4b2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Scoring the Loaf"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"91tk7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Score (slash) your formed loaf deeply with a very sharp knife or blade in a pattern that you like and don't be afraid to get creative! When the loaf goes into the dutch oven the moisture in the dough will expand rapidly as steam and if the scores are not deep enough or plentiful enough the crust will split open at it's weakest points. Sometimes this can create a misshapen loaf. The great thing is it won't affect the flavor. It can affect the texture though so a better score will allow the dough to expand and help to give you a lighter bread with more beautiful holes and a softer internal texture.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"btsgt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ia0i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carefully take your preheated dutch oven out and remove the lid. Using the parchment paper, place the loaf, parchment paper and all, directly into the pot and replace the lid. Place the  dutch oven back into your oven and reduce the temperature to 400 degrees F for 50 minutes. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3kkc5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fisg9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Don't forget to use your oven mitts when handling this exceedingly hot dutch oven and it's lid.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aupni","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"aq1id","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b8c1a5eb4c414ad4b68a3bad68084489~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Formed Sourdough Bread in a Dutch Oven"}},{"type":"PARAGRAPH","id":"30vpo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Rosemary Garlic Sourdough in a preheated dutch oven before covering with the lid and placing in the oven.","decorations":[{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"4oe2f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"dejqf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"9v6g8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fmal5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In this photo you can see a place near the bottom of the loaf that has split open left to right in the oven where the scores I made vertically were not quite sufficient to allow for the rapid expansion caused by the steam escaping from the bread. To correct this I would say I would make deeper and longer slashes next time. In this case, it was a minor thing and since the bread split as it did, it didn't affect the texture. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"23dca","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_698967855449425da54da186b8dd896d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"9nt8a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Something about baking bread is definitely therapeutic and thoroughly satisfying. The aroma of the rosemary and the garlic filling the kitchen was heavenly while baking this bread. I hope you will give it a try in your home. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8jhr2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ah0qd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Happy Baking!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"908b3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"42krm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tgk5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"3e12o","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE"