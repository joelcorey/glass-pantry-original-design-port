jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_3131e0fe4aab4d47a922eaf3466cfaa5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_637dfb011ad24db4abac054b6507257d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_0570285ece5948dab5c5c8ad43894707~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_b359b26bffbe42a7b41ebde8c95dabbb~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_3115a6f6cc2941e7b074f7b6398e0859~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_a946621a4cf0464792923ade6cae0ab6~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_346cc62ab0d44856a8324bad7ca8ef92~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_a8bd4d37b69a48398498d7a7995cd71b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_d990d0eb2fd94214a2fcb89d31b5af1c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_5da50ef4b2884a16babec6df1f5b549a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"cd9qg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It was slow going at first as we kept trying to figure out how to keep from losing anyone out there. We were eating each other's dust so of course we didn't want to follow anyone too closely and some vehicles are just made to go faster than others. Also, all GPS are not created equal. So Mike and I and the two men in the Montero had an undisputed advantage. Our drivers had co-pilots! I could read the map and signal to Mike where to go while he drove the Buggy.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7gbaq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6erut","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Our little Bug is also pretty fast. It's geared so that it was difficult to go anywhere in 2nd but in 3rd we were almost flying! It was light and nimble up there in the mountains and soon we were in the lead! The Montero was a bit overloaded and slower but that's another story.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8q17p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b75bv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"30ehl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3lift","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I became one of the navigators and we would stop whenever there was a divide in the road. The next rider would pull up behind us and wait for the next rider and then they would point the way follow us and leave that rider to point the way for the next and so on. It was like playing tag across the mountain tops! Eventually the guys on the motorcycles found it easier to point several people through and wait so they could eat something. During the days on the trail we ate a lot of beef jerky and trail mix. Be forewarned, there are no restaurants on the backroads.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bv8ri","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dr2v8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tr1o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"a27p9","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_b86b6b51c0534bd3ad8c249ee69b8520~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_43b774bdb4b749489522bb5434b75fae~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_be0a1825417940da91ca4296ed39d064~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_100f56766d7a4fcbbe7a674a470f144b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_09d08f5460074efe9764b4d610b1c85b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_3e0706c992444c0898f3d639ef5b0e67~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_a264d9ddc57042dbbf2c5777a4245d53~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Conconully General Store"},{"image":{"media":{"src":{"url":"577c92_d1889c6f88eb4a719a768d49b732a896~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height"