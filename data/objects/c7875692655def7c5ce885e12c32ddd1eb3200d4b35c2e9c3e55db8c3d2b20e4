4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_c1f5e08414b54c52835c59ce3ca6124f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_b2d3e20944ac404991df9f294621b497~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"First snow sighting"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"aac4s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6r9u1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"As we came close to Lake Takhlakh we began to see just a bit of snow along the road. Then, almost immediately, it became a lot of snow. Very soft wet snow that wasn't too deep right at first but quickly became several inches if not feet deep around the next bend. At least 2 of our 3 vehicles probably couldn't make it as we were equipped so we would have to find a work around.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ekkh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"djh0p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1kkeh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8i06i","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_32c2511676cb4ef2b1a160dd143fa596~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"WABDR 2018"}},{"type":"PARAGRAPH","id":"5jmch","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"nm6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5bc10","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"a7cpb","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_bde764513e8a4b149d062e38ee9de376~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"End of the road"},{"image":{"media":{"src":{"url":"577c92_f23a97f3126345d8be7b854f5eb40bf2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"."},{"image":{"media":{"src":{"url":"577c92_3c31ccb1efb34696b0cb4db6fc5bc07f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Tanner"},{"image":{"media":{"src":{"url":"577c92_c022a2cf933446e6a8a75c47700d395b~mv2.jpg"},"width":1500,"height":1125}},"title":"Deep snow"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"6pkb9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It was a beautiful spot to stop and take some pictures. Mark and Mike towed the Buggy back to solid footing and the dogs had a ball in the snow.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"elsiu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"51j95","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5sh80","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2c2id","nodes":[],"imageData":{"containerData":{"width":{"size":"SMALL"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e25f0ab9e041420d9c2714d618ca2639~mv2.jpg"},"width":1125,"height":1500},"altText":"WABDR 2018"}},{"type":"PARAGRAPH","id":"9smf9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"7midd","nodes":[],"imageData":{"containerData":{"width":{"size":"SMALL"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_165cbd87cbc54221811ae5e20da9ca3d~mv2.jpg"},"width":1500,"height":1125},"altText":"WABDR 2018"}},{"type":"PARAGRAPH","id":"qfnp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Such beautiful country!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"bhnth","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6o6qh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"f24r8","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_b00b6446b8d3438a9f7bbb8101a2cfe5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Tadpoles, Horseshoe Lake"},{"image":{"media":{"src":{"url":"577c92_a69ae186fe0d45acb42337a7764b90ec~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Horseshoe Lake"},{"image":{"media":{"src":{"url":"577c92_093fd51439b04e7897e75f317a56340a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Horseshoe Lake"},{"image":{"media":{"src":{"url":"577c92_4f9a5ed8a3cd48b0872ea2597b2ee166~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Horseshoe Lake Campground"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"2681b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" We backtracked to Horseshoe Lake Campground to take a look and plan our next steps. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b5tao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b4230","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We didn't want to go too far off the WABDR and we wanted to get to the other side of Lake Takhlakh on the same road where we had to turn back. Mark and Joe had been up the other side just a few days before and they were hopping the snow had melted enough for us to get through.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c8n8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3buuj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mike and I had seen a sign for Randle, WA on NF #5603 just a short way back so we decided to take that road, NF 5603 North to NF 56 where we turned west then crossed the Cispus River just before turning west again onto NF 21 We continued on to NF 23 where we turned south taking us to the other side of Lake Takhlakh at NF 2329.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4gdli","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6n2oo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We had continued on NF 21 West until we turned South on NF 23 although we know now the snow was melted on NF 5601. That would have made our work around shorter but the guys had been there only a few days before and it had been impassable. It's incredible how much snow can melt in just a few days! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5io48","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5dpa2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"With that said, we've only been home a few days and there is probably more snow falling around 4500 feet today and possibly for the next few days.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1o2tu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1pb8