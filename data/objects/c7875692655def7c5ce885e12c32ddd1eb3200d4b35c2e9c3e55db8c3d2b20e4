ingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"betau","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c7a0a507a92344679a436f13b02c3b64~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"WABDR Part 3"}},{"type":"PARAGRAPH","id":"4dn1q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"65msd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you've been following along on our Backcountry Discovery trip you will know that we needed to complete a re-do because of a breakdown on notorious Bethel Ridge last August. If you haven't been following along, I hope you will take a look back at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Part 1","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/09/01/Washington-Backroads-Discovery-Route-Part-One","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" and ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Part 2","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/09/28/Washington-Backcountry-Discovery-Route-Part-Two","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" of our 3 blog journey through the breathtaking wilderness of the WABDR.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4afqc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4nnnu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We were a little concerned about how cold it might be to go this early in the spring, but we boldly made hotel reservations that we could cancel, just in case it became a week of really bad weather. It turned out to be glorious! So off we went in our little bug to meet up with our friends in Ellensburg, WA.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"325s2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b8s0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you know something about the WABDR and this sounds backwards to you, it's not because we're directionally challenged, it's because we have been doing the WABDR from Canada to Stevenson on purpose. We just happen to live in the Columbia River Gorge and we wanted to be home when we finished the backcountry roads instead of having to drive all the way home from Canada afterwards. We decided to run the roads backwards.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dhtpu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"dr9h9","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_694a55d621dd447daf072135a0380ae2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Leaving for Ellensburg"},{"image":{"media":{"src":{"url":"577c92_6fbd8f52761d42029acc30230febd24e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Maryhill"},{"image":{"media":{"src":{"url":"577c92_aea1d454ebb740a899be3ba10341592e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Maryhill Windmills"},{"image":{"media":{"src":{"url":"577c92_3653efad955a4aa986e6a95398c14568~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Bob's Burgers and Brew, Yakima WA"},{"image":{"media":{"src":{"url":"577c92_43ef27d13c9f4ed1880263a33e7d36b5~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Yakima River Canyon"},{"image":{"media":{"src":{"url":"577c92_d821d4b6129f4923bab5791518b224fb~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Yakima River Canyon"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"fjj24","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f4511","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Our first stop was in Yakima WA for a bite to eat. We stopped at Bob's Burger's and Brew because it had good reviews, it was near the freeway and it had a nice parking lot where we could keep an eye on our rig while we ate. The Buggy was full of things and all open so we really wanted safe parking and visibility.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4qe9k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"7qd8f","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_3653efad955a4aa986e6a95398c14568~mv2_d_4032_3024_s_4_2.jpg"},"wid