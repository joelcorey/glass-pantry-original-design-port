textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6dqi","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_381133bc5b69446f9396c831a6b05a55~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"dt34v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I had a rice cooker once. It was supposed to make the cooking and cleanup of rice easier. I was sadly disappointed. It is easier than you think to make rice in a pot and a pot has far fewer parts to clean than a rice cooker. Plus I don't have to store an extra gadget in my kitchen. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9qmui","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"10fse","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"There are many different kinds of rice so it's good to get to know the kind of rice you are using. The differences in cooking white, brown and wild rice can be astounding! That said, most white rices cook very similarly. Here is my method for cooking white rice. Specifically Jasmine Rice because that's definitely our favorite white rice.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d3bqs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2o0k5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ntn9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place 3 cups of hot water in a 2 quart pot. Then add 1 1/2 cups rice. For most white rice, a ratio of 2 parts water to 1 part rice will be just about right. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c1h9p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"92gd9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Some recipes call for rinsing the rice but if you've ever read the back of most rice packages they don't usually suggest this step. Neither do I. I've tried it several times and the rice always becomes too sticky. I like to bring the rice quickly to a high simmer (not quite boiling) by starting with hot water. Don't let it sit in the water too long before boiling it or it will be sticky.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4kp6v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ggv0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"752sn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1utuu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bring the rice to a very high simmer (not quite a boil) and hold it there 1 minute.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fvi3r","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ab55ee1bfe044cc2a0d906df8b95b90f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"btahr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"ch0dm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Reduce the heat on the burner to low and cover the pot with a tight fitting lid.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"eb9lk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"97d8j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c0bb38dbe99f405da653162c755d5b2b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"e1md5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Let the pot simmer for 15 minutes then give it a peek. If it looks nearly done then fluff it with a fork and test a bite. Is it nearly done? Put the lid back on and turn off the heat. Let the rice rest 10 minutes or until you are ready to serve.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7og0t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cn51v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9r89h","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image"