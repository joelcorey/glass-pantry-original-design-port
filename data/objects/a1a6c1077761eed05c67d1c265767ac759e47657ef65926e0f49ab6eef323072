"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Once you have brought a vibrant bubbly sourdough starter to life you will need to give it a little love and care to keep it happy and healthy. Not to worry! This is a very simple thing to do. Even Goldminer&#39;s and Sheepherders had time for this and they were seriously hard working people back in the day as I&#39;ve been told.</span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kfctz36p1":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:22px;\"><span style=\"font-size:22px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Storing your Sourdough Starter:</span></span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Storage Method #1 - Counter Top Method:</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">If you keep your starter on the counter top, as I&nbsp;often&nbsp;do, a&nbsp;few minutes a day is all you need . If you don&#39;t have the time for baking with it, you also have 3 other options for storage so this just gets easier and easier!</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kfctz36r1":{"crop":{"x":0,"y":72,"width":4032,"height":2881},"alt":"Care and Keeping of Sourdough Starter","width":4032,"height":3024,"uri":"577c92_c14911ca31c64263b0b4166b44815093~mv2.jpg","name":"20200801_095233.jpg","containerId":"comp-kfctz36r1","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/577c92_c14911ca31c64263b0b4166b44815093~mv2.jpg/v1/crop/x_0,y_72,w_4032,h_2881/fill/w_599,h_428,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200801_095233.jpg","srcset":"https://static.wixstatic.com/media/577c92_c14911ca31c64263b0b4166b44815093~mv2.jpg/v1/crop/x_0,y_72,w_4032,h_2881/fill/w_599,h_428,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200801_095233.jpg 1x, https://static.wixstatic.com/media/577c92_c14911ca31c64263b0b4166b44815093~mv2.jpg/v1/crop/x_0,y_72,w_4032,h_2881/fill/w_1198,h_856,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200801_095233.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":599,"height":428,"objectFit":"cover"}}},"containerWidth":599,"containerHeight":428,"isInFirstFold":false,"onClickBehavior":"disabled","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-kfctz36r1","mainPageId":"qgy49","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-kfctz36t":{"uri":"577c92_c14911ca31c64263b0b4166b44815093~mv2.jpg","description":"Care and Keeping of Sourdough Starter","size":"small","color":"gray","counterPosition":"none","staticMediaUrl":"//static.wixstatic.com/media","urlFormat":"slash","exte