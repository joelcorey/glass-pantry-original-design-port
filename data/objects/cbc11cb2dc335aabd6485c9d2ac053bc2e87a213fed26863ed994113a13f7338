rations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eib2n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"clh53","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A Restaurant Review","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cfaao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"eqbv1","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4f9173a05d3f4d89ab266a334f82d701~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032},"altText":"SooRah Korean Cuisine, Korean Food in the Rogue Valley"}},{"type":"PARAGRAPH","id":"fh6g1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"esspr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bc1bd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"SooRah Korean Cuisine is a beautifully exotic, upscale restaurant in Medford OR, in the heart of the beautiful Rogue Valley. It's a very unique place in an area known more for it's many pizza, diner and farm to table establishments. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"58u7i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"crcfo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The restaurant is cozy, hip and stylish, decorated with dark woods and brick. SooRah is located in historic downtown across from the old Woolworth's Building where many of the buildings are being revitalized into great restaurants, wine bars and shopping. It's also within walking distance to some great live theater!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9s1a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ft63","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"As for our meal here, we thought it was absolutely delicious! It was presented with several banchan dishes as pictured above but portions were somewhat small if you love your kimchi. Fortunately, I was the one who really likes all of these small Korean pickled veggie dishes so I got to eat most of them. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9vfg4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6vcav","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My daughter and I really enjoyed a sweetened chili radish we'd never tried before. Due to a language barrier with our server I can't tell you exactly what it was marinated in but it was sooooo yummy! Our server was very happy to replenish any of the dishes so perhaps they've determined it's best to serve small portions until their guests discover which of the banchan they prefer. We got more of those little sweet spicy radishes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1v8fh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eorc0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4jqhl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fqf3m","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_10cc5dd136a54175bd7f8bf6c8ff75d2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Bibimbap, SooRah Korean Cuisine, Korean Food in the Rogue Valley"}},{"type":"PARAGRAPH","id":"bnad5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"72tqv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I had the bibimbap with chicken and yes, there was a lot of chicken and rice underneath all of those veggies and perfectly cooked fried egg. Just listen to the sizzling rice as it was brought to our table. It created the most wonderful crunchy caramelized rice bits!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6bmcj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"VIDEO","id":"8j1mb","nodes":[],"videoData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"video":{"src":{"url":"https://www.youtube.com/watch?v=Hu3BHlsIHJs"}},"thumbnail":{"src":{"url":"https://img.youtube.com/vi/Hu3BHlsIHJs/mqdefault.jpg"},"width":626,"height":352}}},{"type":"PARAGRAPH","id":"47cvv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dnojk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3kb39","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My daughter and son-in-law ordered soju cocktails and loved them! Soorah has a full bar and mixes lovely drinks. They also have several Asian beers, wines and sake.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"98agh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"10t9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"934c8","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4283beb317984ca4b2b36e14f1b4464f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Soju cocktail at SooRah Korean Cuisine in Medford OR"}},{"type":"PARAGRAPH","id":"crkie","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Peach Soju Cocktail","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"akdf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8t3vq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dge0a","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_18c1b42668484b7789ad44365d07b13a~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Seafood Rice Noodle Soup, SooRah Korean Cuisine, Medford OR"}},{"type":"PARAGRAPH","id":"5bfne","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Seafood Rice Noodle Soup","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"3388d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"922dl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"jfnd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hanna ordered the Seafood Rice Noodle soup and was very happy. She's not a huge eater so there was plenty left for lunch the next day and she even shared some with her husband! I also ended up bring home some of my bibimbap as the portion was quite large.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"940gg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"db18s","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER