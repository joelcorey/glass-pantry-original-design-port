d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cdih2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cube the lamb to about 1 1/2 inches. Season it liberally with salt and pepper then sear it quickly in small batches in a very hot dutch oven on the stove top. Add the chopped onion, the herbs and the stock.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ab9f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7h9t0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bring all of this to a boil and then put the lid on and turn it down to a temperature that allows the pot to remain at a full simmer. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"etme0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"22uvr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After 90 minutes check to see how the meat is coming along. It should be starting to become tender by now and you can stir in 2 peeled and diced russet potatoes and the rest of the diced vegetables. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"98mp6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e7n4i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add some water if it's drying out too much then leave the pot to simmer for about 40 minutes more while you make the mashed potatoes for the topping.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ieca","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"de7g2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tvb5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4a9k1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For the Mashed Potato Topping","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"706i0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aiqjb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Peel and chop 6 russet potatoes into roughly 1 1/2 inch pieces and add then to a pot with just enough hot water to cover them. Bring the pot to a boil for about 12-15 minutes or until they pierce very easily with a fork. Drain the potatoes and add half a stick of butter and 1- 1/2 cups milk. Add more butter or milk to get the consistency you like. It needs to be spreadable but also hold it's shape when you create peaks with a fork. Season to taste with salt and white pepper.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bqn6c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4979u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6kcun","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Assemble the Shepherd's Pie","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3o91s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fpoit","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the vegetables in the lamb stew have become soft, assemble the Shepherd's Pie. First lay down a layer of the stew in the bottom of a heavy 13 x 9 casserole dish.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cbvqu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1s68e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next add spoonfuls of mashed potatoes across the top of the casserole. Spread the spoonfuls about on top of the casserole decoratively with a fork to form the peaks that will crisp and brown as the Shepherd's Pie bakes. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bundu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7gj07","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bake the casserole uncovered for about 40 minutes or until the edges are bubbling and the top is lightly browned at 350 degrees. Broil and watch closely for about 5 minutes more if you like.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ih85","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8c289","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Allow the shepherd's pie to cool 5 minutes before serving.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"53hvr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-12T10:56:07.453Z","updatedTimestamp":"2024-05-12T10:56:07.453Z","id":"3ff1b6a5-7d3d-4d6d-96ae-2ecb36915d1d"}},"contentId":"61728aecc42843001614130c","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_f641049da8da4d24aaafcc34181651e5~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_f641049da8da4d24aaafcc34181651e5~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f676986b1c54b001781c706","internalCategoryIds":["5f67697cf4b037001706012d","5f67697cf4b037001706013d","5f67697cf4b037001706012b"],"internalRelatedPostIds":[],"isLiked":false,"isSubscribed":false,"owner":{"activityStatus":"UNKNOWN","contactId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","id":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","name":"By Melisa Smith","privacyStatus":"PUBLIC","siteMemberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","status":"UNKNOWN","isBlocked":false,"isOwner":false},"preview":false},"blog":{"settings":{"ampEnabled":false,"allPostsFeedLabel":"All Posts","comments":