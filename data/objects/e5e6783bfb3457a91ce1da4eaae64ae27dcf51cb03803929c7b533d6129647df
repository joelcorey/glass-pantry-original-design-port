{"postPage":{"id":"c65c09e0-8473-4c50-9d71-7ee84e31c55c","post":{"id":"c65c09e0-8473-4c50-9d71-7ee84e31c55c","title":"Easy Crab Dinner","excerpt":"Easy Crab Dinner Have you seen whole crab at your market fish counter lately? It's Dungeness Crab season and crab feeds are happening all...","firstPublishedDate":"2018-02-01T17:20:34.791Z","lastPublishedDate":"2018-02-01T17:20:34.791Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2018/02/01/easy-crab-dinner"},"slug":"2018/02/01/easy-crab-dinner","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","86cb13c9-ebe8-4da9-92bc-d9f63db5b610"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":48},"minutesToRead":5,"tagIds":["41361980-6fd2-44e5-a8dd-45af0c25be2f","dfdcd060-3a3a-4683-a44a-b848216c4e8a","5b4c71a1-f0d5-43d1-8991-243aca3b129f","e5addee2-4087-47d9-820d-74ed073e9c6f","93d0a142-db32-41e2-9775-6f1eb40f2f4b"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":48,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Easy Crab Dinner","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Easy Crab Dinner | Dungeness Crab | Mashed Red Potatoes"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"PARAGRAPH","id":"93m0l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"24ieo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Easy Crab Dinner","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"du852","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d7d6d8b1cda34716a4af6ce43d1e9b1a~mv2.jpg"},"width":1500,"height":1125},"altText":"Easy Crab Dinner"}},{"type":"PARAGRAPH","id":"iecs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Have you seen whole crab at your market fish counter lately? It's Dungeness Crab season and crab feeds are happening all over Oregon this month. We picked up some beautiful crab and had our own crab feed at home. It was fabulous! It's also crazy fast and easy. I had the crab cleaned at the fish counter. Ask someone there to do it for you, it's a free thing and getting that back off is hard for small hands like mine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"90uc8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eegp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband and I grew up on the Oregon coast. My dad had a boat we would use for crabbing and I have no idea how many crab we ate, wow! When you can pull them right out of the bay and build a fire on the beach it's a great way to pass the day.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6u81","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5gqt9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Several people would pile into the boat and off we went. We would drop the crab pots on the way out to what's known as the North Spit. It's a long sand bar on the outside of Coos Bay with the Pacific Ocean on the other side. Dad would beach the boat on the Spit and we would all get out and set up our day camp. We would build a large fire with driftwood and fill a large canning size pot with sea water and set it on the fire to boil.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ff4td","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"femre","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bn0mf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"About the time that was accomplished, 2 or 3 people would go back out in the boat to check the crab pots. They would haul up the pots and check to see which crab were of legal size and put the babies back in the bay. They set the pots back out and then returned to the Spit with the catch. That was repeated several times throughout the day and we would bring several crab home that evening.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ufh6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dqulm","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_dd5581d9fa084170908a4b8ec504200b~mv2.jpg"},"width":1500,"height":1125},"altText":"Cooked, Cleaned Dungeness Crab"}},{"type":"PARAGRAPH","id":"5bhor","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cr6aj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fl0a8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I honestly can't remember having warmed butter out there but we probably did. What I remember was throwing the large live crabs into the boiling water and watching them turn bright red. It doesn't take long.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e3hpi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ut5j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We pulled them out of the boiling pot and let them cool enough to handle then someone with big strong hands would take them down by the waters edge and pull the backs off, shake out the insides and pull out the gills for the seagulls. After the back is removed it's fairly easy to break the crab in half. Then it would be rinsed ever so briefly in the bay water.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4u84j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"oopk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Then we would eat! Standing right there on the edge of the water, throwing our shells into the bay. I'm sure someone ate from paper plates near the fire too. Maybe that's where the butter was. I guess I'll have to ask Mom.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c1nol","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3smcl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Maybe she'll leave me a comment at the end of this blog?","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a4bfu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"des3d","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d836ef609a124796b749f16ab3785995~mv2.jpg"},"width":1144,"height":858},"altText":"Vintage Butter Warmer"}},{"type":"PARAGRAPH","id":"adp11","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This is my vintage butter melting pot that I can't live without.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3fps4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ernsc","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_05d70d6250854a5f8b32933fb02b8d3a~mv2.jpg"},"width":1500,"height":1125},"altText":"Butter Warmer"}},{"type":"PARAGRAPH","id":"2uoh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1259h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is a butter warmer. It is not necessary equipment but it sure is nice! Especially for those who feel that crab was only meant to be a wonderful means of conveyance for the warm butter.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dder","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e7i0n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dc1bk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I once made browned butter for this and my daughter, who had not yet tried browned butter, declared it delicious and proceeded to soak it all up from the butter warmer on her dinner roll in about 2 bites. So funny! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2qcgs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dtur","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_38e0fe3da603460b9003c9483b0dd19f~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"fl388","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" These are the tools we like to use at the table. The Lobster/Crab cracker is the usual but I like to add the nut pick. It's great for getting the meat from the tiny parts of the legs. If you don't have something like a nut pick simply use the tiny pointed end of the crab leg. That's what we used on the beach.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8hiai","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"61ucm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c6ofs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"egf4u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2jrmo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now that the table is set and the butter is warming, I rinse the crab I just bought and set it into a shallow baking pan. I begin heating the oven to 375 degrees and set the crab aside while I make some rustic mashed red potatoes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"468jb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dv57q","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5ce55dd70b3e447992222d187e948443~mv2.jpg"},"width":1500,"height":1125},"altText":"Easy Crab Dinner"}},{"type":"PARAGRAPH","id":"94eb3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2sq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I fill a 3 quart saucepan with about 1 1/2 inches of water then clean and quarter the red potatoes. I do not peel them. As I chop them them I put them into the water so they don't oxidize and begin to turn brown.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dn618","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5bqrh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a7f0q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The volume of the potatoes displaces the water so the level of the water will rise keeping your potatoes just beneath the surface. Bring the potatoes to a boil for about 12 minutes or until you can pierce them quite easily with a fork. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"34fo6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"61agj","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_69ea2303835a43e8807168c539337366~mv2.jpg"},"width":1346,"height":1010}},"title":"quartering 7 potatoes"},{"image":{"media":{"src":{"url":"577c92_caa26a31fd9f4183b50e236322d427d7~mv2.jpg"},"width":1500,"height":1125}},"title":"into a 3 qt pot"},{"image":{"media":{"src":{"url":"577c92_53725e207cb64a4aaffc710f169e0b07~mv2.jpg"},"width":1500,"height":1125}},"title":"water just to cover potatoes"},{"image":{"media":{"src":{"url":"577c92_cc19e035544c43b7b968dd9cd6a8d653~mv2.jpg"},"width":1500,"height":1125}},"title":"Drain"},{"image":{"media":{"src":{"url":"577c92_c9b33749895940c6ae845d215065c646~mv2.jpg"},"width":1500,"height":1125}},"title":"Mash well"},{"image":{"media":{"src":{"url":"577c92_598947692da949aca25269bcc658f9e0~mv2.jpg"},"width":1500,"height":1125}},"title":"Done!"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"aohua","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Click on the pictures for more close-ups and details. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ff1o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"16s9e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The potatoes take about 30 minutes total so about the time the potatoes are getting soft I put the crab into the oven to warm. I finish up the mashed potatoes and corn while the crab warms for about 15-20 minutes in the oven.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a1cm3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"gi8n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Alternatively, you don't really need to warm it at all. The crab is ready to eat.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d7sm6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"707er","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9h9u4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My hubby loves corn with mashed potatoes so I warmed up a can of sweet yellow corn with it's liquid in a glass bowl  in the microwave for 4 minutes.  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dm01a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"e43u","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ea6ab99fde7549478a998111ef2c653d~mv2.jpg"},"width":1500,"height":1125},"altText":"Easy Crab Dinner"}},{"type":"PARAGRAPH","id":"9uehs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7tt1h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Oh this is so good! It really takes us both back to our days living by Coos Bay and the Oregon coast.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82e5e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ksrb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1152h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Did you know this is crab season because it's the time when most of the dungeness have filled out their shells with meat before molting and growing a new larger shell?","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"frkud","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3cir1","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_7f12d1e93628421aa8167a7b4bdcebac~mv2.jpg"},"width":1500,"height":1125},"altText":"Easy Crab Dinner"}},{"type":"PARAGRAPH","id":"efh3q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8gl60","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now is the perfect time for a crab feast folks so go out get some!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9t0ol","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ruqg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"77e1f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7fv2q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"1q2ru","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"2bfq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"78qla","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Easy Crab Dinner","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AU