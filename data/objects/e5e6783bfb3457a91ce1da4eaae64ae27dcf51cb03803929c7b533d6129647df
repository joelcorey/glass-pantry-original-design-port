nt":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fuoq3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon white pepper","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"atpqn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 can sweet yellow corn","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1jmto","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4l9gh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method   ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" (takes about 35 minutes)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1l5mi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fdi2r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Heat an oven to 375 degrees then rinse and place crab in a shallow baking dish and set it aside. Put one stick of butter into a small pot to melt on the stove on low heat.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"18id5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"46jbf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Quarter the potatoes and add them immediately to a 3 qt pot with 1 1/2 inches of water. The potatoes should be just barely covered with water.