":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"f8b3e","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_138a8b48cac848d4ae17e6bc4fd0d791~mv2.jpg"},"width":1391,"height":992},"altText":"Tea Smoked Chicken"}},{"type":"PARAGRAPH","id":"e324n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I believe my husband's step son Adam called this \"Magic Chicken\" the first time I made it. I discovered my first recipe for tea smoked chicken on ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Food & Wine","decorations":[{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.foodandwine.com/recipes/tea-smoked-roast-chickens","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" a few years ago and it never fails to produce beautiful juicy delicately complex flavored chickens. Nothing like American smoked chicken but still something wonderful! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ast8b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9oqph","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The recipe may look intimidating but it's actually quite simple and as long as foil is your friend, the clean-up is a breeze. I have made a few adjustments to that first recipe that work for me but the brine I have kept the same. It's probably the most important part in making this chicken \"Magical\".","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dum09","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"v42c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Basically there are three steps to this chicken. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bg5ei","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5euk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Brine the chicken and let it hang out in the refrigerator overnight.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"98khs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Smoke the chicken. ( actual smoking time about 10 minutes )","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b9gat","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Roast the chicken. ( actual roasting time, 1 hour)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tu02","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1q4i9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Making the brine is very quick. It simmers about 10 minutes and then I let it cool until I'm ready to add it to the chickens that I've rinsed and placed into 1 quart plastic freezer bags. I place the chicken in the bags and fill them with the cooled brine and let them marinate for 24 hours, turning them over once or twice.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d4qmb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5rjnf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2g795","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"There is also this magical Ginger Scallion Sauce that I serve with it. I've added a touch of dark soy to my recipe to give it more smoky depth of flavor and richer color.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ekkne","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6v8dq","nodes":[],"imageData":{"containerData":{"width":{"size":"SMALL"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_de36a882e8a44e46aa28b97ca4f6026c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Ginger Scallion Sauce"}},{"type":"PARAGRAPH","id":"2eit8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"qic4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"di4lv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8e4ks","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2rmmu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I love to make Tea Smoked Chicken in the winter because you can do it inside! The foil seals in all the smoke until it settles onto the chicken. See my tip below on how to get a fool proof seal if you need to use more than one piece of foil to cover a large roaster.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bpg7k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"14a4k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"23a83","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"762on","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_7576b4e48f6e40ef9b091b3df5a9aaf1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"e127k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7pev9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fb33s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I put together a mixture of rice, dried black tea, sugar, dried chilies and sweet spices that I will burn inside the foil lined roaster pan to \"smoke\" the chicken.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5g4pu","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_820b200104a3428c80711bc7f95d4e19~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Tea Smoking Mixture"}},{"type":"PARAGRAPH","id":"9atko","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a1tad","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9uolf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3r8p2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I scatter this on the bottom of a foil lined roasting pan and then add a rack to hold the chickens.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9nvrs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6q0un","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_119ac02f241f4c4e8636a3bf9fb6da14~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"IMAGE","id":"e1259","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d6a694a1d1d0420dba1e6bea554b8d5b~mv2.jpg"},"width":1500,"height":1125},"altText":"Brined Chickens Ready for Tea Smoking"}},{"type":"PARAGRAPH","id":"falci","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After removing the chicken from their overnight brine and patting them dry, I add them to the roaster and cover them tightly with foil to prepare them for smoking.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b23m2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5s05m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7qbh7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5n862","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tip: ","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Lay 2 pieces of foil back to back and tightly fold one side up about an inch then tightly fold up once more another inch. When you open the foil you will have a well sealed seam and a very large piece of foil that will completely cover a large roaster.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8v759","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"33pqb","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_bec31d695f5f475f81c92457032b80e3~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Folding foil to seal the chickens in the roaster."}},{"type":"PARAGRAPH","id":"8k3te","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bt361","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tightly crimp the foil around the sides of the roaster sealing in the smoking spices and the chickens.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dvr4h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"d213f","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b8c27886c64249be853eb5f7280ca778~mv2.jpg"},"width":1340,"height":1005},"altText":"Foil Sealed Roaster"}},{"type":"PARAGRAPH","id":"9ofqp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ctc4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2qssv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now I place the lid on the roaster. I don't really think it's necessary but I do press it down to help seal around the top edge of the roaster.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2im13","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"328g8","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_98840abfe210485cafc9197d08ece857~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Tea Smoking the Chickens"}},{"type":"PARAGRAPH","id":"d7eln","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cdu84","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I place the roaster over two burners and a bridge element on my glass top stove, turn the elements on high for 2 minutes then reduce the heat to medium low. I remove the roaster from the heat after 5 minutes and let it rest for 3 minutes before removing the lid and foil to expose the chickens. Then I let the chicken rest 10 minutes more with the lid off. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ac7d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3jug","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the temperature of the burners are on high, I do hear the spices ignite and begin to burn in the bottom of the pan. I will say, it's a little odd.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bgg8g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4q7hv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"99c0h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d7v7s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"jh31","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the chickens have been smoked, I place them on a sheet pan, rub them with a bit of oil, season them with some salt and Szechuan pepper and roast them in the oven. I preheat the oven to 375 degrees and roast the chickens uncovered for 30 minutes. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"c2684","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_eac197cf255f44279302d1ebbdef2cc5~mv2.jpg"},"width":1500,"height":1125},"altText":"Tea Smoked Chicken ready to roast"}},{"type":"PARAGRAPH","id":"45kr7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2o2qk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I turn the pan around and turn up the heat to 425 degrees at that point and then roast for another 30 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"713n8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"f3q9v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b189782f603a45ad9354066309e41c0f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Tea smoked Chickens after roasting"}},{"type":"PARAGRAPH","id":"13vcb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Aren't they pretty! I let them rest for at least 10 minutes before carving.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"4jkop","