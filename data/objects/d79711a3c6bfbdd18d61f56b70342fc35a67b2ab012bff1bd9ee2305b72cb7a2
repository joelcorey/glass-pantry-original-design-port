{"postPage":{"id":"8539fc7d-7909-4803-acea-7ae3310cb4c8","post":{"id":"8539fc7d-7909-4803-acea-7ae3310cb4c8","title":"Motorcycle Riding in the Columbia Gorge","excerpt":"Motorcycle Riding in the Columbia Gorge We finally got on the road again with our motorcycle a few weeks ago and man was it beautiful!...","firstPublishedDate":"2017-05-11T00:03:12.939Z","lastPublishedDate":"2017-05-11T00:03:12.939Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/05/10/motorcycle-riding-in-the-columbia-gorge"},"slug":"2017/05/10/motorcycle-riding-in-the-columbia-gorge","featured":false,"pinned":false,"categoryIds":["340a691e-f0fb-48cb-81ca-aa54a6c4e6bc","7a4e13b1-0b29-43ff-bafe-a30058858dd5","f0e3fce4-d677-461b-af98-d7f059887e9a","77a7e5bb-3035-4aec-b5d9-f3ac91f5cdd7","6817d7b7-5a3c-46cb-84df-6c98e5d3e96f","7b640cc9-cc3a-4e7a-854c-b3ddf807d97e"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":99},"minutesToRead":3,"tagIds":["4de8e135-f969-4884-a9c2-54d768e2926e","384bbfdc-3d3e-4606-94bd-1b382b6fe033"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":99,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Motorcycle Riding in the Columbia Gorge","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Motorcycle Ride | Columbia Gorge | Rowena Curves | Klickitat River | Dog Creek Falls | Everybody's Brewing | Mosier Or."},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"mamj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Motorcycle Riding in the Columbia Gorge","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4pmas","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"143l8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We finally got on the road again with our motorcycle a few weeks ago and man was it beautiful! We've had a long cold winter here in the Pacific Northwest and personally we had a flood in our basement that required a lot of personal time rebuilding and refinishing so we were long overdue for a good ride. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1glic","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fgi2l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We went through the Rowena Curves on the way back to The Dalles and 2 nights ago there was a massive rock slide and that part of the road is closed currently. It looks like it will be about 2-3 weeks before it will be opened up again so make sure you check the roads before you go.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3aijo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bjurv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dr1l2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rowena Crest Viewpoint","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theoutbound.com/oregon/chillin/drive-to-the-rowena-crest-viewpoint","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"a9ml5","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_59b6bed2960340418fbba7fc469a9aef~mv2_d_4008_3006_s_4_2.jpg"},"width":4008,"height":3006},"altText":"Motorcycling Rowena Crest, Mosier Oregon"}},{"type":"PARAGRAPH","id":"b469f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"kndc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fqd5g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You can see the details of our route and videos of Rowena Curves ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"here","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"https://www.theglasspantry.com/klickitat-river-loop","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":".","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8gpek","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5967t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"85mrg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4331v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We left early and it was a little chilly so I didn't pull out my camera for the first part of the ride through Goldendale, Wa and along the Klickitat River but no worries, I'll get to that another time. We like to take many variations on this ride throughout motorcycle season.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"37hd9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a6qse","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I did take out my camera out for a shot of the Klickitat River Trail Head. They have a bit of a rest area at the mouth of the river where the Klickitat Trail begins. It's an amazing walk along the river with views of the Klickitat River Gorge and the Indian fishing piers. It's very popular but not as crowded as you'll find other trails in the area. The views of the river are spectacular and the road is great! Above the Klickitat River Gorge there are many camping areas and places to pull on and off the river if you are a fisherman with a river boat.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c5alt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"i09f","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_30f08a559c7c47aeb4a4aaae529284f9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Klickitat River Trailhead"}},{"type":"PARAGRAPH","id":"fnoqi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Klickitat River Trailhead at Lyle, WA","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.wta.org/go-hiking/hikes/klickitat-rail-trail","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2alvv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dh4k4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8c7kh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A little farther up highway 14, we stopped at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Dog Creek Falls","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.fs.usda.gov/recarea/crgnsa/recarea/?recid=29898","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" to stretch our legs. Although I haven't gone swimming here, I have friends that tell me this place is almost a secret, even on hot summer days you can sometimes have this place to yourself. The creek and falls are barely visible from the highway and there's a small gravel lot for parking.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dgjl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9fmoi","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_981eabc9112742d39d031ffbc9e7e503~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"b37e2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aif1d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Click here for a detailed map of this tour.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"https://www.theglasspantry.com/klickitat-river-loop","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"59sjc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"buh6e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"94bl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f090a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ar2k1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Dog Creek","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8oo49","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_0735bfdb10774de0be9851e4e8e00c69~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"3lsk2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c60fb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Shortly after stopping at Dog Creek we rode west to the town of White Salmon and had a great lunch at","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Everybody's Brewing","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.everybodysbrewing.com/about.html","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":". It's a really nice craft brewery with tasty sandwiches and pub fare. Try the chicken gyro!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ipau","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"qkef","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We continued on hwy 14 west to The Bridge of the Gods near Stevenson WA where we crossed over the Columbia River. This is the famous ending point to the book \"Wild\" by Cheryl Strayed and part of The Pacific Crest Trail. It was pretty windy as we crossed and again, I missed the photo op. Ugh! We even got stopped on the bridge because of traffic at the toll booth, yes there's a toll of $1.00. It's a good idea to have this in your pocket and not in a saddle bag when you get to the toll booth. Between the wind and the dollar in my gloved hand I just couldn't bring myself to juggle my camera on the bouncing metal bridge, go figure!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52hf8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6nla6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"16vcu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2sff7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Turning East on the Oregon side we rode up hwy 84 to The Starvation Creek trail head. They have very nice bathrooms there and lots of parking but this spot can be really busy and parking does get full early on big hiking days.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aust2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bhoe2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Falls are quite close to the parking area but there's a lot more to see if you like to go exploring.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6h1sc","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_64d12f2a81e3470faca83197aeb6483a~mv2_d_3662_2639_s_4_2.jpg"},"width":3662,"height":2639},"link":{"url":"www.nwhiker.com/CGNSAHike47.html","target":"BLANK"},"altText":"Starvation Creek Falls"}},{"type":"PARAGRAPH","id":"6d0av","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Starvation Creek Falls","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.nwhiker.com/CGNSAHike47.html","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8fv63","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c6792","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9dnnr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Last but certainly not least, we came to Mosier, OR where we exited hwy 84 and took the historic old hwy 30 to Rowena Crest Viewpoint and then down through the Rowena Curves. This is truly one amazing ride. Watch out for bicyclists and pedestrians. Click ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"here","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"https://www.theglasspantry.com/klickitat-river-loop","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" to see some videos I shot of this ride.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eh2qj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1he8m","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_bebae72a68ca48a4857530046584ea90~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"ei5ik","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bss8s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Click here for a detailed map of this tour.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"https://www.theglasspantry.com/klickitat-river-loop","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"bdek3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"r7a8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"dchkq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3h33h","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f71755bdca9945109f15029052820cc7~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"vjqd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" We caught up with a few others out enjoying the curves!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5qh7o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"q1ks","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_355960a4f5fb4a6e9fb803709f373157~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"5bq0i","nodes":[{"type":"TEXT","id"