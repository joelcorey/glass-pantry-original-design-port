ent":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aqm2d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4ir7j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fresh chopped cilantro, Greek yogurt, thinly sliced scallion, diced jalapeno and lime wedges.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3jhll","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1o5q8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method​","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"33vba","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1dn8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cut the squash in half and remove the seeds. Place the squash in a large shallow baking pan with about 1/2 inch of water in it. Rub the exposed surfaces with vegetable oil and bake it in a preheated oven at 425 degrees for about 45-50 minutes or until soft when pierced with a fork. Your's may not take as long if it's smaller.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c92bb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fv506","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In a small bowl, combine the drained canned chicken, the chili flakes, cumin, garlic powder and dehydrated minced onion. Then add one can of rinsed and drained black beans, a can of drained corn, and a small can of chopped green chilies. Stir these together and season generously with salt and pepper. Remember that when combined with the spaghetti squash, the seasoning of the filling will be greatly diminished. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"92lld","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1mira","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the squash is soft and thoroughly cooked it will pull away as shown, very easily, with a fork into long shreds. Remove the shredded squash to a large bowl then combine the chicken mixture with the shredded squash. Add half of the cheese and stir gently to combine. Now fill the squash boats with the filling and top with the rest of the cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ftf9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fcqq1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bake the squash in a preheated oven at 350 degrees for 40 to 60 minutes depending on how large your squash is.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8nt4g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fvflm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Top the baked squash boats with fresh chopped cilantro, Greek yogurt, thinly sliced scallion, and some diced jalapeno. Serve with the lime wedges.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2geqv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"67mbv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3uri8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To reheat as a make ahead meal ","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"(directions are for one very large squash)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"abk8l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9bfv8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"No need to bake after filling the squash boats. Do not top with the rest of the cheese yet. Cover the boats with foil and refrigerate until 2 1/2 hours before serving. Remove from the refrigerator for one hour to take the chill off.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"btskj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"53e4g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the foil and top with the rest of the cheese. Bake them for about an hour at 350 degrees. ","decorations":[]}}],"paragra