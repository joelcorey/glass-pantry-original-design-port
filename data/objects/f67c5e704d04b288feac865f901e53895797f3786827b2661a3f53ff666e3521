decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8pv9g","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_6f6189c332394dedab45d2bf63b5495d~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"eiaao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"akn5f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Easy comfort food! Fresh and satisfying with just a little heat from the canned green chilies and chopped fresh jalapeno. I love all of the freshness topped onto this comforting cheesy bake. It's a great contrast to the cheesy, beany goodness inside and the corn adds a sweet crunch and pop! So Good.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"rqfi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4u0an","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I also use a few other staples from the pantry to make this healthy recipe fast. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cl0gp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Canned chicken makes this so much easier because I don't have to get out a skillet and cook anything to prep the filling. Baking the squash is the only thing I cook before assembling the squash boats.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4cv67","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f0s18","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This could easily be made as a vegetarian dish as well by simply leaving out the canned chicken. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cn8la","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5b56r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1fbqj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I cut the squash in half and remove the seeds then place the squash halves into a large shallow baking pan with about 1/2 inch of water in it. Rub the exposed surfaces with vegetable oil and bake it in a preheated oven at 425 degrees for about 45-50 minutes or until they are soft when pierced with a fork.  Your's may not take as long if it's smaller. I use very large spaghetti squash because we love the leftovers from this for lunches throughout the week and I grew some very large spaghetti squash last summer. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4bdbg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"13mei","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aeqen","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ehu72","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_71444b5c27af497dbb87b8eb546cc925~mv2.jpg"},"width":1500,"height":1125},"altText":"Southwest Spaghetti Squash"}},{"type":"PARAGRAPH","id":"fa7er","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I prefer to remove the seeds and bake this kind of squash cut side up to get the most evaporation out of it. Spaghetti Squash has a tendency to be somewhat watery and I feel like this helps it dry out a bit.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"36hq7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2t9gk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I also think using larger more mature spaghetti squash helps with that too. I used a few of the smaller immature spaghetti squash that didn't quite finish growing when the weather really turned cold here last fall and it was very interesting. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"tqnr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"32t10","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"They were still a touch green in color and the skins were somewhat soft. I knew they wouldn't harden off and keep well so I thought, what the heck, I'll cook them and see what we get!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3f88k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e1i7r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"What we got was angel hair spaghetti squash and perfect with ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Shrimp Scampi","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2018/04/05/Harissa-Shrimp-Scampi","target":"SELF"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"! If you grow your own spaghetti squash I highly recommend cooking a few of your baby squash. It was very tasty.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8lkuf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ftj7g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"123t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eu4nt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Here's a step by step tutorial for making this Southwest Spaghetti Squash. Click on the pictures for a closer look.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"570e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"ec982","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_cdb0b100dd8d4cce9d2fade4e4a754e6~mv2.jpg"},"width":1500,"height":1125}},"title":"Add the chili flakes"},{"image":{"media":{"src":{"url":"577c92_89c7d97ed9d24596a94ade3960938c40~mv2.jpg"},"width":1500,"height":1125}},"title":"Add the minced dehydrated onions"},{"image":{"media":{"src":{"url":"577c92_16f085da96d04ff18b108c0f76b88d20~mv2.jpg"},"width":1500,"height":1125}},"title":"Then add the cumin, garlic & oregano"},{"image":{"media":{"src":{"url":"577c92_d4651a1d05bf43bc8a6d2fd8eb7610a5~mv2.jpg"},"width":1500,"height":1125}},"title":"Add the black beans"},{"image":{"media":{"src":{"url":"577c92_96f4ab953be94dc89c0d1d4c506bec3d~mv2.jpg"},"width":1500,"height":1125}},"title":"A can of corn, rinsed and drained"},{"image":{"media":{"src":{"url":"577c92_db05fa9b32d548c1a2ad84d1bcd1e2eb~mv2.jpg"},"width":1500,"height":1125}},"title":"Stir to combine."},{"image":{"media":{"src":{"url":"577c92_49f7fab28ab84a8c8f2928e29aaa0108~mv2.jpg"},"width":1500,"height":1125}},"title":"Season with salt and pepper"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"7m5a9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In a medium sized bowl, combine the drained canned chicken, the chili flakes, cumin, garlic powder, oregano and dehydrated minced onion. Then add one can of rinsed and drained black beans, a can of drained corn, and a small can of chopped green chilies. Stir these together and season generously with salt and pepper. When combined with the spaghetti squash, the seasoning of the filling will be greatly diminished.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"akldi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3p0dd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"85ias","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the squash is soft and thoroughly cooked it will pull away very easily with a fork in long shreds.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"917m0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8a3bl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"bgn3","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_214b5477b0664b08904a3ed95bf772e6~mv2.jpg"},"width":1500,"height":1125}},"title":"Shred the spaghetti squash"},{"image":{"media":{"src":{"url":"577c92_bede3695afd64a4e90744d5fc7158612~mv2.jpg"},"width":1500,"height":1125}},"title":"Empty both boats into the large bowl"},{"image":{"media":{"src":{"url":"577c92_6aef3cc2f88b4f3c8dd7f762db4117f8~mv2.jpg"},"width":1500,"height":1125}},"title":"Cleaned Spaghetti Boats"},{"image":{"media":{"src":{"url":"577c92_221e690eaa4a4dca92d52b09eb48bd53~mv2.jpg"},"width":1500,"height":1125}},"title":"Mix together gently,"},{"image":{"media":{"src":{"url":"577c92_2fc3fced7d7b40b6ab82818cbe20b6e4~mv2.jpg"},"width":1500,"height":1125}},"title":"Top with half the cheese"},{"image":{"media":{"src":{"url":"577c92_4a8ecb74561642458821f33c123b1bec~mv2.jpg"},"width":1500,"height":1125}},"title":"Fill the boats"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"cp5fp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the shredded squash to a large bowl then combine the chicken mixture with the shredded squash. Add half of the cheese and stir gently to combine. Now fill the squash boats with the filling and top with the rest of the cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a9vt9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9s3ab","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bake the squash in a preheated oven at 350 degrees for 40 to 60 minutes depending on how large your squash is.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ul52","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"cu7ce","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f6cbd79f77d745dfb7407d9cc498db7e~mv2.jpg"},"width":1368,"height":1026},"altText":"Southwest Spaghetti Squash"}},{"type":"PARAGRAPH","id":"7l2bn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This was a squash that I grew in our garden last summer and it was really large. It took an hour to bake. Most spaghetti squash from the grocery store are 1/2 to 3/4 the size of this and wouldn't take as long to bake. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}