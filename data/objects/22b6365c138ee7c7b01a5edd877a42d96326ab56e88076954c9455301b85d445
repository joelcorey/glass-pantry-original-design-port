{"result":{"status":200,"page":"plz7w","data":{"userDefinedFilter":{},"items":[{"introduction":"Crispy golden brown on the bottom, moist and full of flavor on top! This makes an awesome holiday side dish for serving with anything. Traditional herbs, celery and onion are so good with the tangy sourdough bread cubes I save from the ends and pieces of homemade bread but you can use store bought sourdough if your not a bread baker. Mixing up different types of sourdough bread will give it a unique texture and flavor that's amazing!","servings":"6-8","photo":"image://v1/577c92_7a0f659a109342098dc32c3f31c4b536~mv2_d_4032_3024_s_4_2.jpg/4032_3024/20181123_181456.jpg","url":"https://www.theglasspantry.com/sausage-mushroom-sourdough-stuffing","link-recipes-1-1-title":"/mushrooms1/sausage-mushroom-sourdough-stuffing-","_id":"66964ca0-127b-4b37-bd19-860792f7ef3e","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2023-03-08T18:37:48.316Z"},"shortDescription":"Crispy golden brown on the bottom, moist and full of flavor on top! This makes an awesome holiday side dish for serving with anything. Traditional herbs, celery and onion are so good with the tangy sourdough bread cubes I save from the ends and pieces of homemade bread but you can use store bought sourdough if your not a bread baker. Mixing up different types of sourdough bread will give it a unique texture and flavor that's amazing!","cookingTime":"50 minutes","_updatedDate":{"$date":"2023-03-08T20:25:06.977Z"},"recipesCatagoryCatagory":"/Recipes/catagory/Wild-Mushrooms","preparationTime":"30 minutes","order":12.0,"ingredients":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8 cups diced sourdough bread cubes","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"tgunv129","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 pound bulk pork sausage. (I used Jimmy Dean Sage Breakfast sausage)","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ouh3l131","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 cups chopped fresh cremini mushrooms or 1 cup cooked and chopped wild mushrooms as described in the method below.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"66zyd133","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 3/4 - 2 cups chicken stock","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"exxg1135","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons melted butter","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"rxntm137","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons chopped parsley","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"861jt139","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 of a large sweet onion chopped (1/2 inch pieces)","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"a4au2141","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4 ribs of celery chopped into a small dice (1/4 to 1/2 inch)","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"84efd143","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon each: dried basil, dried thyme leaves, dried tarragon leaves and dried rosemary all crushed together with a mortar & pestle.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"8zc1i145","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 teaspoon salt","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5sgml147","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 teaspoon black pepper","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-03-08T19:12:04.355Z","updatedTimestamp":"2023-03-08T19:12:04.355Z","id":"a2b379cd-27fe-4906-b7d0-6cf535a16b8b"},"documentStyle":{}},"catagory":"Wild Mushrooms","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cut sourdough bread into small cubes while browning the sausage lightly.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"wun6l186","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"enbhf188","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add 1 tablespoon chopped parsley, the salt, pepper, and crushed herbs to the cubed bread.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"65nlp190","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"4ana3192","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the celery and onions to the sausage and sauté until wilted. Next add the mushrooms. Stir them in and sauté another 2 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3jsjc194","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"667m2196","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I have used store bought cremini in this recipe but Chanterelles, Fried Chicken mushrooms (Lyophyllum decastes), Honey Mushrooms (Armillaria), a variety of milk caps ( Lactarius), Oyster mushrooms or Shrimp Russula (Russula xerampelina) mushrooms would be very tasty in this dish.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"bsivj198","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"pimms200","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Important Note *","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}},{"type":"BOLD","fontWeightValue":700.0}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" If using wild mushrooms for this recipe, be sure you have properly identified the mushrooms and thoroughly cleaned and cooked them before adding them to this casserole. I like to use wild mushrooms that I have already prepared, sautéed and frozen, thaw just enough to loosen them and mix them in. You could alternatively add 1 1/2 cups cleaned and chopped fresh wild mushrooms and cook them thoroughly with the sausage.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"md5uj204","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"mg4yp206","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Melt the butter and add it, along with the chicken stock and the sausage mixture to the seasoned bread cubes and mix well.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"v5b6k208","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ooo4r210","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Spray oil a 13 x 9 glass baking dish and spread the stuffing into the baking dish and pack it gently with the back of a large spoon or spatula.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ojzru212","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3vbm9214","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add a little more water or stock if the stuffing seems too dry. That will depend on how dry your bread is and how moist you like your stuffing.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"uobca216","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ct9ob218","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cover tightly with foil and place in an oven preheated to 350 degrees for 50 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"s51ww220","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"tr1rh222","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After 50 minutes, reveal your masterpiece.","decora