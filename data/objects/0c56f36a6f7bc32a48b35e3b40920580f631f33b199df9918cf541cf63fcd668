a":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_db34d476845740b4a158c26d87ed5041~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Super Fast Garlic Red Chard"}},{"type":"PARAGRAPH","id":"9dkns","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bs861","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You know what we've been craving this last week? Lean salads with crunchy, high protein, salad sprinkles! After moving away from the deep snow and cold winds of North Central Oregon, the weather here in Medford, OR is mild and clear with afternoon temperatures in the mid fifties. After the snow up north this feels positively balmy! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"62alb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6rpdm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We really feel like eating lighter with this warmer weather and my husband loves the hearty crunchiness of these sprinkles topping off a big green salad so I decided it was time to stock up some great greens and shake up a big jar of vinaigrette dressing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d4t4m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"uv57","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_34f7e001a6e1441986c9e854c610b0ae~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Crunchy Salad Sprinkles"}},{"type":"PARAGRAPH","id":"bf0v2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"214pp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5rm6t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I change up the ingredients occasionally using wheat berries or soy nuts depending on what I find in the bulk foods section at the market. Today I used the toasted soy nuts I found so the rest of the ingredients that I usually keep on hand in my freezer needed to be toasted. I mixed up equal parts raw sunflower seeds, raw sliced almonds and raw pumpkin seeds and spread them on a baking sheet while I preheated the oven to 300 degrees. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"739vj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9l9o1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I like to use a sheet of parchment paper because its' so easy to pick them up and pour them into a container for storage after toasting. It also leaves my baking sheet perfectly clean, which is also a plus, but it's not really necessary.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bkpmo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3p6rg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I toast the crunchies for 12 minutes then stir them up to make sure they brown evenly and then continue to toast them for another 12 minutes until they are golden brown and fragrant.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"mm8p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1rq9a","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e2b5d8a241e24a77a8891963b177004e~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Super Fast Garlic Red Chard"}},{"type":"PARAGRAPH","id":"8de1j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"399l2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After toasting the other ingredients, I added the already toasted soy nuts and just a sprinkle of fine sea salt. Wait until they have cooled, then store them in an airtight container for up to two weeks. That is, if they last that long.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2n5rg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"arfdu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Since we've been moving I haven't been able to make many of the things like this that we were enjoying regularly, so making up a batch of these salad crunchies was really satisfying!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e5jtn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e9g2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Try adding these tasty crunchies to a sandwich instead of potato chips or to top a lovely slice of avocado or peanut butter toast! They also make a great snack by themselves or with cocktails.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3iu1p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eio3j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ou2d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7opep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cg0ab","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7dfu3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"a4l7e","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"IMAGE","id":"ej3gg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"