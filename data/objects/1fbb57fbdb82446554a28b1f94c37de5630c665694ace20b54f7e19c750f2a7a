tter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ds3h0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"diojo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"2ir26","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ba8d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2q1gu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Make the soaker:","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f9dr1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"55psd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The night before baking, mix together 1 cup room temperature water with 1 cup cornmeal. Cover with plastic wrap and allow it to sit at room temperature overnight.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d6f0i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1uj77","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Make the dough:","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ech30","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52i09","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mix together 2 cups of the flour, the yeast, the soaker and the lukewarm water in the bowl of a stand mixer. Cover with plastic wrap or a towel to ferment for one hour or until the sponge begins to bubble.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"22asn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1b0ki","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the remaining 2 1/2 cups of flour, the salt, molasses and butter. Mix on low with a dough hook until the dough begins to come together into a ball. You may need to add water or flour one tablespoon at a time to bring the dough together into a soft sticky dough.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9akph","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fjhfe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Continue to mix on medium speed with the dough hook for 6-8 minutes in the stand mixer to knead the dough then remove the dough to an oiled bowl and cover with plastic wrap. Place in a warm location for 90 minutes or until the dough has doubled in size.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1nte6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"49po3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the dough from the bowl and divide it into 2 equal portions and shape into loaves. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a06th","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ffs6e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the loaves into 9 x 5 bread pans that have been sprayed with spray oil. Mist the tops of the loaves with spray oil and loosely cover them with plastic wrap.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3aj4s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ds86a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place them in a warm place to proof once again for 60-90 minutes or until the loaves have completely crested the tops of the bread pans.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ebrik","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b651p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Begin preheating the oven 30 minutes before the loaves will be ready for the oven to 350 degrees with the rack in the middle of the oven.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8c48r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"64j1o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the loaves on a sheet pan then remove the plastic wrap and mist the tops of the loaves with water and sprinkle with cornmeal. Place the sheet pan into the oven and bake for 40-50 minutes, rotating the sheet pan for even baking after 20 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7qmk5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2sjk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The loaves are done when they are golden brown, including the sides and the bottom, and register at least 185-190 degrees in the center. They should make a hollow sound when tapped on the bottom.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f5ael","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d4ae2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the loaves are done, remove them immediately from the pans and cool on a rack for at least one hour before slicing and serving.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8cfjl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"P