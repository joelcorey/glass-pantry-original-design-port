"id":"","nodes":[],"textData":{"text":"Place in a warm location for 90 minutes or until the dough has doubled in size. Remove the dough from the bowl and divide it into 2 equal portions and shape into loaves.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8f10i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c3uj8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"abi47","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"cjbm9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This slide show illustrates forming the loaves.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"b1o13","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"3hioc","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_bd1672183fd74ca5b26a317794a1fd15~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Remove the dough from the bowl"},{"image":{"media":{"src":{"url":"577c92_be774d0e73d3400caff7029d868236e9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Knead 3-4 times"},{"image":{"media":{"src":{"url":"577c92_24b45c6f839e4ef69dc2469bd65f9c2f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Divide the dough"},{"image":{"media":{"src":{"url":"577c92_630c4bb2e5f44835a7