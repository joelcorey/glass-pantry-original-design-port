"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a3c04f44936c4f1293cbf7cb0413dedd~mv2.jpg"},"width":1500,"height":1125},"altText":"Pineapple Ham Fried Rice"}},{"type":"PARAGRAPH","id":"c1jao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"drqo6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fried rice is one of my favorite comfort foods and my husbands too. It's also a wonderful vehicle for using up those odds and ends in the refrigerator otherwise known as leftovers. After a holiday meal it's especially good!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1osge","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d1bh8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Many people will be having a ham this season and fresh pineapple has been plentiful so of course I couldn't resist showing you this recipe and making up some of our favorite Polynesian/Thai style pineapple ham fried rice. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7s005","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9pads","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband ordered this for lunch once at a Thai restaurant in Hood River, OR and it was so good I had to add it to my regular rotation of fried rice at home. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6pdpv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ehtr0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ftfdt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3chkk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2qbcl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_64788fe332e74f0986c77c7ec1d6057c~mv2.jpg"},"width":1500,"height":1125},"altText":"3 day old rice for fried rice"}},{"type":"PARAGRAPH","id":"3do0f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" The first thing to know about making fried rice is that you really should use old rice. Yes, I actually make lots of extra rice so I get a quantity of leftover rice enough to make this. Cook once, eat twice, or more....there is usually enough fried rice leftover for a few more lunches too! Here's my recipe for ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Jasmine Rice in a Pot","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/12/03/Jasmine-Rice-in-a-Pot","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":".","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/12/03/Jasmine-Rice-in-a-Pot","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"18ih2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7fjp2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9k1b5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is leftover Jasmine rice that's 3 days old. Aged rice has time to fully hydrate and then begin to dry out so it fries better without breaking and becoming mushy. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"blk07","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"7b6rh","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_642eaa831ef2469d81d023bd5d5621c7~mv2.jpg"},"width":1500,"height":1125},"altText":"3 day old rice for fried rice"}},{"type":"PARAGRAPH","id":"4g1et","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I start by getting the rice into my electric skillet. If the rice sticks together in small chunks, I gently smash the rice with the back of a spatula and the grains separate easily. This works best if you are using leftover rice at least one day old. I turn the heat on low while I get together the rest of my ingredients. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9nacv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"74njn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5pcep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bd6e9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I like to get all of the ingredients ready before I start because this recipe is essentially a stir fry and it comes together very quickly once I start cooking.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4nn1h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"c4ksk","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ab5f8dee868d4247b25fd803ce54a78c~mv2.jpg"},"width":1500,"height":1125},"altText":"pineapple ham fried rice ingredients"}},{"type":"PARAGRAPH","id":"33b77","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"704nn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I have my leftovers: diced ham, pineapple, scallion, and red bell pepper that I chopped to roughly the same size. Then I added two eggs, some frozen peas, diced carrot, celery and some grated fresh ginger to the mix. From the pantry I used fish sauce, sesame oil, low sodium soy sauce and some powdered garlic. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4iift","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bi57h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fish sauce is the second thing you should know about fried rice. If you hate it, leave it out but if you aren't sure or you know you like it. Try it in your fried rice. My husband thinks its magical! It's very authentic for Southeast Asian style cooking and it's amazing what it will do to season this dish. It's inexpensive and lasts a long time. I like Vietnamese fish sauce the best.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6k2rn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fdek0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"68vmt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9fdep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ucn7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now that all of my ingredients are ready, it's time to season the rice in the skillet.  As it begins to warm and dry the rice, I add a drizzle of sesame oil, fish sauce and soy to the rice and use a spatula like a paddle to lift and turn the rice until it becomes evenly colored.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fbfd2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b3ug5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cuo2g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6nn36","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f82a2c7f71c5495cb81fb8bd4eb455d2~mv2.jpg"},"width":1500,"height":1125},"altText":"scrambled eggs for fried rice"}},{"type":"PARAGRAPH","id":"9a5fa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Next I scramble the egg and add that to the rice.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"27e2u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"5auh9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"bjr23","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"1bkbn","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a654b4c9afae4804ad9150a31e20c46f~mv2.jpg"},"width":1500,"height":1125},"altText":"veggie stir-fry for fried rice"}},{"type":"PARAGRAPH","id":"c6s3l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Then I saute' the carrots, celery and red bell pepper just until it's translucent and the sugars are starting to caramelize.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"7vcsb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"btrl4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"f68hi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"5dhj7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"2ca7h","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_409e18ba0e0e4524a90ccbe163cdfc52~mv2.jpg"},"width":1500,"height":1125},"altText":"adding vegetables to fried rice"}},{"type":"PARAGRAPH","id":"fv1fi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3k9fl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I add the vegetables to the rice in the skillet and again, use a spatula like a paddle to lift and turn the rice. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4egu9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"esri3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Even on low heat the rice will begin to fry and you may find you have bits of brown crispy pieces forming on the bottom so keep stirring every few minutes while you continue to add the rest of the ingredients.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6boea","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fu82o","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_cd895923f6fb4244bdcc8c8474217eaf~mv2.jpg"},"width":1500,"height":1125},"altText":"fried rice"}},{"type":"PARAGRAPH","id":"8i4cr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5bltc","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_646f4275b45242da905d12a6430e868e~mv2.jpg"},"width":1500,"height":1125},"altText":"chopped ham stir frying"}},{"type":"PARAGRAPH","id":"dp9rg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next I fry up the diced ham until it begins to brown just a little bit.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"10fbp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"4o1bu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"f788m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Then I fry the pineapple until it has dried out some.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"cpjha","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6bi4b","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_fea206df1bf1446ebcdedf5364a70ffc~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"bk07s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52h4v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I add the ham, the pineapple, the frozen peas and the garlic powder to the rice and toss it all together. I like to give the fried rice a touch of garlic but I don't want it to be too prominent in the flavor profile so I don't use freshly minced garlic for this.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d6g6k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"10rq3","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ec62bc5ee2f648e88fe7ddcee888c101~mv2.jpg"},"width":1500,"height":1125},"altText":"pineapple ham fried rice"}},{"type":"PARAGRAPH","id":"aue6u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I adjust the seasoning by adding more fish sauce or soy sauce during this time. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fmjim","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d0k77","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dfuln","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ajc8n","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_93e62439ff9443249607efdc1dd44285~mv2.jpg"},"width":1500,"height":1125},"altText":"pineapple ham fried rice"}},{"type":"PARAGRAPH","id":"f540","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e98n4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"64mg3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you are fast like Rachel Ray, you can whip up this meal in about 45 minutes but I'm a little bit more relaxed about gathering my ingredients and prepping them. It does take about 10 minutes to stir-fry and get everything into the electric skillet. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dlqpa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"204bt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Once all of the ingredients have been added to the skillet, I like to let it steam slowly 