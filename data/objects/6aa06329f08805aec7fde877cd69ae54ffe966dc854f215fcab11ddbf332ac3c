:{"src":{"id":"577c92_24c3a2194caf489dbe47799fe762e30f~mv2.jpg"},"width":1092,"height":819},"altText":"Stuffed Sourdough Pizza Rolls"}},{"type":"PARAGRAPH","id":"1lrlo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aurat","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"akt3a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Making these home made stuffed sourdough pizza rolls was so fun! I made some sourdough bread dough and let it rise then cut it into pieces and stuffed it. I let it rise again and then slit the top exposing the pizza filling interior and baked. Half way through baking I turned the pans around then sprayed them with a bit of olive oil and added some more cheese before putting them back into the oven to finish.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ep3ms","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"rv6s","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f0614e3a05dc4746b31f81f51eb357ab~mv2.jpg"},"width":1500,"height":1125},"altText":"Stuffed Sourdough Pizza Rolls"}},{"type":"PARAGRAPH","id":"3gd59","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2m6nn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Superman and I stopped at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Creswell Bakery","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"creswellbakery.com/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" in Creswell, OR on our way home from the ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Oregon Coast Dune Buggy Adventure.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/10/02/Oregon-Coast-Dune-Buggy-Adventure","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" We ordered this amazing ham and cheese stuffed sourdough roll and I knew I had to try to make it at home. We live several hours drive from Creswell Bakery and I didn't think we wanted to wait until we went back over there to have another one.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1u91g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9i73b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I made the Ham and cheese version first and I was so excited. It worked so well! That's when I decided to make these pizza style rolls. I imagine there is no end to the ingredient combinations one could come up with. I'm going to be making this a regular Leftover Queen recipe because obviously I'm going to find great leftovers to stuff into these things. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bev0q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"62pao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f5ue4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The dough recipe and the method for mixing it are below but first, here's a more detailed look at how to put the stuffed rolls together. Click on the pics for more information.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"61kfl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6mdbn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7k96f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"8p4qj","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_b4f96e16019a4f97ba5c7cb421f9b10d~mv2.jpg"},"width":1500,"height":1125}},"title":"After mixing the dough"},{"image":{"media":{"src":{"url":"577c92_f0614e3a05dc4746b31f81f51eb357ab~mv2.jpg"},"width":1500,"height":1125}},"title":"Form a loose oval"},{"image":{"media":{"src":{"url":"577c92_a5213ca4483f47d8891960cce2e658b6~mv2.jpg"},"width":1500,"height":1125}},"title":"Fold the ends in"},{"image":{"media":{"src":{"url":"577c92_79ade6b3fbf34663a81d6c1554e40ed5~mv2.jpg"},"width":1500,"height":1125}},"title":"Pinch the ends and the seam to seal"},{"image":{"media":{"src":{"url":"577c92_0dae00724d27442bb3b419b23bca7022~mv2.jpg"},"width":1500,"height":1125}},"title":"Repeat the process"},{"image":{"media":{"src":{"url":"577c92_ffd3da2c599147cfa435b0f9296b7ef3~mv2.jpg"},"width":1500,"height":1125}},"title":"Pinch them closed"},{"image":{"media":{"src":{"url":"577c92_b245fb2becf34419a4983abf368b787f~mv2.jpg"},"width":1500,"height":1125}},"title":"Fill another"},{"image":{"media":{"src":{"url":"577c92_61c9525780cd4a82a5f38379fec10916~mv2.jpg"},"width":1440,"height":1080}},"title":"Until all are filled and sealed"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"btjhq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"mgpv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5k07p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Lay them out on a parchment lined sheet pan to rise covered lightly with plastic wrap or a thin kitchen towel until they have risen 60-90 minutes. When the dough is fully risen, it should leave a small dent and not spring all the way back too quickly when you poke the dough with your fingertip.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"23fc2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"c4p7f","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f163deb485cc49b181631f798b3295f2~mv2.jpg"},"width":1287,"height":965},"altText":"Stuffed Sourdough Pizza Rolls"}},{"type":"PARAGRAPH","id":"ob2n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cfn61","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Start preheating the oven to 450 degrees about 30 minutes before the rolls will be ready for baking.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2dgil","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3gh48","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f3qv6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ama4t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the rolls are ready and the oven is hot. Make a very long deep slit in the top of the roll down into the filling. The rolls should start to spread apart slowly after you make the cut.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1mup9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"6pmrj","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_d0d5e8a7326e41a3b8dfc3facf102526~mv2.jpg"},"width":1365,"height":1024}},"title":"Stuffed Sourdough Pizza Rolls"},{"image":{"media":{"src":{"url":"577c92_0846339552e14d0a8432321cfc59e892~mv2.jpg"},"width":1385,"height":1039}},"title":"Stuffed Sourdough Pizza Rolls"},{"image":{"media":{"src":{"url":"577c92_4149ca1b4dc548489954c1ad05dc22c1~mv2.jpg"},"width":1192,"height":894}},"title":"Stuffed Sourdough Pizza Rolls"},{"image":{"media":{"src":{"url":"577c92_6da71d83c5fb4877a518d7fb3c578fc8~mv2.jpg"},"width":1336,"height":1011}},"title":"Stuffed Sourdough Pizza Rolls"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"aabsi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Put the pans into the preheated oven, reduce the temperature and bake at 425 degrees for 15 minutes and then pull out the pans. Spray with oil, sprinkle with more cheese and put them back into the oven, trays turned and shifted top to bottom from the way you took them out.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"86trt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9tsbs","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_97205eeebeb64de8893eeb58f85917e2~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Stuffed Sourdough Pizza Rolls"}},{"type":"PARAGRAPH","id":"3cc62","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8kamc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5eedd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8mj14","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_9b794a42773849edb2fdf343640ef8e9~mv2.jpg"},"width":1500,"height":1125},"altText":"Stuffed Sourdough Pizza Rolls"}},{"type":"PARAGRAPH","id":"au5nk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Reduce the temperature again to 375 degrees and continue to bake another 5-10 minutes or until they are browned the way you like them.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c189f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"54ab8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tips: ","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sourdough bread will be crusty and somewhat crunchy if well browned and freshly baked. I think sourdough bread and rolls are best if let to cool completely (as they do with the breads at Creswell Bakery) and reheated to order. The crust will soften some and become the chewy and crusty sourdough you are probably familiar with.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"av9pi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6eu6b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you intend to reheat these rolls later, take the rolls out of the oven when they are a little light in color and you can finish browning them. Store them in the refrigerator for up to 3 days, freeze them if you won't be eating them for more than 3 days.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4mjc1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cmmdk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5dh2h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"These reheat wonderfully from the refrigerator or freezer. I reheat mine at 350 degrees for about 15-20 minutes in the oven and they come out fantastic!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8035l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8nt79","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e70jq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"sj1p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"23hkb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"aqi1g","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_077de1ed4965