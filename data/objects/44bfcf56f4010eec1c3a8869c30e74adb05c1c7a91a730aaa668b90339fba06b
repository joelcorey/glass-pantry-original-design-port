MAGE","id":"f684k","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1b37ab9b123c4480a87f9d618f61ccbd~mv2.jpg"},"width":972,"height":729},"altText":"Italian Nachos"}},{"type":"PARAGRAPH","id":"fftuf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d8flt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A few years ago we were making several visits to Bend Oregon and we used to frequent a restaurant called Johnny Carino's. Maybe you have one near you? I haven't been there in quite a while but when we did go there, Italian Nachos were on the appetizer menu and they were delicious!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8jiab","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5q6dm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The chips were made from fresh lasagna noodles. They have a very interesting texture when deep fried and they are much lighter and crispier than corn chips. I thought to myself, there has to be a way to make these at home. Hey wait! I have a kitchen-aid with a pasta maker attachment and a deep fryer. I can make this!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2hivd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b5ce","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4i3ov","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"51dts","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This time I took a short cut with the recipe because I was making them for Halloween and I was extra busy. I didn't want to mess with making pasta so I used store bought egg roll wrappers! They are noodles after all.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"909na","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"43d9e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"59vqg","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_d79b779b40d74044bd57c1268f9412e4~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Egg rolls skins"},{"image":{"media":{"src":{"url":"577c92_327b9d14dff849e4a888aadc27bbbba3~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Cut up for frying"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"728t6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I cut them into triangles and they were ready to drop in the fryer.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"3l6j4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"33rpg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_07a57a0270ae44d0b7e43d6eb18fab4f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Fried Eggroll Skins"}},{"type":"PARAGRAPH","id":"8n89v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fog7g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"So you know those crispy fried wonton pieces that you often get at Chinese restaurants usually drizzled with that crazy red sweet and sour sauce no one can quite make right at home? This a whole sheet pan full of them!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"oc14","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1afjm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I fry 6-8 triangles at a time in my large deep fryer and it goes really quickly. The noodles fry in about 30 seconds each at 350 degrees. I slip them into the oil one at a time and then push them down into the oil as they pop back up and start floating, flipping them once quickly. I lift them up with the fryer basket and let them drain well before turning them out onto a sheet pan lined with paper towels or parchment paper.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f7pp0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8maee","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I used about half the package of egg roll wrappers for this recipe. If you want to make these a day or so ahead they can be stored in a plastic bag after they have completely cooled and will keep for 1 or 2 days. Heating them up will refresh them when you cook the Italian Nachos. Here's a great idea to use up any leftover egg roll wrappers you might have. Try my","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Ricotta Stuffed Wontons","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2018/03/12/Ricotta-Stuffed-Wontons-2-Ways","target":"SELF"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":".","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"jb9p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"crpru","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1gov3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Earlier I had browned some sweet Italian sausage and made a marinara sauce that I would use in place of taco meat and salsa on my nachos. I also rinsed and drained a can of cannelini beans and prepared some red onion, sliced peperoncini's and sliced black olives for topping the nachos.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6fi7u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9auvh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fnl1d","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_3fcbcc24f3744c118b077c16947e44c8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"dbujq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"All right now we're really prepped and ready to finish this up.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"sa00","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"bf03u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Let's start piling on those toppings!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"c7ri0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"c0iqd","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_aac6530a01614a0e86743751270a8286~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"abloh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"5bcr8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"First I add 1/2 of the chopped red onion, cannelini beans, olives and peperoncini's. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"43hdl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b688p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b2tmg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e59kk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Then I top that with the first layer of shredded mozzarella.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6459a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"ahnfa","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f3eb733ef1f7473aac570be18f25b712~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"62v0t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"26gkb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dhbd3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now I add the sweet Italian sausage, marinara sauce, and then the rest of the toppings followed by more Mozzarella cheese. Save a few black olives and peperoncini's for garnishing the very top.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7l4j5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ftr1i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"djil8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After a few minutes in a 450 degree oven it's gorgeous!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cfbfd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4mpfg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"es7rs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b1j8m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is such a great twist on nachos. It's so flavorful with the sweet Italian sausage and peperoncini's and who can resist all that gooey cheese? Did I mention what great party food this is? You can prep the ingredients a day ahead of time and put it all together quickly for an impressive hot appetizer.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tdv2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"92n0k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dpel8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6m2n6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9r5v6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"b8gak","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"PARAGRAPH","id":"dhjkl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"HEADING","id":"73dvs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Italian Nachos (Johnny Carino's copycat)","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aoet4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"61gr7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"d9se4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragrap