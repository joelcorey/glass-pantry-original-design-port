extAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4mp4v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6h64l","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_bb9cf9cb80d54a6793e3a4f94fc85dc7~mv2.jpg"},"width":1500,"height":1125},"altText":"Spring Butterfly and Daisy Sugar Cookies"}},{"type":"PARAGRAPH","id":"c31ne","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cobf4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Last spring I made these sweet Spring Butterfly and Daisy Sugar Cookies for my daughter for her birthday. She and her husband were excited about these and wanted to help decorate so that made me very happy! We had a great day decorating together and visiting. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"287vq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eh2oa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I was thinking that these would make some pretty beautiful Easter cookies and a fun family project for the holiday as well. They could be bright like these or a more pastel theme if you like but I really like the combination of the two patterns together. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"17on9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1g2uv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cookies like these are not made in one day, so I made the dough the night before baking the cookies and let the flour bloom and everything get cozy overnight in the fridge. (day 1)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4sj4k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5o7nr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f3teb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I've researched many sugar cookie recipes and I've come to a compromise. The recipes that make the cleanest sharp edged intricately designed cookies do not make the tastiest cookies. The rich, chewy sugar cookie recipes taste great but do not make the prettiest cut outs because they are too puffy and the edges become too rounded. So the recipe I have used here is somewhere in the middle.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9lk9s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7amsu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The next day, (day 2), I quartered the dough and then one at a time, I rolled the dough out and cut and baked the cookies. That process takes a couple of hours and is illustrated below. Click on the images for extra details.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6hn5d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52slm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"90ttn","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_ca32e75f562c4a01bd8b34d1b8b28e8a~mv2.jpg"},"width":1305,"height":979}},"title":"Roll out the cookie dough"},{"image":{"media":{"src":{"url":"577c92_4cae1c6b8fcb4461a7cfda0ef2a8e10f~mv2.jpg"},"width":1125,"height":1500}},"title":"Roll the dough to 1/4\" thickness."},{"image":{"media":{"src":{"url":"577c92_87fe38b795724f4eb906d83f9c560a6b~mv2.jpg"},"width":1125,"height":1500}},"title":"Ready for the oven."},{"image":{"media":{"src":{"url":"577c92_9bdb84836ae54486888d331a90319405~mv2.jpg"},"width":1341,"height":1006}},"title":"Cool on a tea towel separately."},{"image":{"media":{"src":{"url":"577c92_765fb3a2ac884b37a99a1d86a83e2cc8~mv2.jpg"},"width":951,"height":713}},"title":"Ready to be decorated."}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"5sqlj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Flour the surface well and use a thin metal spatula to lift the cut cookie if it gets stuck to the work surface or roll the dough out between sheets of waxed paper or parchment.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2cf7n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7h3kf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After cutting and rolling out the cookies I bake them at a slightly higher temperature for a shorter length of time than most recipes call for. I found that 375 degrees for 8-9 minutes gives me the just slightly golden color I like. Don't forget to turn the pan half way through baking to maintain an even color.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3q9ng","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f8s41","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When all of the cookies are baked and have had plenty of time to cool, I put them into a large airtight container for the night. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"apvro","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"vku2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"drlda","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3i9v4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"(Day 3) Decorating Day!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2edr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"eoc5o","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_5123470d75df41ea8d8ed27d400b2864~mv2.jpg"},"width":1500,"height":1125}},"title":"Flooding the cookies"},{"image":{"media":{"src":{"url":"577c92_8505321714ce495cbbf867c8065fc363~mv2.jpg"},"width":1499,"height":1124}},"title":"Piping the edges."}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"1v981","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1p0k1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After making and coloring the icing for flooding, I fill one piping bag with a thicker version of the icing. It's just a little bit more stiff so that it will hold its shape when piped onto the edge of the cookie creating a barrier that will keep the flooding icing from running all over the place and making a nice clean edge. Use a pint glass to hold the piping bag for you while you fill it. Fold the bag open and over the edge of the glass, it works like magic!  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"btemf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"7i6tb","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_bd95edafb0ce4b218b1a41d21e534dd2~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"eji7c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bd23j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"69om0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dae3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9a1f","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f31e91087e0b4498b3efdd47e5ea8d7b~mv2.jpg"},"width":966,"height":1288},"altText":"Spring Daisy Sugar Cookies"}},{"type":"PARAGRAPH","id":"4oj69","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7han0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a2um7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I found the icing recipe at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Stuff By Stace.","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"stuffbystace.blogspot.com/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  I usually use Wilton food coloring to get the intense hues but I made these beautiful colors with Kroger Neon Food Colors. I was impressed at the depth of color I was able to achieve with this brand.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9bqs8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a9c2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To flood the cookies I add enough milk to the icing to get a consistency that melts back into itself within a few seconds when drizzled without leaving marks on the surface. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2i0i1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ecm8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fbb0b","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c488a60c50b644adaa260fc191f14971~mv2.jpg"},"width":1125,"height":1500},"altText":"Spring Butterfly and Daisy Sugar Cookies"}},{"type":"PARAGRAPH","id":"ccq4i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"81f1f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4jlg4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I love that these came out so colorful and whimsical. My daughter and her husband are quite artistic!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type"