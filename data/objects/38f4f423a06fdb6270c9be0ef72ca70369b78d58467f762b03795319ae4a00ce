ean sauce. Lower the temperature of the oven to 350 degrees and bake the coated wings 5 more minutes.&nbsp;</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Baste again with the sauce before serving.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jnlraq7v":{"id":"comp-jnlraq7v","appDefinitionId":"13016589-a9eb-424a-8a69-46cb05ce0b2c","widgetId":"130165ba-4eeb-4a87-3121-a3cf2a86d2ca","isAppInClientSpecMap":true,"isViewerMode":true,"isResponsive":false,"translations":{"preloaderOverlay":{"loading":"Loading"},"errorMessageOverlay":{"reloadText":"Refresh this page","oopsText":"App Didn't Load","installErrorText":"We Were Unable to Install This App","generalErrorPrefix":"Try again later, disable any ad blockers, or reload the page. Contact the author of","generalErrorSuffix":"for help.","uninstalledErrorText":"We Were Unable to Install This App"},"unavailableMessageOverlay":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us.","reloadText":"Refresh this page"}},"applicationId":"2979"},"comp-lo1v07ez":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07ez","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jnlraq9p":{"images":[{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_24a35ec5