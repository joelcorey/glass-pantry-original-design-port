RAGRAPH","id":"2o65n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"57qcs","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8628000c65ae427fabb8bcf3e53a7d49~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Super Fast Garlic Red Chard"}},{"type":"PARAGRAPH","id":"bn9ra","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f1tvo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is an herb salt blend that I developed over years of cooking. When I was a kid, my mom always had a bottle of seasoned salt available for seasoning any number of things and I fully realized the power of that little jar.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8clk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"16do1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The problem is that it was pretty high in, you guessed it,...salt.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fn28v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"abi0n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I think the world seemed to notice this was a thing at the same time I did and suddenly there were many salt free blends to choose from. Many of these were good but still, you need some salt, so now I was reaching for two things, the blend and the salt.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b5tk2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"adcuv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2i5fq","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5cc7b3c32ab8451f9acbe62364178e2c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Mel's Secret Spice Blend"}},{"type":"PARAGRAPH","id":"4vq9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I make mine to fill a spice jar with a grinder top, using more whole spices. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"7bo5s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8cpnl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"80vl0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"One day I used up the last bit of salt in a Himalayan Pink Salt grinder I had been using and thought, I should refill this jar with something I want to use all the time! I also love the brighter flavors that come from grinding these ingredients as you need them.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fpbp3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6h1kr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I started rummaging through the kitchen cupboards and chose some of my home dried herbs and then added to those, some coarse ground salt, dried minced onion, garlic and chili flakes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ar48","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8u0fd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Over time it evolved into this blend of herbs, spices and salt that simply works! It's lower in salt than most \"seasoned salts\" and has all the flavors we love to use for many dishes. I'll admit to changing it a little now and again but most of the time, I make this over and over again. I hope you find it as useful as I do or at least inspiring enough for you to make up your own.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2v7um","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dlrd6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c8av2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f51b3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData