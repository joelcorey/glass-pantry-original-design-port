{"postPage":{"id":"0cf51982-2eb4-40d8-b7a7-725d28455cd2","post":{"id":"0cf51982-2eb4-40d8-b7a7-725d28455cd2","title":"How to Roast and Peel Peppers","excerpt":"How to Roast and Peel Peppers I recently found Hatch chili peppers for sale at our grocery store. Yay! My husband and I spent our...","firstPublishedDate":"2017-10-11T00:11:06.682Z","lastPublishedDate":"2017-10-11T00:11:06.682Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/10/10/how-to-roast-and-peel-peppers"},"slug":"2017/10/10/how-to-roast-and-peel-peppers","featured":false,"pinned":false,"categoryIds":["77a7e5bb-3035-4aec-b5d9-f3ac91f5cdd7","15abe877-7a05-4ea7-9f92-bfe7c73120b4","accdf66c-0e8c-4ccb-9d3c-46a7d67e90f5","7d525f78-2dd8-406c-9140-22b38e2eeded"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":1113},"minutesToRead":2,"tagIds":["932deed8-f57a-44dc-8dd8-e0ae71a58832","cb38192a-18c6-4a8d-a31d-b0f89265936a","63a45d29-5adf-49f5-b9d6-a90a6115dccc","16ccbfa4-271a-40ce-adca-2836e920a2df","0a3cc181-6eea-4533-bbb0-5cbc3495b043"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":1113,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"How to Roast and Peel Peppers","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"How to roast and peel peppers | Chili Peppers | Hatch Chili Peppers"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"35coi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" How to Roast and Peel Peppers","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"53n9j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_312c17e871ed4fd5a7916c073cdfe6e8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Roast and peeled Hatch Chili Peppers"}},{"type":"PARAGRAPH","id":"3gl30","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4hni6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I recently found Hatch chili peppers for sale at our grocery store. Yay! My husband and I spent our anniversary in March of 2016 in New Mexico and we were blown away by all the chili sauces. You know, green or red? No matter what you order there, each restaurant has their own red or green hatch chili sauce to go with it. We came back wanting more but here in the PNW there are rarely any Hatch chilies to be found. I was so excited! I finally had the opportunity to work with these magic chilies myself.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f2bj7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"95t68","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3o5c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"m19e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is the technique for prepping peppers for use in many recipes and it can be applied to any pepper that you would like to serve cooked and without it's somewhat waxy outer skin.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1909p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cm0q1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After washing and thoroughly drying the peppers I roast them under a broiler in the oven on the highest setting until the outer skins are deeply charred turning them over halfway through. This took about 5 minutes per side and made the house smell wonderful!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"kpj5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3kn6d","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_7b6987f8154a4647819d3cee9a5cf2c9~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Roast Hatch Chili Peppers"}},{"type":"PARAGRAPH","id":"dnbq1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fl4jp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After broiling the heck out of them, I popped them into a large plastic freezer bag for 15 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2c02n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6aisp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6m9a6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ajc7r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9qk4m","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_201fbf82a7a047a3a333ae92c69503e4~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Hatch Chilies steaming in a plastic bag"}},{"type":"PARAGRAPH","id":"9isot","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8vv5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8c8n5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The steam off of the peppers fills up the bag slightly and the peppers steam for a while and the skins become loose. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3kafa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6qnf1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"22p8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"egp3b","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c72f682f96894bb397dfe386065ae57b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"seeding and peeling roast peppers"}},{"type":"IMAGE","id":"8s1rc","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_cc07044c286b47c0ad7f390c5777d513~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"seeding and peeling roast peppers"}},{"type":"PARAGRAPH","id":"2ii3b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b0vf3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After steaming the peppers are very soft and the waxy outer skins are almost falling off. I slit them open and scrape off the seeds and then turn the pepper over to lift the peel off of the flesh of the pepper. The peeled peppers are folded up to the right hand side of the photo.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b0hs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f71ng","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Essentially these are the same as those canned chilies you've probably been buying in the tiny cans in the Hispanic food section of your grocery store but the taste is incomparable! These hatch chili's have so much flavor and they are spicy. This batch of 8 peppers made about 1 cup of cooked chilies. I used it all at one time but you can freeze these roasted and peeled peppers no matter what variety you use.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7rga1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ukfk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"79usp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3k2k5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This is the same method I use to make the roasted red peppers that are popular jarred grocery store items. Made from fresh, any pepper you roast and peel yourself will be superior and I like knowing I haven't added any preservatives to mine.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c1fel","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"qboh","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1a0d47b19bef49e8b480ad9b595a5852~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"8dtss","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cdhkk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Aren't these beautiful. Just imagine one of these beauties on your next green chili burger!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e39gh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9jdt5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"As I said before, this technique works for all chilies and bell peppers and it's really easy to do so go out and buy some peppers and try it yourself.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fk5i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dcrb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7eeb2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6qn2k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6l84g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1l28k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-10T20:47:54.507Z","updatedTimestamp":"2024-06-10T20:47:54.507Z","id":"f30bb145-d7c1-4450-ac5b-c06bb5790ce7"}},"contentId":"61728aec1d9d1c0017ddc700","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_312c17e871ed4fd5a7916c073cdfe6e8~mv2_d_4032_3024_s_4_2.jpg","url":"https://static.wixstatic.com/media/577c92_312c17e871ed4fd5a7916c073cdfe6e8~mv2_d_4032_3024_