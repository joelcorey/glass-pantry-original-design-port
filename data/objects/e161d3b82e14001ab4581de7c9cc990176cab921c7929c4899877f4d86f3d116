9","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-5vc5f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/4- 1 1/2 cups lukewarm water","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-17T19:34:11.868Z","updatedTimestamp":"2023-02-17T19:34:11.868Z","id":"37ce971a-ade7-474e-a3c6-bd4a258cda6e"},"documentStyle":{}},"catagory":"Bread","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Add both flours and yeast to a stand mixer ( I don't sift) and mix on low speed with the hook attachment to somewhat combine.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"gkav34315","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-579pq","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"za5uc4316","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-f02a1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Add sourdough starter all at once and mix again on low speed to somewhat combine.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"axcst4318","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-1omhh","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"7rgup4319","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-f6hhm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Begin to drizzle in the liquid very slowly with the machine running on low speed until you have used a little more than 1 cup.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"mafzu4321","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-5sfov","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"66ocd4322","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-a8s5u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4. Allow the machine to continue to work the dough until it begins to pull away from the sides of the mixer adding more liquid tablespoon by tablespoon if it seems too dry. If you go too fast and the dough gets too wet add more bread flour a few tablespoons at a time. The dough should become just slightly sticky and be very soft in about 5 minutes. Let the machine knead a few minutes after it comes together maybe 7-8 minutes total. The dough should be just tacky now and still very soft.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"zzoec4324","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-algjq","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ycnpu4325","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-c500r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"5. Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xk9qa4327","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-1hcv2","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xpa104328","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-c7iku","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6. Gather the dough into a ball and place it in a large bowl that has a tablespoon of oil in it and roll it around so it's lightly covered with the oil. I used olive oil but any good oil will do.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"293zx4330","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-98nr8","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"bjm774331","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-fqusj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"7. Cover the bowl with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"956c34333","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-d3l6j","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yy1px4334","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-c8vqf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8. When your bread has risen until you can still see your fingerprint when you poke it gently and it doesn't immediately spring back then it's time to form your rolls as shown above.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5ms4f4405","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xrb9x4369","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"9. Form the rolls as demonstrated above.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vo9rg4379","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e002p","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"usbd34380","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-7hb60","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10. Lay them out on a parchment lined sheet pan to rise covered lightly with plastic wrap or a thin kitchen towel until they have risen 60-90 minutes. When the dough is fully risen, it should leave a small dent and not spring all the way back too quickly when you poke the dough with your fingertip.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"fqaur4382","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-fo81o","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ocak04383","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-ek13i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"11. Start preheating the oven to 450 degrees about 30 minutes before the rolls will be ready for baking. When the rolls are ready and the oven is hot. Make a very long deep slit in the top of the roll down into the filling. The rolls should start to spread apart slowly after you make the cut.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"zsfo24385","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-aesd5","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"rd4xl4386","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-djb2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"12. Put the pans into the preheated oven turn the heat down to 425 degrees and bake for 15 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"7awp84388","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-amq06","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3dz7d4389","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e1pre","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Take them out of the oven and turn the temperature down to 375 degrees. Spray the rolls with oil, sprinkle with more cheese and put them back into the oven, trays turned and shifted top to bottom from the way you took them out.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"a5ox64391","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-6vkic","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"lyhmf4392","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-80p69","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"14. Continue to bake another 5-10 minutes or until they are browned the way you like them.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"y0wcf4394","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-8uor","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"w4cee4395","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-cg42c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Notes * These rolls are crusty and somewhat crunchy if they are well browned and freshly baked. I think they are best if they are let to cool completely (as they did at Creswell Bakery) and reheated to order. The crust will soften some and become the chewy and crusty.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-17T19:34:35.284Z","updatedTimestamp":"2023-02-17T19:34:35.284Z","id":"08fdfede-77c3-4bda-aa85-2440c15fdd8e"},"documentStyle":{}},"instructions":"1. Add both flours and yeast to a stand mixer ( I don't sift) and mix on low speed with the hook attachment to somewhat combine.\n\n2. Add sourdough starter all at once and mix again on low speed to somewhat combine.\n\n3. Begin to drizzle in the liquid very slowly with the machine running on low speed until you have used a little more than 1 cup.\n\n4. Allow the machine to continue to work the dough until it begins to pull away from the sides of the mixer adding more liquid tablespoon by tablespoon if it seems too dry. If you go too fast and the dough gets too wet add more bread flour a few tablespoons at a time. The dough should become just slightly sticky and be very soft in about 5 minutes. Let the machine knead a few minutes after it comes together maybe 7-8 minutes total. The dough should be just tacky now and still very soft.\n\n5. Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other.\n\n6. Gather the dough into a ball and place it in a large bowl that has a tablespoon of oil in it and roll it around so it's lightly covered with the oil. I used olive oil but any good oil will do.\n\n7. Cover the bowl with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!\n\n8. When your bread has risen until you can still see your fingerprint when you poke it gently and it doesn't immediately spring back then it's time to form your rolls as shown above.\n\n9. Form the rolls as demonstrated above.\n\n10. Lay them out on a parchment lined sheet pan to rise covered lightly with plastic wrap or a thin kitchen towel until they have risen 60-90 minutes. When the dough is fully risen, it should leave a small dent and not spring all the way back too quickly when you poke the dough with your fingertip.\n\n11. Start preheating the oven to 450 degrees about 30 minutes before the rolls will be ready for baking. When the rolls are ready and the oven is hot. Make a very long deep slit in the top of the roll down into the filling. The rolls should start to spread apart slowly after you make the cut.\n\n12. Put the pans into the preheated oven turn the heat down to 425 degrees and bake for 15 minutes.\n\n13. Take them out of the oven and turn the temperature down to 375 degrees. Spray the rolls with oil, sprinkle with more cheese and put them back into the oven, trays turned and shifted top to bottom from the way you took them out.\n\n14. Continue to bake another 5-10 minutes or until they are browned the way you like them.\n\nNotes * These rolls are crusty and somewhat crunchy if they are well browned and freshly baked. I think they are best if they are let to cool completely (as they did at Creswell Bakery) and reheated to order. The crust will soften some and become the chewy and crusty.","title":"Stuffed Sourdough Pizza Rolls"},{"introduction":"Beautiful soft rosemary and garlic scented  harvest bread. This bread makes your house smell wonderful! It's light in texture and color with a chewy crust.","servings":"10-12","photo":"image://v1/577c92_5c302dce8f62413f842ee0bf0dcf2caa~mv2_d_4032_3024_s_4_2.jpg/4032_3024/20170523_131620.jpg","link-recipes-1-title":"/bread-and-sourdough/rosemary-garlic-sourdough-bread","url":"http://www.theglasspantry.com/single-post/2017/05/31/Rosemary-Garlic-Sourdough-Bread","image":"wix:image://v1/577c92_5c302dce8f62413f842ee0bf0dcf2caa~mv2_d_4032_3024_s_4_2.jpg/20170523_131620.jpg#originWidth=4032&originHeight=3024","_id":"2d3a63b1-50dd-4d9f-8b30-c691d0ab3961","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2023-02-17T18:37:31.228Z"},"title1":"Rosemary Garlic Sourdough Bread","shortDescription":"Beautiful soft rosemary and garlic scented  harvest bread. This bread makes your house smell wonderful! It's light in texture and color with a chewy crust.","link-recipes-1-all":"/recipes-1/","cookingTime":"40 minutes","_updatedDate":{"$date":"2023-02-18T22:23:39.172Z"},"recipesCatagoryCatagory":"/Recipes/catagory/Bread","preparationTime":"3 hours","ingredients":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 1/2 cups all-purpose flour 1 cup bread flour ( I used King Arthur Brand) ","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"oqy8t3097","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"ia11n3104","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tsp Fleischmann's active dry yeast ","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"wv9sj3112","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"6yxqu3120","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp salt","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"l7cnt3136","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"m8wpw3145","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 Tbsp crushed dried Rosemary","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"3dl233192","nodes":[],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"type":"PARAGRAPH","id":"84odp3202","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tsp dried minced garlic","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"igj8y3087","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-d70a8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup sourdough starter","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"nf4zk3223","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xlgir3234","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 to 1 1/4 cup warm water ( about 110 degrees)","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-eeubf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"(start with 1 cup and add a tablespoon at a time until the dough comes together)","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"uks1i3091","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-2u1va","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"s22kx3092","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-6ovhf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Olive Oil","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"8rpvb3094","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-5bq8e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cornmeal or Semolina Flour","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-18T22:19:23.687Z","updatedTimestamp":"2023-02-18T22:19:23.687Z","id":"e6fade18-a6d7-48b8-bd66-40be51c85719"},"documentStyle":{}},"catagory":"Bread","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the dry ingredients to a stand mixer bowl and mix them together for a few seconds.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yef112882","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e2edk","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"h9uoi2883","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-191bh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now add the sourdough starter and begin mixing on low speed slowly adding the warm water in a stream until the dough comes together and pulls away from the sides of the mixing bowl. Start with 1 cup of water and add a tablespoon at a time until the dough comes together.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yw0sh2885","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-5akpd","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"blvqr2886","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-63h0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mix on low for about 5-7 minutes or until the dough seems soft and elastic. If the dough seems too wet add more flour a few tablespoons at a time until it's just sticky.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"rm6al2888","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-dnpej","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xp8vw2889","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-6p0f7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the dough has mixed and kneaded in your mixer, turn it out onto a well floured board and flour your hands. Knead the dough by hand a few times and then form it into a ball as illustrated above. it shouldn't really be sticky any more.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"lz12l2891","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-eq1kr","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"8w7ai2892","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-3b94e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the dough to rise in an oiled bowl covered with plastic wrap until it has nearly doubled in size. This takes 60-90 minutes in my kitchen.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"it8f72894","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-a1v60","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ya86f2895","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-19p17","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Scrape the dough back out onto your floured board and knead it a few times as before but this time place it into a well floured banneton or a basket or bowl lined with a floured thin cotton towel to rise once more.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"o258q2897","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-5ag6t","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"j3xkl2898","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-fjco3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"While the dough is proofing this second time, place a large dutch oven into your oven and preheat it to 450 degrees F.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ognyh2900","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e1ttc","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"j6z0s2901","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-aqphn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After about 45-60 minutes the dough should be nearly doubled in size. Flip the dough out onto a parchment sheet generously sprinkled with cornmeal or semolina flour.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"od2932903","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-f096f","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"8ewoy2904","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-1qcka","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Take the dutch oven out of the 450 degree oven and set it on the stove top or other safe spot.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yy9nb2906","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-3c6eh","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"zka1y2907","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-dmm51","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Score your loaf as illustrated above.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ee8402909","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-42jpf","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"tunyl2910","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-boh28","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carefully remove the lid of the extremely hot dutch oven with on oven mitt and then lift the scored loaf using the paper and place it, parchment paper and all, into the preheated dutch oven.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"l1csq2912","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-5jb6t","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"iv7bd2913","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-b1j4a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Replace the lid using your oven mitt and place the dutch oven back into your oven.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"qtlm92915","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-cb1q4","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"nw4cv2916","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-dajmf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Reduce the temperature to 400 degrees and bake for 50 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3vqzv2918","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-4liek","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"a8pp62919","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-je8b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Please try to wait at least 45 minutes before slicing into this loaf if you can. You will avoid losing too much moisture as steam which will dry out the entire loaf rather rapidly.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-18T22:19:23.782Z","updatedTimestamp":"2023-02-18T22:19:23.782Z","id":"26b50aa1-0b28-44c8-b5b5-591fb30c1560"},"documentStyle":{}},"instructions":"Add the dry ingredients to a stand mixer bowl and mix them together for a few seconds.\n\n \n\nNow add the sourdough starter and begin mixing on low speed slowly adding the warm water in a stream until the dough comes together and pulls away from the sides of the mixing bowl. Start with 1 cup of water and add a tablespoon at a time until the dough comes together.\n\n \n\nMix on low for about 5-7 minutes or until the dough seems soft and elastic. If the dough seems too wet add more flour a few tablespoons at a time until it's just sticky. \n\n \n\nAfter the dough has mixed and kneaded in your mixer, turn it out onto a well floured board and flour your hands. Knead the dough by hand a few times and then form it into a ball as illustrated above. it shouldn't really be sticky any more.\n\n \n\nPlace the dough to rise in an oiled bowl covered with plastic wrap until it has nearly doubled in size. This takes 60-90 minutes in my kitchen. \n\n \n\nScrape the dough back out onto your floured board and knead it a few times as before but this time place it into a well floured banneton or a basket or bowl lined with a floured thin cotton towel to rise once more.\n\n \n\nWhile the dough is proofing this second time, place a large dutch oven into your oven and preheat it to 450 degrees F.\n\n \n\nAfter about 45-60 minutes the dough should be nearly doubled in size. Flip the dough out onto a parchment sheet generously sprinkled with cornmeal or semolina flour.\n\n \n\nTake the dutch oven out of the 450 degree oven and set it on the stove top or other safe spot.\n\n \n\nScore your loaf as illustrated above.\n\n \n\nCarefully remove the lid of the extremely hot dutch oven with on oven mitt and then lift the scored loaf using the paper and place it, parchment paper and all, into the preheated dutch oven.\n\n \n\nReplace the lid using your oven mitt and place the dutch oven back into your oven.\n\n \n\nReduce the temperature to 400 degrees and bake for 50 minutes.\n\n \n\nPlease try to wait at least 45 minutes before slicing into this loaf if you can. You will avoid losing too much moisture as steam which will dry out the entire loaf rather rapidly.","title":"Rosemary Garlic Sourdough Bread"},{"introduction":"Semolina sourdough bread is so tasty. It's one of my very favorite to make for dinner. I love what the hard semolina flour does to the texture and color of this bread. It's moist and light with a slightly chewy crust and the semolina gives it a warm inviting yellow color. It's yummy with butter or dipped in your favorite olive oil and balsamic vinegar. This bread would make excellent French Toast too.","servings":"10-12","photo":"image://v1/577c92_65effd8e06744a569d32d81bb273b1c8~mv2_d_4032_3024_s_4_2.jpg/4032_3024/20170401_162146.jpg","link-recipes-1-title":"/bread-and-sourdough/simple-semolina-sourdough-bread","url":"http://www.theglasspantry.com/single-post/2017/04/10/Simply-Semolina-Bread","image":"wix:image://v1/577c92_65effd8e06744a569d32d81bb273b1c8~mv2_d_4032_3024_s_4_2.jpg/20170401_162146.jpg#originWidth=4032&originHeight=3024","_id":"39f7fa60-2d3e-43b6-9395-fe37dde675b7","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2023-02-17T18:37:31.240Z"},"title1":"Simple Semolina Sourdough Bread","shortDescription":"Semolina sourdough bread is so tasty. It's one of my very favorite to make for dinner. I love what the hard semolina flour does to the texture and color of this bread. It's moist and light with a slightly chewy crust and the semolina gives it a warm inviting yellow color. It's yummy with butter or dipped in your favorite olive oil and balsamic vinegar. This bread would make excellent French Toast too.","link-recipes-1-all":"/recipes-1/","cookingTime":"40 minutes","_updatedDate":{"$date":"2023-02-18T22:34:28.981Z"},"recipesCatagoryCatagory":"/Recipes/catagory/Bread","preparationTime":"3 hours","ingredients":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 1/2 cups All Purpose Flour ( I use ","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"King Arthur All Purpose Flour","decorations":[{"type":"LINK","linkData":{"link":{"url":"http://www.kingarthurflour.com/shop/items/king-arthur-unbleached-all-purpose-flour-5-lb","target":"BLANK","rel":{"noreferrer":true}}}},{"type":"COLOR","colorData":{"background":"transparent","foreground":"rgb(9, 87, 162)"}},{"type":"BOLD","fontWeightValue":700.0}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" for this)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"symg54493","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-as74e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3/4 cup Semolina Flour ( I use ","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bob's Red Mill Semolina Pasta Flour","decorations":[{"type":"LINK","linkData":{"link":{"url":"http://www.bobsredmill.com/semolina-pasta-flour.html","target":"BLANK","rel":{"noreferrer":true}}}},{"type":"COLOR","colorData":{"background":"transparent","foreground":"rgb(9, 87, 162)"}},{"type":"BOLD","fontWeightValue":700.0}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":")","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"g1x584497","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-es1sj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons room temperature butter","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xee9z4499","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-737ni","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 teaspoons active dry yeast","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"nqjt94501","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e21qg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp fine sea salt","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ouq264503","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-fl4b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup sourdough starter","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"nw6ia4505","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-7u5t7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup water or whey","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-18T22:30:40.044Z","updatedTimestamp":"2023-02-18T22:30:40.044Z","id":"a924712a-1109-493d-87d6-84f52db991dc"},"documentStyle":{}},"catagory":"Bread","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Add dry ingredients and butter to a stand mixer ( I don't sift) and mix on low speed with the hook attachment to somewhat combine.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vwzdm4550","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-9e5v9","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"1pjjz4551","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-7qahg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Add sourdough starter all at once and mix again on low speed to somewhat combine.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3mpl74553","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-cc7b2","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"iei614554","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-fu32o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Begin to drizzle in the liquid very slowly with the machine running on low speed until you have used about 1 cup.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"b2j2n4556","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e02dd","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vnem24557","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-9drrj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4. Allow the machine to continue to work the dough until it begins to pull away from the sides of the mixer adding more liquid tablespoon by tablespoon if it seems too dry. If you go too fast and the dough gets too wet add more bread flour a few tablespoons at a time. The dough should become just slightly sticky and be very soft in about 5 minutes. Let the machine knead a few minutes after it comes together about 6 minutes total. The dough should be very soft and not too sticky.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xwvaa4559","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-7lt5k","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"dsxve4560","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-qovp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"5. Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"4sm224562","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-3trck","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ce7ty4563","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-mfua","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6. Gather the dough into a ball and place it in a large bowl that has a teaspoon of oil in it and roll it around so it's lightly covered with the oil. I use grape seed oil but any good oil will do.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"dn85i4565","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-aq0l3","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"q7q6z4566","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e8kja","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"7. Cover the bowl loosely with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"9cq2m4568","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-19cmu","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"e1k0x4569","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-c6sj6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8. When your bread has risen until you can still see your fingerprint when you poke it gently and it doesn't immediately spring back then it's time to form your loaf!","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vi93u4571","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-68io5","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"abwcv4572","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-2f02d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"9. Turn it out onto a floured board and degas the dough by folding it over on itself 3-4 times, then gather it back into a ball and put it into a floured proofing basket. I cover this with a cotton kitchen towel and set it back in my warm rising space on top of my stove with the range hood lights on for a little extra warmth.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"u42y94574","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-eec19","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"566me4575","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-ckg1m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10. Put a cast iron dutch oven in your oven and begin heating it to 450 degrees for at least 30 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"1ea8c4577","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-h6e8","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yh6114578","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-1bdep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"11. After 30 to 40 minutes the dough should have nearly doubled in size so prep for scoring by putting a piece of pop-up parchment paper on the breadboard and sprinkle it with cornmeal, polenta grits or semolina flour.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xyh9a4580","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-70p5u","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"1bjb44581","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-csf25","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"12. Very carefully remove the preheated dutch oven to your stove top leaving the lid on.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"eybhy4583","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-4qh9p","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5afof4584","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-8c40g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Gently roll/flip the formed loaf out of the proofing basket onto the parchment paper sprinkled with cornmeal and then quickly score the loaf with a razor blade making almost 1/2 inch deep slashes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"4p0ok4586","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-32nv7","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"i825j4587","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-jpo3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"14. Remove the lid from the dutch oven with an oven mitt and gently transfer your loaf by lifting the parchment paper and setting the whole thing in the pot paper and all. Replace the lid using an oven mitt and put the whole dutch oven back into your oven.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5k8ps4589","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-d27d9","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"c7elm4590","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-cf8rk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"15. Turn down the temperature on the oven to 425 degrees at this point and set a timer for 45 minutes. If you would like a darker crust you may want to keep it on a higher temperature but it should be done within 40-45 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yjb0p4592","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-9ao3r","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"kjw904593","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-ckn39","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bread is done when it sounds hollow when tapped on the bottom. Let cool at least an hour before slicing.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)",