","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"589e12687","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Begin heating a Dutch oven with the lid on inside of your oven to 450 degrees.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"iq46y2689","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yn9ds2691","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the dough has risen, gently roll the dough out onto a piece of parchment paper that has been sprinkled with cornmeal or polenta and score as desired. ","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"as8642693","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"f4x252695","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carefully remove the Dutch oven from the 450 degree oven. Remove the lid and lift the bread using the parchment paper and place it inside the hot dutch oven, paper and all. Replace the lid and place the dutch oven back into the hot oven and lower the heat to 425 degrees.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"2mkn02697","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"7dd332699","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bake 40 minutes without peeking.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"gmqhy2701","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"p2g032703","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Uncover your beautiful bread and carefully lift it out of the dutch oven and onto a bread board to cool using the parchment paper.","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"pxy1v2705","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"​","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"c6j6y2707","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Be sure to let it cool completely before slicing. ","decorations":[{"type":"COLOR","colorData":{"background":"transparent","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-17T19:49:12.822Z","updatedTimestamp":"2023-02-17T19:49:12.822Z","id":"431f3de5-2484-47a3-92d4-57dac359a6f9"},"documentStyle":{}},"instructions":"Add all of the dry ingredients to a mixer and mix on low speed just to combine, then add the sourdough starter and begin mixing on low speed. \n\n \n\nWith the mixer running on low speed slowly add the warm water up to one cup until the dough begins to pull away from the sides of the bowl as shown above. If the dough has not fully combined, add warm water one tablespoon at a time until it does. Be sure to give it time to mix in before each addition. If the dough becomes too wet add a little more all purpose flour until it comes together.\n\n \n\nOnce your dough has come together, continue to mix for 6-8 more minutes on low. The dough should be fairly sticky.\n\n \n\nScrape the dough onto a well floured board and knead with floured hands 4-5 times and form the dough into a ball.\n\n \n\nPlace the ball into a bowl with 2 teaspoons of olive oil and swirl it around until all sides are lightly coated with the oil.\n\n \n\nCover with plastic wrap and leave the dough to rise in a warm place until doubled. (60-90 minutes)\n\n \n\nAfter the dough has risen, move the dough back onto the floured board, knead 4-5 times and reform into a ball.\n\n \n\nPlace the ball of dough into a well floured banneton or alternatively, into a bowl lined with a thin cotton towel that has been well floured.\n\n \n\nCover with the banneton cover or a piece of plastic wrap sprayed with oil and allow the dough to rise once more in a warm place until doubled (45-75 minutes)\n\n \n\nBegin heating a Dutch oven with the lid on inside of your oven to 450 degrees.\n\n \n\nWhen the dough has risen, gently roll the dough out onto a piece of parchment paper that has been sprinkled with cornmeal or polenta and score as desired. \n\n \n\nCarefully remove the Dutch oven from the 450 degree oven. Remove the lid and lift the bread using the parchment paper and place it inside the hot dutch oven, paper and all. Replace the lid and place the dutch oven back into the hot oven and lower the heat to 425 degrees.\n\n \n\nBake 40 minutes without peeking.\n\n \n\nUncover your beautiful bread and carefully lift it out of the dutch oven and onto a bread board to cool using the parchment paper.\n\n​\n\nBe sure to let it cool completely before slicing. ","title":"Everyday Sourdough Bread"},{"introduction":"2 methods of baking, with or without using a Dutch oven. Soft large French sourdough loaf for sandwiches garlic bread or French bread Pizza!","servings":"10-12","photo":"image://v1/577c92_dde41f4bdab74bfb85ed0b1884c862eb~mv2.jpg/1500_900/20170303_183752_edited.jpg","link-recipes-1-title":"/bread-and-sourdough/sourdough-french-bread","url":"http://www.theglasspantry.com/single-post/2017/03/04/Sourdough-French-Bread","_id":"0766fd93-52d1-4594-80cc-4f2a86ef207b","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2023-02-17T18:37:31.247Z"},"title1":"Sourdough French Bread","shortDescription":"2 methods of baking, with or without using a Dutch oven. Soft large French sourdough loaf for sandwiches garlic bread or French bread Pizza!","link-recipes-1-all":"/recipes-1/","cookingTime":"40 minutes","_updatedDate":{"$date":"2023-02-18T22:48:15.938Z"},"recipesCatagoryCatagory":"/Recipes/catagory/Bread","preparationTime":"3 hours","ingredients":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 cups all purpose flour","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"nu11z5893","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-dfcsb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3/4 cup bread flour","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"2c9545895","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-ftnf4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tsp Active Dry Yeast - not instant yeast","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""