":{},"id":"v9qnm3774","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-2tp2i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"cream for brushing","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"m1sqz3776","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-677q9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"sesame seeds to sprinkle","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-18T22:24:58.887Z","updatedTimestamp":"2023-02-18T22:24:58.887Z","id":"3044be87-986b-4b06-adb3-0a420763a0bb"},"documentStyle":{}},"catagory":"Bread","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add all of the dry ingredients to a stand mixer including the butter at room temperature and then add the lightly beaten egg and the sourdough starter all at once before starting the mixer fitted with a dough hook on low. Slowly add the water or whey until the dough comes together and then continue to mix for another 6 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"clxue3868","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-c01v6","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"h16hw3869","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-he2c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the dough from the mixer and roll it into a ball. Put it in a bowl that has been sprayed with spray oil and turn it around to coat it completely finally covering it with plastic wrap to proof for about 90 minutes in a warm place.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"alfj33871","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-2es9v","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"woqaq3872","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-6t42c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After about 90 minutes the dough should rise to nearly double it's original size. Take the dough out of the bowl and onto a floured surface. Knead it a few times by folding it back onto itself then turning it halfway around and folding it back on itself again. Repeat this 2 or 3 times, then cut the dough into 8 equal pieces. I have a postage mailing scale that works very well as a kitchen scale so I weigh mine to check them. Without a scale, it's probably easiest to cut them evenly if the dough is shaped into a rectangle and then cut into 8 equal squares.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"pebqr3874","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-1g2vq","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyl