{"postPage":{"id":"3d07d46e-f3d6-44df-9575-383cc15e303c","post":{"id":"3d07d46e-f3d6-44df-9575-383cc15e303c","title":"Spicy Feel Better Broth","excerpt":"Spicy Feel Better Broth This broth makes you feel so much better! Whenever anyone in our family gets down with a cold or flu this is our...","firstPublishedDate":"2018-03-01T21:36:28.041Z","lastPublishedDate":"2018-03-01T21:36:28.041Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2018/03/01/spicy-feel-better-broth"},"slug":"2018/03/01/spicy-feel-better-broth","featured":false,"pinned":false,"categoryIds":["77a7e5bb-3035-4aec-b5d9-f3ac91f5cdd7","15abe877-7a05-4ea7-9f92-bfe7c73120b4","83230ff1-c2c7-4ffe-ad7b-bd212250ff1b","f3d78c3c-f7fd-498a-8718-f4c2bee77fea"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":39},"minutesToRead":4,"tagIds":["e8198fcd-2969-4664-82d4-e3bd7316e011","fa8e0f98-87e4-4472-9d1f-c91a2ec4a582","58a41742-7ee3-4f57-b325-8a5affa7ff31","2078634d-bf55-4f08-9def-216721c78c62"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":39,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Spicy Feel Better Broth","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Spicy Feel Better Broth | Quick Detox Broth | Immune Boosting Broth"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"PARAGRAPH","id":"9rriv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"ler7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Spicy Feel Better Broth","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"68bnc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"35pov","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a5c4cd02b4804a40a6fb562be18c6607~mv2.jpg"},"width":1500,"height":1125},"altText":"Spicy Feel Better Broth"}},{"type":"PARAGRAPH","id":"eghfp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6kep5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This broth makes you feel so much better! Whenever anyone in our family gets down with a cold or flu this is our go to recipe for boosting immunity and general symptom relief. I've been making this for years and after my kids left home they called me to ask for the recipe when they first found themselves sick and away from home. It's that comforting and we think it really helps us get over our sickness faster.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6e95j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fg4s9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9r8oi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It's full of garlic, ginger, citrus and chili peppers that help to comfort sore throats and coughs. Its also quick and easy to make. That's especially helpful if you are the sick one needing to make it.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ef81h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"la34","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If I have home made chicken stock on hand I'll use that but truthfully, I've made it many times using a good stock base for the chicken broth and I don't think it was any less effective.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eeoc6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d3b8i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband was sick last week and I didn't have time to make a stock so I made it with Minors Chicken Base. He was over his chest cold in 5 days. He is my Superman.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c95ap","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7v9hq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I started drinking 1 or 2 cups a day when he got sick and I think I may have avoided this bug almost entirely. Yesterday I was sure I was coming down with it so I drank the last 2 cups and today I feel much better! It really helped with the sore throat I had and now it's entirely gone.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7bjvm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5tuid","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I think it tastes great. I've been giving it to my kids since they were in elementary school and they like it too. My husband thinks it's pretty spicy but he also likes how effective it is so he's willing to sip it down as hot as I make it.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1l64e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"46ju8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It's definitely spicy so if that's not your thing you could leave out some of the chilies but I really recommend making this as spicy as you can handle. The capsaicin that makes the chilies \"hot\" is very effective for pain relief as odd as that sounds. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"isfp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e8kfv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6mh6n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Here is how I make this wonderful soothing and healing broth:","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6vvkf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fb66v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_848bca81ee2641d1aeece44099eb6bb2~mv2.jpg"},"width":1125,"height":1500},"altText":""}},{"type":"PARAGRAPH","id":"ek318","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I like to use my copper beverage dispenser because we can leave it on the stove top and sip cups of this throughout the day.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dfr6r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bq0bh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fhb93","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I fill it with water and bring it to a low boil then turn it down to a very low temperature to simmer for the day adding water to it as we drink it. At the end of the day, I put away whats left in pitchers in the refrigerator then we can take cupfuls out to reheat in the microwave until it's gone. It will last about one week if we don't drink it all right away.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4cq0l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"38tfg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_2a5c40b0794240ef8e5cecf670ac9741~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"3nu9d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"nv1l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I add 1 teaspoon of Minor's Chicken Base per cup of water to the pot then add the juice of a lime, an orange (or a tangelo this time) a handful of whole peeled garlic cloves, a thumb size piece of peeled and sliced ginger, 3 peeled carrots cut in 3 large pieces each and 3 dried hot chilies. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"t90m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4ahse","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4ril3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I poke a hole in the chilies so the capsaicin from the seeds can leach into the broth better without having them floating around loose in the broth. That could be a problem. Make sure the seeds stay inside the chili pods. I also left the peel on a few slices of the lime and dropped those in along with 2 bay leaves and about 10 green cardamom pods since I had some in the pantry.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ilrf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9k7vk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3gucf","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_7134b5d53f444df39d908024e9cf2081~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"ap4pm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"auqfv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Let this broth steep for 20 minutes before drinking it. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1r0qt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4gqh","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_f0d00241502c4c9e8fc9d0726cd9c2e8~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"6grc0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" It has a beautiful golden color and it's tangy and spicy with citrus and chilies.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7jq8k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2jiq8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"86umk","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_9b23b71ca8e54ecca7dd0db6929fd69f~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"1j8ja","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82co9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I leave the large pieces of carrots and spices in the broth when I put it away in the refrigerator.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5j905","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"alcim","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2p0sd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fhhla","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_cb8dac92f1d34ccbae64023630316f2e~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"fg7uq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fnumj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Strain a cup at a time into a mug and reheat in the microwave for 2 minutes. Enjoy a cup of this healing elixir anytime you need to feel better! It's all good!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5uunu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3qphj","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a5c4cd02b4804a40a6fb562be18c6607~mv2.jpg"},"width":1500,"height":1125},"altText":"Spicy Feel Better Broth"}},{"type":"PARAGRAPH","id":"1cb72","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"79amk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cu0sh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9895c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Since this was posted last march I've added some turmeric to this recipe too. I hope you give my Spicy Feel Better Broth a try the next time you feel a cold or flu coming on and let me know how it works for you.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"95dsb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7220i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Stay Healthy!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d2vf8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aic00","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"1flv0","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"aqjj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Spicy Feel Better Broth","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9q6oh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d15cm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a607v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2rvq2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5v7cr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon of Minor's Chicken Base per cup of water","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1c3be","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"start with about 12 cups of water","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2m17q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The juice of one lime","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6f12g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 wedges of lime with peel","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cn7rt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"the juice of an orange or tangelo","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bjbou","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 handful of peeled whole garlic cloves","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bur19","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 thumb size piece of ginger peeled and sliced thick","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3l6o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 carrots peeled and cut in thirds","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f19ko","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 whole dried hot chili peppers ( or as much as you can handle)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cauhk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 bay leaves","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1caq0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10 green cardamom pods (optional but good!)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"41llf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 inch turmeric root sliced in half lengthwise or 1 teaspoon dried ground.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3qqm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"58scm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4om2i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"418ji","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add 1 teaspoon of Minor's Chicken Base per cup of water to a pot then add the juices and the wedges of lime, the garlic cloves, the sliced ginger, the carrots, dried hot chilies bay leaves and cardamom pods. Bring the mixture to a low boil then turn it down to a very low simmer for the day, adding water to it as needed. You may add more Chicken Base if you think it needs it as you add more water.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cakmh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"epbsc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I poke a hole in the chilies so the capsaicin from the seeds can leach into the broth better without having them floating around loose. Make sure the seeds stay inside the chili pods.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8gtg3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aqr1d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"At the end of the day, put away the remainder in pitchers in the refrigerator. Reheat by straining out a cup at a time and heating in a microwave for 2 minutes. It will last about one week if you don't drink it all right away.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4b6pu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f5ams","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-07T00:52:56.551Z","updatedTimestamp":"2024-06-07T00:52:56.551Z","id":"1115bdfb-ee6b-49f8-937b-da00e498587f"}},"contentId":"61728aecc42843001614130d","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_a5c4cd02b4804a40a6fb562be18c6607~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_a5c4cd02b4804a40a6fb562be18c6607~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f676986b1c54b001781c707","internalCategoryIds":["5f67697cf4b0370017060141","5f67697cf4b037001706012d","5f67697cf4b037001706013d","5f67697cf4b0370017060126"],"internalRelatedPostIds":[],"isLiked":false,"isSubscribed":false,"owner":{"activityStatus":"UNKNOWN","contactId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","id":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","name":"By Melisa Smith","privacyStatus":"PUBLIC","siteMemberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","status":"UNKNOWN","isBlocked":false,"isOwner":false},"preview":false},"blog":{"settings":{"ampEnabled":false,"allPostsFeedLabel":"All Posts","comments":{"enabled":true,"anonymousEnabled":false,"ratingsEnabled":false,"ratingsMandatory":false},"revision":{"low":1,"high":0,"unsigned":false},"blocksPostPage":false,"us