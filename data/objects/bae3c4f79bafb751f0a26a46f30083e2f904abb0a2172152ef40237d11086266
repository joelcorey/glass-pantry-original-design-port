dingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bsr4t","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_1a0381bc7839470ea3f901df259e7a12~mv2.jpg"},"width":1500,"height":1125},"altText":"Kielbasa Sheet Pan Dinner"}},{"type":"PARAGRAPH","id":"bcfgf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"96gpq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b8lqr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My family loves this and it's my favorite go to dinner when I'm short on time and energy! I can chop up the ingredients, pop it in the oven and it finishes up with minimal attention so I can finish up my next blog or get some watering done in the garden. I'm sure you have your own things you could be doing on those busy nights when cooking dinner kind of gets in the way. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4jtmc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3351t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I make this all year but I think we like it best now in the fall. This could be fabulous for an Oktoberfest themed gathering too, leaving you more time for your guests.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2j4bu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bqo8b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sheet pan meals are so great. Quick to put together and they need very little attention. When I'm really busy I like to use a rope sausage for the protein because it's usually in my refrigerator unfrozen if I've forgotten to thaw something for dinner. Also because I can just quickly open the package and chop it up. Easiest prep ever! You can even leave it in large pieces if you want too. Win,Win!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1c79f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e6006","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I know you've seen plenty of sheet pan dinners, maybe even one with Kielbasa but have you tried turkey kielbasa? Most Kielbasa sausage is really fatty. When I'm hungry I want to eat more than a 2 ounce portion so I started comparing and found that my family is perfectly happy with Hillshire Farms Turkey Polska Kielbasa over the usual beef/pork variety and it has less than half the fat! They also make a smoked turkey sausage and a few flavors of chicken sausage now that are just as good. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5q4dk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"So of course you can use any sausage you choose but if you want to save yourself some fat and calories, go with turkey or chicken in this dish it's a big game changer!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2slq9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4nbns","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"8ejtb","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_1a0381bc7839470ea3f901df259e7a12~mv2.jpg"},"width":1500,"height":1125}}},{"image":{"media":{"src":{"url":"577c92_fc25101a4f0a4baf81c894479bb284d1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_ccae62d26a31451fa20d6f6bb170230d~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"7s0p9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8d8dt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"38mt9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Start heating your oven to 375 degrees and have the top rack so it's comfortably close to the top of the oven. Now get out a sheet pan. Line it with foil or parchment and then add 2 tablespoons of oil. Chop your potatoes first and toss them around in the oil your sheet pan, season them with a little seasoned salt or Old Bay seasoning and some pepper then put the pan in the oven while you prep the rest of the ingredients.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6hmr8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bm29p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Chop up some zucchini, red and green bell pepper. You can put these in one bowl to the side while you chop up 2-3 small tomatoes like the ones I get from my patio tomato plants, or roma tomatoes. I like something fleshy and compact for this recipe so they don't fall apart too much.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3gp4n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d8fdc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Set aside the tomatoes and then chop the kielbasa into segments as large as you would like. I cut mine on the bias about an inch thick.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d0imc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8mdqc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"81lcf","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_fc25101a4f0a4baf81c894479bb284d1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"20170815_183620"}},{"type":"PARAGRAPH","id":"9ebfh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fkcjb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Pull the sheet pan with the potatoes out of the oven now and add the chopped zucchini, red & green bell pepper and toss them around in the oil with the potatoes. Top with the chopped kielbasa and put the pan back in the oven.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1rrgs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6gcpe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now you are free to do your own thing for about 40 minutes while your tasty dinner roasts.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"635et","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bgp8v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After 40 minutes, come back and add the chopped tomatoes and sprinkle the sheet pan with the pine nuts then put it back in the oven for about 10 more minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cjuu5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9n9d0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"At this point your sheet pan dinner is delish and done and may be eaten as is but if you have a few more minutes to elevate this dish to the next level, read on....","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"41qg6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"899og","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6b5cp","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_5e202ace9ed941ac8da19c3bb5adc129~mv2.jpg"},"width":1500,"height":1125},"altText":"Charred Rosemary Vinaigrette Ingredients"}},{"type":"PARAGRAPH","id":"927nq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"btvsh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fj8pp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sometime while your sheet pan meal is roasting. Add 1 or 2 large sprigs of fresh rosemary straight onto the rack in the oven with the sheet pan and let it get charred a little bit, this takes about 5 minutes for me. Remove the rosemary to a cutting board and add one tablespoon of good Dijon mustard to a small bowl nearby. Remove the charred leaves from the stem of the rosemary and crush them with a mortar and pestle.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3clc2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b76ae","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"end08","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_23085e6b9293432e96ff1ec18747a9ab~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"fi2rt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8fsol","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the crushed charred rosemary to the mustard.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f4m5t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bh3s1","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8f3844e09c9147f9a1be42ca725e30d0~mv2.jpg"},"width":1500,"height":1125},"altText":"Charred Rosemary Vinaigrette"}},{"type":"PARAGRAPH","id":"d1spf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"favin","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7d5r4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next add 3 tablespoons red wine, apple cider or rose hip vinegar and 1/4 cup of walnut or olive oil. Whisk them together briskly and season your vinaigrette with salt and pepper to taste.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bb7fe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bjf4s","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e4ecc524e2ef438690f047d852228abd~mv2.jpg"},"width":1500,"height":1125},"altText":"Charred Rosemary Vinaigrette"}},{"type":"PARAGRAPH","id":"fqqh5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"av5r9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Serve at the table to drizzle over the pan roast dinner. Delicious!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bu9dj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ajau","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"182pn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4kc5o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Don't be afraid to change out the veggies depending on what you have on hand and please let me know if you find another great combination to try. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c04g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"34mti","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b6nip","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"98jva","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e0n6v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"cq8uf","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"18ius","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sheet Pan Kielbasa Dinner","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"91b1i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aa92g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6nmoc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bms1k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1 pound rope sausage","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ej996","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4 medium potatoes (any kind with the skin on)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7g1gk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 green bell pepper ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"42sir","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 red bell pepper","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8h221","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 medium to large zucchini","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c77u2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2-3 small roma tomatoes","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9d8o3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 pine nuts","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d8asn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 Tablespoons good cooking oil","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"69i3c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Seasoned salt or Old Bay Seasoning to taste","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"efti2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Pepper to taste","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8370e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fmvsh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bvle3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fe03l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2so4m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eoceo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Preheat the oven to 375 degrees, then line a sheet pan with foil or parchment paper and add the cooking oil. Chop the potatoes into bite size pieces add them to the pan and season them with the seasoned salt and pepper. Toss them in the oil on the sheet pan and put the sheet pan into the oven. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"95fta","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2in80","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next chop up the rest of the ingredients. Cut the red and green bell peppers and the zucchini into bite size pieces and set them aside. Chop the tomatoes and set them aside. Cut the Kielbasa into the size you like, I cut them on the bias into 1 inch pieces.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"egeb2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8478m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Remove the sheet pan from the oven, top it with the chopped bell peppers and zucchini and toss everything around in the oil to coat. Now top that with the chopped Kielbasa and put the sheet pan back into the oven.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5rpd6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cj52o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After 40 minutes, remove the pan from the oven and top with the chopped tomatoes and the pine nuts. Continue to bake for another 10 minutes or so until the top is browned the way you like it.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2f7od","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fbnrc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3g2k1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For the vinaigrette","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5h44t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9uv49","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 or 2 large sprigs of fresh rosemary, Charred","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fbsek","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tablespoon Dijon mustard","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4cb5c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 tablespoons vinegar, ( I use red wine, apple cider or rose hip vinegar)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3fql3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup Walnut or Olive oil","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5t8ca","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3nfha","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add 1 or 2 large sprigs of fresh rosemary straight onto the rack in the oven with the sheet pan and let it get charred a little bit (about 5 minutes). Remove it to a cutting board. Add one tablespoon of good Dijon mustard to a small bowl. Remove the charred leaves from the stem of the rosemary, crush them with a mortar and pestle then add the crushed charred rosemary to the mustard.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e40s3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e6b40","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add 3 tablespoons of your chosen vinegar and 1/4 cup of walnut or olive oil. Whisk them together briskly and season with salt and pepper.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"403fi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fi2fk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"*","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Vinaigrette Recipe adapted from Food & Wine, Charred Rosemary Vinaigrette","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b5il0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-12T10:56:07.421Z","updatedTimestamp":"2024-05-12T10:56:07.421Z","id":"b204f667-d57a-42b2-947f-7cc7805fd30f"}},"contentId":"61728aecc4284300161412f5","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_1a0381bc7839470ea3f901df259e7a12~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_1a0381bc7839470ea3f901df259e7a12~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f676980f5145c00175d8418","internalCategoryIds":["5f67697cf4b037001706012d","5f67697cf4b0370017060141","5f67697cf4b037001706013a","5f67697cf4b0370017060132","5f67697cf4b0370017060135"],"internalRelatedPostIds":[],"isLi