d":"577c92_841d9cf294714c0f84fde02b3120af87~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Clams at Mala Ocean Tavern"}},{"type":"PARAGRAPH","id":"28pjt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ucim","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This may have been my favorite lunch outside of Mama's Fish House of course! Mala Ocean Tavern is right on the water at the North end of Front Street in Lahaina. We sat outdoors, the weather was spectacular until we left when the wind started to pick up and a shower rolled through. Our timing could not have been better!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1cs1u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6j7tu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I had the best warm olive appetizer I think I've ever had here. It was so large that I took some back to share with the rest of the family later during beach time at Hale Mahina. Lunch was Manilla clams Oh! So Good! I've been told breakfast here is awesome too.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ackif","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9d44i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"1p3fi","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":