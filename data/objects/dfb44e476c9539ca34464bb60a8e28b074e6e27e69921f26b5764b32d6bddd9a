T","id":"","nodes":[],"textData":{"text":" 21.  Visit the Maui Tropical Plantation","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82f55","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"71j0b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5a1o3","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ba3330ce9baf47efbb010af9c656dbe8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Maui Tropical Plantation"}},{"type":"PARAGRAPH","id":"bddj7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This plantation is truly gorgeous if you are into landscaping at all! I think my husband and I both wished we had come to visit the plantation earlier in the week and taken the full tram tour maybe but we only had half a day and it was raining the day we went there. It was still worth the time but this adventure requires more than that to really experience it. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5b6mn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9gsqm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"There is a fabulous restaurant here called the Mill House that is on the spendy side but looks fantastic! The plantation has the largest gift shop on the entire island full of nice and affordable Maui treasures and tasty treats.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"inden