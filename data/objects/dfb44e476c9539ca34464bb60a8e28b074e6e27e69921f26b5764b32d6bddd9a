 every 20 years.  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ccl9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ch4k8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1u83n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"VIDEO","id":"2fkr","nodes":[],"videoData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"video":{"src":{"url":"https://www.youtube.com/watch?v=Y1Pq85p2XUc"}},"thumbnail":{"src":{"url":"https://img.youtube.com/vi/Y1Pq85p2XUc/mqdefault.jpg"},"width":626,"height":352}}},{"type":"PARAGRAPH","id":"5fknv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"VIDEO","id":"3dhme","nodes":[],"videoData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"video":{"src":{"url":"https://www.youtube.com/watch?v=l1R-pvOctsg"}},"thumbnail":{"src":{"url":"https://img.youtube.com/vi/l1R-pvOctsg/mqdefault.jpg"},"width":626,"height":352}}},{"type":"PARAGRAPH","id":"bhj7o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2l272","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ql7v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[