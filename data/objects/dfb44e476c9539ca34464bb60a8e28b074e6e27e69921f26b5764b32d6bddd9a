044aa6445d3444639e8060d7f007a75f~mv2.jpg"},"width":1500,"height":1125}},"title":"Hula Grill Kaanapali, Maui HI"},{"image":{"media":{"src":{"url":"577c92_6d17a03bc8264775bbe9922c8416fbf3~mv2.jpg"},"width":1125,"height":1500}},"title":"Hula Grill Kaanapali, Maui HI"},{"image":{"media":{"src":{"url":"577c92_0e5a2c97a3464a3ea3c1a87ca1318d27~mv2.jpg"},"width":1500,"height":1125}},"title":"Hula Grill Kaanapali, Maui HI"},{"image":{"media":{"src":{"url":"577c92_4f081947c68f45119c59fae4abbf1d30~mv2.jpg"},"width":1500,"height":1125}},"title":"Hula Grill Kaanapali, Maui HI"},{"image":{"media":{"src":{"url":"577c92_6293c66f8c164034b52233b88c8a84f4~mv2.jpg"},"width":1500,"height":844}},"title":"Hula Grill Kaanapali, Maui HI"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"ajhbr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d46l5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c93dp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Hula Grill at Kaanapali is a very large atmospheric restaurant with great food! As it's name suggests it's set in the resort community of Kaanapali amid the high end shopping mall and hotels. As we were a large party we did have to wait about an hour for a table but just like The Gazebo, this is such an atmospheric place it didn't seem like that long. We found a place to watch the live entertainment and get drinks while waiting and in no time we had a table that could accommodate us all! They had lovely food, service and drinks and we enjoyed the evening immensely.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"52buc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b8m8a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4dcnd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"20bfn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"25. Experience a Luau.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"126ke","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dph8b","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_98737bebcf6749dbbdb642c5598e3d9f~mv2_d_4160_2340_s_2.jpg"},"width":4160,"height":2340},"altText":"Wailele Luau, Maui, HI"}},{"type":"PARAGRAPH","id":"a349k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Wailele Luau, Maui, HI","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"4tvhq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d9mck","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dp4oa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you have never been to Hawaii, do attend a luau! This luau had spectacular entertainment. Drinks and food are included in the price of the ticket and of course it's all you can eat and drink. The servers were attentive but beware, If you intend to eat a lot, get back into line quickly because the buffet gets packed up fairly quickly and all that's left is the dessert table. Drinks do continue however.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b51a5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ah8kh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We enjoyed the opportunity to have professional pictures taken that really turned out wonderful and there were vendors available for souvenir shopping that had surprisingly good prices on their wares. We all purchased something and think we all felt great about our purchases here. Including the photography.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a7l8d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2oi2u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The entertainment was remarkable!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dvf5i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8dlja","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAl