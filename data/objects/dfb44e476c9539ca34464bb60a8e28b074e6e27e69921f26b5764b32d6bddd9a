nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5srkb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You will find this restaurant in a small mall in Napili, West Maui. It's great Filipino food with island flair. Bring your own wine or get some at the nice market next door. They have a $5 corkage fee. What a bargain! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ff0b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cm8ia","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Rumor has it that Chef Joey used to work at Roy's in Kaanapali but recently left to open this restaurant for himself. Everything we had was excellent and we found many locals who obviously ate there regularly. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dcnca","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"15dbq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We ate here more than once and some of us had the mussels more than once! Highly recommended.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cid5i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fug0q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"inden