TO"},"indentation":0}},{"type":"PARAGRAPH","id":"eo2hm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9esc2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6g34j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3ohru","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e78742076cd948d4ad2c72df31b6bbdd~mv2_d_4160_2340_s_2.jpg"},"width":4160,"height":2340},"altText":"Mama's Fish House, Maui HI"}},{"type":"PARAGRAPH","id":"4gdtb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fe59n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The Pearl of Maui as restaurants go. Or should I say Black Pearl? You'll have to see the picture of my dessert below. It's their signature dessert. All desserts are made in house by the way. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b35np","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"90uf4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We came here for lunch the week of Thanksgiving with family and friends. They don't have seating for a group larger than 5 or 6 at any one table so we had adjacent tables and visited each other during our visit to Mama's. Be sure to make reservations and come early. You will want to take in the grounds and the beach on your way in. The cove where this restaurant is located is one of the most beautiful on the Island in my opinion.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"atukh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b7827","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2q3c8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This restaurant is amazing. The staff is well trained and works as a unit. Each person plays a very specific role to ensure that guests are cared for to the best of their ability. Nothing is rushed here and service is impeccable. We had plenty of time to enjoy ourselves at Mama's. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ea2e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4l4hr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mama's Fish House is expensive but worth it! If you enjoy going to a concert or the theater and are willing to spend the money for the ticket, think of Mama's as the same kind of event. You will have a great experience beyond the excellent food and drinks here. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cvtlb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"69nu9","nodes