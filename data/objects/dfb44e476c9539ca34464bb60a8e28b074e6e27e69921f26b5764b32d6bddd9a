height":2340},"altText":"Banyan Tree, Lahaina, West Maui, HI"}},{"type":"PARAGRAPH","id":"5t33l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"22e3k","nodes":[],"imageData":{"containerData":{"width":{"size":"SMALL"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b2dbd1dbe08e406c9cf9178cb8c594f3~mv2_d_2336_4160_s_2.jpg"},"width":2336,"height":4160},"altText":"Banyan Tree, Lahaina, West Maui, HI"}},{"type":"PARAGRAPH","id":"8shef","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This historic Banyan tree covers an entire city park! It's quite a sight to see and directly in front of the old city hall that houses a wonderful little local artists gallery. It's also quite close to the best free public parking in Lahaina.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f10q0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ejs5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Parking in Lahaina is tough. It's very expensive if you can't find street parking. I highly recommend the lot at the south end of Front street that is free parking for a few hours if you can get in.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bo19l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3jgie","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Front street is known for it's quaint shops and art galleries. I'm very sad I didn't think to take pictures here because it's really something. There are also some historic buildings you can tour if you like. There are high end art galleries that are fabulous to window shop as well as trendy clothing and jewelry shops.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4opa7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ftdoj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4bii5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8o5fu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"There are also many low priced souvenir shops, so really, there is something for everyone here. Of course there are several eateries as well and this is a great place to get treats like shave ice and island coffee.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8k9ue","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2giaq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Don't forget the Honolulu Cookie store where you can sample your way through every flavor and then buy gifts for everyone at home. My cousin loves to bring these back for her friends at her office. Smart choice Patti!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1h3jf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlign