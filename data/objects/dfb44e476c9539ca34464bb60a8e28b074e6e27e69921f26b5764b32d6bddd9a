d":"b3gv0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We had the fish tacos here one day for lunch. It was really very good and they had so much more to offer. They have a great salsa bar and everything is made fresh there. This place is very popular for take out with people living or staying in local condos.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"iesq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9pgos","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d1114","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Take time for the sunsets.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1bjsh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dqf5e","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e3c874a33a81489e92d58c2a764f9e95~mv2_d_3341_2232_s_2.jpg"},"width":3341,"height":2232},"altText":"Sunset at Hale Mahina, West Maui"}},{"type":"PARAGRAPH","id":"7rg0d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Sunsets in the islands are some of the best in the world. You are on vacation so take time out to enjoy them.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"33mfb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":