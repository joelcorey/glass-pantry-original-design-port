th":5312,"height":2988}},"title":"The Buccaneer Queen"},{"image":{"media":{"src":{"url":"577c92_92ed21425f774f00ae983eb89e88e2c4~mv2_d_4128_2322_s_2.jpg"},"width":4128,"height":2322}},"title":"El Arco"},{"image":{"media":{"src":{"url":"577c92_d14bad2defec4058a41e8127b1bcd42d~mv2_d_4128_2322_s_2.jpg"},"width":4128,"height":2322}},"title":"Pedregal and Divorce Beach"},{"image":{"media":{"src":{"url":"577c92_3480003a62c34697a759a48abb4f1e84~mv2_d_4128_2322_s_2.jpg"},"width":4128,"height":2322}},"title":"Divorce Beach"},{"image":{"media":{"src":{"url":"577c92_502e6d465f034388b3e46678918881c1~mv2_d_2322_4128_s_2.jpg"},"width":2322,"height":4128}},"title":"Warm brownies and Cabernet"},{"image":{"media":{"src":{"url":"577c92_5d9f042c30e44154ba3c7526fe57cc84~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Sunset off Pedregal Beach"},{"image":{"media":{"src":{"url":"577c92_f324d2eb520a466faf0b2d4e41173dfb~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Land's End"},{"image":{"media":{"src":{"url":"577c92_15057afb603d4596952090035b85b91f~mv2_d_4128_2322_s_2.jpg"},"width":4128,"height":2322}},"title":"Time to head to back to shore."}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":4},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"4ic1b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ceqm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7d4pq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\"","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Another spectacular dining experience was at ","decorations":[{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Manta","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"ITALIC","italicData":true},{"type":"LINK","linkData":{"link":{"url":"www.mantarestaurant.com/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":". Also known as Manta at the Cape a Thompson Hotel. This is a truly stunning resort. The meal was incredible, I regret that I don't have any pictures of the Beef Yakitori, undoubtedly the favorite of our group!\"","decorations":[{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"57m5c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"340f3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"That was what I wrote last year. This year our experience was a little different. This place is still as stunning as ever and the meal could have been incredible but somehow our large group seemed to get off on the wrong foot with the kitchen. Although they have a full service menu, they recommend the chef's tasting menu in a pretty strong way. I think we all agreed we really weren't as interested in it as we were the regular menu. We were all a little disappointed at the staff response to that. Why have a regular menu if you don't want to serve whats on it?","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ssku","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6sst6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"All of our group was surprised that some of the dishes were just \"okay\" this time.  We all agreed that better sweet potatoes could have been made at home and that one New York Strip steak was probably split between the 6 or 7 of us that ordered it. The service was choreographed by a large staff but instead of feeling impressively pampered it felt forced and stuffy. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1pttq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4go3c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"euelv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"64sb4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My brother-in-law received a spectacular birthday surprise topped in edible gold leaf that was beautiful but unfortunately very, very sour with citrus. I'm afraid somehow this restaurant has erroneously perceived themselves to be in a status category they have not yet quite achieved.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"evbpo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"15jnu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"8troa","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":tr