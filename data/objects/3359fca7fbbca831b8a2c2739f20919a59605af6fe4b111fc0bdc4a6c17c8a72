":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup whole wheat flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9clid","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon salt","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3fsin","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 teaspoon active dry yeast","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3flof","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon molasses","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5opi0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3/4 cup sourdough starter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"849jp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1-1/1/4 cup 110 degree water","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b4jgo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dkqvj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fdi5f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4rnq4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add all of the dry ingredients to a mixer and mix on low speed just to combine, then add the molasses and the sourdough starter and begin mixing on low speed. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ovtp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b8v9l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"With the mixer running on low speed slowly add the warm water up to one cup until the dough begins to pull away from the sides of the bowl as shown above. If the dough has not fully combined add warm water one tablespoon at a time until it does. Be sure to give it time to mix in before each addition. If the dough becomes too wet add a little more all purpose flour until it comes together.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5vsdr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fu0ni","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Once your dough has come together, continue to mix for 6-8 more minutes on low. The dough should be fairly sticky.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1jsud","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"poj1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Scrape the dough onto a well floured board and knead with floured hands 4-5 times and form the dough into a ball.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2d4ao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"55adk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the ball into a bowl with 2 teaspoons of olive oil and swirl it around until all sides are lightly coated with the oil.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fjsca","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ssf4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cover with plastic wrap and leave the dough to rise in a warm place until doubled. (60-90 minutes)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c7oqq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"t34n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the dough has risen, move the dough back onto the floured board, knead 4-5 times and reform into a ball.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ud5f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"18m2i","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the ball of dough into a well floured banneton or alternatively, into a bowl lined with a thin cotton towel that has been well floured.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"924kj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"562rn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cover with the banneton cover or a piece of plastic wrap sprayed with oil and allow the dough to rise once more in a warm place until doubled (45-75 minutes)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ek8ok","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dgspc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Begin heating a Dutch oven with the lid on inside of your oven to 450 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a34p5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82fo9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the dough has risen, gently roll the dough out onto a piece of parchment paper that has been sprinkled with cornmeal or polenta and score as desired. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d2oud","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4o30q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carefully remove the Dutch oven from the 450 degree oven. Remove the lid and lift the bread using the parchment paper and place it inside the hot dutch oven, paper and all. Replace the lid and place the dutch oven back into the hot oven and lower the heat to 425 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cd1u2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c7t5m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bake 40 minutes without peeking.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ef6pr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"18q48","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Uncover your beautiful bread and carefully lift it out of the dutch oven and onto a bread board to cool using the parchment paper.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5a32n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bv3mt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Wait until your bread has cooled completely or at least 45 minutes before slicing if you can.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bq0rc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-16T15:45:45.370Z","updatedTimestamp":"2024-05-16T15:45:45.370Z","id":"0c0956d6-0a8e-41fb-b59f-6f08c7004a28"}},"contentId":"61728aecc42843001614130a","mostRecentContributorId"