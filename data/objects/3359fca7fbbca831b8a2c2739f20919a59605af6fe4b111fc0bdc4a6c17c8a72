,"indentation":0}},{"type":"PARAGRAPH","id":"26dhp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dt74m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"94nbi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3qh5h","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_6b58aea510c54bf3b80d29c7ece38b6d~mv2.jpg"},"width":1312,"height":984},"altText":"Whole Wheat Rye Sourdough Bread"}},{"type":"PARAGRAPH","id":"c8hrg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This large hearty loaf has great complex flavor. Lightly sweet and nutty with just enough tang from the sourdough to keep it really interesting. It's also very versatile. We like to start by using as a side at dinner but the next day or two we use it up making toast or sandwiches. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ea8lc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d5o6a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2cof6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The crust has a nice chewy texture and the crumb is fine and even with a few medium sized wholes making it great for hearty rustic sandwiches.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5jugl","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_38642555cd0d46a893448be89a2afc6f~mv2.jpg"},"width":1223,"height":917},"altText":"Whole Wheat Rye Sourdough Bread"}},{"type":"PARAGRAPH","id":"5nkv2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eajt3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"635td","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8da6u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mixing the Dough","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3i9nr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"lj4c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To start a loaf, add all of the dry ingredients to a mixer and mix on low speed just to combine, then add the molasses and the sourdough start and begin mixing on low speed. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d87sg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dq5ie","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"With the mixer running on low speed slowly add the warm water up to one cup until the dough begins to pull away from the sides of the bowl as shown below. If the dough has not fully combined add warm water one tablespoon at a time until it does. Be sure to give it time to mix in before each addition. If the dough becomes too wet add a little more all purpose flour until it comes together. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fbutb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1c7gi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Once your dough has come together, continue to mix for 6-8 more minutes on low. The dough should be fairly sticky.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bhrc4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1mjrp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Below are galleries describing the mixing, rising and forming of the loaf. Click on the pictures for greater detail.","decorations":[{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"79ttl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"8pttd","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_98b1c935c16b48828c2e53e03f404366~mv2.jpg"},"width":1500,"height":1125}},"title":"Stir the dry ingredients"},{"image":{"media":{"src":{"url":"577c92_17d61c74139e4197ac3efb1794f0cba1~mv2.jpg"},"width":1500,"height":1125}},"title":"Adding the wet ingredients"},{"image":{"media":{"src":{"url":"577c92_d6ed946d99ec481d88ee9a03aead3c18~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Slowly add the water"},{"image":{"media":{"src":{"url":"577c92_67b53148575342b9998c9889e1ba8abb~mv2.jpg"},"width":1500,"height":1125}},"title":"Continue mixing"},{"image":{"media":{"src":{"url":"577c92_80e15dad58894b62a96a21e88940d231~mv2.jpg"},"width":1130,"height":848}},"title":"Scrape the dough out"},{"image":{"media":{"src":{"url":"577c92_5f2644ad2fe644b4b8013082be990612~mv2.jpg"},"width":1173,"height":880}},"title":"Knead 4-5 times"},{"image":{"media":{"src":{"url":"577c92_91ad8ca256924cd4a0b44174f1b5d7bb~mv2.jpg"},"width":1500,"height":1125}},"title":"Place the dough"},{"image":{"media":{"src":{"url":"577c92_d998b488dfd44a97bc6b70e56159fdc2~mv2.jpg"},"width":1500,"height":1125}},"title":"Cover with plastic wrap"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"dbeuc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Scrape the dough onto a well floured board and knead with floured hands 4-5 times and form the dough into a ball then place the ball into a bowl with 2 teaspoons of olive oil and swirl it around until all sides are lightly coated with the oil. Cover with plastic wrap and leave the dough to rise in a warm place until doubled. (60-90 minutes)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"adeg9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dmnd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"27sci","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1nsft","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5run0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7mtnc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Forming the Loaf","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cjivp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"nvtl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1bdv9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the dough has risen, move the dough back onto the floured board, knead 4-5 times and reform into a ball.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"35t1c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ahvu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Place the ball of dough into a well floured banneton or alternatively, into a bowl lined with a thin cotton towel that has been well floured. Cover with the banneton cover or a piece of plastic wrap sprayed with oil and allow the dough to rise once more in a warm place until doubled (45-75 minutes)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"46pp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4l077","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Begin heating a Dutch oven with the lid on inside of your oven to 450 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ee9kr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1k57","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Below is a gallery illustrating this process. Click on the pictures for more details.","decorations":[{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"cmemu","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_ee2a587b927d42309a91c73b20cc9d94~mv2.jpg"},"width":1500,"height":1125}},"title":"After the dough has doubled"},{"image":{"media":{"src":{"url":"577c92_edccee85827d4d3eb3ad39f481aa084d~mv2.jpg"},"width":1131,"height":848}},"title":"Place the dough into"},{"image":{"media":{"src":{"url":"577c92_3a991ca655ae4ae18a500c537b1ecbf1~mv2.jpg"},"width":1500,"height":1125}},"title":"Or alternatively,"},{"image":{"media":{"src":{"url":"577c92_6f938601df7e4341a6237e07357e3ffe~mv2.jpg"},"width":1500,"height":1125}},"title":"Let rise again until doubled"},{"image":{"media":{"src":{"url":"577c92_01d40b51fe4742baa4ab4b96324a87f4~mv2.jpg"},"width":1254,"height":941}},"title":"Sprinkle cornmeal"},{"image":{"media":{"src":{"url":"577c92_790886be2f094244a1270a10e72a6856~mv2.jpg"},"width":1500,"height":1125}},"title":"Turn the dough gently"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"af1jq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" When the dough has risen this last time, gently roll the dough out onto a piece of parchment paper that has been sprinkled with cornmeal or polenta and score as desired. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dg6fa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9r20h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"lgfk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3j1uq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Scoring the Loaf","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bjk8o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"akusk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5cnia","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the loaf is formed the surface should be scored with several deep slashes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"g7m4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a9bpk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You can get artistic or simply make three or four large slashes across the top. Make the cuts quickly and decisively for the best results and be prepared to get the dough into the oven immediately after scoring.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dunpv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"ed5f6","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_23b6c20032ba4e1381b1f354c40ffea0~mv2.jpg"},"width":1500,"height":1125},"altText":"Scored Sourdough Bread Dough"}},{"type":"PARAGRAPH","id":"ac1ql","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4g0ug","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This loaf had quite a bit of oven spring and the pattern I scored broke open in a few unintended places. I think I have a tendency to make scores that bisect each other too close together. That's where my patterns sometimes break when the rise in the oven is strong.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"613h2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7n4v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"29cu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"74cr6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband gave me a very nice lame for scoring bread for Christmas and I do like it a lot. Before I had one, I was using a straight edged razor blade and it worked fine but the lame is keeps me from losing the blade which becomes almost invisible laying around by itself and it keeps my hands away from the blade. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"aptg7","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_753f7cc8e01342b3849b5b49621c636a~mv2.jpg"},"width":1500,"height":1125},"altText":"Scored Sourdough Bread Dough"}},{"type":"PARAGRAPH","id":"197db","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9d2h0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f0qg2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3b8lk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Scoring takes some practice but for me, it's one of my favorite parts about making bread. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1rag5","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8e914f2a2ab74fcbb7f85feb7ca086b4~mv2.jpg"},"width":1500,"height":1125},"altText":"Scored Sourdough Bread Dough"}},{"type":"PARAGRAPH","id":"75bsk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After scoring the loaf, carefully remove the Dutch oven from the 450 degree oven. Remove the lid and lift the bread using the parchment paper and place it inside the hot dutch oven, paper and all. Replace the lid and place the dutch oven back into the hot oven. Lower the heat to 425 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4k0ii","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ptjr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2g7cf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Bake for 40 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"500a1","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_628ec44edf974eca96ce9df7c487b432~mv2.jpg"},"width":1500,"height":1125},"altText":"Baked Whole Wheat Rye Sourdough Bread Round"}},{"type":"PARAGRAPH","id":"epl9j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" 