ation":0}},{"type":"PARAGRAPH","id":"cbkjc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cnuej","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To make Browned Butter Ricotta Wontons with Frizzled Sage  (from fresh or frozen)","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fc0g5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b5gtf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carefully drop the fresh or frozen wontons, one by one, into a pot of boiling water for about 2 minutes then remove with a slotted spoon and drain before adding to the saute' pan.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"diu8f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bjvv7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"While bringing the water to a boil for blanching the wontons, melt 1/4 cup butter and 1 1/2 tablespoons olive oil in a saute' pan on medium heat. When the butter begins to sizzle and brown, add the ribbons of sage leaves and saute' until they begin to crisp (about 1 minute). ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ceqvd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9no5b","nodes":[{"type":"TEXT","id":"","nodes":[],"textD