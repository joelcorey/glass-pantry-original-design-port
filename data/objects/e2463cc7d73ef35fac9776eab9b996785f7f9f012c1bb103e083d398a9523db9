{"postPage":{"id":"e1f53041-f19b-4317-85de-a620c0000981","post":{"id":"e1f53041-f19b-4317-85de-a620c0000981","title":"Homemade Swiss Cheese","excerpt":"Swiss Cheese is so exciting to make. Watch it swell up and marvel as the wonderful aroma begins to develop.","firstPublishedDate":"2017-04-27T01:15:51.403Z","lastPublishedDate":"2017-04-27T01:15:51.403Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/04/26/homemade-swiss-cheese"},"slug":"2017/04/26/homemade-swiss-cheese","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","2005ffa7-ea76-4f2a-93e8-f5e21b58d721"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":644},"minutesToRead":4,"tagIds":["8371e60c-c0ab-4e23-a13e-086d16647682","f29cbaae-10b0-439f-aa03-47e16e7f1b67"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":644,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Homemade Swiss Cheese","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Swiss Cheese Recipe | How to make Swiss Cheese at home | Homemade Swiss cheese"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"eag3p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Homemade Swiss Cheese","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"3vf8j","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_6be87c1c5e224e94bbe98b83aef91433~mv2_d_4128_2322_s_2.jpg"},"width":4128,"height":2322},"altText":"Gouda Swiss and Cheddar Cheeses"}},{"type":"PARAGRAPH","id":"74o32","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"gr4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Swiss Cheese is decidedly one of my favorite cheeses to make. It's so exciting to see it swelling up and then smelling the wonderful aroma that develops after just a few weeks! I wish I had begun making cheeses when my kids were still in school because cheese recipes like this make crazy fun science experiments.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8qgd1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ev9b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Various Cheeses Autumn 2016:  Fresh Gouda (top left) Swiss (top right) and two Cheddar (waxed)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"69bj3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9fmhv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ds492","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"59bu4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Making cheese is time consuming but not as much as you might think. In this recipe I spent about 1 1/2 hours stirring near the stove so I read a book while I did that. Otherwise, I was able to write this blog, do a load of laundry, and many other things while the cheese was doing it's thing on it's own in a pot or in the press. You just have to be around and pay attention to your timing. The feeling of accomplishment and the rewards of real cheese to eat are all worth it! Check out the pictures at the end of the recipe because pictures say a thousand words and there are a few tips in the captions.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8saf8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I will post this blog before the cheese is ready because it is going to take it's own wonderful time to mature and there are several steps to the aging process. None are difficult but it is cheese and so it will be ready when it's ready.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6c57b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dg7fn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bfg3k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4m3dr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"9ptv2","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_dd3fac01caae4037bc21ae773eb400ab~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"2 Gallon Copper Pot"},{"image":{"media":{"src":{"url":"577c92_e261bef046b748ed97fd43c322df2cc6~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Inoculating the milk"},{"image":{"media":{"src":{"url":"577c92_675ac45b16e24633b87e81e83b57a8b7~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Today's Cultures"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"alksq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Inoculating the milk is the first step in cheese making after sterilizing the equipment of course. You can sterilize your equipment by boiling all of it in the cheese pot before beginning or you can use a no rinse sterilizer that you can find easily online or at a brewers supply shop.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"67gl8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ckn2g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"4nb9v","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_f74089d1efba4345b9cdcb5531ffa313~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Ready to cut the curd"},{"image":{"media":{"src":{"url":"577c92_0a3b609c542948f5ba43fbec4e9e5b4c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Checkerboard cut curds"},{"image":{"media":{"src":{"url":"577c92_59712264bd64457d956029d203b64234~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"20170426_115057"},{"image":{"media":{"src":{"url":"577c92_61df6241bbbc45bfb7fc33d6ebb847ea~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Stir and stir"},{"image":{"media":{"src":{"url":"577c92_9018d0ddc0014d75b20d9fd02d0c416e~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Ah! The curds are ready!"},{"image":{"media":{"src":{"url":"577c92_f4647217496a45e7a2337f8f7d07a764~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Draining the curds"},{"image":{"media":{"src":{"url":"577c92_ccd362ee9ae64cbd8f08f1034ea0f6da~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Pouring off the whey"},{"image":{"media":{"src":{"url":"577c92_63c3d25b33a742a1941e86a31f2db271~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Curds waiting for the colander"},{"image":{"media":{"src":{"url":"577c92_b7ba01b4e58a40d6bd12b0fb9e7a6439~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Draining the whey"},{"image":{"media":{"src":{"url":"577c92_7c793841853e49d3af5e2feff50a8950~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"The curds are ready for the press"},{"image":{"media":{"src":{"url":"577c92_d130d9862ec648b1ab7449476e2c6caf~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Molding the cheese"},{"image":{"media":{"src":{"url":"577c92_32c34c484bba473da771a63a2adac100~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Heading for the press"},{"image":{"media":{"src":{"url":"577c92_a1c36a7ca6454b2894e0059227a7d0e6~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"First pressing"},{"image":{"media":{"src":{"url":"577c92_a1b462f24494465eaaf325803bb57aa4~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Whey collecting in the bowl"},{"image":{"media":{"src":{"url":"577c92_b683cbbffcfe48e4b5e04dcd7d25d076~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Redressing the cheese"},{"image":{"media":{"src":{"url":"577c92_d0d7cb856d9d48a2bcbd1c39a1b07c51~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Second Pressing"},{"image":{"media":{"src":{"url":"577c92_e6592b149f7e489f8ef093da603b6f55~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Flip and re-dress the cheese"},{"image":{"media":{"src":{"url":"577c92_9e108b754788477389f985b96eca083c~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"3rd Pressing"},{"image":{"media":{"src":{"url":"577c92_ec50f53e46b240d6bbbd49a3b1f6b077~mv2_d_3660_2745_s_4_2.jpg"},"width":3660,"height":2745}},"title":"After 3rd pressing"},{"image":{"media":{"src":{"url":"577c92_0dad79b90f6c417c8852e6a7256534c8~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Last pressing!"},{"image":{"media":{"src":{"url":"577c92_8b4f9eef3be74cdc9a7bfd81d5dbaffa~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Drying cheese cloth"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"507mn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"EQUIPMENT ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"BULLETED_LIST","id":"ul0gm9xaxdossj3265701","nodes":[{"type":"LIST_ITEM","id":"jc6039xaxdossj3265683","nodes":[{"type":"PARAGRAPH","id":"fbfh5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Large pot  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"fzg5h9xaxdossj3265685","nodes":[{"type":"PARAGRAPH","id":"t4ga","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Long Spoon  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"yba039xaxdossj3265687","nodes":[{"type":"PARAGRAPH","id":"55f1c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Thermometer  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"xjyzy9xaxdossj3265689","nodes":[{"type":"PARAGRAPH","id":"dats3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Long knife  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"k2q909xaxdossj3265691","nodes":[{"type":"PARAGRAPH","id":"2ot79","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheesecloth  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"xrvbp9xaxdossj3265693","nodes":[{"type":"PARAGRAPH","id":"bnlvi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Large Colander  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"bi1mn9xaxdossj3265695","nodes":[{"type":"PARAGRAPH","id":"anith","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheese press and 2 lb. cheese mold  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"fimm19xaxdossj3265697","nodes":[{"type":"PARAGRAPH","id":"rub7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Long Whisk  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"kl2ce9xaxdossj3265699","nodes":[{"type":"PARAGRAPH","id":"1is66","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Aging Refrigerator or Cheese Cave ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]}],"bulletedListData":{"indentation":0}},{"type":"PARAGRAPH","id":"f05vj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"INGREDIENTS","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"BULLETED_LIST","id":"3ft7g9xaxdossj3265715","nodes":[{"type":"LIST_ITEM","id":"vc5oj9xaxdossj3265703","nodes":[{"type":"PARAGRAPH","id":"8m4bh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 gallons whole milk, (Not ultra-pasteurized)  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"nlo7t9xaxdossj3265705","nodes":[{"type":"PARAGRAPH","id":"culcp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/8 tsp. Propionibacterium  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"olz8j9xaxdossj3265707","nodes":[{"type":"PARAGRAPH","id":"c5f1k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/8 tsp. bulk thermophilic culture  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"v9rxk9xaxdossj3265709","nodes":[{"type":"PARAGRAPH","id":"9nffq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 tsp. regular strength animal rennet dissolved in 1/2 cup cool water  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"82rzu9xaxdossj3265711","nodes":[{"type":"PARAGRAPH","id":"1e7no","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 Lbs.  (non-iodized)salt, sea salt or cheese salt  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]},{"type":"LIST_ITEM","id":"ot49n9xaxdossj3265713","nodes":[{"type":"PARAGRAPH","id":"5lo15","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 gallon water ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}]}],"bulletedListData":{"indentation":0}},{"type":"PARAGRAPH","id":"68u1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9rdat","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"INSTRUCTIONS","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"75msh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"difl0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Heat the milk to 87°F. Add the thermophilic culture by sprinkling it across the top of the milk and waiting 2 minutes for it to re-hydrate then stir well. Add Propionibacterium (dissolved in 1/2 cup of the warmed milk) and stir for 1 minute. Cover and allow it to ferment for 15 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"46qhl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7te7l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Keeping the temperature at 90°F. Stir to homogenize the milk and slowly fold in the diluted rennet. Using an up-and-down motion with your spoon will work the rennet through all of the milk. It also reduces the movement of the milk after the rennet is added. The milk needs to be stilled so that it can coagulate into a curd. Stirring in a circle creates a whirlpool that is difficult to stop. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a2fg7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"q07f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Allow the cheese to set for 60 minutes at 90°F, or until the whey begins to separate from the curd. You should see a layer of mostly clear whey floating on top of the curd and the curd should be pulling away from the sides of the pot. I guess I’ve never had good enough milk available for the curd to form that strongly but it does form enough and happily, I still get cheese.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bn9v8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"agavo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Using a long knife, cut the curds into 1/4-inch cubes. First slice all the way to the bottom of the pot in parallel lines across the pot in one direction, then turn the pot ¼ turn and slice all the way to the bottom of the pot in parallel lines across the pot in that direction. You should end up with a checkerboard pattern. I like to let the pot sit for 5 minutes at this point to let the curd firm up a little more.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9gevb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9qsv1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Stir the curd with a whisk, slicing it into small pieces. The pieces should all be roughly the same size.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f4tev","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Keep the curds at 90°F and stir with the long spoon, working out the whey, for 30 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cvmmd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"uc2k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Over the next 25 minutes, slowly heat the curds to 120°F, stirring frequently. As you stir, the curds will shrink. Keep the curds at 120°F for 30 minutes. The curds should be small and a handful of curds, squeezed into a ball, should fall apart in your hands.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5mmjr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4mhmc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Pour the curds-and-whey into a large colander lined with cheesecloth, capturing the whey for other projects like baking bread by placing a large bowl or pot under the colander.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ldf8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ka8s","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Put the curds wrapped in the cheesecloth into your cheese press. Work quickly because you want the curds to stay warm. Press at 10 pounds of pressure for 15 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2v374","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"607tq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Using a fresh piece of cheesecloth, flip the cheese and press again at 15 pounds of pressure for 30 minutes.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9qg2f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"735id","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Repeat this process again, at 15 pounds of pressure for 2 hours, rinsing the cheesecloth in clean, cool water each time and hanging to dry.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3lthv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c1muv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Finally, press at 20 pounds of pressure for 12 hours, or overnight.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c3hk2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fr1nd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mix 2 pounds of non-iodized salt with 1 gallon of cold water to make brine. Place the cheese in the brine and let it soak for 24 hours. I have a great brining container that I bought a sporting goods store that works spectacularly for this. It’s meant for brining chickens or pieces of meats but it brines cheese just as well!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fl8n7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8b3i5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Take the cheese out of the brine and age at 55° to 60°F for one week. Flip and wipe daily with damp cheesecloth dipped in salt water.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2f2o0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b2cqa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Move the cheese to a warm space (68-72°) and close to 80% humidity for 2 to 3 weeks. I will need to put mine into a container to maintain that humidity in my home. Flip and wipe daily with damp cheesecloth dipped in salt water. The cheese should swell and will have a characteristic Swiss cheese smell.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a2qui","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2777k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When the cheese has swollen, place the cheese in your aging refrigerator or cheese cave for 12 weeks or more. I’m going to put mine into my aging refrigerator in a container this time to try to keep the humidity closer to 80%. Flip once or twice a week and remove mold with cheesecloth dipped in salt water.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ce0qg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"20mb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7b4r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Happy Cheesemaking!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8p0np","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"i8rp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3mdp9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6p706","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d7er3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-12T10:56:07.464Z","updatedTimestamp":"2024-05-12T10:56:07.464Z","id":"50cdc533-b516-49a5-8b91-ef2ce90038ba"}},"contentId":"61728aecc4284300161412e8","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_6be87c1c5e224e94bbe98b