1~mv2_d_4032_3024_s_4_2.jpg","name":"20180425_141119.jpg","containerId":"comp-jkmq32hj","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/577c92_7e2abf06d39d4fc9bf0608cf6d775491~mv2_d_4032_3024_s_4_2.jpg/v1/fill/w_504,h_378,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180425_141119.jpg","srcset":"https://static.wixstatic.com/media/577c92_7e2abf06d39d4fc9bf0608cf6d775491~mv2_d_4032_3024_s_4_2.jpg/v1/fill/w_504,h_378,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180425_141119.jpg 1x, https://static.wixstatic.com/media/577c92_7e2abf06d39d4fc9bf0608cf6d775491~mv2_d_4032_3024_s_4_2.jpg/v1/fill/w_1008,h_756,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180425_141119.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":504,"height":378,"objectFit":"cover"}}},"containerWidth":504,"containerHeight":378,"isInFirstFold":false,"onClickBehavior":"disabled","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-jkmq32hj","mainPageId":"qgy49","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-lo1v07e11":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07e11","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jkmq32ib":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">How to know when the dough has risen properly&nbsp;and it&#39;s time to continue with the recipe:</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">When your dough has risen until you can still see the dent from your finger when you poke it gently and it doesn&#39;t immediately spring back then it&#39;s time to form your loaf after the first rise or time to bake the bread after the second rise. If it doesn&#39;t spring back at all it has over risen.</span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkmq32j8":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07e2":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07e2","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jkmq32k4":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07e3":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07e3","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jkmq32l1":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Many of my sourdough bread recipes follow the same method with only slight variations. I change up the ingredients and make different shaped loaves but they all start with the same basic bread, <a href=\"https://www.theglasspantry.com/everyday-sourdough-bread\" target=\"_blank\" class=\"wixui-rich-text__text\"><span style=\"color:#2B6CA3;\" class=\"wixui-rich-text__text\"><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Everyday Sourdough Bread.</span></span></span></a></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Once you make a few loaves using my recipes and methods you will probably find yourself feeling confident enough to experiment with&nbsp;few of your own favorite flavors and ingredients using the same principals. I hope that I&nbsp;inspire you to continue to find new and interesting breads to try.</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">Cheers!</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">~Melisa</span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkmq32ly":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07e31":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07e31","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jkmq32ms":{},"comp-jkmq32nu":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:65px;\"><span style=\"font-size:50px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:americantypwrteritcw01--731025,americantypwrteritcw02--737091,serif;\" class=\"wixui-rich-text__text\">Chocolate Rye Sourdough Bread</span></span></h1>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkmq32or":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ingredients</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkmq32pv":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 1/2 cups All Purpose Flour</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/2 cup rye&nbsp;flour</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/4 whole wheat flour</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/4 cup bread flour</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/4 cup cocoa powder</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 /2 teaspoon active dry yeast</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1&nbsp;teaspoon&nbsp;salt</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">3 tablespoons molasses</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">2 tablespoons soft butter</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 cup sourdough starter, fed the night before</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1 cup warm water + 2 tablespoons warm water</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">1/2 cup flour for forming the loaf and baking</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkmq32tb":{"pinUrl":"https://www.pinterest.com/pin/637329784744283533/","isConsentPolicyActive":false,"isMobile":false,"translations":{"componentName":"Share from Pinterest","large_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url> ","large_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","medium_element_one_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> cookie settings.<url>","medium_element_two_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> and <%=cookietype%> cookie settings.<url>","small_element_one_cookie":"<url>Update your cookie settings<url>","small_element_two_cookie":"<url>Update your cookie settings<url>","small_tooltip_one_cookie":"To view <%=componentname%>, update your <%=cookietype%> settings.","small_tooltip_two_cookie":"To view <%=componentname%>, update your <%=cookietype%> and <%=cookietype%> settings.","small_element_aria_label":"More info","tiny_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_aria_label":"Unblock <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertising":"marketing"}},"comp-lo1v07e4":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07e4","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jkmq32r5":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Method</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkmq32sb":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Add all of the dry ingredients to a mixer and mix on low speed just to combine, then add the molasses, butter and sourdough starter and begin mixing on low speed.&nbsp;</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">With the mixer running on low speed slowly add the warm water up to one cup until the dough begins to pull away from the sides of the bowl as shown above. If the dough has not fully combined, add warm water one tablespoon at a time until it does. Be sure to give it time to mix in before each addition. If the dough becomes too wet add a little more all purpose flour until it comes together. </span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Once your dough has come together, continue to mix for 6-8 more minutes on low. The dough should be just tacky now but still very soft.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Scrape the dough onto a well floured board and knead with floured hands 4-5 times and form the dough into a ball.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Place the ball into a bowl with 2 teaspoons of olive oil and swirl it around until all sides are lightly coated with the oil.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Cover with plastic wrap and leave the dough to rise in a warm place until doubled. (60-90 minutes)</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">After the dough has risen, move the dough back onto the floured board,&nbsp;knead 4-5 times and reform into a ball creating surface tension on the top of the loaf by pinching the bottom of the ball as you form it.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Place the ball of dough top down into a well floured banneton or alternatively, into a bowl lined with a thin cotton towel that has been well floured.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Cover with the banneton cover or a piece of plastic wrap sprayed with oil and allow the dough to rise once more in a warm place until doubled (45-75 minutes)</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Begin heating a Dutch oven with the lid on inside of your oven to 450 degrees.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">When the dough has risen properly ( see tips about rising above), gently roll the dough out onto a piece of parchment paper that has been sprinkled with cornmeal or polenta and score deeply as desired.&nbsp;</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Carefully remove the Dutch oven from the 450 degree oven. Remove the lid and lift the bread using the parchment paper and place it inside the hot dutch oven, paper and all. Replace the lid,&nbsp;place the dutch oven back into the hot oven and lower the heat to 425 degrees.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Bake 40 minutes without peeking.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Uncover your beautiful bread and carefully lift it out of the dutch oven and onto a bread board to cool using the parchment paper.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Be sure to let it cool completely before slicing.&nbsp;</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkmq32ue":{"id":"comp-jkmq32ue","appDefinitionId":"13016589-a9eb-424a-8a69-46cb05ce0b2c","widgetId":"130165ba-4eeb-4a87-3121-a3cf2a86d2ca","isAppInClientSpecMap":true,"isViewerMode":true,"isResponsive":false,"translations":{"preloaderOverlay":{"loading":"Loading"},"errorMessageOverlay":{"reloadText":"Refresh this page","oopsText":"App Didn't Load","installErrorText":"We Were Unable to Install This App","generalErrorPrefix":"Try again later, disable any ad blockers, or reload the page. Contact the author of","generalErrorSuffix":"for help.","uninstalledErrorText":"We Were Unable to Install This App"},"unavailableMessageOverlay":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us.","reloadText":"Refresh this page"}},"applicationId":"2979"},"comp-lo1v07e5":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07e5","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jkmq32vd":{"images":[{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_24a35ec53c4a4d41a0da9c7b7cd6d2d3~mv2_d_3000_1965_s_2.jpg","alt":"","width":3000,"height":1965,"id":"dataItem-jkmq32vl1","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_f1ab68320b444a4ca3cc0b7dd2284bf5~mv2_d_3000_4500_s_4_2.jpg","alt":"","width":3000,"height":4500,"id":"dataItem-jkmq32vl2","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-anchor":{},"uri":"b