1125},"altText":"Venison Fajitas"}},{"type":"PARAGRAPH","id":"4627l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fajitas are fabulous made with venison! If you happen to have a freezer full of delectable little round steaks you should make this too. What? No venison? Beef will make a fine substitute, no worries.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aacr3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3tdd2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband hunts so just about every year we have a deer in the freezer. This year our butcher did an exceptional job too so I'm very happy.  We have lots of tender little boneless chops and round steak along with some beautifully lean ground venison. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ken3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cbmki","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Deer are what they eat and the deer in North Central Oregon eat a lot of wheat and the meat is very clean tasting. I never have a problem with the meat tasting gamey here. If I were eating the deer from an area that was not so lucky this would be a great meal to make with it because the lime and seasonings would help lessen the gameyness.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"311dk","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_594eaffc14244adf9b3329c13fea272d~mv2.jpg"},"width":1251,"height":938},"altText":""}},{"type":"PARAGRAPH","id":"c5fu2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Don't these look good! I'll also show you how to make the Spanish rice a little later in this blog.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c5rfe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"34i4j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9pgot","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For the rub, I use a basic fajita or taco seasoning that I make up myself. I really need to get that recipe written down, I know. In the mean time, You can make up your own or use a packaged seasoning.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2vf55","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8mk4m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"2f05h","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_195b3f12c58d495ca455557a929e87df~mv2.jpg"},"width":1500,"height":1125}},"title":"Venison marinating in a dry rub"},{"image":{"media":{"src":{"url":"577c92_b565a4af4009427e899129a78dbdcc5f~mv2.jpg"},"width":1500,"height":1125}},"title":"Venison Round Steak"},{"image":{"media":{"src":{"url":"577c92_ba0c722c849543ac838ee8f8712daa07~mv2.jpg"},"width":1500,"height":1125}},"title":"Venison Round Steak"},{"image":{"media":{"src":{"url":"577c92_30c8852dbb1c4b4c910e9018482f7ba6~mv2.jpg"},"width":1500,"height":1125}},"title":"Venison Round Steaks"},{"image":{"media":{"src":{"url":"577c92_09ec12156e55495396ac36569d172e8d~mv2.jpg"},"width":1500,"height":1125}},"title":"Venison Round Steaks"},{"image":{"media":{"src":{"url":"577c92_e3297d68e1694ecc858d146a8df73478~mv2.jpg"},"width":1500,"height":1125}},"title":"Venison Round Steaks"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"8ealt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After putting the rub on the steaks I let them sit at room temperature about 30 minutes while I prepare the rest of my dinner. The steaks take only a few minutes to cook so I have everything else done before I start searing them. Click on the pictures above for a better look at the cooking process and some of the finer details. The important thing to remember is to only cook the steaks to medium rare or even closer to rare for these fajitas because the strips of meat will go back into the pepper and onion stir-fry to finish off.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1dga5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4oija","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dnmol","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7516v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4quuj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This is my simple recipe for Spanish rice. ","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8170r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1qhhh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Saute one chopped sweet onion in a tablespoon of butter or good cooking oil then add 2 1/2 cups water and 1/2 cup tomato sauce, a shake of garlic powder and a pinch of salt to the pot. Add 1 1/2 cups long grain white rice and bring the pot almost to a boil then turn the heat down to low and simmer with the lid on for 20 minutes or so. Check to see if the rice is done and fluff with a fork. If the rice isn't quite done through. Add a few tablespoons to 1/4 cup hot water and continue to simmer on low for 10 more minutes and check it again. Your Spanish rice should be done. Add more butter, olive oil or salt to taste if you like.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"auiob","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"d2hno","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_23b728d09e334d4f99e7234acd565eb8~mv2.jpg"},"width":1500,"height":1125},"altText":"Spanish Rice"}},{"type":"PARAGRAPH","id":"fgmvg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"98pgc","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_0387b02647f44704b561a2adb3cad069~mv2.jpg"},"width":1500,"height":1125},"altText":"Spanish Rice"}},{"type":"PARAGRAPH","id":"cjv1h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eebhv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Once I have my steaks in their rub and the Spanish rice cooking, I chop up some veggies for the fajitas and gather my sauce ingredients.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ki2q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dran7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6unrf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4gq32","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I've sliced one sweet onion, 1/2 a large red bell pepper and 1/2 a large green bell pepper and cut up some lime wedges. Sometimes I add a diced jalapeno or finely sliced Serrano chili. Occasionally I'll add a small tomato cut into wedges. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"12b9u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"6thdm","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8d206881197f4426856d83742b0dc93d~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"2d5qs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The three ingredients that make this fajita sauce are soy sauce, Worcestershire and lime juice. I like to use dark soy when I have it but regular soy sauce is just fine really. I learned this recipe from a Mexican friend I knew many years ago when I was working in restaurants. I'm sure they used regular soy sauce at the Mexican restaurant where he worked. I recently discovered how much more depth of flavor I get from dark soy that is particularly pleasing in this dish.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fvhhl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"flsbn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"64p8k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For the stir frying of the veggies, I used my heavy copper skillet and heated it to a medium high heat. On my stove using a copper pan I set the burner to medium and let it heat well before adding the oil and then the veggies almost immediately because the oil was shimmering. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"61jgf","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_2f7409990410432eb0921c84001bf379~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"baaao","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I stir-fry 2 minutes then add the soy sauce, Worcestershire and lime juice. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"kbm1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d3vkn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1ad8j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"f99b2","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_61300498f54647bb93ee49823ca0efdc~mv2.jpg"},"width":1500,"height":1125},"altText":"Venison Fajitas"}},{"type":"PARAGRAPH","id":"3kgq3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" After a minute or so I add the sliced venison and stir just to heat it through and I'm almost ready to serve.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d7vu2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ofui","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"31cba","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ci9te","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"While the peppers and onions were stir-frying, I heated a cast iron griddle pan to medium low heat to warm the tortillas. One at a time I warm them for about 30-45 seconds per side on the dry griddle. No oil or anything is needed.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4ik73","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8k43a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I'm using a tortilla that's made of a mix of corn and wheat flour here. I prefer corn tortillas myself but these are a little larger and hold together better. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e5ot4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7v350","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"While heating the second side of the tortilla I like to sprinkle on a few tablespoons of grated Mexican cheese and get it melting before I add the rest of the fajita toppings.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"9k5p","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_8c90efddd32847d7b8ea66a12772e88a~mv2.jpg"},"width":1109,"height":832},"altText":"Tortilla on a cast iron griddle pan"}},{"type":"PARAGRAPH","id":"51dm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now it's time to get these lovely fajitas on a plate!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9laj1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"dktmm","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c956af92359c451ea590975bc6a114bb~mv2.jpg"},"width":1369,"height":1027},"altText":""}},{"type":"PARAGRAPH","id":"3un6k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Enjoy!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c6nks","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"edvja","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"dgctt","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"8d8gt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Venison Fajitas","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6h4po","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9q1og","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"961es","nodes":[{"type":