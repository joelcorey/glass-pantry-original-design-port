 style=\"font-size:18px;\">8 Chilled Hard Boiled Eggs</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">3 - 4 teaspoons Grey Poupon Dijon Mustard</p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\">1/4 cup&nbsp;Real Mayonnaise</p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkegvgnu":{"pinUrl":"https://www.pinterest.com/pin/637329784744207112/","isConsentPolicyActive":false,"isMobile":false,"translations":{"componentName":"Share from Pinterest","large_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url> ","large_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","medium_element_one_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> cookie settings.<url>","medium_element_two_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> and <%=cookietype%> cookie settings.<url>","small_element_one_cookie":"<url>Update your cookie settings<url>","small_element_two_cookie":"<url>Update your cookie settings<url>","small_tooltip_one_cookie":"To view <%=componentname%>, update your <%=cookietype%> settings.","small_tooltip_two_cookie":"To view <%=componentname%>, update your <%=cookietype%> and <%=cookietype%> settings.","small_element_aria_label":"More info","tiny_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_aria_label":"Unblock <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertising":"marketing"}},"comp-jkegvgmz":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Method</span></span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkegvgox":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Remove the shells from the eggs then carefully cut the eggs in half lengthwise and remove the yolks to a small bowl. Crush the yolks well with the back of a fork until they are uniformly fluffy and light almost like sand.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Add the Real Mayonnaise&nbsp;and Grey Poupon Dijon Mustard then mix until very smooth. Taste the yolk mixture and&nbsp;adjust the amount of mustard and mayonnaise to your taste if needed. The texture should be smooth and fairly firm.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Spoon the yolk mixture into a piping bag fitted with a medium sized star tip or one of your choice and pipe the mixture in a swirling motion from the outside into the center of the empty egg white halves until just slightly over the top then quickly pull up and release pressure to form a sharp&nbsp;peak.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Chill well in the refrigerator then serve.</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-jkegvgpx":{"id":"comp-jkegvgpx","appDefinitionId":"13016589-a9eb-424a-8a69-46cb05ce0b2c","widgetId":"130165ba-4eeb-4a87-3121-a3cf2a86d2ca","isAppInClientSpecMap":true,"isViewerMode":true,"isResponsive":false,"translations":{"preloaderOverlay":{"loading":"Loading"},"errorMessageOverlay":{"reloadText":"Refresh this page","oopsText":"App Didn't Load","installErrorText":"We Were Unable to Install This App","generalErrorPrefix":"Try again later, disable any ad blockers, or reload the page. Contact the author of","generalErrorSuffix":"for help.","uninstalledErrorText":"We Were Unable to Install This App"},"unavailableMessageOverlay":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us.","reloadText":"Refresh this page"}},"applicationId":"2979"},"comp-jkegvgqx":{"images":[{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_24a35ec53c4a4d41a0da9c7b7cd6d2d3~mv2_d_3000_1965_s_2.jpg","alt":"","width":3000,"height":1965,"id":"dataItem-jkegvgr41","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_f1ab68320b444a4ca3cc0b7dd2284bf5~mv2_d_3000_4500_s_4_2.jpg","alt":"","width":3000,"height":4500,"id":"dataItem-jkegvgr42","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-anchor":{},"uri":"b25591_2790fd3a23db403793dbf2c3c1c62723~mv2_d_3000_1946_s_2.jpg","alt":"","width":3000,"height":1946,"id":"dataItem-jkegvgr43","title":"Add a Title","type":"Image"},{"quality":{},"link":{},"data-an