yle=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">When 10 minutes is up, I drain the pot and fill it with cold water once or twice to help cool the eggs quickly. Then I place them back into their carton and into the refrigerator to chill for at least 4&nbsp;hours or overnight.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">If I have any difficulty peeling the shells, I run the egg under cool water. It helps to get under the membrane that&#39;s sticking to the egg and the shells just slide right off.</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lo1v07891":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07891","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-jkegvges":{"crop":{"x":0,"y":0,"width":1500,"height":1125},"alt":"3 ingredient deviled eggs","width":1500,"height":1125,"uri":"577c92_71368548406c44e892c95dd9f6b20c20~mv2.jpg","name":"20180615_162306_edited.jpg","containerId":"comp-jkegvges","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/577c92_71368548406c44e892c95dd9f6b20c20~mv2.jpg/v1/fill/w_505,h_375,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20180615_162306_edited.jpg","srcset":"https://static.wixstatic.com/media/577c92_7136854840