/577c92_d5e38bcba7044cb8884f671245a8b74a~mv2.jpg/v1/fill/w_1200,h_900,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200621_151606.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":600,"height":450,"objectFit":"cover"}}},"containerWidth":600,"containerHeight":450,"isInFirstFold":true,"onClickBehavior":"disabled","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-kcuk3gtv","mainPageId":"qgy49","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-kcuk3gu6":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">This recipe will give you excellent results in just one afternoon.&nbsp;Mix the dough using a stand mixer then rise just once and you are ready to bake or grill a great hand made sourdough pizza!</span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kcuk3gul":{"html":"<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">I love my overnight long ferment <span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.theglasspantry.com/best-sourdough-pizza-crust-recipe\" target=\"_self\" class=\"wixui-rich-text__text\">Best Sourdough Pizza Crust</a></span>, don&#39;t get me wrong, but sometimes you just need it to be fast as well as great tasting.</span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></h5>\n\n<h5 class=\"font_5 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-family:avenir-lt-w01_35-light1475496,sans-serif;\" class=\"wixui-rich-text__text\">By starting with a well fed bubbly starter instead of discard starter and adding just a little active dry yeast, this pizza dough is ready in about 90 minutes. While the dough is rising you have time to gather the rest of your ingredients, preheat your oven or grill and maybe even make a homemade pizza sauce!</span></h5>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kcxtph4a":{"pinUrl":"https://www.pinterest.com/pin/637329784760908069/","isConsentPolicyActive":false,"isMobile":false,"translations":{"componentName":"Share from Pinterest","large_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url> ","large_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","medium_element_one_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> cookie settings.<url>","medium_element_two_cookie":"To view <%=componentname%>, <url>adjust your <%=cookietype%> and <%=cookietype%> cookie settings.<url>","small_element_one_cookie":"<url>Update your cookie settings<url>","small_element_two_cookie":"<url>Update your cookie settings<url>","small_tooltip_one_cookie":"To view <%=componentname%>, update your <%=cookietype%> settings.","small_tooltip_two_cookie":"To view <%=componentname%>, update your <%=cookietype%> and <%=cookietype%> settings.","small_element_aria_label":"More info","tiny_element_one_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_two_cookie":"<%=componentname%> was blocked due to your <%=cookietype%> and <%=cookietype%> cookie settings. <url>Update your settings<url>","tiny_element_aria_label":"Unblock <%=componentname%>","analytics":"analytics","functional":"functional","essential":"essential","advertising":"marketing"}},"comp-lo1v07iy":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07iy","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-kcuk3gtj":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-kcuk3gvs":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07iz":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07iz","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-kcuk3gwr":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Mix dry ingredients including the dry yeast in a stand mixer then add the starter and&nbsp;begin mixing on low speed. Slowly add up to 3/4 cup warm water or whey until the dough pulls away from the edges of the mixing bowl. Add more water 1 tablespoon at a time if needed to make the dough come together. Continue mixing to knead for 7 minutes more. The dough should be somewhat sticky at this point and very soft.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">&nbsp;&nbsp;</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Scrape the dough out onto a work board with plenty of flour then with floured hands, knead the dough 4-5 times and form it into a ball.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">&nbsp;</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Place the ball into a large bowl with 2 Tablespoons of Olive oil, roll the ball to cover it with oil then cover the bowl with a towel or plastic wrap. Let the dough rise for an hour or two in a warm place until almost doubled.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">When it&#39;s warmer outside than in house, like in the summer when I have the AC running, I set the covered dough outside (not in the direct sunlight) to speed the rising.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">After the dough has doubled in size, on a floured work space, separate the dough into 2 to 4 dough balls as you would like for the pizzas. 4 will make individual sized thin crust pizzas. 2 will make medium size pizzas about the size of the average pizza peel and little thicker. Two&nbsp;medium sized seem to puff up the best if you want big airy bubbles in your crust.</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lo1v07j0":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07j0","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-kcuk3gx5":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07j1":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07j1","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-kcuk3gxo":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:20px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">To Grill the Pizza</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Start heating your grill to its highest temperature possible and let it heat for at least 30 minutes. You will need a pizza stone unless you have a pizza oven attachment for your grill like the one we recently purchased.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">We have been using our Pizza oven attachment for our Daniel Boone Green Mountain Grill for this recipe but you can also set up a pizza stone on your grill without the attachment as I describe in my recipe for <span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.theglasspantry.com/best-sourdough-pizza-crust-recipe\" target=\"_self\" class=\"wixui-rich-text__text\">Best Sourdough Pizza Crust</a></span> which has amazing flavor but takes an extra long overnight ferment to develop. It&#39;s very easy but not very fast. Click over to that recipe for grilling instructions if you don&#39;t have a Pizza oven attachment for your grill.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">You can also bake this in a conventional oven on a pizza stone. Be sure to place the stone in the oven before you pre-heat it. It&#39;s also a great idea to line the top rack of your oven with a second pizza stone for extra heat from the top down.</span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lo1v07j2":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07j2","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-kcxu1pxg":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-kcuk3gzh":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:16px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">Cooking our pizzas in our new pizza oven attachment for our Green Mountain Grill has been amazing! It basically doubles the heat of the temperature you set it to so when set to 350 degrees I am baking my pizzas in a 700 degree oven! Yay! It literally takes about 6-7 minutes to bake a medium sized well topped pizza.&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">What we like most about using a Pizza Oven Attachment on our pellet grill is the wood fired pizza taste,&nbsp;aroma and&nbsp;those awesome toasty scorched spots!</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">It does take some getting used to because you also have to work quickly. We have decided it&#39;s time to get a second pizza peel just to keep things moving. We are usually baking 2 to 4 pizzas and can only place one at a time into the pizza oven. After removing the first pizza, our aluminum peel is very hot and you need to start the next pizza on a cool peel. We put the peel into our chest freezer to cool it between pizzas and it&#39;s worked out well so far but it&#39;s inconvenient to say the least. We&nbsp;will get another so we can rotate between them and it will be much more efficient for multiple pizzas.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Tip: Always start with a cool peel.&nbsp;</span>If the peel is hot or even too warm to the touch it will cause the dough to warm and become too soft to slide easily off the peel and into your oven. Start with a cool peel dusted generously with cornmeal or polenta for best results.</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">It&#39;s very important to place a generous amount of cornmeal on the&nbsp;pizza peel, then on a floured surface, roll out your pizza crust. Carefully pick it up or roll it over a rolling pin and place it on the cornmeal dusted pizza peel. The cornmeal will be imperative to get the pizza to slide easily off of the peel and onto the pizza stone.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Working quickly, top your pizza as desired then&nbsp;open the&nbsp;grill or oven and slide the&nbsp;pizza crust onto the hot pizza stone and close the lid/ oven door. You will need to work quickly topping the pizza so it doesn&#39;t have too much time to settle onto the the peel. If it settles too long before you slide it onto the stone you may have trouble getting it to slide off smoothly.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Tip: If you have trouble getting the pizza to slide off of an aluminum peel</span>, set the peel directly on the hot pizza stone and close the grill top as much as possible for 1-2 minutes and the pizza will begin to bake. Open the lid again and give the peel a hard horizontal shake and it should slide off onto the stone. Close the lid and continue baking another 3 minutes before turning the pizza.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Check the pizza in&nbsp;3-5 minutes. It should be about 1/2 cooked and may have&nbsp;large pockets of air forming inside the crust. These will deflate some after removal from the hot oven or grill.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">At this point you will want to turn the pizza half way around to ensure even baking/grilling. Use the pizza peel or long tongs to do this then close the lid/door for 3-5 more minutes.&nbsp;</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">If you are using a pizza oven attachment like ours, your pizza will likely be done or require only a few more minutes.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:14px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">When baking in a 500 degree oven, you will need a little longer to finish baking your pizza. Keep a close watch until you achieve&nbsp;the level of browning that you like.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">That said, the time it takes to completely bake your pizza will depend a lot on how heavily you have topped it. More veggies will add moisture and also extend cooking time. A light hand will help your pizza to cook faster and crisper whatever method you choose.</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Cheers!</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">~Melisa</span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:18px;\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></p>","skin":"WRichTextNewSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lo1v07j3":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07j3","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-kcuk3gy8":{"translations":{"title":"Widget Didn’t Load","text1":"Check your internet and refresh this page.","text2":"If that doesn’t work, contact us."}},"comp-lo1v07j31":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lo1v07j31","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-kcxtru6n":{"alt":"Fast Easy Sourdough Pizza Crust Recipe | Oven Baked Pizza Crust | Grilled Pizza Crust | Grilled Sourdough Pizza | Sourdough Discard Recipe | Green Mountain Grill Pizza Oven | Pellet Grill Pizza Oven Review","width":4032,"height":3024,"uri":"577c92_60d57de5baa3485ca09c3b8ede4d9a12~mv2.jpg","name":"20200713_194747.jpg","containerId":"comp-kcxtru6n","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/577c92_60d57de5baa3485ca09c3b8ede4d9a12~mv2.jpg/v1/fill/w_600,h_450,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200713_194747.jpg","srcset":"https://static.wixstatic.com/media/577c92_60d57de5baa3485ca09c3b8ede4d9a12~mv2.jpg/v1/fill/w_600,h_450,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/20200713_194747.jpg 1x, https://static.wixstatic.com/media/577c92_60d57de5baa3485ca09c3b8ede4d9a12~mv2.jpg/v1/fill/w_1200,h_900,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quali