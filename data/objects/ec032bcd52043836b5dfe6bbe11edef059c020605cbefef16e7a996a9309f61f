ation":0}},{"type":"PARAGRAPH","id":"8m6qi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the stir-fry sauce and stir until the sauce comes to a boil, clears, darkens and thickens slightly. Remove from heat.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6sea3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6ojj3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Serve the Firecracker glazed chicken with the pineapple stir-fry over jasmine rice with the reserved Firecracker sauce for drizzling.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eu68d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"deq9k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e33vb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2n23o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-12T10:56:07.368Z","updatedTimestamp":"2024-05-12T10:56:07.368Z","id":"30415d5b-0acc-4938-a260-906bdcb53db5"}},"contentId":"61728aecc4284300161412f2","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_c44f2387d13c4a77b2c39c19191ee796~mv2_d_4032_3024_s_4_2.jpg","url":"https://static.wixstati