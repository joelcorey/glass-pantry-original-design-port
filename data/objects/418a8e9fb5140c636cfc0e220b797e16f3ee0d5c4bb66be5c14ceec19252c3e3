.com/single-post/2017/04/01/Smoked-Tuna-Masago-Sushi-Roll","_id":"315b2b16-e317-4cab-88a4-ca324290b009","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-17T17:58:44.163Z"},"_updatedDate":{"$date":"2018-05-17T17:58:51.320Z"},"catagory":"Main Dishes","title":"Smoked Tuna Masago Sushi Roll","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_ababd40891354459af1f0e73977b51b7~mv2_d_4032_3024_s_4_2.jpg/4032_3024/Jamaican%20Beef%20Stew.jpg","url":"http://www.theglasspantry.com/single-post/2017/03/05/Jamaican-Beef-Stew","_id":"b9804f67-7d9e-4513-8dd7-e5ca9fa09aee","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-17T17:46:30.344Z"},"_updatedDate":{"$date":"2018-05-17T17:47:02.251Z"},"catagory":"Main Dishes","title":"Jamaican Beef Stew","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_c534b6f0bcd945129a8644bb646d4ab5~mv2.jpg/1500_1125/20171220_185237_edited.jpg","url":"https://www.theglasspantry.com/single-post/2018/03/05/Lucky-Irish-Shepherds-Pie","_id":"3810c2c2-e0e3-4e11-be2f-4c8993c749d9","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-04T17:10:36.420Z"},"_updatedDate":{"$date":"2022-02-23T00:01:53.795Z"},"catagory":"Main Dishes","title":"Lucky Irish Shepherd's Pie","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_23adba73d9b9419abce8adc0a3cd40c0~mv2.jpg/1500_1125/20171226_193022_edited.jpg","url":"https://www.theglasspantry.com/post/2018/03/08/irish-lamb-hand-pies","_id":"23abebfd-e830-41b5-9f1e-14b762e8d6e4","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-04T17:07:48.826Z"},"_updatedDate":{"$date":"2019-11-14T20:32:26.782Z"},"catagory":"Main Dishes","title":"Irish Lamb Hand Pies","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_bcc84e89cda3479b8fbb44b2840d036a~mv2.jpg/1500_1125/20180217_191716_edited.jpg","url":"http://www.theglasspantry.com/single-post/2018/03/18/Venison-Meatloaf","_id":"f98f2021-4092-41bd-a830-d09f94a6afbe","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-04T14:39:13.226Z"},"_updatedDate":{"$date":"2018-05-04T17:06:33.376Z"},"catagory":"Main Dishes","title":"Venison Meatloaf","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_e1589c34a2774eb0ae6692de163e92c3~mv2.jpg/1500_1125/20171230_185429_edited.jpg","url":"http://www.theglasspantry.com/single-post/2018/03/10/Sausage-Stuffed-Portabello-Mushrooms","_id":"060dfc0e-8744-43bc-84cf-8edbeba7de12","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-04T14:39:10.177Z"},"_updatedDate":{"$date":"2018-05-04T14:41:57.251Z"},"catagory":"Main Dishes","title":"Sausage Stuffed Portabello Mushrooms","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_cf1f95df41bf4f16b201672f908c8ced~mv2_d_4032_3024_s_4_2.jpg/4032_3024/20180224_182926.jpg","url":"http://www.theglasspantry.com/single-post/2018/03/12/Ricotta-Stuffed-Wontons-2-Ways","_id":"557a57ba-eabd-44c5-953e-5cdb6f4fbd75","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T17:11:43.493Z"},"_updatedDate":{"$date":"2018-05-03T17:11:52.125Z"},"ingredients":"<p>Ingredients</p>\n\n<p>&nbsp;</p>\n\n<p>For Wontons</p>\n\n<p>&nbsp;</p>\n\n<p>1 Beaten Egg</p>\n\n<p>1 Package Wonton Wrappers</p>\n\n<p>1 cup Ricotta</p>\n\n<p>4 Tablespoons shredded Parmesan</p>\n\n<p>2 teaspoons Italian seasoning</p>\n\n<p>Salt and Pepper to taste</p>\n\n<p>&nbsp;</p>\n\n<p>For&nbsp;Browned Butter&nbsp;Ricotta Wontons with&nbsp;Frizzled Sage&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>2-3 Tablespoons large fresh sage leaves rolled up like a cigar and sliced crosswise to create ribbons.</p>\n\n<p>1/4 butter</p>\n\n<p>1 1/2 Tablespoons olive oil</p>\n\n<p>12 -16 Ricotta Wontons (fresh or frozen)</p>","catagory":"Main Dishes","instructions":"<p>Method</p>\n\n<p>&nbsp;</p>\n\n<p>To make the ricotta wontons:</p>\n\n<p>&nbsp;</p>\n\n<p>Mix the ricotta with the beaten egg, the shredded Parmesan and&nbsp;Italian seasoning&nbsp;then salt and pepper to taste.&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>Drop a small spoonful onto the center of the wonton square then use your finger to dampen the edges on the wonton with water then fold and press to seal as shown above.</p>\n\n<p>&nbsp;</p>\n\n<p>Place the formed wontons onto a floured surface until you have finished filling all of the wonton wrappers.&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>To freeze wontons:</p>\n\n<p>&nbsp;</p>\n\n<p>Place the wontons on a sheet pan and freeze until firm then place them in a plastic freezer bag for storage. It&#39;s best to use them within 2-3 months.</p>\n\n<p>&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>To make Deep Fried Ricotta Wontons&nbsp;(from fresh or&nbsp;frozen)</p>\n\n<p>&nbsp;</p>\n\n<p>Carefully drop the fresh or frozen wontons, one at a time, into a deep fryer set</p>\n\n<p>at 350 degrees for about 3 minutes or until golden brown. Serve immediately.</p>\n\n<p>&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>To make&nbsp;Browned Butter Ricotta Wontons with&nbsp;Frizzled Sage&nbsp; (from fresh or&nbsp;frozen)</p>\n\n<p>&nbsp;</p>\n\n<p>Carefully drop the fresh or frozen wontons, one by one, into a pot of boiling water for about 2 minutes then remove with a slotted spoon and drain before adding to the saute&#39; pan.</p>\n\n<p>&nbsp;</p>\n\n<p>While bringing the water to a boil for blanching the wontons, melt 1/4 cup butter and 1 1/2 tablespoons olive oil in a saute&#39; pan on medium heat. When the butter begins to sizzle and brown, add the ribbons of sage leaves and saute&#39; until they begin to crisp (about 1 minute).&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>Add the drained wontons to the browned sage butter and saute&#39; until the edges of the wontons begin to brown and they are warmed completely through. Serve immediately.</p>","title":"Ricotta Stuffed Wontons 2 Ways","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_58959c460449409b9db1e8f8a9716ab3~mv2.jpg/1220_915/20180314_183649_edited.jpg","url":"http://www.theglasspantry.com/single-post/2018/04/08/Southwest-Spaghetti-Squash","_id":"b5715744-a340-4c32-a73c-9dad2f185996","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T17:10:05.545Z"},"_updatedDate":{"$date":"2018-05-03T17:10:14.016Z"},"catagory":"Main Dishes","title":"Southwest Spaghetti Squash","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_0da09940d3b84b878a0a94ee09460a27~mv2.jpg/1500_1125/20180119_183117_edited.jpg","url":"http://www.theglasspantry.com/single-post/2018/04/05/Harissa-Shrimp-Scampi","_id":"8f9ae6a6-88d4-403a-9877-82f26f6bcc30","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T17:09:06.697Z"},"_updatedDate":{"$date":"2018-05-03T17:09:21.500Z"},"catagory":"Main Dishes","title":"Harissa Shrimp Scampi","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_86c35b7f120c4c8fbf3f401d3806ce65~mv2.jpg/952_815/20180102_183938_edited.jpg","url":"https://www.theglasspantry.com/sheet-pan-chicken-shawarma","_id":"27d87d29-004e-4934-9aff-bf55ba914353","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T17:02:41.894Z"},"_updatedDate":{"$date":"2018-05-03T21:36:06.662Z"},"catagory":"Main Dishes","title":"Sheet Pan Chicken Shawarma","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_eb2b84b8da9c4f42851003aaf349c459~mv2.jpg/1500_1125/20171102_185429_edited.jpg","url":"http://www.theglasspantry.com/single-post/2018/04/01/Crispy-Fish-Tacos","_id":"eb89f42e-ca5e-4495-b744-640e163bb53b","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T17:02:40.356Z"},"_updatedDate":{"$date":"2018-05-03T17:14:06.280Z"},"catagory":"Main Dishes","title":"Crispy Fish Tacos with Cilantro Lime and Black Bean Brown Rice","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_627a83b591f142bd8cc5bd4f349b439f~mv2_d_4032_3024_s_4_2.jpg/4032_3024/20180225_185344.jpg","url":"http://www.theglasspantry.com/single-post/2018/04/13/Bulgogi-Beef-Salad-Bowl","_id":"1320f9c7-367a-4dba-8358-a7c86d4a5eb7","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T16:49:00.613Z"},"_updatedDate":{"$date":"2018-05-03T16:52:22.192Z"},"catagory":"Main Dishes","title":"Bulgogi Beef Salad Bowl","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_6fefbd775aaa47679fc420c93529613a~mv2_d_3154_2365_s_2.jpg/3154_2365/20180329_183854.jpg","url":"http://www.theglasspantry.com/single-post/2018/04/25/Turkey-Ramen-Stir-fry","_id":"9aab604e-b0f6-44d8-9d1b-5121c4cc96f1","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T16:47:01.599Z"},"_updatedDate":{"$date":"2018-05-03T16:47:08.998Z"},"ingredients":"<p>Ingredients</p>\n\n<p>&nbsp;</p>\n\n<p>1 lb.&nbsp;Ground Turkey</p>\n\n<p>2 teaspoons peanut oil</p>\n\n<p>2 cakes of Dried Ramen Noodles cooked according to package directions</p>\n\n<p>1 inch knob finely minced&nbsp;Ginger</p>\n\n<p>3 large cloves minced Garlic</p>\n\n<p>2 cups shredded Cabbage</p>\n\n<p>1/2&nbsp; a White Onion</p>\n\n<p>1/2 cup Shredded Carrots</p>\n\n<p>1 can sliced Water Chestnuts sliced into large slivers</p>\n\n<p>1 small bag Bean Shoots</p>\n\n<p>1/2 of 1 small bag of Enoki Mushrooms</p>\n\n<p>2 large Green Onions sliced</p>\n\n<p>1 bunch Cilantro chopped</p>\n\n<p>1 small Serrano Chili diced</p>\n\n<p>1/4 cup fish sauce</p>\n\n<p>1 tablespoon sesame oil</p>\n\n<p>3 tablespoon soy sauce</p>","catagory":"Main Dishes","instructions":"<p>Cook the noodles according to package directions.&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>Mix together the fish sauce, sesame oil and soy sauce then&nbsp;set it aside.</p>\n\n<p>&nbsp;</p>\n\n<p>Preheat a wok to medium high.</p>\n\n<p>&nbsp;</p>\n\n<p>Add a few teaspoons of peanut oil&nbsp;to the very hot wok then half of the ginger and garlic. Brown the ground turkey then add the rest of the ginger and garlic.</p>\n\n<p>&nbsp;</p>\n\n<p>Now add the&nbsp;cabbage,onion, carrots&nbsp;and water chestnuts. Stir-fry 2 minutes.</p>\n\n<p>Next, add the bean shoots and the green onion then stir-fry for 1 minute.</p>\n\n<p>&nbsp;</p>\n\n<p>Stir in the cooked ramen noodles and top with the stir-fry sauce. Stir-fry&nbsp;for another few minutes to incorporate the sauce and heat the noodles through.</p>","title":"Turkey Ramen Stir-fry","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},{"photo":"image://v1/577c92_a500ed3d38244476bbd882f6226c99e8~mv2_d_3148_2362_s_2.jpg/3148_2362/20180331_124045.jpg","url":"https://www.theglasspantry.com/quick-turkey-ramen-pho","_id":"c418a32d-4b5b-4d95-8490-95d68ce03174","_owner":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","_createdDate":{"$date":"2018-05-03T16:46:28.765Z"},"_updatedDate":{"$date":"2018-05-03T16:46:55.719Z"},"ingredients":"<p>Ingredients</p>\n\n<p>​</p>\n\n<p>For the Soup&nbsp;</p>\n\n<p>4-6 cups Stock of your choice</p>\n\n<p>1 black cardamom Pod</p>\n\n<p>2 lime leaves (optional)</p>\n\n<p>2-3 thick slices fresh ginger</p>\n\n<p>1 or 2 Star Anise Pods</p>\n\n<p>​</p>\n\n<p>The Noodles</p>\n\n<p>1 1/2 - 3 cups Turkey Ramen Stir Fry</p>\n\n<p>​</p>\n\n<p>The Toppings</p>\n\n<p>1/2 cup chopped cilantro</p>\n\n<p>1/2 cup chopped scallion</p>\n\n<p>1 or 2 sliced Thai, Serrano or</p>\n\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Jalapeno peppers</p>\n\n<p>1/2 cup torn Thai basil leaves</p>\n\n<p>1/2 package Enoki Mushrooms</p>\n\n<p><span class=\"wixGuard\">​</span></p>","catagory":"Main Dishes","instructions":"<p>Method</p>\n\n<p>​</p>\n\n<p>Place the thawed&nbsp;stock into&nbsp;a pot and heat it over a medium heat setting adding the fresh ginger slices, star anise,&nbsp;a black cardamom pod and lime leaves (if using).&nbsp;</p>\n\n<p>Method</p>\n\n<p><span class=\"wixGuard\">​</span></p>\n\n<p>After the broth has come to a simmer allow it to simmer for 15 minutes, then turn up the heat and get it really hot about (15 minutes )while&nbsp;preparing&nbsp;the fresh herbs for the topping.</p>\n\n<p>​​</p>\n\n<p>Let the ramen warm to room temperature while heating the broth and preparing the toppings.</p>\n\n<p>​</p>\n\n<p>Place&nbsp;some of the ramen stir-fry and enoki mushrooms in a large wide bowl,&nbsp;then top with the hot broth.</p>\n\n<p>​</p>\n\n<p>Serve with the fresh herbs, chili&#39;s and lime wedges.</p>","title":"Quick Turkey Ramen Pho","link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"}],"dynamicUrl":"/Recipes/catagory/{catagory}","config":{"dataset":{"collection":"Recipes","pageSize":100.0,"filter":{"link-Recipes-catagory-catagory":"/Recipes/catagory/main-dishes"},"collectionName":"Recipes","sort":[{"catagory":"asc"},{"_createdDate":"desc"}],"seoV2":true}},"totalCount":93.0,"schemas":{"Recipes":{"displayName":"Recipes","plugins":{},"allowedOperations":["patch","isReferenced","insert","save","bulkInsert","bulkUpdate","update","truncate","remove","removeReference","count","bulkPatch","find","replaceReferences","bulkRemove","insertReference","get","bulkSave","queryReferenced","distinct","aggregate"],"id":"Recipes","fields":{"photo":{"displayName":"Photo","sortable":true,"isDeleted":false,"type":"image","index":2.0},"url":{"displayName":"URL","sortable":true,"isDeleted":false,"type":"url","index":1.0},"_id":{"displayName":"ID","sortable":true,"isDeleted":false,"type":"text","index":7.0},"_owner":{"displayName":"Owner","sortable":true,"isDeleted":false,"type":"text","index":8.0},"_createdDate":{"displayName":"Created Date","sortable":true,"isDeleted":false,"type":"datetime","index":9.0},"_updatedDate":{"displayName":"Update