extData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ab60","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"effgs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fq57k","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ac2602f7aff64013b3b5d6e8b44f9b97~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Restaurant Style Sheet Pan Bacon"}},{"type":"PARAGRAPH","id":"bauce","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cooking great thick cut bacon could not be easier than this. It comes out perfect every time. Crispy, flat and so easy to clean up. You don't have to flip it or babysit it. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cjb2b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bn5c0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I learned about cooking bacon in the oven on a sheet pan while working in a steak house restaurant. All you have to do is lay out the bacon in a single layer across the sheet pan and bake it in a preheated oven at 400 degrees for 40 minutes. If you decide to bake regularly sliced bacon, keep in mind it will take less time. You will want to check it at about 30 minutes. I'm using 1 pound of thick bacon per sheet pan. If you do two pans at the same time, rotate your pans halfway through to help the bacon cook evenly.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"daugh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3difa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I like to add a layer of parchment paper under mine because it keeps the bacon bits from sticking completely. After removing the bacon to drain on paper towels I let it cool for about 10 minutes and pour it into a container to save for future recipes.  If I don't want to save it, I let it cool completely until it congeals into a solid and then I scrape it easily off the pan with a spatula into the garbage.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7j8sn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"eo39p","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_566d303bd31b4b1597f2a701593281ff~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Restaurant Style Sheet Pan Bacon"}},{"type":"PARAGRAPH","id":"anbqp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This method is so convenient that I don't mind making a batch just to have on hand in the refrigerator for those recipes that call for just a few slices of crisped bacon or for an occasional quick BLT sandwich for lunch. Think about how easy that is when the bacon is already made. I think we feel the same way about making bacon cheeseburgers. Prepped bacon is the best!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ag8sq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c8khf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"12hoa","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cooked bacon also freezes very well. Go ahead and make some up to store in an airtight container in the freezer so you can pop open the box and grab a few slices whenever you need them.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8hmok","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ci7de","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Click on the pictures below to get a better look.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1lhm9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"c1g10","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_9c79a486e7a4472982f8a407d41e1b65~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Lay the bacon in a single layer"},{"image":{"media":{"src":{"url":"577c92_f32d020589d941ad9d6578924e453a8c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Slightly overlapping is perfect."},{"image":{"media":{"src":{"url":"577c92_0d762acdb567499e99763c53585f1179~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"After 40 minutes at 400 degrees"},{"image":{"media":{"src":{"url":"577c92_40fb21b6c6894