{"postPage":{"id":"fb5cd897-04c2-46bb-a9b1-eb7b6a62965d","post":{"id":"fb5cd897-04c2-46bb-a9b1-eb7b6a62965d","title":"Soft Sprouted Wheat Multigrain Sourdough Sandwich Bread","excerpt":"This bread is so deliciously soft and hearty! It made wonderful toast and luscious lightly crispy grilled cheese sandwiches. I can't wai","firstPublishedDate":"2017-03-15T18:44:24.416Z","lastPublishedDate":"2017-03-15T18:44:24.416Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/03/15/soft-sprouted-wheat-multigrain-sourdough-sandwich-bread"},"slug":"2017/03/15/soft-sprouted-wheat-multigrain-sourdough-sandwich-bread","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","a3a5dcbf-0099-4cce-9147-27c56bc3988e","e444dbd4-a3f2-41ca-b0ae-85bd13111cd6"],"memberId":"4bafc351-4af6-4e6a-bf15-1ac9c1d80e80","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":752},"minutesToRead":3,"tagIds":["fb070fdd-1127-481b-9958-af2125379122","97cc5c29-3e28-491f-b2da-791004ca2ff3","6598f707-1789-4257-b5a3-3e0b3875ef1d","afc4060b-618c-4660-a430-150f124c97b6"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":752,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Soft Sprouted Wheat Multigrain Sourdough Sandwich Bread","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"How to make sprouted wheat bread | Sourdough Sandwich Bread"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"5jehl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Soft Sprouted Wheat Multigrain Sourdough Sandwich Bread","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"73tf4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ccqdd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This bread is so deliciously soft and hearty! It makes wonderful toast and luscious lightly crispy grilled cheese sandwiches. I can't wait to try it for deli roast beef and  meatloaf sandwiches the next time I make it.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ar7c5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"f0b72","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_b68c17103f4b41ad956c481765071ed0~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"ds8gl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1i8g8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3bgri","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8v9pg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d7b745b69a314c05b1593a9736a35a47~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"afvuk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1760u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eeomr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This loaf started out with all of the dry ingredients and 1 cup of sourdough starter in my stand mixer on low speed. Then I slowly added the warm whey (you could use warm water or skim milk) until it came together in a soft dough. Then I kneaded it just a minute or two before forming it into a ball and rolling it in a large bowl with a little oil to coat it.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bfpci","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"9bh2o","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_c4645eed9e6449c38d3c901f6bf99953~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Seed mixture"},{"image":{"media":{"src":{"url":"577c92_d8a9d07fbed343c78bcb027acf3c9354~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Dry Ingredients"},{"image":{"media":{"src":{"url":"577c92_343f89e2cd974a33b937770723285792~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Add the Sourdough Starter"},{"image":{"media":{"src":{"url":"577c92_70dd6e40249e4a08a876820742072ad4~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Sourdough added"},{"image":{"media":{"src":{"url":"577c92_0b8cfb6df2fd49269e72ece4de5195df~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Mix it up!"},{"image":{"media":{"src":{"url":"577c92_e0bea68317f3498b8cf78bc159172a7f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Now it looks ready!"},{"image":{"media":{"src":{"url":"577c92_5429826194254d53b7fb06e5ec1024b8~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Knead a minute or two"},{"image":{"media":{"src":{"url":"577c92_d76c87808ed84d08a353157c86590f3c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"First Rise"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"26im0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It rested for an hour or so until it was doubled in size, then I formed it into a loaf by rolling it up like a newspaper and settling it into a large glass loaf pan lightly sprayed with oil to rise again loosely covered in plastic wrap sprayed with oil.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"744vd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4l1cd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"h5uu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"od9c","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_1df1b8100fa8426890945866db96a8d6~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Ready for forming the loaf"},{"image":{"media":{"src":{"url":"577c92_9c7ca98cb91441b9a651c57201051ffb~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Rolling like a newspaper"},{"image":{"media":{"src":{"url":"577c92_dc72015f1db14226ac9212417d4b588d~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Forming the loaf"},{"image":{"media":{"src":{"url":"577c92_e7b17bbeedf8424bade3600279227c6b~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Forming the loaf"},{"image":{"media":{"src":{"url":"577c92_093bd5e4965c4d4cae875fa24f5a8977~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Ready for the pan"},{"image":{"media":{"src":{"url":"577c92_b319ed5136a84ab0b800466764752df6~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"2nd Rise"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"eke3f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fal88","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After it had risen again it was time for the oven. This only takes about 45 minutes in my kitchen so I got the oven going on 375 degrees when I set it up for it's second rise. Unfortunately I forgot to take a picture of the beautifully risen loaf just before it went into the oven when I brushed it with some melted butter. Ooops! It was lovely!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3dub3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d5sm6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"30akr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"a3t72","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d2a4f95e0baa4ca7a931fe7bf4aac552~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":""}},{"type":"PARAGRAPH","id":"5j84l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7hojp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7tnd2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"So this is it! Brush it again with some melted butter and let it cool for about 10 minutes before loosening it from the pan and cooling it on a wire rack. I often use a thin metal spatula to loosen the sides and then lay it on one side until it cools flipping from side to side to help it along. Let it cool for at least 45 minutes before cutting if you can stand it. The top gets softer and the sides firm up as it cools making a wonderfully sliceable texture perfect for sandwiches","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5bi1e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9olu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"82gu9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This sounds like a lot of work but the active time is only 40 minutes of the total 2 1/2- 3 hours, the rest is rising and baking time and the results are completely worth it!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bb0a2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3adas","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Happy Baking!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ba1a2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dos9g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"cm125","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"a126","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Soft Sprouted Wheat ","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"1ff4f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Multigrain Sourdough Sandwich Bread","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8qojh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"62bkn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c30ba","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d885c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dkt1n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 1/2 cups all purpose flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8ge88","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2  cup bread flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"39fld","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2  cup sprouted wheat flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bdbsu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp fine salt","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eohss","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tsp active dry yeast","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1tp9m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons each, flax seed, poppy seed and white sesame seeds","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9r842","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"    I think millet or chia seeds would work really well in this mix too","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5uaep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons butter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ia3h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons honey","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bs6t3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup sourdough starter - mine is usually fed and about the consistency of pancake batter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"flg3a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/4-1/2 cups lukewarm whey or water or skim milk","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9g5t3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"melted butter for brushing the top twice","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ndns","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fge5c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1flht","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bgufk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5hao1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Mix all of the dry ingredients then add the butter, honey and sourdough starter.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"43iv7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Slowly add a cup of the warm whey while the mixer is running on low speed until the dough begins to come together adding more if you need it a tablespoon at a time. You can add a bit more flour if you go over and it gets too sticky. Let the mixer knead the dough 7-8 minutes more.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1lg58","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4r9r6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now scrape the dough out of the mixer and onto a floured board. Knead the dough for a minute or two then shape it into a ball. Roll it around in a large bowl with a little good quality oil to coat it and cover it with plastic wrap to rise for about 1 1/2 hours.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d1ajd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bn8f0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the dough has risen to about double in size you can form your loaf by kneading a few times then rolling the dough up like a newspaper and pinching closed the seem. See the illustrations above for more tips on forming your loaf.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8jqkj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dncel","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Let the dough rise in the loaf pan covered loosely with plastic wrap that has been sprayed with oil for about 30 minutes to 1 hour while preheating your oven to 375 degrees.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1o0u2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"evatq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After the dough has risen 1/2 inch or so above the rim of your loaf pan, remove the plastic wrap, gently brush the top with melted butter and then put it on the middle rack in the preheated oven for 25-30 minutes. It will rise even more in the oven so be sure it's not too close to the top element. Turn the loaf front to back halfway through to ensure even baking and color. When it's done it will sound quite hollow on top when tapped.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4g0t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"460ch","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Brush it again with melted butter and let it cool for about 10 minutes before loosening it from the pan and cooling it on a wire rack. Let cool at least 45 minutes before cutting.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"foda1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"910na","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-18T18:02:21.123Z","updatedTimestamp":"2024-05-18T18:02:21.123Z","id":"b08b9d19-8f12-49d9-a138-a77b9ced2b53"}},"contentId":"61728aecc4284300161412e3","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_b68c17103f4b41ad956c481765071ed0~mv2_d_4032_3024_s_4_2.jpg","url":"https://static.wixstatic.com/media/577c92_b68c17103f4b41ad956c481765071ed0~mv2_d_4032_3024_s_4_2.jpg","height":3024,"width":4032}},"displayed":true,"custom":false},"translations":[],"customExcerpt":true,"internalId":"5f6769804f34aa001761fd2c","internalCategoryIds":["5f67697cf4b037001706012d","5f67697cf4b0370017060123","5f67697cf4b037001706013e"],"internalRelatedPostIds":[],"isLiked":false,"isSubscribed":false,"owner":{"activityStatus":"UNKNOWN","contactId":"4bafc351-4af6-4e6a-bf15-1ac9c1d80e80","id":"4bafc351-4af6-4e6a-bf15-1ac9c1d80e80","name":"Melisa Smith","privacyStatus":"PUBLIC","siteMemberId":"4bafc351-4af6-4e6a-bf15-1ac9c1d80e80","status":"UNKNOWN","isBlocked":false,"isOwner":false},"preview":false},"blog":{"settings":{"ampEnabled":false,"allPostsFeedLabel":"All Posts","comments":{"enabled":true,"anonymousEnabled":false,"ratingsEnabled":false,"ratingsMandatory":false},"revision":{"low":1,"high":0,"unsigned":false},"blocksPostPage":false,"useBlogLikeService":true,"allPosts":"All Posts"},"translations":{"en":"All Posts"},"blogSettingsV2":{"ampEnabled":false,"allPostsFeedLabel":"All Posts","comments":{"enabled":true,"anonymousEnabled":false,"ratingsEnabled":false,"ratingsMandatory":false},"revision":{"low":1,"high":0,"unsigne