{"postPage":{"id":"803a5dd2-0a2b-4e76-b1d4-e8fb79972165","post":{"id":"803a5dd2-0a2b-4e76-b1d4-e8fb79972165","title":"Fried Green Tomatoes","excerpt":"Fried Green Tomatoes Do you grow tomatoes? If you do then this recipe is for you! The end of tomato season is near and it always seems...","firstPublishedDate":"2017-09-25T00:03:20.289Z","lastPublishedDate":"2017-09-25T00:03:20.289Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/09/20/fried-green-tomatoes"},"slug":"2017/09/20/fried-green-tomatoes","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","ecbcfcfe-4a80-42f2-bfc4-b104a8dcf8fd","7d525f78-2dd8-406c-9140-22b38e2eeded"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":53},"minutesToRead":3,"tagIds":["ff129fac-442c-485a-95f9-57cc9b0ce016","1e81da7d-64f5-4920-8fae-1b71a92309d1","d186ba53-8bf3-4827-bccf-9edb4e3b4700","9e49ba9d-58b1-47aa-93dc-50c5a271dc97","50eb0648-a970-493a-bb86-f112fdd53943"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":53,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Fried Green Tomatoes","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Fried Green Tomatoes | Salt Pork | Creme Fraiche"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"3df1j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fried Green Tomatoes","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"aa77v","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c9a0543cbfa64776bcd7fcfce4d03439~mv2.jpg"},"width":1500,"height":1125},"altText":"Fried Green Tomatoes"}},{"type":"PARAGRAPH","id":"1sqh9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a97is","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Do you grow tomatoes? If you do then this recipe is for you! The end of tomato season is near and it always seems that there are plenty of tomatoes still on the vine that just will not ripen so why not pick them now and fry them up? ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"964l8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2t5ee","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" This is a classic southern recipe that really is somewhat of a delicacy because you of have to grow your own or know someone who grows a lot of them to get any tomatoes that are green. I mean really, have you ever seen green tomatoes for sale in the market?","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b56ga","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ced80","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I remember eating these when I was growing up. We had this huge garden and always had lots of tomatoes. I really like these in the morning with an egg over easy or with thin skillet fried elk or venison steaks but tonight they are an appetizer served with a drizzle of creme fraiche then topped with garden chives and salt pork croutons.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5d7ep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8o5ss","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"m97t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"4m9tf","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_dbb32dbf59324c4c95e82364c8d4c0db~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}},{"image":{"media":{"src":{"url":"577c92_919878d9221c47b6b4a2fb4ac18d2861~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}}}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"daa0l","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2o01t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Every now and then I like to buy a small package of salt pork to kick up a few dishes like this one.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5psh5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9hvg8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I chop salt pork into 1/4 inch diced pieces and saute them over medium heat until the oil is rendered out and I'm left with glorious little crispy bits. The fragrant almost bacon like fat will flavor my fried green tomatoes and the tasty croutons will be a delicious crunchy topping.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6nv05","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ujrr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5d242","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Now it's time to get those tomatoes frying! Be sure to use very firm green tomatoes and cut them evenly in a thick quarter inch slice.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8elfv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2pgou","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_582e3f24de294642a9435eb3cb60c0a3~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"How to Fry Green Tomaotes"}},{"type":"PARAGRAPH","id":"9mvtf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cndde","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" First I dredge the slices in seasoned flour, then in an egg wash. Some people use a few tablespoons of milk whisked into the egg wash but I've used water. Last the tomato is dredged through some corn meal and it's into the frying pan.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"apt2d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"edhhk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I'm using a heavy copper saute pan here so if you don't have one, the next and maybe some would say the best pan to use is cast iron. Make sure you use enough oil to cover the bottom of the pan and get the pan good and hot before you add the tomatoes or your breading will turn to mush. If the salt pork doesn't render quite enough fat don't worry add some vegetable oil and you will still have some great porky flavor!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8urhn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5ivj9","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_13a9ed3286b4421bb6091f86a890365b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"Fried Green Tomatoes"}},{"type":"PARAGRAPH","id":"493lj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fslk6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e3dth","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Fry each side until they are golden brown. The tomatoes should just be starting to turn soft but still hold their shape. You can remove them to a paper towel lined plate to drain a little bit if you think they seem too oily. If the tomatoes are fried in oil that's not quite hot enough they will take too long and the oil will be absorbed into the breading making them too oily so I try to heat the oil until it's shimmering and barely starting to smoke. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1omar","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6b0cf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"11bj4","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4229825acebc4889a38bd2bf9f37fca7~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032},"altText":"Fried Green Tomatoes"}},{"type":"PARAGRAPH","id":"b1kta","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ir8m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now this appetizer is ready to plate! I lay the tomatoes out in pretty rows, top with a few tablespoons of creme fraiche and then sprinkle with the chopped chives and salt pork croutons. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f8kj7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2kojt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"et2c8","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ffd3c4821d6c48e386e5058cde95c30a~mv2.jpg"},"width":1500,"height":1125},"altText":"Fried Green Tomatoes Appetizer"}},{"type":"PARAGRAPH","id":"25n69","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fbunu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" That's it! I think these tomatoes are really tasty. Crispy, sour and creamy complimented by the crunchy and salty little pork croutons. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eog20","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dj0s7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I hope you'll try this with your tomatoes this year.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7imgc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"csff4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8kneg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Happy Fall and enjoy the last fruits of your garden.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bic2t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"942ph","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"9ugvh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fried Green Tomatoes","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eeo5v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dqa1h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"12u2c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9eio2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 large green tomato sliced into 4-5 slices a fat 1/4 inch thick","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"erfks","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 large egg beaten with 2 tablespoons of water","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"76b3g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup flour ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6qpkb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tablespoon seasoned salt or Old Bay seasoning ( I like to use Old Bay)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2hspc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 teaspoon pepper ( optional if you use Old Bay Seasoning)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4aa2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup Corn Meal ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"86jff","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup diced salt pork","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"831sg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"extra oil as needed","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3ced0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup creme fraiche for drizzling (or substitute sour cream)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"af0ci","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 Tablespoons chopped chives","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9eqa0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1fntu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8f620","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e1up4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"18fo6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Add the diced salt pork to a heavy cast iron or copper pan and turn heat to medium to start rendering the fat from the croutons. as they begin to fry, turn the heat down to medium low until they have turned light and crispy and the majority of the pork fat has been rendered into the pan.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ebp3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5rke2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Scoop the croutons out onto a paper towel and set aside.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"flqb5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a5fa0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Turn the heat back up on the pan and add more oil if necessary to cover the bottom. When the oil begins to shimmer it's time to add the tomato slices so be prepared to work fairly quickly as the oil heats up. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5tmbe","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c9tn6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Dredge the tomato slices one at a time in the flour (seasoned with Old Bay or Seasoned salt and pepper) and then the egg wash, followed by the corn meal. Lay each piece into the hot oil carefully and let them fry about 5 minutes per side until they are golden brown and crispy.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aeh6u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a8401","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Lay them out on a plate and top them with the creme fraiche, chives and crispy pork croutons","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5blcg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-04T19:06:17.180Z","updatedTimestamp":"2024-06-04T19:06:17.180Z","id":"35d65146-bd09-4856-9e2a-7d818b34c271"}},"contentId":"61728aec98f45e00165412b3","mostRecentContributorId":"577c92d8-55f7-4f98-88a2-d8647b1c2c9c","media":{"wixMedia":{"image":{"id":"577c92_c9a0543cbfa64776bcd7fcfce4d03439~mv2.jpg","url":"https://static.wixstatic.com/media/577c92_c9a0543cbfa64776bcd7fcfce4d03439~mv2.jpg","height":1125,"width":1500}},"displayed":true,"custom":false},"translations":[],"customExcerpt":false,"internalId":"5f6769847284500017e600ff","internalCategoryIds":["5f67697cf4b037001706012d","5f67697cf4b0370017060120","5f67697cf4b0370017060130"],"internalRelatedPostIds":[],"isLiked":false,"isSubscribed":false,"owner":{"activityStatus":"UNKNOWN","contactId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","id":"2d3dcba5-39de-4c33-b11a-89d9248a0e51"