{"postPage":{"id":"b238c88d-ea43-4a4d-9600-ed8601effd8d","post":{"id":"b238c88d-ea43-4a4d-9600-ed8601effd8d","title":"Real Pizza Burgers","excerpt":"Real Pizza Burgers My husband and I have ordered pizza burgers in restaurants and have usually been at least mildly disappointed so we...","firstPublishedDate":"2017-11-21T15:09:00.000Z","lastPublishedDate":"2017-11-21T15:09:00.000Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/11/21/real-pizza-burgers"},"slug":"2017/11/21/real-pizza-burgers","featured":false,"pinned":false,"categoryIds":["77a7e5bb-3035-4aec-b5d9-f3ac91f5cdd7","15abe877-7a05-4ea7-9f92-bfe7c73120b4","3f1d7728-06fe-468a-87cf-d2fcd2b9e367","6ba8db7a-6fe2-4b5a-83bf-acd0b1cbda4c","91a7e390-df71-4f96-9111-d518514de53a"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":112},"minutesToRead":3,"tagIds":["b08d39a1-4086-44ef-80c8-f8e8350ce628","85770abb-b1c0-4309-91ad-dc7e22f75279","0c4dac2b-7e0e-4c14-a1dd-ed8ccda80aa5","43d51ee2-c293-4380-896f-016de13adb3c","35f4e4bb-e1b8-44de-a84c-bd312373939c","6e46f861-0fed-4874-b21c-271039f22fb8","8371e60c-c0ab-4e23-a13e-086d16647682"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":112,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Real Pizza Burgers","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Real Pizza Burgers | Sweet Italian Sausage | Best Pizza Burger"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"7g1ki","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Real Pizza Burgers","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"fp181","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_9f5b587b2a894f51a974b3075de3f89b~mv2.jpg"},"width":1500,"height":1125},"altText":"Pizza Burger"}},{"type":"PARAGRAPH","id":"636nj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7u5mp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"My husband and I have ordered pizza burgers in restaurants and have usually been at least mildly disappointed so we decided it was time to invent our own. The first thing we changed was the meat patty. I used mild sweet Italian sausage instead! Yep, no burger.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"de5k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ektfr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I started building our new pizza burger from the bottom up using real pizza ingredients and then topped them with the thin grilled sausage patty, tomato and fresh greens. I would normally use spinach or arugula but we didn't have any in The Glass Pantry today so I went out to the garden and was inspired by the beautiful nasturtium growing there. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5fftf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"32m1b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Have you ever tried nasturtium leaves or flowers? They are sweet and spicy like arugula without the bitterness. They seemed like a perfect match for the sweet mild sausage and spicy pepperoni in our pizza burgers.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5vhn4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4qtuh","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"513ht","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a62c7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"8psvm","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_76576f23b84f443eb409cfad49febb31~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"dhhov","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" First I fry the thin sausage patties until they are no longer pink. While they are sizzling away I make up a quick pizza sauce. I use a small can of tomato sauce and heat it over low heat with some granulated garlic, onion powder, basil, pepper and a touch of red chili flakes and dried oregano. When the sausage patties are done just set them aside until you are ready to finish the pizza burgers.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ch9f3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9ec67","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"17jt4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"48gcd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a2djv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next I start preheating the broiler on the oven and then start topping the little pizza's. I've used jalapeno cheese kaiser rolls here. We both think these are by far the best bun for our pizza burgers. Before adding the sauce and toppings I butter the bottom bun. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7epi5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"oom5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tip: If you lightly butter the bread for your sandwiches (any sandwich) The fats will act as a barrier to keep the bread from becoming soggy. Science for the win! And it adds some flavor too. It's just like brushing a pizza crust with oil before adding the sauce and toppings. Please don't use oil here because the bread is too porous and it will just soak into the bread and make it soggy.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dqsiu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"egiac","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_e13ae4a2f3044528aae2d07c55b905cc~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"fkrn1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6mnau","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5cr9d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After I butter the buns, I layer on some pizza sauce, a sprinkle of mozzarella cheese, a few slices of pepperoni, some slivers of red onion, sliced olives, rings of green bell pepper and more mozzarella cheese. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d1ghk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bbhla","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aumjb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now give it a quick minute or two under the hot broiler. I used a medium setting on my oven broiler.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"7n8b0","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_ef3de5b1fee54e3eb0d8c30d18acb618~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"d4c37","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentat