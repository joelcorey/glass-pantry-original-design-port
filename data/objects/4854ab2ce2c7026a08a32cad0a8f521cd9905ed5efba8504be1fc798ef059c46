T"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_184fb2cc108b49c688726d0f628d1eb4~mv2.jpg"},"width":1500,"height":1125},"altText":"Louisiana Hot Legs"}},{"type":"PARAGRAPH","id":"66f8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dbb00","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Have you ever had a craving for some hot wings with just a little more meat on the bones? Well these Louisiana Hot Legs will cure that craving. I was looking for a buffalo chicken style recipe that I could really call dinner when I decided to opt for some chicken legs instead of the wings. These tasty legs are also baked, not deep fried.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8j15k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f0rb7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Hot Legs!","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"4veg2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"r4ml","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"We just call them Hot Legs at our house but since I had used a Louisiana Wing Sauce I added that to the title. Try this recipe with Frank’s or Durkee Hot Sauces, they make wonderful Hot Legs too!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"76i2p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6n374","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"These spicy chicken legs go great with rice or mashed potatoes. I had made some mashed potatoes the night before and we had some left over so I made some Mashed Potato Pancakes to go along with these. They were so good! ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2urns","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bq6t7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"b19uk","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_fc20593c7a51483ab24257651ed0d84c~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Sprinkle with Seasoning"},{"image":{"media":{"src":{"url":"577c92_55ab117a22754f20b88a6390ef10cf15~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Now shake on some flour."},{"image":{"media":{"src":{"url":"577c92_4d00aea2b2364b4cb262e440e6ac84c0~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Then spritz with some spray oil."},{"image":{"media":{"src":{"url":"577c92_0e3a73e4690545dc906d0a6da105b9e6~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Ready for the oven!"}],"options":{"layout":{"type":"GRID","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":2},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"a2k05","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a0f09","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"To make the legs, I start by shaking on some Old Bay seasoning then I sift on some flour and spritz with spray oil. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"374cs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8cjca","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e7m0a","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3g7hi","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Bake them a 425 degree oven for about 40 minutes until they are well done and crispy.  I turn them when they are half done to get them crispy all the way around.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2k49b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"5l1ku","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_d0836d5a4a454ca9baf424ba5590917a~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"20sfo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9nb55","