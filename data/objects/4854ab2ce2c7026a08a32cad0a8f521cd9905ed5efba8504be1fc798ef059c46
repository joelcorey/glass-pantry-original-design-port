id":"577c92_2925b2b3ae614ce8a359549492777fbf~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"272gu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I melted 6 tablespoons of butter in my saute pan until it was nice and foamy then added 6 tablespoons of Louisiana Wing Sauce. I stirred them together and then dipped and rolled each chicken leg in the sauce until well coated.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ar3ps","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"e0qfr","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_62e73566a49d4e0cb6c0fcba51728251~mv2.jpg"},"width":1196,"height":828},"altText":""}},{"type":"PARAGRAPH","id":"5i0bn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" Yum!","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"7j8ff","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"PARAGRAPH","id":"9aou7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cqcpq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"CENTER"},"indentation":0}},{"type":"IMAGE","id":"fs5ih","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_bab0bbc06b4c4c55a3bfc96e50aba1df~mv2.jpg"},"width":1245,"height":967},"altText":""}},{"type":"PARAGRAPH","id":"3gp9k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"After all of your hot legs have taken the dip, plate them up with a garnish of green onions and dig in!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6d8bt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ce5tv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1d8h1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aihbo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Make sure you have plenty of napkins!  These could be a meaty addition to your next game day.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"14uc5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"47hsh","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_fa23fa248e5e4ee69462b3477667e9ef~mv2.jpg"},"width":1500,"height":1125}},"title":"Louisiana Hot Legs"},{"image":{"media":{"src":{"url":"577c92_184fb2cc108b49c688726d0f628d1eb4~mv2.jpg"},"width":1500,"height":1125}},"title":"Louisiana Hot Legs"},{"image":{"media":{"src":{"url":"577c92_30557a9a457c4d73a51960142cd72675~mv2.jpg"},"width":1344,"height":975}},"title":"Louisiana Hot Legs"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orient