}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8dv99","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fumkn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"daokl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eciq5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 large package of chicken legs","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"98qvv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6 tablespoons of butter","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7fh70","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6 tablespoons Louisiana Wing Sauce, Frank's Hot Sauce or Durkee Hot Sauce","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a1uu4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup flour","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ar7pg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 tablespoons Old Bay Seasoning","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cl97r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Spray oil","decorations":[]}}],"paragraphData":{"te