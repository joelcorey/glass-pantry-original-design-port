{"postPage":{"id":"3eb21f6a-acf2-48f4-98ab-616e80447f55","post":{"id":"3eb21f6a-acf2-48f4-98ab-616e80447f55","title":"Carolina Reaper Hot Pepper Sauce","excerpt":"Carolina Reaper Hot Pepper Sauce Carolina Reaper peppers may just be the hottest peppers on the planet and I am a lucky girl to have a...","firstPublishedDate":"2017-12-10T18:49:05.706Z","lastPublishedDate":"2017-12-10T18:49:05.706Z","url":{"base":"https://www.theglasspantry.com","path":"/single-post/2017/12/06/carolina-reaper-hot-pepper-sauce"},"slug":"2017/12/06/carolina-reaper-hot-pepper-sauce","featured":false,"pinned":false,"categoryIds":["15abe877-7a05-4ea7-9f92-bfe7c73120b4","a704b556-158c-45cd-8aa0-7ecf3fb52188","7d525f78-2dd8-406c-9140-22b38e2eeded","27278c23-7e90-46de-93b3-ad018839fa44"],"memberId":"2d3dcba5-39de-4c33-b11a-89d9248a0e51","hashtags":[],"commentingEnabled":true,"postCountInfo":{"comments":0,"likes":0,"views":4193},"minutesToRead":4,"tagIds":["7aa07a18-7e74-414e-bc93-6a771d04f6b8","1dad3e35-ae86-4914-a78b-9c2b8e2ada11","a4293307-cc98-423f-8ce7-cfd9d16fbb7e","6c5a6e29-2bfe-4e38-bae7-070e3702090f"],"relatedPostIds":[],"pricingPlanIds":[],"language":"en","metrics":{"comments":0,"likes":0,"views":4193,"totalRatings":0,"averageRating":0},"seoData":{"tags":[{"type":"title","children":"Carolina Reaper Hot Pepper Sauce","custom":false,"disabled":false},{"type":"meta","props":{"name":"description","content":"Carolina Reaper Hot Pepper Sauce | How to make hot sauce | Hot Pepper Sauce"},"children":"","custom":false,"disabled":false}]},"richContent":{"nodes":[{"type":"HEADING","id":"f9csg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carolina Reaper Hot Pepper Sauce","decorations":[]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"1jp34","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4ca4494a146b47e9a569f6535a2561b4~mv2.jpg"},"width":1500,"height":1125},"altText":"Carolina Reaper Hot Sauce"}},{"type":"PARAGRAPH","id":"asb4o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8gr1g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carolina Reaper peppers may just be the hottest peppers on the planet and I am a lucky girl to have a friend who grows these beauties! I believe it's time to make some HOT sauce.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"33gcq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"12dih","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I received these shiny bright red peppers from Bob earlier this fall and they have been stored carefully in my spare refrigerator for a few weeks. They are not often sold in stores because of the difficulties in shipping and handling, You really need to grow these yourself or find a friend who does if you would like some.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bb8en","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"87so2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Most people have heard of Ghost Peppers but these Carolina Reapers are the clear winners when it comes to the Scoville heat units.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"afvff","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9nrj5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Here is a great article from ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Pepperscale","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true},{"type":"LINK","linkData":{"link":{"url":"www.pepperscale.com/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  called ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carolina Reaper Vs. Ghost Pepper: PepperScale Showdown","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.pepperscale.com/carolina-reaper-vs-ghost-pepper/","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":". I've found some really good information from this blog. If you are interested in hot peppers you might check them out.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9tm9v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"214fb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"One thing you should very seriously consider is wearing gloves and eye protection while handling these peppers. Knock on wood, I haven't had any problems yet but I sure wouldn't want any of this stuff in my eye!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ftshf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fdmiv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I made some hot sauce and some really hot salsa with the peppers I received from Bob last year and I was surprised at how easy making hot sauce really is. I did give a few bottles to friends but I still have 1 1/2 bottles here to keep me supplied for the next few months so I've decided to let this new batch do a little bit of aging with some oak chips. The oak chips I have were created for distilling whisky to mimic aging in an oak cask.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9r4ab","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"a3rt9","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4df02f7b503c49ebbd1f4395408832e2~mv2.jpg"},"width":1500,"height":1125},"altText":"Carolina Reaper pepper sauce"}},{"type":"PARAGRAPH","id":"35cmk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"90knd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cjjk4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The first thing I do is gather my ingredients and then carefully remove the stems from 20 rinsed peppers by pulling them straight out. This is fairly easy to do without rupturing the skin of the fruit. I cut each pepper in half by pinching the pepper with my fore finger and thumb then making one smooth cut with a very sharp knife. I toss it immediately into 2 cups of water in a small pot. This keeps the HOT from spreading anywhere I don't want it, like all over me or the cutting board.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"apc1c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bir4d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I then coarsely chop a small sweet onion, peel a small head of garlic ( leave the cloves whole) and add those vegetables plus 1 teaspoon of salt and 1 tablespoon of avocado oil to the pot.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8q1op","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"e4fdf","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4823031d2600464aaae44f556f7c3842~mv2.jpg"},"width":1500,"height":1125},"altText":"Carolina Reaper pepper sauce"}},{"type":"PARAGRAPH","id":"fjnh9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"  ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6foak","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1od2r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I bring this to a slow boil with the lid on and let it cook for 10 minutes or so without removing the lid. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c63ab","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e8mlg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Keep the peppers covered as much as possible to keep the capsaicin from escaping into the air. Capsaicin is what humans perceive as the \"heat\" in chile peppers. If you breath it too deeply it can cause coughing and burning sensations in your eyes and sinuses.  ","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bvlbd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"dc7aj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cvvk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1llb9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next, I set the pot off of the burner and let it cool down until it will no longer be steaming when I remove the lid. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5av5t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7feci","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Keep the peppers covered as much as possible to keep the capsaicin from escaping into the air. ","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Capsaicin","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"en.wikipedia.org/wiki/Capsaicin","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" is what humans perceive as the \"heat\" in chile peppers. If you breath it too deeply it can cause coughing and burning sensations in your eyes and sinuses. ","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" I cannot stress this enough.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9k3a3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fbjet","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When it's cooled down, I pour the contents of the pot into a blender, add 1 cup of white distilled vinegar and puree with the lid on until it's smooth. I leave the lid on for a few minutes to let things settle, then I pour the hot sauce into a sterilized mason jar with the lid just slightly loose and store it in the refrigerator. The hot sauce will likely do some fermenting over time and I want to be sure the gasses can escape.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5vsph","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ed9n2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I'll keep an eye on this and taste test in a few weeks to adjust the salt or vinegar if I think it needs it and then I will add the wood chips. After the sauce has had a few weeks to ferment, I'll tighten up the lid and let the hot sauce age for at least 6-8 months this time. Last years batch just seems to get better with age.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"64sur","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fmss6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This years batch tastes great now and is ready to use. Since this makes nearly a quart jar full, I would suggest bottling some to use some now and save the rest for later, aging in the cold storage of a refrigerator.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4lsdl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"donr6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It is important to learn and follow safe bottling procedures so no one gets botulism. Learn more about safe bottling procedures here at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"How to Bottle Sauces. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.ehow.com/how_2291883_bottle-sauces.html?utm_source=pinterest&utm_medium=eHowpinterest&utm_campaign=pinterest","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"by eHow","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fa4aq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"d2cjd","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_734486294c8e4621aba1daf2c03cd2b5~mv2.jpg"},"width":1125,"height":1500},"altText":