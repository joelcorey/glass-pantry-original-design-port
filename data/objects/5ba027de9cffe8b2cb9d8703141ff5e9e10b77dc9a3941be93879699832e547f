ment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"98mgj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7fjd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fqal4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"20 Hot Peppers ( Carolina Reapers or other varieties)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3643f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 cups hot water","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bf8tu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 coarsely chopped sweet onion","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b75t8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 small head of garlic whole cloves peeled","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4l572","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon of salt ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"48vfv","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tablespoon of vegetable oil ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6n5nq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup distilled vinegar","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eg9hj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 teaspoon xanthan gum","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c3h16","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 teaspoon citric acid","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1qqbo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"47vf7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9idn1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7hv2d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Carefully remove the stems from 20 rinsed peppers.by pulling them straight out. Cut each pepper in half. Tossing each one immediately into 2 cups of water in a small pot.  Add the rest of the vegetables plus 1 teaspoon of salt and 1 tablespoon of vegetable oil to the pot. Bring this to a slow boil with the lid on and let it cook for 10 minutes without removing the lid.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bhnle","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f755g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next, set the pot off of the burner and let it cool down.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"elp1v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3fq8q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When it's cooled,  pour the contents of the pot into a blender, add 1 cup of white distilled vinegar and puree with the lid on until it's smooth. Leave the lid on for a few minutes to let things settle, then add the xanthan gum and citric acid and puree once more to mix. Leave the lid on for a few minutes to let things settle again, then pour the hot sauce into a sterilized jar.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"esn8g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f01fg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It is important to learn and follow safe bottling procedures so no one gets botulism. Learn more about safe bottling procedures here at ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"How to Bottle Sauces. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.ehow.com/how_2291883_bottle-sauces.html?utm_source=pinterest&utm_medium=eHowpinterest&utm_campaign=pinterest","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"by eHow","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-06-06T02:23:16.912Z","updatedTimestamp":"2024-06-06T02:23:16.912Z","id":"6d6b0593-b858-4996-95f0-0223d92d81