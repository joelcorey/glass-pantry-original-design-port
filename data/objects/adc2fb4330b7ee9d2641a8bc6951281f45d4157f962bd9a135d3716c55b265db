:"AUTO"}},"style":{},"id":"xee9z4499","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-737ni","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 teaspoons active dry yeast","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"nqjt94501","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e21qg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tsp fine sea salt","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ouq264503","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-fl4b","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup sourdough starter","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"nw6ia4505","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-7u5t7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 cup water or whey","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"}],"metadata":{"version":1.0,"createdTimestamp":"2023-02-18T22:30:40.044Z","updatedTimestamp":"2023-02-18T22:30:40.044Z","id":"a924712a-1109-493d-87d6-84f52db991dc"},"documentStyle":{}},"catagory":"Bread","steps":{"nodes":[{"type":"PARAGRAPH","id":"foo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1. Add dry ingredients and butter to a stand mixer ( I don't sift) and mix on low speed with the hook attachment to somewhat combine.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0.0}},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vwzdm4550","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-9e5v9","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"1pjjz4551","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-7qahg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2. Add sourdough starter all at once and mix again on low speed to somewhat combine.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"3mpl74553","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-cc7b2","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"iei614554","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-fu32o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3. Begin to drizzle in the liquid very slowly with the machine running on low speed until you have used about 1 cup.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"b2j2n4556","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e02dd","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vnem24557","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-9drrj","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4. Allow the machine to continue to work the dough until it begins to pull away from the sides of the mixer adding more liquid tablespoon by tablespoon if it seems too dry. If you go too fast and the dough gets too wet add more bread flour a few tablespoons at a time. The dough should become just slightly sticky and be very soft in about 5 minutes. Let the machine knead a few minutes after it comes together about 6 minutes total. The dough should be very soft and not too sticky.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xwvaa4559","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-7lt5k","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"dsxve4560","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-qovp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"5. Turn the dough out onto a floured board with a spatula. Flour your hands and then knead the dough just a few times by folding it over itself one direction and then the other.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"4sm224562","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-3trck","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"ce7ty4563","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-mfua","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"6. Gather the dough into a ball and place it in a large bowl that has a teaspoon of oil in it and roll it around so it's lightly covered with the oil. I use grape seed oil but any good oil will do.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"dn85i4565","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-aq0l3","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"q7q6z4566","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-e8kja","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"7. Cover the bowl loosely with plastic wrap and set it somewhere warm to rise for 1-2 hours or until it has doubled in size. The more you bake in your house and the warmer it is, the faster your bread will rise. The extra yeasts in the air and some warmth will do amazing things!","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"9cq2m4568","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-19cmu","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"e1k0x4569","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-c6sj6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"8. When your bread has risen until you can still see your fingerprint when you poke it gently and it doesn't immediately spring back then it's time to form your loaf!","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"vi93u4571","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-68io5","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"abwcv4572","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-2f02d","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"9. Turn it out onto a floured board and degas the dough by folding it over on itself 3-4 times, then gather it back into a ball and put it into a floured proofing basket. I cover this with a cotton kitchen towel and set it back in my warm rising space on top of my stove with the range hood lights on for a little extra warmth.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"u42y94574","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-eec19","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"566me4575","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-ckg1m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"10. Put a cast iron dutch oven in your oven and begin heating it to 450 degrees for at least 30 minutes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"1ea8c4577","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-h6e8","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"yh6114578","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-1bdep","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"11. After 30 to 40 minutes the dough should have nearly doubled in size so prep for scoring by putting a piece of pop-up parchment paper on the breadboard and sprinkle it with cornmeal, polenta grits or semolina flour.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"xyh9a4580","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-70p5u","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"1bjb44581","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-csf25","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"12. Very carefully remove the preheated dutch oven to your stove top leaving the lid on.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"eybhy4583","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-4qh9p","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5afof4584","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-8c40g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"13. Gently roll/flip the formed loaf out of the proofing basket onto the parchment paper sprinkled with cornmeal and then quickly score the loaf with a razor blade making almost 1/2 inch deep slashes.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"4p0ok4586","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-32nv7","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"i825j4587","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-jpo3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"14. Remove the lid from the dutch oven with an oven mitt and gently transfer your loaf by lifting the parchment paper and setting the whole thing in the pot paper and all. Replace the lid using an oven mitt and put the whole dutch oven back into your oven.","decorations":[{"type":"COLOR","colorData":{"background":"var(--ricos-custom-p-background-color,unset)","foreground":""}}]}}],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"5k8ps4589","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-d27d9","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"c7elm4590","nodes":[],"type":"PARAGRAPH"},{"paragraphData":{"textStyle":{"textAlignment":"AUTO"}},"style":{},"id":"viewer-cf8rk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"15. Turn down the temperature on the oven to 425 degrees at this 