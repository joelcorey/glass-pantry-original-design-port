des":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Easy Mexican ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"fooli","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cole Slaw ","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2389h","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_c089c8a29c93482dbfc2d0bcb56e4613~mv2.jpg"},"width":1500,"height":1125},"altText":"Easy Mexican Cole Slaw"}},{"type":"PARAGRAPH","id":"2b2dp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"92ot1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"    I just love this Mexican Cole Slaw. It's fast, simple, healthy and I make mine with only 4 ingredients. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"br5qp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7qelb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"A friend showed me how to make this using a grater but I recently bought a julienne peeler that I use to create long thin noodle like pieces of carrot for this salad. The ratio of carrot to cabbage varies from region to region in Mexico but the ingredients remain close to this recipe. I like to use a lot of carrot. If you don't have any cabbage, try making this with just carrots, lime juice and a touch of sugar. It's delicious!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1oss9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ammpk","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Since I took this picture before the salad had time to marinate long, it's really fresh looking here. When given just 15 minutes or so the carrot and cabbage begin to weep and wilt creating a wonderful dressing and making the vegetables a little bit softer. This salad will stay crunchy and tasty for a few days so it's a great make ahead dish for a picnic or party.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a4rmb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"bjibo","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_a4e34e00318c460a922adcf285ebe2c7~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"29vrg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"folgc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2ijnr","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_3f3c497c96c3406d9c8ceeb6c6ce03a6~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"6p4g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2agak","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I chop the cabbage finely then add the julienne carrot, lime juice and sugar. Toss the slaw and let it stand at room temperature while making the rest of the meal or store it tightly covered in a refrigerator until later if your making this ahead of time.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"21luc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4oc89","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If I'm feeling like changing it up a little, I add a sprinkle of cayenne pepper, ground cumin, salt, or paprika. Usually only one or the other and not all of them together. A garnish of cilantro or a lime wedge is always pretty if you serve this family style or take it to a pot luck.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"135n6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"cdvp9","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_817ef659bf6642ecad1216ec388fdf93~mv2.jpg"},"width":1500,"height":1125},"altText":""}},{"type":"PARAGRAPH","id":"e39bm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1vu3e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1afgn","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The cabbage and carrot pickle just slightly in the lime juice and their juices blend with the lime to create a flavorful salad dressing with no fat that's low in processed sugar. I only add a  few teaspoons of sugar because the natural sugars of the carrot, cabbage and lime are nearly enough once their juices start flowing. This salad is nutritionally rich and has a good bit of healthy fiber. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6npss","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ae0of","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I like to serve this as a side or a topping whenever I'm making Mexican or Southwest style foods but it also compliments any kind of barbecue, or southeast Asian cuisine. Try it on a pulled pork or bahn-mi sandwich!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4d25","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bfcpm","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bar04","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"d3lt9","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"1rj9e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Easy Mexican Cole Slaw","decorations":[]}}]