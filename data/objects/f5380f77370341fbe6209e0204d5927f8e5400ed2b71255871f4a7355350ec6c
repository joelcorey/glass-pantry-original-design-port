emphasis on the North so we scooted through just after they reopened Interstate 84 and before the snow began.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ciqgr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"4kikg","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4ff52044424b4fe6a696153c18615da1~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"The Glass Pantry The Light at the End of the Tunnel"}},{"type":"PARAGRAPH","id":"68ui9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3k0ta","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"calnb","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Today I'm continuing to pack, clean, patch and paint the walls. I'm removing all of our pictures and artwork to get ready for the next trip.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"62p81","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ehug2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"90a0m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"It also appears we may be leaving a little earlier than we anticipated due to more snow on the wa