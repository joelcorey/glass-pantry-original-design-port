":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bql3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cn1ue","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" We're home from our second trip! One more big load to go and we will get to settle into our new home in Medford Oregon. It's certainly been an adventure traveling together pulling the two trailers all day through the winter weather.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5ltpf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a37ic","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"35kpf","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"HEADING","id":"fs5r0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You know the saying, \" I'm finally seeing a light at the end of the tunnel.\" Well, I'm sure most are seeing daylight, but I'm just cynical enough to be wondering if it's really an oncoming train.","decorations":[{"type":"BOLD","fontWeightValue":700}]}}],"headingData":{"level":3,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fsggu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7a0g9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"50o2r","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_4b8502f5e8fe470ca13efc147d5c593d~mv2_d_4160_3120_s_4_2.jpg"},"width":4160,"height":3120},"altText":"The Glass Pantry Foodie Blues"}},{"type":"PARAGRAPH","id":"vj44","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Superman took this photo on our way home after the first load in mild weather. Since then we've experienced several inches of snow and severe weather in North Central Oregon that have made us change our plans several times. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7bef0","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"918kp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"In truth it's probably encouraged us to hurry up because we always end up leaving a day ahead of schedule in order to scoot through before the next storm hits. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"126no","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"avo1h","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"The last run we made gave us a clear drive all the way to our new home just before it snowed there too! We had a lovely light snow that melted the next day. Lovely, non-life threatening snow.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7svr5","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ",