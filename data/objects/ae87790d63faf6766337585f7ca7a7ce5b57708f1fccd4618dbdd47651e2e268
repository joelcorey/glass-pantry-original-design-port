yle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"93uie","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"IMAGE","id":"2lcm2","nodes":[],"imageData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"image":{"src":{"id":"577c92_2062ee9c0c4c4ab8856fb82f6a01ba3b~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024},"altText":"<a data-pin-do=\"buttonPin\" data-pin-round=\"true\" data-pin-save=\"false\"  data-cke-saved-href=\"https://www.pinterest.com/pin/create/button/?url=https%3A%2F%2Fwww.flickr.com%2Fphotos%2Fkentbrew%2F6851755809%2F&media=https%3A%2F%2Ffarm8.staticflickr.com%2F7027%2F6851755809_df5b2051c9_z.jpg&description=Next%20stop%3A%20Pinterest\" href=\"https://www.pinterest.com/pin/create/button/?url=https%3A%2F%2Fwww.flickr.com%2Fphotos%2Fkentbrew%2F6851755809%2F&media=https%3A%2F%2Ffarm8.staticflickr.com%2F7027%2F6851755809_df5b2051c9_z.jpg&description=Next%20stop%3A%20Pinterest\"><img  data-cke-saved-src=\"//assets.pinterest.com/images/pidgets/pinit_fg_en_round_red_16.png\" src=\"//assets.pinterest.com/images/pidgets/pinit_fg_en_round_red_16.png\" /></a>"}},{"type":"PARAGRAPH","id":"8o6ob","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"You know how when you go to a nice restaurant and they have these really tasty, chunky, real croutons on the salad or as a soup topping?  I always feel short changed when I'm in a nice restaurant and I'm served croutons that I know came right out of a box. Especially when it seems like they probably have regularly leftover loaves or rolls from some delicious breads they are serving to everyone in the restaurant.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"mn43","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1mdcp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3789u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I always have bits of leftover bread ends and pieces after dinner.  So here's what I do with them!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2sfl4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"eqfsp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I save all of the ends and pieces in my freezer until I have enough for a batch of oven baked croutons. The more varieties of breads involved the better this is and these crunchy savory croutons are so easy to make, just thaw out the bread pieces and get chopping.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5m76o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"96sg7","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bq6f2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"GALLERY","id":"biu4p","nodes":[],"galleryData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":true},"items":[{"image":{"media":{"src":{"url":"577c92_d60e12e127e84ec4b84edaf15bb21b3f~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Bread for croutons"},{"image":{"media":{"src":{"url":"577c92_bb41baab347d4ade95cf6b37b0739023~mv2_d_3024_4032_s_4_2.jpg"},"width":3024,"height":4032}},"title":"Almost ready for the oven"},{"image":{"media":{"src":{"url":"577c92_35b2f18f701d43709da70463546c98d0~mv2_d_4032_3024_s_4_2.jpg"},"width":4032,"height":3024}},"title":"Beautiful Homemade Croutons"}],"options":{"layout":{"type":"FULLSIZE","horizontalScroll":false,"orientation":"ROWS","numberOfColumns":3},"item":{"targetSize":300,"ratio":1,"crop":"FILL","spacing":10},"thumbnails":{"placement":"BOTTOM","spacing":0}}}},{"type":"PARAGRAPH","id":"6nj5e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5goqr","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Once the bread is cubed, or torn, place the cubes on baking sheets with some seasonings that you like and some extra virgin olive oil then bake at a medium temp until you get the crispy crunch you desire. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b9aan","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"97v1q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"For me this takes about 30 minutes at 350 degrees, tossing the croutons and rotating the sheet pans once. I always have on hand a seasoning blend that I put together out of coarse or kosher salt, some chili flakes, pepper and dried herbs that I keep in a repurposed spice grinder. I grind it liberally onto the bread cubes before tossing them in the oil and baking.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"ed0n4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"afv6t","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"33n5g","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Although my husband really likes these when they are just a little bit soft, I find they tend to go stale much faster than if you get them dried through. If you like them a little soft like we do sometimes just make enough for a meal or two. If you want them to keep for a while, dry them thoroughly and keep them in an airtight container. Mine usually keep for 2-3 weeks this way. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1q68r","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"4adbg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"If you've ever felt bad about wasting bread, especially homemade breads and rolls, feel bad no more! Make croutons and try them in a recipe like my ","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Caesar Salad with Pan Grilled Chicken and Sweet Potato. ","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"COLOR","colorData":{"foreground":"#0957a2"}},{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/04/13/Caesar-Salad-with-Pan-Grilled-Chicken-and-Crispy-Roasted-Sweet-Potatoes","target":"BLANK"}}}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I've also used these to make incredible stuffing! ","decorations":[{"type":"LINK","linkData":{"link":{"url":"www.theglasspantry.com/single-post/2017/04/13/Caesar-Salad-with-Pan-Grilled-Chicken-and-Crispy-Roasted-Sweet-Potatoes","target":"BLANK"}}}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bso39","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b4b3c","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"I really hope you'll try this recipe because there is nothing like a homemade crouton in a box at the store.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f0rlt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"tcec","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Cheers!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"a3g7m","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"~Melisa","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"d4ciq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"DIVIDER","id":"cg2vj","nodes":[],"dividerData":{"containerData":{"width":{"size":"CONTENT"},"alignment":"CENTER","textWrap":false},"lineStyle":"SINGLE","width":"LARGE","alignment":"CENTER"}},{"type":"HEADING","id":"d37r3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"How to Make Great Croutons","decorations":[]}}],"headingData":{"level":2,"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1gium","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"90o9o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9nf2e","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"This Recipe makes 4-5 cups of croutons","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2n74v","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"88a0p","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Ingredients","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"96krc","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5srli","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Lots of leftover bread cut into cubes or torn in pieces (about 4-5 cups)","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3k207","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Seasoned salt & pepper mix of your choice to taste","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2jpv4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Approximately 1/4 cup Extra Virgin Olive Oil ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2ja18","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3algo","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1hmfg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6odri","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"e1dfd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"3q4e3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Toss the bread cubes on sheet pans with the seasoned salt and then the EVOO and bake at 350 degrees for 30 minutes tossing croutons and rotating pans halfway through.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"22oj2","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"58pre","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"fb833","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}}],"metadata":{"version":1,"createdTimestamp":"2024-05-07T16:58:38.520Z","updatedTimestamp":"2024-05-07T16:58:38.520Z","id":"aaf11930-6484-4bde-9760-6312abaa331c"}},"contentId":"61728aecc4284300161412ee","mostR