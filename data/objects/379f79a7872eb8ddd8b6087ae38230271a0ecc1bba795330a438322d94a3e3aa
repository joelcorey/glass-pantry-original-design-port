textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"b6ops","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 red jalepeño chilies, seeded and minced","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"c1uu9","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 teaspoons minced garlic","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"38msq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 cup + 2 Tbsp rum","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cv4gs","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"3 Tbsp Kahlua","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"cnkkg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"bgpk3","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8kejg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 cups chicken stock, homemade is always nice!","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"537jl","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/2 teaspoon allspice","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"6iiqt","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1/4 teaspoon cinnamon","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"41c68","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 teaspoon hot pepper sauce - I used a habañero hot sauce I made at home","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"acd8f","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"4 sprigs fresh thyme or 1 tsp dry thyme","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8hds6","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"2 bay leaves","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1vs7q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tablespoon brown sugar ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"art3o","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tablespoon red wine vinegar","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"atfjg","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 (14.5-ounce) can diced tomatoes, preferably fire roasted","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8594j","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 tablespoon soy sauce","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"9n8ij","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"1 1/2 tablespoons steak sauce, such as A-1","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"371g8","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5vs95","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"\n","decorations":[]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Method","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"ITALIC","italicData":true}]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"i95k","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"48ctq","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Heat the oil a dutch oven on the stove top then sprinkle beef with salt and pepper. Start searing the meat in batches until all pieces are well browned. Reserve done pieces of meat in a pie plate to rest as they finish searing.","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f3lrd","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5d8q1","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When all the beef has been seared, add the onion and the carrots to the pot adding back in the seared meat and any juices that have accumulated in the pie plate. Let this cook at medium high heat while stirring it around for a few minutes. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"8o62q","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5pbff","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Next turn the heat down to medium and add in the chilis, garlic, rum and coffee liqueur. Bring to a boil and let that cook together while stirring any brown bits off the bottom of the pan for a few minutes more. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"1vfcp","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"5tl3u","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Now you can add all the rest of the spices, seasonings, stock and tomatoes while stirring and bringing everything back to a boil before putting the lid on your dutch oven and turning the heat down to simmer for 1 1/2 hours. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"2vlh4","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"f4i9n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"When stew is done take off the lid and discard thyme sprigs and bay leaves. If you think your stew is not thick enough, just leave it to simmer with the lid off for a while to thicken it up. Season to taste with salt and pepper. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"7ja37","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"aiphu","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Garnish with green onions if you like and serve with your favorite rice. ","decorations":[]}}],"paragraphData":{"textStyle":{"textAlignment":"AUTO"},"indentation":0}},{"type":"PARAGRAPH","id":"54u8n","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":" ","decorations":[]}}],"paragraphData":{"